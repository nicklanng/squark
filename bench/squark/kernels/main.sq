// kernels runs one small loop many times: the loops a vectorizing compiler should turn into SIMD
// code. bench/gocompute/kernels.go is the Go version; outputs must match.
//
//	kernels NAME REPS
//
// The kernels take slices, not the package arrays, so the compiler can't see their lengths.
// Each repetition changes one input element, so a repetition can't be skipped.
program

use json, os, strconv, strings

const n = 16384

thread (
	f32a f32[n]
	f32b f32[n]
	f64a f64[n]
	i32a i32[n]
	i32b i32[n]
	u8a  u8[n]
	u8b  u8[n]
	u8c  u8[n]
)

//squark:noinline
fn saxpy(a f32, x f32[], y f32[]) {
	for i, _ in x {
		y[i] += a * x[i]
	}
}

//squark:noinline
fn dot_int32(a i32[], b i32[]) -> i32 {
	var s i32
	for i := 0; i < len(a); i++ {
		s += a[i] * b[i]
	}
	return s
}

// sum_float64 adds in order: a vectorized sum would round differently, so it stays scalar
// until it is written with SIMD types.
//
//squark:noinline
fn sum_float64(x f64[]) -> f64 {
	var s f64
	for v in x {
		s += v
	}
	return s
}

//squark:noinline
fn count_byte(b u8[], c u8) -> int {
	k := 0
	for i, _ in b {
		if b[i] == c {
			k++
		}
	}
	return k
}

const hex_digits = "0123456789abcdef"

thread hex_out u8[2 * n]

//squark:noinline
fn hex_encode(dst u8[], src u8[]) {
	for i, c in src {
		dst[2*i] = hex_digits[c>>4]
		dst[2*i+1] = hex_digits[c&15]
	}
}

//squark:noinline
fn max_int32(x i32[]) -> i32 {
	m := x[0]
	for i := 1; i < len(x); i++ {
		if x[i] > m {
			m = x[i]
		}
	}
	return m
}

//squark:noinline
fn xor_bytes(dst u8[], a u8[], b u8[]) {
	for i, _ in dst {
		dst[i] = a[i] ^ b[i]
	}
}

// pair_sums writes each pair's sum and difference: a loop that steps by two.
//
//squark:noinline
fn pair_sums(dst i32[], src i32[]) {
	for i := 0; i < len(src)-1; i += 2 {
		dst[i] = src[i] + src[i+1]
		dst[i+1] = src[i] - src[i+1]
	}
}

// add_rows adds two w-wide row-major matrices row by row, the index offset by the row start.
//
//squark:noinline
fn add_rows(dst i32[], a i32[], b i32[], w int) {
	rows := len(dst) / w
	for r := 0; r < rows; r++ {
		base := r * w
		for j := 0; j < w; j++ {
			dst[base+j] = a[base+j] + b[base+j]
		}
	}
}

//squark:noinline
fn brighten(dst u8[], src u8[]) {
	for i, _ in src {
		v := int(src[i]) * 3 / 2
		if v > 255 {
			v = 255
		}
		dst[i] = u8(v)
	}
}

//squark:noinline
fn dot_float32(a f32[], b f32[]) -> f32 {
	var s f32
	for i, _ in a {
		s += a[i] * b[i]
	}
	return s
}

// index_byte returns the index of the first c in b, or -1. The loop can exit early, which
// stops clang vectorizing it.
//
//squark:noinline
fn index_byte(b u8[], c u8) -> int {
	for i, _ in b {
		if b[i] == c {
			return i
		}
	}
	return -1
}

// Vec is a vector of numbers held in a struct: the loops index a field through a pointer.
struct Vec {
	data f32[]
}

impl Vec {
	//squark:noinline
	fn axpy(&self, a f32, x *Vec) {
		for i, _ in self.data {
			self.data[i] += a * x.data[i]
		}
	}
}

fn setup_dot() {
	for i, _ in f32b {
		f32b[i] = f32(i % 7)
	}
}

// one 255 near the end: the search reads almost all of u8c
fn setup_index() { u8c[n-5] = 255 }

// letters, with "needle" near the end
fn setup_text() {
	for i, _ in u8c {
		u8c[i] = 'a' + u8(i%23)
	}
	copy(u8c[n-40:], "needle")
}

fn main() {
	if os.n_args() != 3 {
		println("usage: kernels NAME REPS")
		os.exit(2)
	}
	name := os.arg(1)
	reps, err := strconv.atoi(os.arg(2))
	if err != nil or reps < 1 {
		println("REPS must be a positive integer")
		os.exit(2)
	}
	for i := 0; i < n; i++ {
		f32a[i] = f32(i % 64)
		f64a[i] = f64(i % 64)
		i32a[i] = i32(i%1000 - 500)
		i32b[i] = i32(i%7 + 1)
		u8a[i] = u8(i * 7)
		u8b[i] = u8(i * 13)
	}
	var check i64
	switch name {
	case "saxpy":
		for r := 0; r < reps; r++ {
			// a alternates between 1 and -1, so y stays small and every result is exact
			saxpy(f32(1-2*(r&1)), f32a[:], f32b[:])
			check += i64(f32b[r%n])
			f32a[r%n] = f32(r % 64)
		}
	case "dot-int32":
		for r := 0; r < reps; r++ {
			check += i64(dot_int32(i32a[:], i32b[:]))
			i32a[r%n] = i32(r%1000 - 500)
		}
	case "sum-float64":
		for r := 0; r < reps; r++ {
			check += i64(sum_float64(f64a[:]))
			f64a[r%n] = f64(r % 64)
		}
	case "count-byte":
		for r := 0; r < reps; r++ {
			check += i64(count_byte(u8a[:], 7))
			u8a[r%n] = u8(r)
		}
	case "max-int32":
		for r := 0; r < reps; r++ {
			check += i64(max_int32(i32a[:]))
			i32a[r%n] = i32(r % 1001)
		}
	case "xor-bytes":
		for r := 0; r < reps; r++ {
			xor_bytes(u8c[:], u8a[:], u8b[:])
			check += i64(u8c[r%n])
			u8a[r%n] = u8(r)
		}
	case "pair-sums":
		for r := 0; r < reps; r++ {
			pair_sums(i32b[:], i32a[:])
			check += i64(i32b[r%n])
			i32a[r%n] = i32(r % 7)
		}
	case "add-rows":
		for r := 0; r < reps; r++ {
			add_rows(i32b[:], i32a[:], i32b[:], 128)
			check += i64(i32b[r%n])
			i32b[r%n] = i32(r % 7)
		}
	case "brighten":
		for r := 0; r < reps; r++ {
			brighten(u8c[:], u8a[:])
			check += i64(u8c[r%n])
			u8a[r%n] = u8(r)
		}
	case "dot-float32":
		setup_dot()
		for r := 0; r < reps; r++ {
			check += i64(dot_float32(f32a[:], f32b[:]))
			f32a[r%n] = f32(r % 8)
		}
	case "method-axpy":
		// saxpy as a method: v.data and x.data are fields reached through pointers
		v := Vec{f32b[:]}
		x := Vec{f32a[:]}
		for r := 0; r < reps; r++ {
			v.axpy(f32(1-2*(r&1)), &x)
			check += i64(f32b[r%n])
			f32a[r%n] = f32(r % 64)
		}
	case "strings-index":
		// standard library code: strings.index finds "needle" near the end of 16 KiB of text
		setup_text()
		for r := 0; r < reps; r++ {
			check += i64(strings.index(str(u8c[:]), "needle"))
			u8c[r%(n-64)] = 'a' + u8(r%26)
		}
	case "json-string":
		// json.append_string of 16 KiB of text with an escape every 64 bytes
		setup_text()
		for i := 63; i < n; i += 64 {
			u8c[i] = '"'
		}
		var out u8[2 * n]
		for r := 0; r < reps; r++ {
			check += i64(len(json.append_string(out[:0], str(u8c[:]))))
			u8c[r%(n-64)] = 'a' + u8(r%26)
		}
	case "json-decode":
		// json.Decoder.String of a 16 KiB JSON string with an escape every 64 bytes
		setup_text()
		u8c[0] = '"'
		for i := 63; i < n-1; i += 64 {
			u8c[i-1], u8c[i] = '\\', 'n'
		}
		u8c[n-1] = '"'
		var out u8[n]
		for r := 0; r < reps; r++ {
			d := json.new_decoder(u8c[:])
			s, _ := d.string(out[:])
			check += i64(len(s))
			u8c[1+r%(n-80)] = 'a' + u8(r%26)
		}
	case "hex":
		for r := 0; r < reps; r++ {
			hex_encode(hex_out[:], u8a[:])
			check += i64(hex_out[(r*7)%(2*n)])
			u8a[r%n] = u8(r)
		}
	case "index-byte":
		setup_index()
		for r := 0; r < reps; r++ {
			check += i64(index_byte(u8c[:], 255))
			u8c[r%(n-5)] = u8(r % 200)
		}
	default:
		c, ok := simd_kernel(name, reps)
		if not ok {
			println("unknown kernel", name)
			os.exit(2)
		}
		check = c
	}
	println(check)
}
