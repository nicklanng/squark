package main

// The SIMD versions. Their results equal the scalar ones because the data are small integers,
// so every float sum is exact in any order.

//squark:noinline
func sumFloat64SIMD(x []float64) float64 {
	var a, b float64x4
	i := 0
	for ; i+8 <= len(x); i += 8 {
		a += float64x4(x[i:])
		b += float64x4(x[i+4:])
	}
	s := (a + b).Sum()
	for ; i < len(x); i++ {
		s += x[i]
	}
	return s
}

//squark:noinline
func dotFloat32SIMD(x []float32, y []float32) float32 {
	var a, b float32x8
	i := 0
	for ; i+16 <= len(x); i += 16 {
		a += float32x8(x[i:]) * float32x8(y[i:])
		b += float32x8(x[i+8:]) * float32x8(y[i+8:])
	}
	s := (a + b).Sum()
	for ; i < len(x); i++ {
		s += x[i] * y[i]
	}
	return s
}

//squark:noinline
func indexByteSIMD(b []byte, c byte) int {
	cs := uint8x16(c)
	i := 0
	for ; i+16 <= len(b); i += 16 {
		if m := uint8x16(b[i:]) == cs; m.Any() {
			for j := 0; j < 16; j++ {
				if m[j] != 0 {
					return i + j
				}
			}
		}
	}
	for ; i < len(b); i++ {
		if b[i] == c {
			return i
		}
	}
	return -1
}

// hexEncodeSIMD looks up the digits of 16 high and 16 low nibbles at once, then interleaves them.
//
//squark:noinline
func hexEncodeSIMD(dst []byte, src []byte) {
	t := uint8x16(hexDigits)
	i := 0
	for ; i+16 <= len(src); i += 16 {
		b := uint8x16(src[i:])
		hi, lo := t.Lookup(b>>4), t.Lookup(b&15)
		hi.Shuffle(lo, 0, 16, 1, 17, 2, 18, 3, 19, 4, 20, 5, 21, 6, 22, 7, 23).Store(dst[2*i:])
		hi.Shuffle(lo, 8, 24, 9, 25, 10, 26, 11, 27, 12, 28, 13, 29, 14, 30, 15, 31).Store(dst[2*i+16:])
	}
	for ; i < len(src); i++ {
		dst[2*i] = hexDigits[src[i]>>4]
		dst[2*i+1] = hexDigits[src[i]&15]
	}
}

// simdKernel runs a SIMD kernel: the same work and result as the scalar kernel it is named after.
func simdKernel(name string, reps int) (int64, bool) {
	var check int64
	switch name {
	case "sum-float64/simd":
		for r := 0; r < reps; r++ {
			check += int64(sumFloat64SIMD(f64a[:]))
			f64a[r%n] = float64(r % 64)
		}
	case "dot-float32/simd":
		setupDot()
		for r := 0; r < reps; r++ {
			check += int64(dotFloat32SIMD(f32a[:], f32b[:]))
			f32a[r%n] = float32(r % 8)
		}
	case "index-byte/simd":
		setupIndex()
		for r := 0; r < reps; r++ {
			check += int64(indexByteSIMD(u8c[:], 255))
			u8c[r%(n-5)] = byte(r % 200)
		}
	case "hex/simd":
		for r := 0; r < reps; r++ {
			hexEncodeSIMD(hexOut[:], u8a[:])
			check += int64(hexOut[(r*7)%(2*n)])
			u8a[r%n] = byte(r)
		}
	default:
		return 0, false
	}
	return check, true
}
