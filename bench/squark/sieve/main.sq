// sieve counts primes below N. The bit table is a package-level array: static memory, sized at
// compile time, so the program's maximum memory use is known before it runs.
program

use os, strconv

const max_n = 50000000

thread composite bool[max_n]

fn sieve(n int) -> int {
	if n < 3 {
		return 0
	}
	c := composite[:n]
	for i := 2; i*i < n; i++ {
		if not c[i] {
			for j := i * i; j < n; j += i {
				c[j] = true
			}
		}
	}
	count := 0
	for i := 2; i < n; i++ {
		if not c[i] {
			count++
		}
	}
	return count
}

fn main() {
	n := max_n
	if os.n_args() > 1 {
		v, err := strconv.atoi(os.arg(1))
		if err != nil or v < 0 or v > max_n {
			println("N must be between 0 and", max_n)
			os.exit(2)
		}
		n = v
	}
	println(sieve(n))
}
