// sieve counts primes below N. The bit table is a package-level array: static memory, sized at
// compile time, so the program's maximum memory use is known before it runs.
package main

import (
	"os"
	"strconv"
)

const maxN = 50000000

var composite [maxN]bool

func sieve(n int) int {
	if n < 3 {
		return 0
	}
	c := composite[:n]
	for i := 2; i*i < n; i++ {
		if !c[i] {
			for j := i * i; j < n; j += i {
				c[j] = true
			}
		}
	}
	count := 0
	for i := 2; i < n; i++ {
		if !c[i] {
			count++
		}
	}
	return count
}

func main() {
	n := maxN
	if os.NArgs() > 1 {
		v, err := strconv.Atoi(os.Arg(1))
		if err != nil || v < 0 || v > maxN {
			println("N must be between 0 and", maxN)
			os.Exit(2)
		}
		n = v
	}
	println(sieve(n))
}
