// jsonenc encodes an order with 10 items N times into a reused buffer and prints the total
// number of bytes (counting a trailing newline per document, like Go's json.Encoder).
program

use json, os, strconv

struct Item {
	sku         str
	name        str
	qty         int
	price_cents int
}

struct Order {
	id       int
	customer str
	email    str
	paid     bool
	items    Item[]
}

fn append_order(dst u8[], o *Order) -> u8[] {
	dst = append(dst, `{"id":`...)
	dst = json.append_int(dst, o.id)
	dst = append(dst, `,"customer":`...)
	dst = json.append_string(dst, o.customer)
	dst = append(dst, `,"email":`...)
	dst = json.append_string(dst, o.email)
	dst = append(dst, `,"paid":`...)
	dst = json.append_bool(dst, o.paid)
	dst = append(dst, `,"items":[`...)
	for i, it in o.items {
		if i > 0 {
			dst = append(dst, ',')
		}
		dst = append(dst, `{"sku":`...)
		dst = json.append_string(dst, it.sku)
		dst = append(dst, `,"name":`...)
		dst = json.append_string(dst, it.name)
		dst = append(dst, `,"qty":`...)
		dst = json.append_int(dst, it.qty)
		dst = append(dst, `,"price_cents":`...)
		dst = json.append_int(dst, it.price_cents)
		dst = append(dst, '}')
	}
	dst = append(dst, "]}\n"...)
	return dst
}

fn main() {
	n := 2000000
	if os.n_args() > 1 {
		n, _ = strconv.atoi(os.arg(1))
	}
	// item strings are built once into a text arena
	var text u8[512]
	t := text[:0]
	var items Item[10]
	for i, _ in items {
		s := len(t)
		t = append(t, "SKU-"...)
		t = strconv.append_int(t, 1000+i)
		sku := str(t[s:])
		s = len(t)
		t = append(t, "widget "...)
		t = strconv.append_int(t, i)
		items[i] = Item{sku: sku, name: str(t[s:]), qty: i + 1, price_cents: 199 * (i + 1)}
	}
	o := Order{customer: "Ada Lovelace", email: "ada@example.com", items: items[:]}
	var buf u8[4096]
	total := 0
	for i := 0; i < n; i++ {
		o.id = i
		o.paid = i%2 == 0
		out := append_order(buf[:0], &o)
		total += len(out)
	}
	println(total)
}
