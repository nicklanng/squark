// wordfreq prints the 10 most frequent words in a file as "count word".
// It streams the file through a 64 KiB buffer and copies each distinct word once into a
// package arena, so memory use is bounded by the vocabulary, not the file size.
program

use io, os, sort, strconv

const (
	max_words  = 128K
	chunk_size = 64K
)

// words holds one copy of every distinct word for the life of the program.
arena words 8M

struct Entry {
	word  str
	count int
}

thread entries Entry[max_words]
thread nentries = 0

// counts maps each word (interned, so its key is static) to its index in entries.
thread counts int[str; max_words]

fn count(w u8[]) {
	idx, ok := counts[str(w)]
	if not ok {
		if nentries == max_words {
			panic("too many distinct words")
		}
		idx = nentries
		entries[idx] = Entry{word: str(w) in words}
		counts[entries[idx].word] = idx
		nentries++
	}
	entries[idx].count++
}

// less orders by count descending, then word ascending.
fn less(a, b Entry) -> bool {
	if a.count != b.count {
		return a.count > b.count
	}
	return a.word < b.word
}

fn main() {
	if os.n_args() != 2 {
		println("usage: wordfreq FILE")
		os.exit(2)
	}
	f, err := os.open(os.arg(1))
	if err != nil {
		println("open:", err.message())
		os.exit(1)
	}
	var buf u8[chunk_size]
	carry := 0
	loop {
		n, err := f.read(buf[carry:])
		end := carry + n
		at_eof := err == io.EOF or n == 0
		if err != nil and err != io.EOF {
			println("read:", err.message())
			os.exit(1)
		}
		start := -1
		for i := 0; i < end; i++ {
			c := buf[i]
			if c >= 'A' and c <= 'Z' {
				c += 'a' - 'A'
				buf[i] = c
			}
			if c >= 'a' and c <= 'z' {
				if start < 0 {
					start = i
				}
			} else if start >= 0 {
				count(buf[start:i])
				start = -1
			}
		}
		if at_eof {
			if start >= 0 {
				count(buf[start:end])
			}
			break
		}
		// carry a partial word over to the next chunk
		carry = 0
		if start >= 0 {
			carry = copy(buf[:], buf[start:end])
		}
	}
	f.close()
	all := entries[:nentries]
	sort.slice(all, less)
	var line u8[128]
	for i := 0; i < len(all) and i < 10; i++ {
		out := strconv.append_int(line[:0], all[i].count)
		out = append(out, ' ')
		out = append(out, all[i].word...)
		out = append(out, '\n')
		os.stdout.write(out)
	}
}
