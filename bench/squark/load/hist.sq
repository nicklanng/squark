program

// Hist is a small HDR-style log-linear histogram of nanosecond latencies, the same as
// bench/load/hist.go: each power-of-two range is split into 128 linear sub-buckets, so any
// recorded value is reported with < 0.8% relative error.
const (
	sub_bits    = 7
	sub_count   = 1 << sub_bits
	hist_bucket = (64-sub_bits)*sub_count + sub_count
)

struct Hist {
	counts u64[hist_bucket]
	n      u64
	sum    u64
	max    u64
	min    u64
}

// len64 is Go's bits.Len64: the number of bits needed to represent x.
fn len64(x u64) -> int {
	n := 0
	if x >= 1<<32 {
		x >>= 32
		n = 32
	}
	if x >= 1<<16 {
		x >>= 16
		n += 16
	}
	if x >= 1<<8 {
		x >>= 8
		n += 8
	}
	while x != 0 {
		x >>= 1
		n++
	}
	return n
}

fn bucket_of(v u64) -> int {
	if v < 2*sub_count {
		return int(v)
	}
	exp := len64(v) - (sub_bits + 1)
	return exp*sub_count + int(v>>uint(exp))
}

// bucket_mid returns a representative value (midpoint) for bucket i.
fn bucket_mid(i int) -> u64 {
	if i < 2*sub_count {
		return u64(i)
	}
	exp := i/sub_count - 1
	mant := u64(i - exp*sub_count)
	lo := mant << uint(exp)
	return lo + (u64(1)<<uint(exp))/2
}

impl Hist {
	fn record(&self, ns int) {
		v := u64(ns)
		self.counts[bucket_of(v)]++
		self.n++
		self.sum += v
		if v > self.max {
			self.max = v
		}
		if self.min == 0 or v < self.min {
			self.min = v
		}
	}

	fn merge(&self, o *Hist) {
		for i := 0; i < hist_bucket; i++ {
			self.counts[i] += o.counts[i]
		}
		self.n += o.n
		self.sum += o.sum
		if o.max > self.max {
			self.max = o.max
		}
		if o.min != 0 and (self.min == 0 or o.min < self.min) {
			self.min = o.min
		}
	}

	// quantile returns the q-quantile in nanoseconds.
	fn quantile(&self, q f64) -> int {
		if self.n == 0 {
			return 0
		}
		target := u64(q*f64(self.n) + 0.5)
		if target < 1 {
			target = 1
		}
		var seen u64
		for i := 0; i < hist_bucket; i++ {
			seen += self.counts[i]
			if seen >= target {
				v := bucket_mid(i)
				if v > self.max {
					v = self.max
				}
				return int(v)
			}
		}
		return int(self.max)
	}

	// mean returns the mean in nanoseconds.
	fn mean(&self) -> int {
		if self.n == 0 {
			return 0
		}
		return int(self.sum / self.n)
	}
}

