// load is the squark port of bench/load: an HTTP load generator with N keep-alive connections,
// each driven by its own goroutine sending pre-built requests through the std http client and
// timing the responses (whose bodies are read and dropped).
//
//	load -url http://127.0.0.1:8080/notes -c 64 -d 10s [-method GET] [-body '{...}'] [-mix] [-seed 1000] [-json]
//
// The flags, the -json output and the latency histogram are bench/load's, so the harness can use
// either. -mix seeds -seed notes with POST /notes, then sends 80% GET /notes/{id}, 10% GET /notes
// and 10% POST /notes. -startup (launch a server and time it until it answers) needs process
// spawning, which squark doesn't have: use the Go load (bench/bin/load) for that.
//
// With threads auto, each scheduler thread runs main: each opens its share of the connections (at
// least 32, so -c 64 runs on two threads) and counts its own results, and the threads send their
// counts to thread 0, which prints the total. SQUARK_THREADS=N limits the number of threads.
program {
	threads auto
	pool http.serve_conn 1 // the http package's server goroutines: unused here
}

use http, json, os, runtime, strconv, strings, time

const (
	max_conns = 4096  // connections per scheduler thread
	max_seed  = 10000 // notes seeded for -mix

	conns_per_thread = 32
)

// the command line (each thread parses it)
thread (
	raw_url = "http://127.0.0.1:8080/notes"
	conns   = 64
	dur     = 10 * time.second
	method  = "GET"
	body    = ""
	mix     = false
	seed_n  = 1000
	as_json = false
	startup = 0
)

// the target and the requests built from it
thread (
	addr      str // host:port to dial
	host      str // the Host header
	path      str // path and query
	addr_buf  u8[256]
	path_buf  u8[4K]
	fixed_buf u8[64K + 1K]
	fixed_req u8[] // the request without -mix
	post_buf  u8[64K + 1K]
	post_req  u8[]
	list_buf  u8[1K]
	list_req  u8[]
	mode_buf  u8[1K]
)

struct Seeded {
	n   int
	ids int[max_seed]
}

// Stats are one thread's results; its connection goroutines update them between requests.
struct Stats {
	h        Hist
	requests int
	non2xx   int
	errors   int
	status   int[600]
	elapsed  time.Duration
}

thread (
	seeded Seeded
	st     Stats
	other  Stats
	stop   bool
	done   bool chan[max_conns]
)

// Thread 0 seeds the notes for -mix and sends their ids to the other threads; they send their
// results back.
shared seed_ch Seeded chan[1]
shared results Stats chan[1]

fn fatal(msg str) {
	if runtime.shard() == 0 {
		var b u8[512]
		m := append(b[:0], "load: "...)
		m = append(m, msg...)
		m = append(m, '\n')
		os.stderr.write(m)
		os.exit(1)
	}
	loop {
		time.sleep(time.hour) // thread 0 reports the error and ends the process
	}
}

fn fatal2(msg str, detail str) {
	var b u8[1024]
	m := append(b[:0], msg...)
	m = append(m, detail[:min(len(detail), 900)]...)
	fatal(str(m))
}

// parse_duration parses a Go duration ("10s", "1.5s", "1m30s", "500ms").
fn parse_duration(s str) -> (time.Duration, bool) {
	if s == "0" {
		return 0, true
	}
	if s == "" {
		return 0, false
	}
	var d f64
	while len(s) > 0 {
		i := 0
		while i < len(s) and (s[i] >= '0' and s[i] <= '9' or s[i] == '.') {
			i++
		}
		if i == 0 {
			return 0, false
		}
		v, err := strconv.parse_float(s[:i])
		if err != nil {
			return 0, false
		}
		s = s[i:]
		j := 0
		while j < len(s) and not (s[j] >= '0' and s[j] <= '9' or s[j] == '.') {
			j++
		}
		unit := 0.0
		switch s[:j] {
		case "ns":
			unit = 1
		case "us", "µs":
			unit = 1e3
		case "ms":
			unit = 1e6
		case "s":
			unit = 1e9
		case "m":
			unit = 60e9
		case "h":
			unit = 3600e9
		default:
			return 0, false
		}
		s = s[j:]
		d += v * unit
	}
	return time.Duration(d), true
}

// parse_flags reads the command line as Go's flag package would (-name value, -name=value, and
// --name; bool flags take no value), up to the first non-flag argument or "--".
fn parse_flags() {
	for i := 1; i < os.n_args(); i++ {
		a := os.arg(i)
		if a == "--" or len(a) < 2 or a[0] != '-' {
			return
		}
		name := a[1:]
		if name[0] == '-' {
			name = name[1:]
		}
		name, val, has_val := strings.cut(name, "=")
		if name == "mix" or name == "json" {
			b := true
			if has_val {
				v, err := strconv.parse_bool(val)
				if err != nil {
					fatal2("invalid boolean value for -", name)
				}
				b = v
			}
			if name == "mix" {
				mix = b
			} else {
				as_json = b
			}
			continue
		}
		switch name {
		case "url", "method", "body", "c", "seed", "startup", "d":
		default:
			fatal2("flag provided but not defined: -", name)
		}
		if not has_val {
			i++
			if i >= os.n_args() {
				fatal2("flag needs an argument: -", name)
			}
			val = os.arg(i)
		}
		switch name {
		case "url":
			raw_url = val
		case "method":
			method = val
		case "body":
			body = val
		case "c", "seed", "startup":
			n, err := strconv.atoi(val)
			if err != nil {
				fatal2("invalid value for flag -", name)
			}
			switch name {
			case "c":
				conns = n
			case "seed":
				seed_n = n
			default:
				startup = n
			}
		case "d":
			d, ok := parse_duration(val)
			if not ok {
				fatal2("invalid duration for -d: ", val)
			}
			dur = d
		}
	}
}

// parse_target splits raw_url into the address to dial, the Host header and the request path.
fn parse_target() {
	rest, ok := strings.cut_prefix(raw_url, "http://")
	if not ok {
		fatal("only http:// URLs are supported")
	}
	hostport := rest
	path = "/"
	if i := strings.index_byte(rest, '/'); i >= 0 {
		hostport = rest[:i]
		path = rest[i:]
	} else if i := strings.index_byte(rest, '?'); i >= 0 {
		hostport = rest[:i]
		path = str(append(append(path_buf[:0], '/'), rest[i:]...)) // "http://h?q" asks for "/?q"
	}
	if i := strings.index_byte(path, '#'); i >= 0 {
		path = path[:i]
	}
	host = hostport
	addr = hostport
	if strings.index_byte(hostport, ':') < 0 {
		addr = str(append(append(addr_buf[:0], hostport...), ":80"...))
	}
}

// build_request builds a request as bench/load does: Host, User-Agent and, with a body or for POST
// and PUT, Content-Type: application/json and Content-Length.
fn build_request(dst u8[], method str, path str, body str) -> u8[] {
	h := http.Header[2]{{name: "User-Agent", value: "squark-load"}, {name: "Content-Type", value: "application/json"}}
	hdrs := h[:1]
	if len(body) > 0 or method == "POST" or method == "PUT" {
		hdrs = h[:2]
	}
	var b u8[64K]
	n := copy(b[:], body)
	req, err := http.append_request(dst[:0], method, host, path, hdrs, b[:n])
	if err != nil {
		fatal2("building the request: ", err.message())
	}
	return req
}

// get_note builds GET /notes/{id} into dst.
fn get_note(dst u8[], id int) -> u8[] {
	var p u8[32]
	path := strconv.append_int(append(p[:0], "/notes/"...), id)
	h := http.Header[1]{{name: "User-Agent", value: "squark-load"}}
	req, _ := http.append_request(dst[:0], "GET", host, str(path), h[:], nil)
	return req
}

// seed POSTs n notes over one connection and keeps their ids.
//
//squark:noinline
fn seed(n int) {
	var buf u8[64K]
	c, err := http.dial(addr, buf[:])
	if err != nil {
		fatal2("seeding: ", err.message())
	}
	defer c.close()
	var key u8[16]
	for i := 0; i < n; i++ {
		resp, err := c.round_trip(post_req)
		if err != nil {
			fatal2("seeding: ", err.message())
		}
		if resp.status_code != 201 {
			var m u8[128]
			fatal2(str(strconv.append_int(append(m[:0], "seeding: seed POST returned "...), resp.status_code)), "")
		}
		id := 0
		d := json.new_decoder(resp.body)
		if d.begin_object() {
			loop {
				k, ok := d.field(key[:])
				if not ok {
					break
				}
				if k == "id" {
					id, _ = d.int()
				} else {
					d.skip()
				}
			}
		}
		if id == 0 {
			fatal2("seeding: seed POST: cannot parse id from ", str(resp.body))
		}
		seeded.ids[seeded.n] = id
		seeded.n++
	}
}

// next is xorshift64*.
fn next(s *u64) -> u64 {
	x := *s
	x ^= x >> 12
	x ^= x << 25
	x ^= x >> 27
	*s = x
	return x * 2685821657736338717
}

fn intn(s *u64, n int) -> int { return int((next(s) >> 1) % u64(n)) }

// pick returns the request to send next.
fn pick(rng *u64, dst u8[]) -> u8[] {
	if not mix {
		return fixed_req
	}
	r := intn(rng, 100)
	switch {
	case r < 80:
		return get_note(dst, seeded.ids[intn(rng, seeded.n)])
	case r < 90:
		return list_req
	}
	return post_req
}

// worker drives one keep-alive connection until stop.
task worker(id int) pool max_conns {
	var buf u8[16K]
	var rq u8[256]
	rng := u64(id+1)*0x9E3779B97F4A7C15 | 1
	var c http.Client
	connected := false
	while not stop {
		if not connected {
			cl, err := http.dial(addr, buf[:])
			if err != nil {
				st.errors++
				time.sleep(10 * time.millisecond)
				continue
			}
			c = cl
			c.discard_body = true
			connected = true
		}
		req := pick(&rng, rq[:])
		t0 := time.now()
		resp, err := c.round_trip(req)
		lat := time.since(t0)
		if err != nil {
			st.errors++
			c.close()
			connected = false
			continue
		}
		st.requests++
		st.h.record(int(lat))
		if resp.status_code < 600 {
			st.status[resp.status_code]++
		}
		if resp.status_code < 200 or resp.status_code > 299 {
			st.non2xx++
		}
		if resp.close {
			c.close()
			connected = false
		}
	}
	if connected {
		c.close()
	}
	done <- true
}

fn merge(t *Stats, o *Stats) {
	t.h.merge(&o.h)
	t.requests += o.requests
	t.non2xx += o.non2xx
	t.errors += o.errors
	for i := 0; i < len(t.status); i++ {
		t.status[i] += o.status[i]
	}
	t.elapsed = max(t.elapsed, o.elapsed)
}

fn us(ns int) -> f64 { return f64(ns) / 1e3 }

fn append_dur(b u8[], ns int) -> u8[] {
	switch {
	case ns < 1000000:
		return append(strconv.append_float(b, us(ns), 1), "us"...)
	case ns < 1000000000:
		return append(strconv.append_float(b, f64(ns)/1e6, 2), "ms"...)
	}
	return append(strconv.append_float(b, f64(ns)/1e9, 2), 's')
}

fn report(t *Stats, mode str) {
	var out u8[16K]
	b := out[:0]
	h := &t.h
	secs := t.elapsed.seconds()
	rps := f64(t.requests) / secs
	if as_json {
		b = append(b, `{"url":`...)
		b = json.append_string(b, raw_url)
		b = append(b, `,"mode":`...)
		b = json.append_string(b, mode)
		b = append(b, `,"connections":`...)
		b = strconv.append_int(b, conns)
		b = append(b, `,"duration_s":`...)
		b = strconv.append_float(b, secs, -1)
		b = append(b, `,"requests":`...)
		b = strconv.append_int(b, t.requests)
		b = append(b, `,"rps":`...)
		b = strconv.append_float(b, rps, -1)
		b = append(b, `,"latency_us":{"min":`...)
		b = strconv.append_float(b, us(int(h.min)), -1)
		b = append(b, `,"mean":`...)
		b = strconv.append_float(b, us(h.mean()), -1)
		b = append(b, `,"p50":`...)
		b = strconv.append_float(b, us(h.quantile(0.50)), -1)
		b = append(b, `,"p90":`...)
		b = strconv.append_float(b, us(h.quantile(0.90)), -1)
		b = append(b, `,"p99":`...)
		b = strconv.append_float(b, us(h.quantile(0.99)), -1)
		b = append(b, `,"max":`...)
		b = strconv.append_float(b, us(int(h.max)), -1)
		b = append(b, `},"non2xx":`...)
		b = strconv.append_int(b, t.non2xx)
		b = append(b, `,"errors":`...)
		b = strconv.append_int(b, t.errors)
		b = append(b, `,"status":{`...)
		first := true
		for code := 0; code < len(t.status); code++ { // 3-digit codes: numeric order is Go's key order
			if t.status[code] == 0 {
				continue
			}
			if not first {
				b = append(b, ',')
			}
			first = false
			b = append(b, '"')
			b = strconv.append_int(b, code)
			b = append(b, `":`...)
			b = strconv.append_int(b, t.status[code])
		}
		b = append(b, '}')
		if seeded.n > 0 {
			b = append(b, `,"seeded":`...)
			b = strconv.append_int(b, seeded.n)
		}
		b = append(b, "}\n"...)
		os.stdout.write(b)
		return
	}
	b = append(b, "target:   "...)
	b = append(b, raw_url...)
	b = append(b, "  mode: "...)
	b = append(b, mode...)
	b = append(b, "  conns: "...)
	b = strconv.append_int(b, conns)
	b = append(b, "  duration: "...)
	b = strconv.append_float(b, secs, 2)
	b = append(b, "s\n"...)
	if seeded.n > 0 {
		b = append(b, "seeded:   "...)
		b = strconv.append_int(b, seeded.n)
		b = append(b, " notes\n"...)
	}
	b = append(b, "requests: "...)
	b = strconv.append_int(b, t.requests)
	b = append(b, "  ("...)
	b = strconv.append_float(b, rps, 0)
	b = append(b, " req/s)\nlatency:  p50 "...)
	b = append_dur(b, h.quantile(0.50))
	b = append(b, "  p90 "...)
	b = append_dur(b, h.quantile(0.90))
	b = append(b, "  p99 "...)
	b = append_dur(b, h.quantile(0.99))
	b = append(b, "  max "...)
	b = append_dur(b, int(h.max))
	b = append(b, "  mean "...)
	b = append_dur(b, h.mean())
	b = append(b, "\nstatus:  "...)
	for code := 0; code < len(t.status); code++ {
		if t.status[code] > 0 {
			b = append(b, ' ')
			b = strconv.append_int(b, code)
			b = append(b, '=')
			b = strconv.append_int(b, t.status[code])
		}
	}
	b = append(b, "\nnon-2xx:  "...)
	b = strconv.append_int(b, t.non2xx)
	b = append(b, "  errors: "...)
	b = strconv.append_int(b, t.errors)
	b = append(b, '\n')
	os.stdout.write(b)
}

fn main() {
	me := runtime.shard()
	shards := runtime.shards()
	parse_flags()
	parse_target()
	if startup > 0 {
		fatal("-startup launches the server, and squark can't start processes: use the Go load generator (bench/bin/load) for it")
	}
	if conns < 1 {
		fatal("-c must be >= 1")
	}
	mode := str(append(append(append(mode_buf[:0], method...), ' '), path...))
	if mix {
		post := body
		if post == "" {
			post = `{"title":"x","body":"y"}`
		}
		post_req = build_request(post_buf[:], "POST", "/notes", post)
		list_req = build_request(list_buf[:], "GET", "/notes", "")
		mode = "mix"
		if seed_n <= 0 {
			fatal("-mix needs -seed > 0")
		}
		if seed_n > max_seed {
			fatal("-seed is at most 10000")
		}
		if me == 0 {
			seed(seed_n)
			for i := 1; i < shards; i++ {
				seed_ch <- seeded
			}
		} else {
			seeded = <-seed_ch
		}
	} else {
		fixed_req = build_request(fixed_buf[:], method, path, body)
	}
	// One thread keeps more than 100k requests/s going on well under a core, and spreading a few
	// connections over many threads costs CPU the server (on the same machine) could use: so only
	// the first threads, with at least conns_per_thread connections each, open any.
	active := min(shards, (conns+conns_per_thread-1)/conns_per_thread)
	n := 0
	if me < active {
		n = conns / active
		if me < conns%active {
			n++
		}
	}
	if n > max_conns {
		fatal("-c is at most 4096 per scheduler thread")
	}
	start := time.now()
	for i := 0; i < n; i++ {
		start worker(me + i*active)
	}
	time.sleep(dur)
	stop = true
	for i := 0; i < n; i++ {
		<-done
	}
	st.elapsed = time.since(start)
	if me != 0 {
		results <- st
		return
	}
	for i := 1; i < shards; i++ {
		other = <-results
		merge(&st, &other)
	}
	report(&st, mode)
}
