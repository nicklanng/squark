program

// Run by TestNoHeapAtRuntime under an allocation counter. It pauses so the startup count can be
// read, then uses every std package except sqlite (whose C library has its own allocator) and
// serves HTTP requests to itself, then pauses again for the final count.

use bytes, errors, flag, http, json, math, net, os, strconv, strings, time, utf8

fault Mine 7 "mine"

thread sum int
thread page u8[20000]

fn handle(w *http.ResponseWriter, r *http.Request) {
	if r.path == "/big" {
		w.write(page[:]) // larger than the write buffer: chunked
		return
	}
	w.write_string("hello ")
	w.write_string(r.query_value("name"))
}

task serve(addr str) pool 1 {
	if err := http.listen_and_serve(addr, handle); err != nil {
		panic(err)
	}
}

thread results int chan[64]

task worker(n int) pool 8 {
	results <- n * 2
}

// keep_alive sends two requests on one connection with a pause between them, so the server parks
// the connection in the idle set (releasing its task's stack) and resumes it.
fn keep_alive(addr str, buf u8[]) -> int {
	c, err := net.dial(addr)
	if err != nil {
		panic(err)
	}
	total := 0
	for i := 0; i < 2; i++ {
		c.write_string("GET /?name=idle HTTP/1.1\r\nHost: x\r\n\r\n")
		n, _ := c.read(buf)
		total += n
		time.sleep(150 * time.millisecond) // longer than http.idle_release
	}
	c.close()
	return total
}

// echo accepts in a loop: with threads N the kernel may route several shards' connections to
// one shard's listener
task echo(l net.Listener) pool 1 {
	loop {
		c, err := l.accept()
		if err != nil {
			return
		}
		start echo_conn(c)
	}
}

task echo_conn(c net.Conn) pool 8 {
	var b u8[64]
	loop {
		n, err := c.read(b[:])
		if err != nil or n == 0 {
			return
		}
		c.write(b[:n])
	}
}

fn get(addr, req str, buf u8[]) -> int {
	c, err := net.dial(addr)
	if err != nil {
		panic(err)
	}
	c.write_string(req)
	total := 0
	loop {
		n, err := c.read(buf)
		if err != nil or n == 0 {
			break
		}
		total += n
	}
	c.close()
	return total
}

fn main() {
	time.sleep(400 * time.millisecond) // startup count is read here
	verbose := flag.bool_flag("v", false, "verbose")
	every := flag.duration_flag("every", time.second, "how often")
	flag.parse() // the four arguments are positional
	if *verbose or flag.n_arg() != 4 or flag.arg(3) != os.arg(4) or len(flag.args()) != 4 {
		panic("flag.Parse")
	}
	sum += int(*every)
	start serve(os.arg(2))
	l, err := net.listen(os.arg(1))
	if err != nil {
		panic(err)
	}
	start echo(l)
	c, err := net.dial(os.arg(1))
	if err != nil {
		panic(err)
	}
	time.sleep(50 * time.millisecond)
	var buf u8[512]
	var store u8[256]
	for i := 0; i < 500; i++ {
		if _, err := os.open("/nonexistent/squark"); err != nil {
			sum += len(err.message())
		}
		f, err := os.create(os.arg(3))
		if err == nil {
			f.write_string("hello, file\n")
			f.close()
		}
		f, err = os.open(os.arg(3))
		if err == nil {
			n, _ := f.read(buf[:])
			sum += n
			f.close()
		}
		sum += len(os.getenv("HOME"))
		b := strconv.append_float(buf[:0], math.sqrt(f64(i))+math.pow(1.5, 3)+math.sin(1), 6)
		v, _ := strconv.atoi("12345")
		sum += len(b) + v + strings.count("a,b,c", ",") + utf8.rune_count_in_string("héllo")
		var parts str[4]
		sum += len(strings.split("x y z", " ", parts[:]))
		j := json.append_string(buf[:0], "q\"uote é")
		d := json.new_decoder(j)
		if s, ok := d.string(store[:]); ok {
			sum += len(s)
		}
		je := json.new_encoder(buf[:0])
		je.object()
		je.key("k")
		je.string("v é")
		je.key("f")
		je.float(1.5)
		je.end()
		if je.finish() == nil {
			sum += len(je.bytes())
		}
		with arena ja 1K {
			jd := json.new_decoder_in(je.bytes(), ja)
			if jd.begin_object() {
				if k, ok := jd.key(); ok {
					t, _ := jd.text()
					sum += len(k) + len(t)
				}
			}
			ge := json.new_encoder_in(nil, ja)
			ge.array()
			for j := 0; j < 50; j++ {
				ge.int(j)
			}
			ge.end()
			sum += len(ge.bytes())
		}
		bb := bytes.new_buffer(store[:0])
		bb.write_string("buffered")
		sum += bb.len()
		if errors.is(Mine, Mine) {
			sum++
		}
		sum += int(time.since(time.now()).nanoseconds() & 1)
		if d, err := time.parse_duration("1h2m3.5s"); err == nil {
			sum += len(d.string(buf[:]))
		}
		c.write_string("ping")
		n, _ := c.read(buf[:])
		sum += n
		sum += get(os.arg(2), "GET /?name=x HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n", buf[:])
		sum += get(os.arg(2), "GET /big HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n", buf[:])
		sum += get(os.arg(2), "HEAD /big HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n", buf[:])
	}
	// paths outside the loop: idle parking, error paths, stdin, many short tasks, channels
	for i := 0; i < 3; i++ {
		sum += keep_alive(os.arg(2), buf[:])
	}
	if _, err := net.dial(os.arg(4)); err != nil { // nothing listens there: connection refused
		sum += len(err.message())
	}
	// name lookups: the hosts file, a DNS query (UDP; with no resolv.conf the servers are the
	// loopback addresses, where nothing listens), IPv6 literals and their text form
	var ips net.IP[4]
	net.resolv_conf = "/nonexistent/resolv.conf"
	if res, err := net.lookup_ip("localhost", ips[:]); err == nil {
		sum += len(res[0].string(buf[:]))
	}
	if _, err := net.lookup_ip("nothing.invalid.", ips[:]); err != nil {
		sum += len(err.message())
	}
	if ip, ok := net.parse_ip("2001:db8::1"); ok {
		sum += len(ip.string(buf[:]))
	}
	if _, err := net.listen(os.arg(2)); err != nil { // already in use
		sum += len(err.message())
	}
	dead, err := net.dial(os.arg(1))
	if err == nil {
		dead.close()
		if _, err := dead.write_string("x"); err != nil { // closed descriptor
			sum += len(err.message())
		}
	}
	sum += len(os.errno(9999).message()) + len(os.errno(-3).message())
	n, _ := os.stdin.read(buf[:]) // a pipe: waits through the poller
	sum += n
	for i := 0; i < 200; i++ {
		start worker(i)
		if i >= 32 {
			sum += <-results // stay below the channel's capacity
		}
	}
	for i := 0; i < 32; i++ {
		sum += <-results
	}
	println(sum > 0)
	time.sleep(400 * time.millisecond) // final count is read here
}
