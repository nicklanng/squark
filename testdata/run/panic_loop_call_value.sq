program

// a call through a func value can do anything: here it shrinks the slice the loop reads

thread store int[4]
thread pkg int[]

fn shrink() {
	pkg = pkg[:1]
}

fn main() {
	pkg = store[:]
	f := shrink
	sum := 0
	for i := 0; i < 4; i++ {
		if i == 2 {
			f()
		}
		println("at", i)
		sum += pkg[i]
	}
	println(sum)
}
