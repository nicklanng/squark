program {
	threads 4
}

// select across scheduler threads: 4 threads × 2 workers select over shared channels and a
// timeout; shard 0 produces jobs and sums the results, then closes quit, which ends every worker
// on every thread.

use runtime, time

shared jobs int chan[8]
shared results int chan[8]
shared quit int chan[0]

thread done int chan[2]
thread total int chan[1]

task worker() pool 2 {
	idle := 0
	loop {
		select {
		case j := <-jobs:
			select {
			case results <- j * 2:
			case <-time.after(5 * time.second):
				panic("results stuck")
			}
		case <-quit:
			done <- idle
			return
		case <-time.after(2 * time.millisecond):
			idle++
		}
	}
}

task producer() pool 1 {
	for i := 1; i <= 2000; i++ {
		select {
		case jobs <- i:
		case <-time.after(5 * time.second):
			panic("jobs stuck")
		}
	}
}

task collector() pool 1 {
	sum := 0
	for i := 0; i < 2000; i++ {
		sum += <-results
	}
	close(quit)
	total <- sum
}

fn main() {
	start worker()
	start worker()
	if runtime.shard() == 0 {
		start producer()
		start collector()
		println(<-total)
	}
	<-done
	<-done
}
