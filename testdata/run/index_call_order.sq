program

// s[f()] where f reassigns s: the pointer and the length must come from the same slice (they
// used to be read on either side of the call, so the bounds check used the wrong length).
thread small int[1]
thread big int[100]
thread s int[]

fn f() -> int {
	s = big[:]
	return 50
}

thread str_ str

fn g() -> int {
	str_ = "0123456789abcdef"
	return 12
}

fn main() {
	s = small[:]
	s[f()] = 7
	println(big[50], big[49])
	str_ = "x"
	println(str_[g()])
}
