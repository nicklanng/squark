program

// Values of an assignable (identical underlying, differently named) type: a returned tuple,
// comma-ok forms and range assignment each convert to the target's C type.
struct Pair { a, b int }
Ints: int[]

thread store int[4]

fn f() -> Ints ! { return store[:], nil }
fn g() -> int[] ! { return f() }

fn h() -> (struct { a, b int }, bool) { return struct { a, b int }{1, 2}, true }
fn k() -> (Pair, bool)              { return h() }

fn f4() -> (Ints, int, error) ! { return store[:], 2, nil, nil }
fn via_try() -> (int[], int) !   { return f4()! }

fn main() {
	x, _ := g()
	p, ok := k()
	y, n, _ := via_try()
	println(len(x), p.b, ok, len(y), n)

	var m struct { a, b int }[int; 2]
	m[1] = Pair{3, 4}
	p, ok = m[1]
	println(p.b, ok)

	var c struct { a, b int } chan[1]
	c <- Pair{5, 6}
	p, ok = <-c
	println(p.a, ok)

	ps := struct { a, b int }[1]{{7, 8}}
	for q in ps {
		p = q
	}
	println(p.b)
}
