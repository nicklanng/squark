program

// Loops whose indexes are the counter (times a constant) plus a fixed offset run a copy without bounds checks when
// a test before the loop shows every index is in range (cgen_loop.go). These check that both
// copies compute the same thing.

thread g int[8]

fn neighbours(a int[], b int[]) {
	for i := 1; i < len(a); i++ {
		b[i-1] = a[i] + a[i-1]
	}
}

fn inclusive(a int[], n int) -> int {
	s := 0
	for i := 0; i <= n-1; i++ {
		s += a[i]
	}
	return s
}

fn flipped(a int[]) -> int {
	s := 0
	for i := 0; len(a) > i; i++ {
		s += a[i] * i
	}
	return s
}

// the test fails (b is shorter), so the checked copy runs, and the if keeps it in range
fn guarded(a int[], b int[]) -> int {
	n := 0
	for i, _ in a {
		if i < len(b) {
			b[i] = a[i]
			n++
		}
	}
	return n
}

// s changes after the loop: the copy read before the loop must not leak out
fn later(s int[]) -> int {
	t := 0
	for i, _ in s {
		t += s[i]
	}
	s = s[1:]
	return t + len(s)
}

// s changes in the loop, so its indexes stay checked
fn shrinking(s int[]) -> int {
	t := 0
	for i := 0; i < 3; i++ {
		t += s[i]
		s = s[1:]
	}
	return t
}

fn branches(a int[]) -> int {
	s := 0
	for i := 0; i < len(a); i++ {
		if a[i] == 3 {
			continue
		}
		if a[i] == 6 {
			break
		}
		s += a[i]
	}
	return s
}

fn rows(dst int[], a int[], w int) {
	for r := 0; r < len(dst)/w; r++ {
		base := r * w
		for j := 0; j < w; j++ {
			dst[base+j] = a[base+j] * (r + 1)
		}
	}
}

fn via_pointer(p *(int[8])) -> int {
	s := 0
	for i in 0..8 {
		s += p[i] + g[i]
	}
	return s
}

fn bytes_of(s str, n int) -> int {
	t := 0
	for i in 0..n {
		t += int(s[i])
	}
	return t
}

// indexes that are the counter times a constant, plus an offset
fn interleave(dst int[], a int[], b int[]) {
	for i, _ in a {
		dst[2*i] = a[i]
		dst[i*2+1] = b[i]
	}
}

const stride = 3

fn strided(a int[], n int) -> int {
	s := 0
	for i := 0; i < n; i++ {
		s += a[stride*i+1]
	}
	return s
}

fn evens_down(a int[]) -> int {
	s := 0
	for i := len(a)/2 - 1; i >= 0; i-- {
		s = s*10 + a[2*i]
	}
	return s
}

fn odds_back(a int[], n int) -> int {
	s := 0
	for i := 1; i <= n; i++ {
		s += a[2*i-1]
	}
	return s
}

// k*i wraps around to 0 at i = 4: the range test must reject the loop (the product overflows),
// and the checked copy reads a[0] as the index wraps
fn wrapped(a int[]) -> int {
	s := 0
	for i := 4; i < 5; i++ {
		s += a[(1<<62)*i]
	}
	return s
}

fn main() {
	x := int[]{1, 2, 3}
	y := int[]{10, 20, 30}
	var z int[6]
	interleave(z[:], x, y)
	println(z[0], z[1], z[2], z[3], z[4], z[5])
	println(strided(int[]{0, 1, 0, 0, 2, 0, 0, 3}, 3), strided(x, 0))
	println(evens_down(int[]{1, 0, 2, 0, 3, 0}))
	println(odds_back(int[]{0, 1, 0, 2, 0, 3}, 3))
	println(wrapped(y))

	a := int[]{1, 2, 3, 4, 5, 6, 7, 8}
	var b int[8]
	neighbours(a, b[:])
	println(b[0], b[6], b[7])
	println(inclusive(a, 8), inclusive(a, 0))
	println(flipped(a))
	var c int[3]
	println(guarded(a, c[:]), c[0], c[2])
	println(later(a))
	println(shrinking(a))
	println(branches(a))
	var d int[8]
	rows(d[:], a, 4)
	println(d[0], d[3], d[4], d[7])
	for i, _ in g {
		g[i] = i
	}
	var e int[8]
	copy(e[:], a)
	println(via_pointer(&e))
	println(bytes_of("abc", 3), bytes_of("abc", 0))
}
