program

use strconv

fault Negative 22 "negative input"
fault TooBig 34 "too big"

thread cleanups = 0

fn cleanup() { cleanups++ }

fn parse_positive(s str) -> int ! {
	n := strconv.atoi(s)!
	if n < 0 {
		return 0, Negative
	}
	return n, nil
}

fn sum3(a, b, c str) -> int ! {
	defer cleanup()
	x := parse_positive(a)!
	y := parse_positive(b)!
	z := parse_positive(c)!
	if x+y+z > 1000 {
		return 0, TooBig
	}
	return x + y + z, nil
}

fn check(n int) -> ! {
	if n > 5 {
		return TooBig
	}
	return nil
}

fn check_all() -> ! {
	check(1)!
	check(9)!
	println("not reached")
	return nil
}

fn pair() -> (int, str) ! { return 7, "seven", nil }

fn use_pair() -> str ! {
	n, s := pair()!
	_ = n
	return s, nil
}

fn main() {
	v, err := sum3("1", "2", "3")
	println(v, err == nil)
	_, err = sum3("1", "-2", "3")
	println(err.message(), err.code(), err == Negative)
	_, err = sum3("1", "x", "3")
	println(err.message(), err == strconv.Syntax)
	_, err = sum3("900", "200", "1")
	println(err == TooBig, cleanups)
	println(check_all().message())
	s, _ := use_pair()
	println(s, 64K, 2M/1K)
}
