program

use strings

// strings.index_byte, LastIndexByte and Index (SIMD inside) agree with simple loops at every length
// and position.

fn naive_index(s, sep str) -> int {
	for i := 0; i+len(sep) <= len(s); i++ {
		if s[i:i+len(sep)] == sep {
			return i
		}
	}
	return -1
}

fn naive_first(s str, c u8) -> int {
	for i := 0; i < len(s); i++ {
		if s[i] == c {
			return i
		}
	}
	return -1
}

fn naive_last(s str, c u8) -> int {
	for i := len(s) - 1; i >= 0; i-- {
		if s[i] == c {
			return i
		}
	}
	return -1
}

fn main() {
	var buf u8[80]
	for i, _ in buf {
		buf[i] = 'a' + u8(i%7)
	}
	bad := 0
	for n := 0; n <= len(buf); n++ {
		s := str(buf[:n])
		for c in "abcgz" {
			if strings.index_byte(s, u8(c)) != naive_first(s, u8(c)) {
				bad++
			}
			if strings.last_index_byte(s, u8(c)) != naive_last(s, u8(c)) {
				bad++
			}
		}
		for sep in str[]{"a", "gab", "cdefg", "zz", "abcdefgabcdefgabcd", "fgabcdefgabcdefga"} {
			if strings.index(s, sep) != naive_index(s, sep) {
				bad++
				println("Index", n, sep, strings.index(s, sep), naive_index(s, sep))
			}
		}
		for k := 0; k < n; k++ {
			old := buf[k]
			buf[k] = '#'
			s := str(buf[:n])
			if strings.index_byte(s, '#') != k or strings.last_index_byte(s, '#') != k {
				bad++
				println("byte", n, k, strings.index_byte(s, '#'), strings.last_index_byte(s, '#'))
			}
			buf[k] = old
		}
	}
	println("mismatches:", bad)
}
