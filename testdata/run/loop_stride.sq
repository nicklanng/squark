program

// Loops that step by more than one get an unchecked copy too: the test before the loop looks at
// the last value the counter takes, so these all run unchecked where they can and give the same
// results either way.

const max_int = 9223372036854775807

fn pairs(xs int[]) -> int {
	sum := 0
	for i := 0; i < len(xs)-1; i += 2 {
		sum += xs[i] * xs[i+1]
	}
	return sum
}

fn thirds(xs int[]) -> int {
	sum := 0
	for i := 1; i <= len(xs)-1; i += 3 {
		sum += xs[i]
	}
	return sum
}

fn down(xs int[]) -> int {
	sum := 0
	for i := len(xs) - 1; i >= 0; i -= 2 {
		sum = sum*10 + xs[i]
	}
	return sum
}

fn above(xs int[]) -> int {
	sum := 0
	for i := len(xs) - 1; i > 0; i -= 3 {
		sum = sum*10 + xs[i-1]
	}
	return sum
}

fn main() {
	var buf int[9]
	for i in 0..9 {
		buf[i] = i + 1
	}
	for n in 0..10 {
		xs := buf[:n]
		println(n, pairs(xs), thirds(xs), down(xs), above(xs))
	}
	// near the top of int the counter would wrap after its last value: the checked copy runs
	var s int[8]
	count := 0
	for i := max_int - 5; i < max_int; i += 4 {
		if i < 0 {
			break // wrapped
		}
		s[i-(max_int-5)]++
		count++
	}
	println(count, s[0], s[4])
}
