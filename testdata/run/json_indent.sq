package main

// json.Encoder.SetIndent: the layout of json.MarshalIndent (a member or element per line, empty
// containers on one line, "key": value), Raw values laid out again, a top-level scalar, the prefix,
// SetIndent after the first value (ErrMisuse), and a full buffer (each call all or nothing,
// line breaks included)

import "json"

func show(label string, e *json.Encoder) {
	err := e.Finish()
	println(label)
	if err != nil {
		println(string(e.Bytes()), "err:", err.Error())
	} else {
		println(string(e.Bytes()))
	}
}

func doc(e *json.Encoder) {
	e.Object()
	e.Key("id")
	e.Int(7)
	e.Key("tags")
	e.Array()
	e.String("a")
	e.String("b")
	e.End()
	e.Key("none")
	e.Array()
	e.End()
	e.Key("empty")
	e.Object()
	e.End()
	e.Key("raw")
	var raw [64]byte
	n := copy(raw[:], ` {"x": [1, {}, [ ], "a,b:{"], "y":{"z":null}} `)
	e.Raw(raw[:n])
	e.Key("deep")
	e.Array()
	e.Array()
	e.Object()
	e.Key("k")
	e.Bool(true)
	e.End()
	e.End()
	e.End()
	e.End()
}

func main() {
	var buf [512]byte
	e := json.NewEncoder(buf[:0])
	e.SetIndent("", "  ")
	doc(&e)
	show("two spaces:", &e)

	e = json.NewEncoder(buf[:0])
	e.SetIndent("> ", "\t")
	doc(&e)
	show("prefix and tab:", &e)

	e = json.NewEncoder(buf[:0])
	e.SetIndent("", "")
	e.Array()
	e.Int(1)
	e.Int(2)
	e.End()
	show("no indent:", &e)

	e = json.NewEncoder(buf[:0])
	e.SetIndent("  ", "  ")
	e.String("top")
	show("scalar:", &e)

	e = json.NewEncoder(buf[:0])
	e.SetIndent("", " ")
	e.Array()
	e.SetIndent("", "  ")
	show("late SetIndent:", &e)

	// a full buffer: the call that doesn't fit writes nothing, line break and indentation included
	var small [12]byte
	f := json.NewEncoder(small[:0])
	f.SetIndent("", "    ")
	f.Array()
	f.Int(1)
	f.Int(2)
	println("full:", f.Err.Error(), len(f.Bytes()), string(f.Bytes()))
	f.Clear()
	f.Err = nil
	f.Int(2)
	f.End()
	show("after Clear:", &f)
}
