program

struct Point { x, y int }

// package-level storage: static, usable from any task
thread events str chan[4]
thread index int[str; 64]

fn total(xs int[]) -> int {
	t := 0
	for x in xs {
		t += x
	}
	return t
}

fn count(m int[str], w str) { m[w]++ }

task producer() pool 1 {
	events <- "one"
	events <- "two"
	close(events)
}

fn main() {
	var v int[..8]
	for i := 1; i <= 5; i++ {
		v.push(i * 10)
	}
	println(len(v), cap(v), v[0], v[4], total(v[:]), total(v))
	last := v.pop()
	println("popped", last, "len", len(v), v.try_push(99), len(v))
	for i, x in v {
		if i > 2 {
			break
		}
		print(x, " ")
	}
	println()
	v.clear()
	println("cleared", len(v))

	pts := Point[..4]{{1, 2}, {3, 4}}
	pts.push(Point{5, 6})
	println(len(pts), pts[2].x)

	var seen int[str; 16]
	count(seen, "a")
	count(seen, "a")
	count(seen, "b")
	seen["c"] = 7
	println(len(seen), seen["a"], seen["b"], seen["c"], seen["zz"])
	delete(seen, "a")
	_, ok := seen["a"]
	println("deleted", not ok, len(seen))

	index["x"] = 1
	println("index", len(index))

	start producer()
	for e in events {
		println("event", e)
	}
	println(len(events), cap(events))
}
