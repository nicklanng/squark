program

// Stale poller events must not uncount a task's current wait (the scheduler stops polling
// when it counts no waiters, and reports a false deadlock):
//   - a read registration still queued when another task closes the descriptor fails (kqueue
//     reports EBADF for it) after the reader has moved on to another connection;
//   - a WaitReadable that timed out is followed by data on that connection while its task
//     waits on another one.

use net, runtime, strconv, time

thread c1, c2, p1, p2 net.Conn
thread done str chan[4]

task closed_reader() pool 1 {
	var buf u8[16]
	if _, err := c1.read(buf[:]); err == nil {
		done <- "c1: data"
		return
	}
	n, err := c2.read(buf[:])
	if err != nil {
		done <- "c2: error"
		return
	}
	done <- str(buf[:n]) in str_
}

task grace_reader() pool 1 {
	if c1.wait_readable(10 * time.millisecond) {
		done <- "c1: readable"
		return
	}
	var buf u8[16]
	n, err := c2.read(buf[:])
	if err != nil {
		done <- "c2: error"
		return
	}
	done <- str(buf[:n]) in str_
}

arena str_ 64

fn addr(port int) -> str {
	var b u8[32]
	return str(strconv.append_int(append(b[:0], "127.0.0.1:"...), port)) in str_
}

fn pair(l net.Listener, a str) -> (net.Conn, net.Conn) {
	c, err := net.dial(a)
	if err != nil {
		panic(err)
	}
	p, err := l.accept()
	if err != nil {
		panic(err)
	}
	return c, p
}

fn main() {
	l, err := net.listen("127.0.0.1:0")
	if err != nil {
		panic(err)
	}
	a := addr(l.port())

	c1, p1 = pair(l, a)
	c2, p2 = pair(l, a)
	start closed_reader()
	runtime.gosched() // the reader is parked on c1, its registration not yet sent to the poller
	c1.close()
	time.sleep(50 * time.millisecond)
	p2.write_string("after close")
	println(<-done)
	p1.close()
	c2.close()
	p2.close()

	c1, p1 = pair(l, a)
	c2, p2 = pair(l, a)
	start grace_reader()
	time.sleep(50 * time.millisecond) // WaitReadable has timed out; the reader waits on c2
	p1.write_string("late")
	time.sleep(50 * time.millisecond)
	p2.write_string("after timeout")
	println(<-done)
}
