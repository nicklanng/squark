package main

import "strconv"

type Node struct {
	Name     string
	Children []*Node
}

// interned strings live forever in a package arena
arena names 4K

func intern(s string) string {
	return string([]byte(s) in names) in names
}

// build allocates a tree in the caller's arena
func build(a arena, depth int, prefix string) *Node {
	root := new(Node) in a
	root.Name = prefix
	// an explicit stack instead of recursion
	type_ := 0
	_ = type_
	level := []*Node{root}
	for d := 0; d < depth; d++ {
		next := make([]*Node, 0, 0) in a
		for _, n := range level {
			for i := 0; i < 2; i++ {
				var buf [8]byte
				child := new(Node) in a
				child.Name = n.Name + "." + string(strconv.AppendInt(buf[:0], i)) in a
				n.Children = append(n.Children, child) in a
				next = append(next, child) in a
			}
		}
		level = next
	}
	return root
}

func count(n *Node) int {
	total := 0
	stack := [64]*Node{}
	sp := 0
	stack[sp] = n
	sp++
	for sp > 0 {
		sp--
		cur := stack[sp]
		total++
		for _, c := range cur.Children {
			stack[sp] = c
			sp++
		}
	}
	return total
}

func main() {
	arena scratch 64K {
		tree := build(scratch, 3, "root")
		println("nodes:", count(tree), "leaf:", tree.Children[1].Children[0].Children[1].Name)
		println("used > 0:", scratch.Used() > 0, "cap:", scratch.Cap(), scratch.Left() == scratch.Cap()-scratch.Used())

		n := 10
		squares := make([]int, n) in scratch
		for i := range squares {
			squares[i] = i * i
		}
		println("squares", len(squares), squares[9])

		m := make(map[string]int, n) in scratch
		m["a"] = 1
		m["b"] = 2
		println("map", len(m), m["b"])

		var words []string
		for i := 0; i < 100; i++ {
			words = append(words, "w") in scratch
		}
		println("grown", len(words), cap(words) >= 100)

		greeting := "hello, " + tree.Name + "!" in scratch
		println(greeting)
	}
	a := intern("alpha")
	b := intern("beta")
	println(a, b)
}
