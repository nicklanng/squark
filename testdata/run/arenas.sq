program

use strconv

struct Node {
	name     str
	children *Node[]
}

// interned strings live forever in a package arena
arena names 4K

fn intern(s str) -> str {
	return str(u8[](s) in names) in names
}

// build allocates a tree in the caller's arena
fn build(a arena, depth int, prefix str) -> *Node {
	root := new(Node) in a
	root.name = prefix
	// an explicit stack instead of recursion
	type_ := 0
	_ = type_
	level := (*Node)[]{root}
	for d := 0; d < depth; d++ {
		next := make((*Node)[], 0, 0) in a
		for n in level {
			for i := 0; i < 2; i++ {
				var buf u8[8]
				child := new(Node) in a
				child.name = n.name + "." + str(strconv.append_int(buf[:0], i)) in a
				n.children = append(n.children, child) in a
				next = append(next, child) in a
			}
		}
		level = next
	}
	return root
}

fn count(n *Node) -> int {
	total := 0
	stack := (*Node)[64]{}
	sp := 0
	stack[sp] = n
	sp++
	while sp > 0 {
		sp--
		cur := stack[sp]
		total++
		for c in cur.children {
			stack[sp] = c
			sp++
		}
	}
	return total
}

fn main() {
	with arena scratch 64K {
		tree := build(scratch, 3, "root")
		println("nodes:", count(tree), "leaf:", tree.children[1].children[0].children[1].name)
		println("used > 0:", scratch.used() > 0, "cap:", scratch.cap(), scratch.left() == scratch.cap()-scratch.used())

		n := 10
		squares := make(int[], n) in scratch
		for i, _ in squares {
			squares[i] = i * i
		}
		println("squares", len(squares), squares[9])

		m := make(int[str], n) in scratch
		m["a"] = 1
		m["b"] = 2
		println("map", len(m), m["b"])

		var words str[]
		for i := 0; i < 100; i++ {
			words = append(words, "w") in scratch
		}
		println("grown", len(words), cap(words) >= 100)

		greeting := "hello, " + tree.name + "!" in scratch
		println(greeting)
	}
	a := intern("alpha")
	b := intern("beta")
	println(a, b)
}
