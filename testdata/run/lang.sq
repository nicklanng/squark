program

use strconv, strings

struct Shape {
	kind str
	w, h int
}

impl Shape {
	fn area(self) -> int { return self.w * self.h }

	fn scale(&self, k int) {
		self.w *= k
		self.h *= k
	}
}

Celsius: f64

enum Tens { a = 0, b = 10, c = 20 }

fn minmax(xs int[]) -> (int, int) {
	lo, hi := xs[0], xs[0]
	for x in xs[1:] {
		lo = min(lo, x)
		hi = max(hi, x)
	}
	return lo, hi
}

fn describe(n int) -> str {
	switch n {
	case 0:
		return "zero"
	case 1, 2, 3:
		return "small"
	}
	return "big"
}

fn main() {
	s := Shape{kind: "rect", w: 2, h: 3}
	s.scale(2)
	println(s.kind, s.area())

	shapes := Shape[]{{"a", 1, 1}, {"b", 2, 2}}
	total := 0
	for sh in shapes {
		total += sh.area()
	}
	println("total", total)

	println(Tens.a, Tens.b, Tens.c)
	lo, hi := minmax(int[]{5, -2, 9, 3})
	println(lo, hi)
	println(describe(0), describe(2), describe(10))

	var t Celsius = 21.5
	println(t > 20)

	var u8_ u8 = 250
	u8_ += 10
	var i8_ i8 = 127
	i8_++
	println(u8_, i8_, -7/2, -7%2, 1<<62>>61)

	var buf u8[32]
	out := strconv.append_int(buf[:0], -12345)
	out = append(out, ' ')
	out = strconv.append_float(out, 3.14159, 3)
	println(str(out))

	n, err := strconv.atoi("123x")
	println(n, err != nil, err.message())
	v, _ := strconv.atoi("-9876")
	println(v)

	var parts str[4]
	fields := strings.split("a,b,c", ",", parts[:])
	println(len(fields), fields[0], fields[2])
	before, after, found := strings.cut("key=value", "=")
	println(before, after, found)
	println(strings.trim_space("  hi  "), strings.index("hello", "ll"), strings.equal_fold("Go", "GO"))

	var m str[int; 16]
	for i in 0..10 {
		m[i] = describe(i)
	}
	delete(m, 5)
	println(len(m), m[2], m[5] == "")
	count := 0
	for k, v in m {
		if v == "big" {
			count += k
		}
	}
	println("sum of big keys", count)

	arr := int[5]{1, 2, 3}
	arr2 := arr
	arr2[0] = 100
	println(arr[0], arr2[0], len(arr), arr == int[5]{1, 2, 3, 0, 0})

	x := 10
	p := &x
	*p += 5
	println(x)
}
