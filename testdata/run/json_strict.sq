program

// json.Decoder follows the JSON grammar: numbers (no leading zeros; a fraction or exponent is not
// an Int), literals that end at a delimiter, and Skip rejects what isn't a value.

use json

thread src u8[128]

fn try1(doc str) {
	n := copy(src[:], doc)
	d := json.new_decoder(src[:n])
	var key u8[16]
	d.begin_object()
	loop {
		k, ok := d.field(key[:])
		if not ok {
			break
		}
		switch k {
		case "n":
			v, _ := d.int()
			print("n=", v, " ")
		case "b":
			v, _ := d.bool()
			print("b=", v, " ")
		case "z":
			print("null=", d.null(), " ")
		default:
			d.skip()
		}
	}
	end := d.end()
	print(doc, " -> end=", end, " err=")
	if d.err != nil {
		println(d.err.message())
	} else {
		println("nil")
	}
}

fn main() {
	try1(`{"n": 12, "b": true, "x": [1, -0.5e-3, {"y": null}, "s\\\"q"], "z": null}`)
	try1(`{"n": -0, "b": false, "x": 0}`)
	try1(`{"x": @@@}`)
	try1(`{"x": nul}`)
	try1(`{"x": "abc}`)
	try1(`{"n": 007}`)
	try1(`{"n": 1.5}`)
	try1(`{"n": 1e3}`)
	try1(`{"b": truex}`)
	try1(`{"x": 1 2}`)
	try1(`{"x": 1.}`)
	try1(`{"x": -}`)
	try1(`{"z": 1}`)
}
