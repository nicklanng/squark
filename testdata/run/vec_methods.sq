program

// methods on a named vector type, next to the builtin vector methods

Stack: int[..8]

impl Stack {
	fn top(&self) -> int { return (*self)[len(*self)-1] }

	fn sum(self) -> int {
		n := 0
		for v in self {
			n += v
		}
		return n
	}
}

fn main() {
	var s Stack
	s.push(3)
	s.push(4)
	println(s.top(), s.sum(), len(s))
	p := &s
	println(p.top(), p.sum(), s.pop())
}
