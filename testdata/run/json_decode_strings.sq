fn show(s str, ok bool, d *json.Decoder) {
	print(ok, " ", d.offset(), " ", d.err.code(), " ", len(s), " [")
	print(s)
	println("]")
}

fn main() {
	var data u8[512]
	var buf u8[256]
	for ci, c in cases {
		n := copy(data[:], c)
		println("case", ci)
		for k in int[]{0, 3, 17, 40, 200} {
			d := json.new_decoder(data[:n])
			s, ok := d.string(buf[:k])
			show(s, ok, &d)
		}
		for m in int[]{0, 5, 20, 1000} {
			with arena a 1K {
				d := json.new_decoder_in(data[:n], a)
				s, ok := d.text_max(m)
				show(s, ok, &d)
			}
		}
		d := json.new_decoder(data[:n])
		ok := d.skip()
		show("", ok, &d)
	}
}
