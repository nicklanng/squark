package main

// v.Append(xs) / v.TryAppend(xs) add a whole slice to a vector (and a string to a byte vector):
// fixed-size text that can cross threads on a shared channel, filled without a byte loop.

import "runtime"

threads 2

type Line struct {
	From int
	Text [..32]byte
}

shared var lines chan Line cap 4

task send() pool 1 {
	var l Line
	l.From = runtime.Shard()
	l.Text.Append("hello ")
	var from [4]byte
	copy(from[:], "from")
	l.Text.Append(from[:])
	ok := l.Text.TryAppend(" a thread with a very long name that won't fit")
	l.Text.Push(' ')
	l.Text.Push(byte('0' + l.From))
	println("too long appended:", ok)
	lines <- l
}

func main() {
	if runtime.Shard() == 1 {
		go send()
		return
	}
	l := <-lines
	println(string(l.Text[:]), len(l.Text), cap(l.Text))

	var nums [..5]int
	nums.Append([]int{1, 2, 3})
	nums.Append(nums[:2]) // from itself
	println(len(nums), nums[3], nums[4], nums.TryAppend([]int{9}))
	nums.Append([]int{7}) // full: panics
}
