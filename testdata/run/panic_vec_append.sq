program {
	threads 2
}

// v.Append(xs) / v.TryAppend(xs) add a whole slice to a vector (and a string to a byte vector):
// fixed-size text that can cross threads on a shared channel, filled without a byte loop.

use runtime

struct Line {
	from int
	text u8[..32]
}

shared lines Line chan[4]

task send() pool 1 {
	var l Line
	l.from = runtime.shard()
	l.text.append("hello ")
	var from u8[4]
	copy(from[:], "from")
	l.text.append(from[:])
	ok := l.text.try_append(" a thread with a very long name that won't fit")
	l.text.push(' ')
	l.text.push(u8('0' + l.from))
	println("too long appended:", ok)
	lines <- l
}

fn main() {
	if runtime.shard() == 1 {
		start send()
		return
	}
	l := <-lines
	println(str(l.text[:]), len(l.text), cap(l.text))

	var nums int[..5]
	nums.append(int[]{1, 2, 3})
	nums.append(nums[:2]) // from itself
	println(len(nums), nums[3], nums[4], nums.try_append(int[]{9}))
	nums.append(int[]{7}) // full: panics
}
