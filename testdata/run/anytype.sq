program

use bytes, json, os, sort

struct Entry {
	word  str
	count int
}

fn by_count(a, b Entry) -> bool {
	if a.count != b.count {
		return a.count > b.count
	}
	return a.word < b.word
}

fn desc(a, b int) -> bool { return a > b }

// total works for any slice or array of ints
fn total(xs anytype) -> int {
	t := 0
	for i := 0; i < len(xs); i++ {
		t += xs[i]
	}
	return t
}

// both calls another generic function
fn both(xs anytype, ys anytype) -> int { return total(xs) + total(ys) }

fn size(m anytype) -> int { return len(m) }

thread counts int[str; 8]

fn main() {
	xs := int[]{5, 2, 9, 1, 5, 6}
	sort.ints(xs)
	println(xs[0], xs[1], xs[2], xs[3], xs[4], xs[5])
	sort.slice(xs, desc)
	println(xs[0], xs[5], sort.is_sorted(xs, desc))

	es := Entry[]{{"b", 2}, {"a", 2}, {"c", 7}, {"d", 1}}
	sort.slice(es, by_count)
	for e in es {
		print(e.word, e.count, " ")
	}
	println()

	words := str[]{"pear", "apple", "fig"}
	sort.strings(words)
	println(words[0], words[1], words[2])

	arr := int[3]{1, 2, 3}
	println(total(xs), total(arr), total(xs[:2]), both(arr, xs))

	counts["x"] = 1
	counts["y"] = 2
	println(size(counts), size("four"))

	var store u8[64]
	b := bytes.new_buffer(store[:0])
	json.write_string(&b, "say \"hi\"\n")
	println(b.string())
	json.write_string(os.stdout, "tab\there")
	println()

	// an empty string, and one over the 256-byte chunk with 2-byte characters across the boundary
	var big u8[1024]
	bb := bytes.new_buffer(big[:0])
	json.write_string(&bb, "")
	long := "éééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé"
	json.write_string(&bb, long)
	out := bb.string()
	println(out[:2], len(out), len(long)+4, out[len(out)-3:])

	// the same bytes as AppendString, for every kind of escape
	var x u8[128]
	var y u8[128]
	odd := "q\"b\\s\n\t\x01 bad\xff\xc3 ls\u2028 é"
	yb := bytes.new_buffer(y[:0])
	json.write_string(&yb, odd)
	println(str(json.append_string(x[:0], odd)) == yb.string())
}
