program

// comparisons are untyped booleans; min/max of untyped constants take the widest kind

MyBool: bool

fn is_nil(a arena) -> bool { return a == nil }

const lo = min(3, 2.5, 7)
const hi = max(1, 'a')

fn main() {
	x := 3
	var b MyBool = x > 1
	c := x == 3
	var d MyBool = not (x < 0) and b
	println(b, c, d, lo, hi, max("b", "ab"), min(x, 2))
	println(is_nil(nil))
	with arena a 64 {
		println(is_nil(a))
	}
}
