program

// Tasks waiting on descriptors: Close wakes a blocked Read (and closing a listener a blocked
// Accept) with an error instead of leaving them parked forever; and one task can read a
// socket while another is blocked writing to it (epoll used to keep only the last waiter).

use net, strconv, time

thread done str chan[4]
thread c net.Conn
thread big u8[4 << 20]

task reader() pool 1 {
	var buf u8[64]
	n, err := c.read(buf[:])
	if err != nil {
		done <- "read: error"
		return
	}
	done <- "read: " + str(buf[:n]) in str_
}

task writer() pool 1 {
	_, err := c.write(big[:]) // far more than the socket buffers: blocks until the peer drains it
	if err != nil {
		done <- "write: error"
		return
	}
	done <- "write: done"
}

task acceptor(l net.Listener) pool 1 {
	if _, err := l.accept(); err != nil {
		done <- "accept: error"
		return
	}
	done <- "accept: conn"
}

arena str_ 256

fn wait() -> str {
	select {
	case s := <-done:
		return s
	case <-time.after(2 * time.second):
		return "stuck"
	}
}

fn addr(port int) -> str {
	var b u8[32]
	return str(strconv.append_int(append(b[:0], "127.0.0.1:"...), port)) in str_
}

fn main() {
	l, err := net.listen("127.0.0.1:0")
	if err != nil {
		panic(err)
	}
	a := addr(l.port())

	// Close wakes a blocked Read
	c, _ = net.dial(a)
	peer, _ := l.accept()
	start reader()
	time.sleep(10 * time.millisecond)
	c.close()
	println(wait())
	peer.close()

	// a reader and a writer blocked on one socket
	c, _ = net.dial(a)
	peer, _ = l.accept()
	start reader()
	time.sleep(10 * time.millisecond)
	start writer()
	time.sleep(10 * time.millisecond) // the writer is blocked now, the reader still waiting
	peer.write_string("hi")
	println(wait())
	var buf u8[64 << 10]
	total := 0
	while total < len(big) {
		n, err := peer.read(buf[:])
		if err != nil {
			break
		}
		total += n
	}
	println(wait(), total == len(big))
	c.close()
	peer.close()

	// closing a listener wakes a blocked Accept
	start acceptor(l)
	time.sleep(10 * time.millisecond)
	l.close()
	println(wait())
}
