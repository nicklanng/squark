program

// math rounding, infinities and NaN; integers in other bases and padded; CutPrefix/CutSuffix and
// AppendRepeat; os.read_file and ReadFull's EOF errors.

use io, math, os, strconv, strings

fn main() {
	println(math.round(2.5), math.round(-2.5), math.trunc(-2.7), math.mod(7, -3), math.log2(8), math.log10(1000))
	println(math.is_inf(math.inf(1), 1), math.is_inf(math.inf(-1), 1), math.is_inf(math.inf(-1), 0), math.is_na_n(math.na_n()), math.is_na_n(1))
	println(math.max_int == math.max_int64, math.max_float64 > 1e308, math.smallest_nonzero_float64 > 0)

	var b u8[80]
	out := strconv.append_int_base(b[:0], 255, 16)
	out = append(out, ' ')
	out = strconv.append_int_base(out, -10, 2)
	out = append(out, ' ')
	out = strconv.append_uint_base(out, 1<<63, 36)
	out = append(out, ' ')
	out = strconv.append_int_pad(out, 7, 3, '0')
	out = append(out, '|')
	out = strconv.append_int_pad(out, -7, 4, '0')
	out = append(out, '|')
	out = strconv.append_int_pad(out, 42, 5, ' ')
	out = append(out, '|')
	out = strconv.append_int_pad(out, 123456, 2, ' ')
	println(str(out))

	rest, ok := strings.cut_prefix("GET /x", "GET ")
	name, ok2 := strings.cut_suffix("main.sq", ".go")
	println(rest, ok, name, ok2, str(strings.append_repeat(b[:0], "ab", 3)), len(strings.append_repeat(b[:0], "x", 0)))

	path := "/tmp/squark_stdlib_more_test.txt"
	f, _ := os.create(path)
	f.write_string("hello, file")
	f.close()
	var small u8[4]
	var big u8[64]
	data, err := os.read_file(path, big[:])
	println(str(data), err == nil)
	data, err = os.read_file(path, small[:])
	println(str(data), err == io.TooLarge)
	g, _ := os.open(path)
	n, err := g.read_full(big[:20])
	println(n, err == io.UnexpectedEOF)
	n, err = g.read_full(big[:4])
	println(n, err == io.EOF)
	g.close()
	_, err = os.read_file("no/such/file", big[:])
	println(err != nil)
}
