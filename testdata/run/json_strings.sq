package main

// JSON string decoding (surrogates, bad escapes) and encoding (invalid UTF-8, U+2028), against
// Go's encoding/json; the .out file was produced by the equivalent Go program

import (
	"json"
	"os"
	"strconv"
)

var inputs = [...]string{
	`"plain"`,
	`"Aé世"`,
	`"😀"`,
	`"\uD800Ax"`,
	`"\uD800Ax"`,
	`"\uD800𐀀"`,
	`"\uDC00x"`,
	`"\uD800"`,
	`"\u12G4"`,
	`"\u12"`,
	`"a\qb"`,
	`"tab\tnl\nq\"bs\\sl\/"`,
}

var encode = [...]string{"a\xffb", "\xe2\x80\xa8|\xe2\x80\xa9", "ok é 世", "\x00\x1f", "\xed\xa0\x80", "\xf0\x9f\x98\x80", "\xc3"}

func hexBytes(s string) {
	var b [256]byte
	out := b[:0]
	for i := 0; i < len(s); i++ {
		out = strconv.AppendInt(out, int(s[i]))
		out = append(out, ' ')
	}
	out = append(out, '\n')
	os.Stdout.Write(out)
}

func main() {
	for _, src := range inputs {
		var doc [64]byte
		n := copy(doc[:], src)
		d := json.NewDecoder(doc[:n])
		var sb [64]byte
		s, ok := d.String(sb[:])
		if !ok {
			println("error")
			continue
		}
		hexBytes(s)
	}
	for _, s := range encode {
		var b [64]byte
		hexBytes(string(json.AppendString(b[:0], s)))
	}
}
