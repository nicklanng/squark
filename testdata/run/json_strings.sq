program

// JSON string decoding (surrogates, bad escapes) and encoding (invalid UTF-8, U+2028), against
// Go's encoding/json; the .out file was produced by the equivalent Go program

use json, os, strconv

thread inputs = str[...]{
	`"plain"`,
	`"Aé世"`,
	`"😀"`,
	`"\uD800Ax"`,
	`"\uD800Ax"`,
	`"\uD800𐀀"`,
	`"\uDC00x"`,
	`"\uD800"`,
	`"\u12G4"`,
	`"\u12"`,
	`"a\qb"`,
	`"tab\tnl\nq\"bs\\sl\/"`,
}

thread encode = str[...]{"a\xffb", "\xe2\x80\xa8|\xe2\x80\xa9", "ok é 世", "\x00\x1f", "\xed\xa0\x80", "\xf0\x9f\x98\x80", "\xc3"}

fn hex_bytes(s str) {
	var b u8[256]
	out := b[:0]
	for i := 0; i < len(s); i++ {
		out = strconv.append_int(out, int(s[i]))
		out = append(out, ' ')
	}
	out = append(out, '\n')
	os.stdout.write(out)
}

fn main() {
	for src in inputs {
		var doc u8[64]
		n := copy(doc[:], src)
		d := json.new_decoder(doc[:n])
		var sb u8[64]
		s, ok := d.string(sb[:])
		if not ok {
			println("error")
			continue
		}
		hex_bytes(s)
	}
	for s in encode {
		var b u8[64]
		hex_bytes(str(json.append_string(b[:0], s)))
	}
}
