program

// SIMD vectors: operators lane by lane, masks, conversions, loads and stores, methods.

Vec4: f32x4

fn scale(v f32x4, k f32) -> f32x4 { return v * f32x4(k) }

fn main() {
	a := f32x4{1, 2, 3, 4}
	b := f32x4(2)
	println(a + b, a * b, a / b, -a, a - 1, 2 * a)
	println(a.sum(), a.min(), a.max(), len(a), a[2])
	m := a > b
	println(m, m.any(), m.all(), (a == a).all())
	println(m.select(a, b), min(a, b), max(a, b, f32x4(3.5)))
	xs := f32[]{9, 8, 7, 6, 5}
	v := f32x4(xs[1:])
	println(v, scale(v, 0.5))
	var buf f32[6]
	v.store(buf[2:])
	println(buf[0], buf[2], buf[5])
	i := i32x4{1, -2, 3, -4}
	println(i << 1, i >> 1, u32x4{1, 2, 3, 0x80000000} >> 31, i & 1, i | 8, i ^ -1, i &^ 1, ^i)
	var n uint = 40
	println(i << n, i >> n)
	println(f32x4(i), i32x4(f32x4{1.9, -1.9, 3e10, -3e10}), u8x16(i8x16{-1, 2}))
	u := u8x16{250, 5, 7}
	println((u + 10)[0], u.sum(), u.max())
	d := f64x4{1, 2, 3, 4}
	println(d.sum(), d * d, i64x4(d))
	var w Vec4 = Vec4{1, 1, 1, 1}
	println(f32x4(w) + a)
	var z i16x8
	println(z, z.any())
	k := 3
	println(a[k])
}
