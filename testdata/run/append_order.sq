program

// append and vector push evaluate all their operands before storing anything

thread trace int[..16]

fn tr(n int) -> int {
	trace.push(n)
	return n
}

fn main() {
	s := int[]{1, 2}
	s = append(s[:0], s[1], s[0])
	println(s[0], s[1])

	var buf int[4]
	t := buf[:3]
	t[0], t[1], t[2] = 1, 2, 3
	t = append(t[:1], t[2], t[1], t[0])
	println(t[0], t[1], t[2], t[3])

	with arena a 1K {
		u := int[]{1, 2}
		u = append(u[:0], u[1], u[0], 9) in a
		println(u[0], u[1], u[2])
	}

	var w int[..2]
	w.push(1)
	w.push(2)
	w.push(w.pop()) // full before the argument runs, not after
	println(len(w), w[0], w[1])
	ok := w.try_push(w.pop())
	println(ok, len(w))

	var v int[..4]
	v.push(tr(3))
	x := append(buf[:0], tr(1), tr(2))
	println(len(v), len(x), len(trace), trace[0], trace[1], trace[2])
}
