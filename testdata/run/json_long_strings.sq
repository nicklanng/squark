program

use bytes, json, utf8

// json.append_string and WriteString skip 16 plain bytes at a time; they must agree with a simple
// byte-by-byte encoder for every special character at every offset of long plain runs.

const hex = "0123456789abcdef"

fn reference(dst u8[], s str) -> u8[] {
	dst = append(dst, '"')
	for i := 0; i < len(s); i++ {
		c := s[i]
		if c >= 0x80 {
			r, size := utf8.decode_rune_in_string(s[i:])
			if r == utf8.rune_error and size == 1 {
				dst = append(dst, "�"...)
			} else if r == 0x2028 or r == 0x2029 {
				dst = append(dst, '\\', 'u', '2', '0', '2', hex[r&0xF])
			} else {
				dst = append(dst, s[i:i+size]...)
			}
			i += size - 1
			continue
		}
		switch {
		case c == '"':
			dst = append(dst, '\\', '"')
		case c == '\\':
			dst = append(dst, '\\', '\\')
		case c == '\n':
			dst = append(dst, '\\', 'n')
		case c == '\r':
			dst = append(dst, '\\', 'r')
		case c == '\t':
			dst = append(dst, '\\', 't')
		case c < 0x20:
			dst = append(dst, '\\', 'u', '0', '0', hex[c>>4], hex[c&0xF])
		default:
			dst = append(dst, c)
		}
	}
	return append(dst, '"')
}

thread specials = str[]{"\"", "\\", "\n", "\x01", "\x1f", "é", "世", "\xff", " ", "\xe2\x80", "~"}

fn main() {
	var src u8[96]
	var got, want u8[512]
	var wb u8[512]
	w := bytes.new_buffer(wb[:])
	bad, cases := 0, 0
	for n := 0; n <= 70; n++ {
		for pos := 0; pos <= n; pos++ {
			for sp in specials {
				k := 0
				for ; k < pos; k++ {
					src[k] = 'a' + u8(k%26)
				}
				k += copy(src[k:], sp)
				for ; k < n+len(sp); k++ {
					src[k] = 'A' + u8(k%26)
				}
				s := str(src[:k])
				a := json.append_string(got[:0], s)
				b := reference(want[:0], s)
				w.reset()
				json.write_string(&w, s)
				cases++
				if str(a) != str(b) or str(w.bytes()) != str(b) {
					bad++
					if bad < 5 {
						println("mismatch:", str(b), str(a), str(w.bytes()))
					}
				}
			}
		}
	}
	println(cases, "strings, mismatches:", bad)
}
