program

// zero-size types compile and behave

struct E {}

struct W {
	e E
	n int
	z int[0]
}

thread ge E
thread gz int[0]

fn mk() -> E { return E{} }

fn main() {
	var e E
	var z int[0]
	var w W
	w.n = 3
	println(e == mk(), e == ge, len(z), len(gz), w.n, len(w.z))
	var es E[3]
	println(len(es), es[1] == e)
}
