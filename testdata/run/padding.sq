// strconv.append_uint_pad (any base, left padding) and strings.append_pad_right (right padding,
// counted in runes).
program

use strconv, strings

fn main() {
	var buf u8[96]
	println(str(strconv.append_uint_pad(buf[:0], 0xbeef, 16, 8, '0')))
	line := strconv.append_uint_pad(append(buf[:0], '['), 0xdeadbeef, 16, 8, '0') // exactly width
	line = strconv.append_uint_pad(append(line, ' '), 0x1_2345_6789, 16, 8, '0') // wider: whole
	line = strconv.append_uint_pad(append(line, ' '), 0, 16, 4, '0')
	line = strconv.append_uint_pad(append(line, ' '), 5, 2, 8, '0')
	line = strconv.append_uint_pad(append(line, ' '), 42, 10, 6, ' ')
	line = strconv.append_uint_pad(append(line, ' '), 35, 36, 3, '_')
	line = strconv.append_uint_pad(append(line, ' '), 7, 10, 0, '0')
	line = strconv.append_uint_pad(append(line, ' '), 7, 10, -3, '0')
	line = strconv.append_uint_pad(append(line, ' '), 0xffffffffffffffff, 16, 20, '0')
	println(str(append(line, ']')))

	line = strings.append_pad_right(append(buf[:0], '['), "ab", 5, '.')
	line = strings.append_pad_right(append(line, '|'), "abcdef", 3, '.') // longer: whole
	line = strings.append_pad_right(append(line, '|'), "", 3, ' ')
	line = strings.append_pad_right(append(line, '|'), "crème", 7, '.') // 5 runes, 6 bytes
	line = strings.append_pad_right(append(line, '|'), "日本", 4, '-')
	line = strings.append_pad_right(append(line, '|'), "x", -1, '-')
	println(str(append(line, ']')))

	// a table: names padded right, numbers padded left
	names := str[3]{"apples", "kiwis", "crème brûlée"}
	counts := u64[3]{12, 7, 1024}
	for i, name in names {
		row := strings.append_pad_right(buf[:0], name, 14, ' ')
		row = strconv.append_uint_pad(row, counts[i], 10, 5, ' ')
		row = strconv.append_uint_pad(append(row, "  0x"...), counts[i], 16, 4, '0')
		println(str(row))
	}
}
