program

// Loop versioning (cgen_loop.go) of slices in struct fields and package variables, and of loops
// counting down: both copies must compute the same thing.

struct Matrix {
	n    int
	data f32[]
}

thread table i32[16]
thread tab i32[]

impl Matrix {
	fn add(&self, o *Matrix) {
		for i, _ in self.data {
			self.data[i] += o.data[i]
		}
	}

	fn scale(&self, k f32) {
		for i := 0; i < len(self.data); i++ {
			self.data[i] *= k
		}
	}

	fn sum(self) -> f32 {
		var s f32
		for i, _ in self.data {
			s += self.data[i]
		}
		return s
	}

	// the loop changes m.n but not m.data: m.data is still copied
	fn count_positive(&self) -> int {
		self.n = 0
		for i := 0; i < len(self.data); i++ {
			if self.data[i] > 0 {
				self.n++
			}
		}
		return self.n
	}

	// the loop stores a slice: m.data may change, so its indexes stay checked
	fn shrink(&self, other f32[]) -> f32 {
		var s f32
		for i := 0; i < 3; i++ {
			s += self.data[i]
			self.data = other
		}
		return s
	}

	// a nil m with a loop that doesn't run is fine
	fn first_n(&self, n int) -> f32 {
		var s f32
		for i := 0; i < n; i++ {
			s += self.data[i]
		}
		return s
	}
}

fn reverse_copy(dst, src i32[]) {
	for i := len(src) - 1; i >= 0; i-- {
		dst[len(src)-1-i] = src[i]
	}
}

fn down(a i32[], n int) -> i32 {
	var s i32
	for i := n; i > 0; i-- {
		s += a[i-1]
	}
	return s
}

fn down_to(a i32[], lo int) -> i32 {
	var s i32
	for i := len(a) - 1; lo <= i; i -= 1 {
		s += a[i] * i32(i)
	}
	return s
}

fn sum_tab(n int) -> i32 {
	var s i32
	for i := 0; i < n; i++ {
		s += tab[i]
	}
	return s
}

fn main() {
	var a, b, c f32[8]
	for i, _ in a {
		a[i] = f32(i)
		b[i] = 10
		c[i] = -1
	}
	m := Matrix{0, a[:]}
	o := Matrix{0, b[:]}
	m.add(&o)
	m.scale(0.5)
	println(m.data[0], m.data[7], m.sum(), m.count_positive(), m.n)
	println(m.shrink(c[:]), m.data[0])
	var none *Matrix
	println(none.first_n(0))
	for i, _ in table {
		table[i] = i32(i)
	}
	tab = table[:]
	var r i32[16]
	reverse_copy(r[:], table[:])
	println(r[0], r[15], down(table[:], 16), down(table[:], 0), down_to(table[:], 10), down_to(table[:], 20), sum_tab(16))
}
