program

// kqueue batches registrations and sends a full batch early. A registration in it that fails (its
// descriptor was closed before the batch was sent) must not drop the ones after it: here the
// idle registration of y would be lost and NextIdle would never return it.

use net, runtime, strconv, time

thread xc net.Conn
thread got int chan[1]

task reader() pool 1 {
	var buf u8[8]
	xc.read(buf[:])
}

task idler() pool 1 {
	_, tag := net.next_idle()
	got <- tag
}

arena str_ 64

fn addr(port int) -> str {
	var b u8[32]
	return str(strconv.append_int(append(b[:0], "127.0.0.1:"...), port)) in str_
}

fn pair(l net.Listener, a str) -> (net.Conn, net.Conn) {
	c, err := net.dial(a)
	if err != nil {
		panic(err)
	}
	s, err := l.accept()
	if err != nil {
		panic(err)
	}
	return c, s
}

fn main() {
	l, err := net.listen("127.0.0.1:0")
	if err != nil {
		panic(err)
	}
	a := addr(l.port())
	xc, _ = pair(l, a)
	yc, ys := pair(l, a)
	_, zs := pair(l, a)

	start reader()
	runtime.gosched() // the reader's registration for xc is queued, not yet sent
	xc.close()        // so sending it fails
	ys.park_idle(2)
	for i := 0; i < 300; i++ { // fills the batch: it is sent before the poller runs
		zs.park_idle(3)
	}
	start idler()
	yc.write_string("y")
	select {
	case tag := <-got:
		println("idle:", tag)
	case <-time.after(2 * time.second):
		println("y's idle registration was lost")
	}
}
