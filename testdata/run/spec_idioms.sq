program

// The idioms from docs/spec.md section 8, kept compiling and running.
use http, math, os, strconv

struct Node {
	name     str
	children *Node[]
}

struct Shape { kind int; w, h f64 }

const circle = 1
fault NoUser 404 "user not found"

fn area(s Shape) -> f64 {
	switch s.kind {
	case circle:
		return math.pi * s.w * s.w
	}
	return s.w * s.h
}

fn squares(n int, out int[]) -> int[] {
	out = out[:0]
	for i := 0; i < n; i++ {
		out = append(out, i*i)
	}
	return out
}

fn read_all(path str, data u8[]) -> int ! {
	f := os.open(path)!
	defer f.close()
	n, _ := f.read_full(data)
	return n, nil
}

fn lookup(name str, err error) -> ! {
	if err != nil {
		println("lookup failed for", name, ":", err.message())
		return NoUser
	}
	return nil
}

fn handle(w *http.ResponseWriter, r *http.Request) {
	w.set_header("Content-Type", "application/json")
	w.write_header(201)
	w.write_string(`{"ok":true}`)
}

fn main() {
	id, name := 7, "ada"
	var buf u8[64]
	line := strconv.append_int(append(buf[:0], "id="...), id)
	line = append(append(line, " name="...), name...)
	line = append(line, '\n')
	os.stdout.write(line)

	var data u8[64K]
	n, err := read_all(os.arg(0), data[:])
	println("read", n > 0, err == nil)

	var out int[10]
	println(len(squares(5, out[:])))

	with arena tree 256K {
		root := new(Node) in tree
		root.children = append(root.children, new(Node) in tree) in tree
		s := "name=" + name in tree
		println(s)
		var stack *Node[..64]
		stack.push(root)
		count := 0
		while len(stack) > 0 {
			nd := stack.pop()
			count++
			for c in nd.children {
				stack.push(c)
			}
		}
		println("nodes", count)
	}
	println(area(Shape{kind: circle, w: 1}) > 3, lookup("x", NoUser) == NoUser)
	_ = handle
	for i in 0..3 {
		print(i)
	}
	println()
}
