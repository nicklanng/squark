program

// maps: deleting during range visits every remaining entry exactly once, and heavy insert/delete
// churn (tombstones, compaction) agrees with a simple reference model

thread m int[int; 1000]

thread small int[int; 48]

// reference model for small: keys 0..199
thread present bool[200]
thread value int[200]

thread seed u64 = 12345

fn rnd(n int) -> int {
	seed = seed*6364136223846793005 + 1442695040888963407
	return int((seed >> 33) % u64(n))
}

thread names int[str; 8]

fn main() {
	for i in 0..1000 {
		m[i] = i
	}
	visited := 0
	for k, _ in m {
		visited++
		if k%2 == 0 {
			delete(m, k)
		}
	}
	println("delete evens:", visited, len(m))
	sum := 0
	for k, v in m {
		if k != v or k%2 == 0 {
			println("bad entry", k, v)
		}
		sum += k
	}
	println("odd sum:", sum)

	// deleting entries other than the current one: those not reached yet are not produced
	seen := 0
	for k, _ in m {
		seen++
		delete(m, k)
		delete(m, k+2) // a later odd key, if still there
	}
	println("delete ahead:", seen > 0, len(m))

	visited = 0
	for i in 0..1000 {
		m[i] = i
	}
	for k, _ in m {
		visited++
		delete(m, k)
	}
	println("delete all:", visited, len(m))

	// churn against the reference model
	for step in 0..200000 {
		k := rnd(200)
		switch rnd(3) {
		case 0:
			if present[k] or len(small) < 48 {
				small[k] = step
				present[k] = true
				value[k] = step
			}
		case 1:
			delete(small, k)
			present[k] = false
		default:
			v, ok := small[k]
			if ok != present[k] or ok and v != value[k] {
				println("mismatch at step", step, "key", k)
				return
			}
		}
	}
	n := 0
	for k, _ in small {
		if not present[k] {
			println("extra key", k)
		}
		n++
	}
	count := 0
	for k in 0..200 {
		if present[k] {
			count++
		}
	}
	println("churn:", n == count, len(small) == count)

	// string keys
	names["a"] = 1
	names["b"] = 2
	names["c"] = 3
	delete(names, "b")
	names["d"] = 4
	_, has_b := names["b"]
	println("strings:", len(names), names["a"], has_b, names["c"], names["d"])
}
