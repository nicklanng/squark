// math/rand: fixed seeds give fixed sequences (checked against a Go port of xoshiro256** seeded by
// splitmix64), Intn stays in bounds without bias, Float64 stays in [0, 1), Perm and Shuffle
// permute, and the per-thread generator works without a seed.
package main

import (
	"math/rand"
	"strconv"
)

func isPerm(p []int) bool {
	var seen [64]bool
	for _, v := range p {
		if v < 0 || v >= len(p) || seen[v] {
			return false
		}
		seen[v] = true
	}
	return true
}

func main() {
	r := rand.New(1)
	for i := 0; i < 4; i++ {
		println("uint64:", r.Uint64())
	}
	z := rand.New(0)
	println("seed 0:", z.Uint64())

	r = rand.New(42)
	println("int63:", r.Int63(), "int:", r.Int())
	ns := [7]int{1, 2, 6, 1000, 1024, 1 << 40, 3 << 61}
	for _, n := range ns {
		println("intn", n, r.Intn(n))
	}
	var buf [32]byte
	for i := 0; i < 3; i++ {
		println("float64:", string(strconv.AppendFloat(buf[:0], r.Float64(), -1)))
	}
	var p [10]int
	pv := r.Perm(p[:])
	print("perm:")
	for _, v := range pv {
		print(" ", v)
	}
	println()
	letters := [8]string{"a", "b", "c", "d", "e", "f", "g", "h"}
	r.Shuffle(letters[:])
	print("shuffle:")
	for _, s := range letters {
		print(" ", s)
	}
	println()
	var v [..5]int
	v.Append([]int{10, 20, 30, 40, 50})
	r.Shuffle(v[:])
	print("shuffle vector:")
	for _, x := range v {
		print(" ", x)
	}
	println()

	// a copy carries on from the same point
	c := r
	println("copy repeats:", c.Uint64() == r.Uint64(), c.Intn(1000) == r.Intn(1000))

	// a fair die: 60000 rolls, each face within 3% of 10000
	r = rand.New(7)
	var faces [6]int
	for i := 0; i < 60000; i++ {
		faces[r.Intn(6)]++
	}
	print("faces:")
	fair := true
	for _, n := range faces {
		print(" ", n)
		fair = fair && n > 9700 && n < 10300
	}
	println()
	println("fair:", fair)

	// a range over 2^62, beyond the 32-bit path: in bounds, and both halves hit
	const big = 3 << 61
	low, high := 0, 0
	for i := 0; i < 10000; i++ {
		x := r.Intn(big)
		if x < 0 || x >= big {
			println("out of range:", x)
		}
		if x < big/2 {
			low++
		} else {
			high++
		}
	}
	println("big halves:", low, high)

	// Float64: in [0, 1), mean near 1/2
	lo, hi, sum := 1.0, 0.0, 0.0
	for i := 0; i < 100000; i++ {
		f := r.Float64()
		if f < 0 || f >= 1 {
			println("float out of range")
		}
		lo = min(lo, f)
		hi = max(hi, f)
		sum += f
	}
	mean := sum / 100000
	println("float64 range ok:", lo < 0.0001, hi > 0.9999,
		"mean near 1/2:", mean > 0.495 && mean < 0.505)

	// Perm is a permutation for every length, 0 included
	ok := true
	var q [64]int
	for n := 0; n <= 64; n++ {
		ok = ok && isPerm(r.Perm(q[:n]))
	}
	println("perms ok:", ok)

	// the per-thread generator seeds itself; its values vary from run to run, so check bounds only
	inBounds := true
	for i := 0; i < 1000; i++ {
		x := rand.Intn(10)
		f := rand.Float64()
		inBounds = inBounds && x >= 0 && x < 10 && f >= 0 && f < 1 && rand.Int() >= 0 && rand.Int63() >= 0
	}
	println("package-level in bounds:", inBounds, "varies:", rand.Uint64() != rand.Uint64())
	println("package-level perm ok:", isPerm(rand.Perm(q[:20])))
	rand.Shuffle(letters[:])
	n := 0
	for _, s := range letters {
		n += len(s)
	}
	println("package-level shuffle kept", n, "letters")
}
