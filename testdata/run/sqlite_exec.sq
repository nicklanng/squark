program

// sqlite.Stmt.Exec: binds Int, Text and Null in order, runs the statement to its end and reports
// LastInsertID and RowsAffected; the statement is reset afterwards (other statements and a second
// Exec run without a Reset), also after a failed bind or step; rows a statement returns are
// skipped

use sqlite

fn run() -> ! {
	db := sqlite.open(":memory:")!
	db.exec("CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT, n INTEGER UNIQUE)")!
	ins := db.prepare("INSERT INTO t(name, n) VALUES(?, ?)")!
	res := ins.exec(sqlite.text("a"), sqlite.integer(1))!
	println("insert:", res.last_insert_id, res.rows_affected)
	res = ins.exec(sqlite.null(), sqlite.integer(2))!
	println("insert null:", res.last_insert_id, res.rows_affected)
	res = ins.exec(sqlite.text("c"), sqlite.integer(3))!
	println("insert:", res.last_insert_id, res.rows_affected)

	// a constraint failure is the step's error, and the statement is usable afterwards
	_, err := ins.exec(sqlite.text("dup"), sqlite.integer(3))
	println("duplicate:", err != nil, err.code(), err.message())
	// too many arguments: the bind's error
	_, err = ins.exec(sqlite.text("x"), sqlite.integer(9), sqlite.integer(10))
	println("too many args:", err != nil, err.code())
	res = ins.exec(sqlite.text("d"))!
	println("missing arg is null:", res.last_insert_id, res.rows_affected)

	upd := db.prepare("UPDATE t SET name = ? WHERE id > ?")!
	res = upd.exec(sqlite.text("z"), sqlite.integer(2))!
	println("update:", res.rows_affected)
	del := db.prepare("DELETE FROM t WHERE id = ?")!
	res = del.exec(sqlite.integer(42))!
	println("delete none:", res.rows_affected)

	// a statement with rows: Exec skips them
	sel := db.prepare("SELECT id FROM t")!
	_ = sel.exec()!

	// the statements were reset: rows can be read with Step
	q := db.prepare("SELECT id, name IS NULL, n IS NULL FROM t ORDER BY id")!
	defer q.reset()
	while q.step()! {
		println("row:", q.column_int(0), q.column_int(1), q.column_int(2))
	}
	return nil
}

fn main() {
	if err := run(); err != nil {
		println("error:", err.message())
	}
}
