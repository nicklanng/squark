program

// strings and utf8 edge cases that follow Go

use strings, utf8

fn show(parts str[]) {
	print(len(parts), ":")
	for p in parts {
		print(" [", p, "]")
	}
	println()
}

fn main() {
	var out str[8]
	show(strings.split("abc", "", out[:]))
	show(strings.split("héllo", "", out[:3]))
	show(strings.split("", "", out[:]))
	show(strings.split("a,b,c", ",", out[:2]))
	println(strings.count("héllo", ""), strings.count("", ""), strings.count("cheese", "e"))
	println(utf8.rune_len(0xD800), utf8.rune_len(0xDFFF), utf8.rune_len(0xE000), utf8.rune_len('é'))
}
