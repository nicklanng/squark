program

// Not "no storage" errors: a pointer method can give a map its storage, delete on a nil map does
// nothing, and a select never picks a nil channel.
M: int[str]

impl M {
	fn init(&self, a arena) { *self = make(int[str], 4) in a }
}

arena pa 1K

thread gm M
thread never int[str]
thread quiet int chan

fn main() {
	gm.init(pa)
	gm["x"] = 1
	delete(never, "x")
	select {
	case v := <-quiet:
		println("got", v)
	default:
		println("nothing", gm["x"], len(never))
	}
}
