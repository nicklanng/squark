program

// Floats as text: shortest form with AppendFloat(dst, v, -1), ParseFloat, and json.Decoder.Float.
// (TestFloatConversions checks both against Go on 20000 values.)

use json, strconv

fn show(v f64) {
	var b u8[64]
	print(str(strconv.append_float(b[:0], v, -1)), " ")
}

fn main() {
	show(0.1)
	show(1.0 / 3)
	show(100)
	show(1e21)
	show(1e-7)
	show(-0.0)
	println()
	for s in str[...]{"3.5", "1e-3", "  ", "0x10", "1e999", "-Infinity"} {
		f, err := strconv.parse_float(s)
		show(f)
		println(err == nil)
	}
	var doc u8[64]
	n := copy(doc[:], `{"price": 3.25, "qty": 2, "big": 1e400}`)
	d := json.new_decoder(doc[:n])
	var key u8[8]
	d.begin_object()
	sum := 0.0
	loop {
		k, ok := d.field(key[:])
		if not ok {
			break
		}
		f, ok := d.float()
		println(k, ok)
		sum += f
	}
	show(sum)
	println(d.err != nil)
}
