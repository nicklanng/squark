program

// cap of a map is the number of entries its storage holds (0 for a nil map)

thread m int[int; 4]

fn cap_of(v int[int]) -> int { return cap(v) }

fn main() {
	m[1] = 1
	var nilm int[int]
	println(cap(m), len(m), cap_of(m), cap(nilm))
	with arena a 4K {
		mm := make(int[str], 10) in a
		println(cap(mm))
	}
}
