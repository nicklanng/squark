package main

// SIMD lanes can be assigned (v[i] = x, op=, ++, parallel assignment), and Shuffle and Swizzle
// rearrange lanes.

type P struct{ v [2]int32x4 }

func main() {
	var a float32x4
	a[1] = 5
	a[2] += 1.5
	a[3]++
	i := 0
	a[i] = 9
	println(a)
	var p P
	j := 1
	p.v[j][3] = 7
	p.v[j][3] *= 3
	p.v[0][0], p.v[1][0] = 4, 6
	q := &p
	q.v[1][2] -= 2
	println(p.v[0], p.v[1])
	var m uint8x16
	for k := range 16 {
		m[k] = byte(k * 3)
	}
	m[15] <<= 1
	println(m)
	b := int32x4{10, 11, 12, 13}
	c := int32x4{20, 21, 22, 23}
	println(b.Swizzle(3, 2, 1, 0), b.Swizzle(0, 0, 0, 0))
	println(b.Shuffle(c, 0, 4, 1, 5), b.Shuffle(c, 2, 3, 4, 5))
	f := float32x8{1, 2, 3, 4, 5, 6, 7, 8}
	println(f.Swizzle(7, 6, 5, 4, 3, 2, 1, 0).Sum())
	b[0], b[1] = b[1], b[0]
	println(b)
	viaPointer()
}

func viaPointer() {
	v := float32x4{1, 2, 3, 4}
	p := &v
	p[0] = 7
	p[1] += 1
	println(p[0], p[1], len(p), p.Sum(), *p)
}

