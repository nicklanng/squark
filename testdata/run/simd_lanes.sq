program

// SIMD lanes can be assigned (v[i] = x, op=, ++, parallel assignment), and Shuffle and Swizzle
// rearrange lanes.

struct P { v i32x4[2] }

fn main() {
	var a f32x4
	a[1] = 5
	a[2] += 1.5
	a[3]++
	i := 0
	a[i] = 9
	println(a)
	var p P
	j := 1
	p.v[j][3] = 7
	p.v[j][3] *= 3
	p.v[0][0], p.v[1][0] = 4, 6
	q := &p
	q.v[1][2] -= 2
	println(p.v[0], p.v[1])
	var m u8x16
	for k in 0..16 {
		m[k] = u8(k * 3)
	}
	m[15] <<= 1
	println(m)
	b := i32x4{10, 11, 12, 13}
	c := i32x4{20, 21, 22, 23}
	println(b.swizzle(3, 2, 1, 0), b.swizzle(0, 0, 0, 0))
	println(b.shuffle(c, 0, 4, 1, 5), b.shuffle(c, 2, 3, 4, 5))
	f := f32x8{1, 2, 3, 4, 5, 6, 7, 8}
	println(f.swizzle(7, 6, 5, 4, 3, 2, 1, 0).sum())
	b[0], b[1] = b[1], b[0]
	println(b)
	via_pointer()
}

fn via_pointer() {
	v := f32x4{1, 2, 3, 4}
	p := &v
	p[0] = 7
	p[1] += 1
	println(p[0], p[1], len(p), p.sum(), *p)
}

