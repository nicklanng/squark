program

// pool, stack and from are contextual words: types with those names still work as results

struct Stack { items int[..8] }

From: int

fn new_stack() -> Stack {
	var s Stack
	s.items.push(1)
	return s
}

fn depth() -> Stack stack 16K { // result type stack, then a stack clause
	return new_stack()
}

fn from_of(n int) -> From { return From(n) }

thread f fn() -> Stack = new_stack

fn view(b u8[]) -> u8[] in b { return b[:1] }

fn main() {
	s := f()
	d := depth()
	var b u8[4]
	println(len(s.items), len(d.items), int(from_of(3)), len(view(b[:])))
}
