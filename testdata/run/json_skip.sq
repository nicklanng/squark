program

// json.Decoder.Skip follows the JSON grammar (brackets match, separators where they belong,
// valid escapes, no raw control characters), never moves Offset past the end of the data, and
// nests up to 1024 deep. String replaces invalid UTF-8 with U+FFFD, as Go does.

use json, os, strconv

thread src u8[4096]

fn skip(doc str) {
	n := copy(src[:], doc)
	d := json.new_decoder(src[:n])
	ok := d.skip()
	end := d.end()
	print(doc, " -> ", ok and end, " offset=", d.offset(), "/", n, "\n")
}

fn deep(n int) {
	b := src[:0]
	for _ in 0..n {
		b = append(b, '[')
	}
	for _ in 0..n {
		b = append(b, ']')
	}
	d := json.new_decoder(b)
	ok := d.skip()
	println("depth", n, ok and d.end())
}

fn main() {
	// valid
	skip(`[]`)
	skip(`{}`)
	skip(` [ [ ] , { } ] `)
	skip(`{"a":[1,{"b":"é\n\"\\\/"}],"c":null,"d":true,"e":-1.5e3}`)
	skip(`"x"`)
	skip(`12`)
	skip(`[1,[2,[3]],{"x":{"y":[]}}]`)
	// invalid
	skip(`[1,]`)
	skip(`[,1]`)
	skip(`[1 2]`)
	skip(`{"a":1,}`)
	skip(`{"a" 1}`)
	skip(`{"a":}`)
	skip(`{1:2}`)
	skip(`{"a":1 "b":2}`)
	skip(`[}`)
	skip(`{]`)
	skip(`]`)
	skip(`}`)
	skip(`,`)
	skip(`["a":1]`)
	skip(`[[]`)
	skip(`"a\qb"`)
	skip(`"a\u12"`)
	skip(`"a\u12x4"`)
	skip("\"a\tb\"")
	skip(`"abc`)
	skip(`"abc\`)
	skip(`[1`)
	skip(`[`)
	skip(``)
	skip(`[tru]`)
	// a lone closer inside an object doesn't count as a value
	n := copy(src[:], `{"a": ], "b": 2}`)
	d := json.new_decoder(src[:n])
	var key u8[8]
	d.begin_object()
	k, _ := d.field(key[:])
	println(k, d.skip(), d.err != nil)
	deep(1024)
	deep(1025)

	// String: invalid UTF-8 becomes U+FFFD, valid multi-byte runes pass through
	n = copy(src[:], "\"a\xffb\xc3\xa9\xed\xa0\x80\xc3\"")
	d = json.new_decoder(src[:n])
	var sb u8[32]
	s, ok := d.string(sb[:])
	var out u8[128]
	o := out[:0]
	for i := 0; i < len(s); i++ {
		o = strconv.append_int(o, int(s[i]))
		o = append(o, ' ')
	}
	o = append(o, '\n')
	os.stdout.write(o)
	println(ok)
	// the replacement needs room for 3 bytes
	n = copy(src[:], "\"ab\xff\"")
	d = json.new_decoder(src[:n])
	var small u8[4]
	s, ok = d.string(small[:])
	println(ok, d.err == json.Buffer)
}
