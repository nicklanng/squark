program

// str(s) in a copies s into the arena, whether s is a u8[] or already a string: changing
// the original bytes afterwards doesn't change the copy.

arena keep 256

thread kept str

fn remember(s str) {
	kept = str(s) in keep // a copy in static memory, so s may be on the caller's stack
}

fn main() {
	var buf u8[5]
	copy(buf[:], "hello")
	s := str(buf[:])
	with arena a 64 {
		c := str(s) in a
		b := str(buf[:]) in a
		buf[0] = 'J'
		println(s, c, b, a.used())
	}
	remember(s)
	buf[0] = 'Y'
	println(kept, keep.used())
}
