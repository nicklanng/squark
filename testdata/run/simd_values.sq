program

// SIMD vectors are plain values: struct fields, arrays, channel elements, task arguments.

Vec4: f32x4

struct Particle {
	pos, vel f32x4
}

thread ch i32x8 chan[2]

task worker(v i32x8) pool 1 {
	ch <- v * 2
}

fn main() {
	var ps Particle[3]
	for i, _ in ps {
		ps[i].vel = f32x4(f32(i))
		ps[i].pos += ps[i].vel
	}
	println(ps[2].pos)
	var vs u16x8[2]
	vs[1] = u16x8{1, 2, 3}
	println(vs[1].sum(), len(vs[0]))
	w := Vec4{1, 2, 3, 4}
	println(w.sum(), w+w, (w > 2).any())
	start worker(i32x8{1, 2, 3, 4, 5, 6, 7, 8})
	println(<-ch)
	var p *Particle = &ps[1]
	println(p.vel[3], (p.pos == p.vel).all())
}
