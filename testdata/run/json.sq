program

use json

fn main() {
	var src u8[128]
	n := copy(src[:], ` {"name": "squark ❤", "n": -42, "ok": true, "skip": {"a": [1, {"b": "}"}]}, "tail": "x\"y"} `)
	d := json.new_decoder(src[:n])
	var key u8[16]
	var val u8[64]
	if not d.begin_object() {
		println("bad")
		return
	}
	loop {
		k, ok := d.field(key[:])
		if not ok {
			break
		}
		switch k {
		case "name", "tail":
			s, _ := d.string(val[:])
			println(k, "=", s)
		case "n":
			n, _ := d.int()
			println(k, "=", n)
		case "ok":
			b, _ := d.bool()
			println(k, "=", b)
		default:
			d.skip()
			println("skipped", k)
		}
	}
	println("end", d.end(), d.err == nil)

	var out u8[128]
	enc := json.append_string(out[:0], "tab\there \"quoted\" \x01")
	println(str(enc))
}
