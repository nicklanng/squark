program {
	threads 4
}

// shared channels: 4 scheduler threads; shard 0 produces jobs, every shard's workers take them
// and send results back, shard 0 sums them. An unbuffered shared channel hands values across
// threads one at a time.

use runtime

shared jobs int chan[16]
shared results int chan[16]
shared ping int chan[0]
shared pong int chan[0]

thread done int chan[1] // per shard

task producer() pool 1 {
	for i := 1; i <= 1000; i++ {
		jobs <- i
	}
	close(jobs)
}

task collector() pool 1 {
	sum := 0
	for i := 0; i < 1000; i++ {
		sum += <-results
	}
	done <- sum
}

task worker() pool 2 {
	for j in jobs {
		results <- j * 2
	}
}

task echo() pool 1 {
	for v in ping {
		pong <- v + 1
	}
}

fn main() {
	if runtime.shard() == 0 {
		start producer()
		start collector()
	}
	start worker()
	start worker()
	if runtime.shard() == 1 {
		start echo()
	}
	if runtime.shard() == 0 {
		println(<-done)
		v := 0
		for i := 0; i < 100; i++ {
			ping <- v
			v = <-pong
		}
		close(ping)
		println(v)
	}
}
