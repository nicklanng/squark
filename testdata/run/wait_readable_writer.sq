program

// A WaitReadable that times out withdraws only its own registration: another goroutine blocked
// writing the same connection still wakes when the peer drains it (epoll keeps one registration
// per descriptor for both directions, and the timeout used to clear it whole).

use net, strconv, time

thread done str chan[4]
thread c net.Conn
thread big u8[4 << 20]

task writer() pool 1 {
	if _, err := c.write(big[:]); err != nil { // far more than the socket buffers: blocks
		done <- "write: error"
		return
	}
	done <- "write: done"
}

task grace() pool 1 {
	if c.wait_readable(20 * time.millisecond) {
		done <- "grace: readable"
		return
	}
	done <- "grace: timed out"
}

arena str_ 64

fn wait() -> str {
	select {
	case s := <-done:
		return s
	case <-time.after(2 * time.second):
		return "stuck"
	}
}

fn main() {
	l, err := net.listen("127.0.0.1:0")
	if err != nil {
		panic(err)
	}
	var b u8[32]
	c, err = net.dial(str(strconv.append_int(append(b[:0], "127.0.0.1:"...), l.port())) in str_)
	if err != nil {
		panic(err)
	}
	peer, err := l.accept()
	if err != nil {
		panic(err)
	}
	start writer()
	time.sleep(10 * time.millisecond) // the writer is blocked now
	start grace()
	println(wait())
	var buf u8[64 << 10]
	total := 0
	while total < len(big) and peer.wait_readable(time.second) {
		n, err := peer.read(buf[:])
		if err != nil {
			break
		}
		total += n
	}
	println(wait(), total == len(big))
}
