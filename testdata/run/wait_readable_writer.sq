package main

// A WaitReadable that times out withdraws only its own registration: another goroutine blocked
// writing the same connection still wakes when the peer drains it (epoll keeps one registration
// per descriptor for both directions, and the timeout used to clear it whole).

import (
	"net"
	"strconv"
	"time"
)

var done chan string cap 4
var c net.Conn
var big [4 << 20]byte

task writer() pool 1 {
	if _, err := c.Write(big[:]); err != nil { // far more than the socket buffers: blocks
		done <- "write: error"
		return
	}
	done <- "write: done"
}

task grace() pool 1 {
	if c.WaitReadable(20 * time.Millisecond) {
		done <- "grace: readable"
		return
	}
	done <- "grace: timed out"
}

arena str 64

func wait() string {
	select {
	case s := <-done:
		return s
	case <-time.After(2 * time.Second):
		return "stuck"
	}
}

func main() {
	l, err := net.Listen("127.0.0.1:0")
	if err != nil {
		panic(err)
	}
	var b [32]byte
	c, err = net.Dial(string(strconv.AppendInt(append(b[:0], "127.0.0.1:"...), l.Port())) in str)
	if err != nil {
		panic(err)
	}
	peer, err := l.Accept()
	if err != nil {
		panic(err)
	}
	go writer()
	time.Sleep(10 * time.Millisecond) // the writer is blocked now
	go grace()
	println(wait())
	var buf [64 << 10]byte
	total := 0
	for total < len(big) && peer.WaitReadable(time.Second) {
		n, err := peer.Read(buf[:])
		if err != nil {
			break
		}
		total += n
	}
	println(wait(), total == len(big))
}
