program

// index, len and range on a call (or receive) that yields a vector: a temporary used as a view
fn mk() -> int[..4] {
	var v int[..4]
	v.push(7)
	v.push(8)
	return v
}

fn main() {
	println(mk()[0], len(mk()))
	for x in mk() {
		println(x)
	}
	var c int[..2] chan[1]
	var w int[..2]
	w.push(3)
	c <- w
	println(len(<-c))
}
