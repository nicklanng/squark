program

const min_int = -9223372036854775807 - 1

// i - min_int wraps around to a negative index: the range test must reject the loop (the offset
// -min_int is min_int again), so the index stays checked and panics.
fn sub(a int[], off int) -> int {
	s := 0
	for i := 0; i < 2; i++ {
		s += a[i-off]
	}
	return s
}

fn main() {
	a := int[]{1, 2, 3}
	println(sub(a, -1))
	println(sub(a, min_int))
}
