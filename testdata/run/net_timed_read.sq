program

// Reading a connection with a timeout. Conn.with_timeout(d) is a source whose reads give up with
// net.Timeout after d without input; d <= 0 means no deadline, for it and for ReadTimeout
// (which used to time out at once). bufio.Reader.ReadLine returns a partial last line at io.EOF,
// but drops it when the source fails otherwise (a timeout), in both the ordinary path and the one
// for a line that fills the buffer exactly.

use bufio, net, time

const short = 30 * time.millisecond

thread l net.Listener

// pair returns the two ends of a new connection: the client's, then the server's.
fn pair() -> (net.Conn, net.Conn) {
	var b u8[32]
	c, err := net.dial(str(net.append_host_port(b[:0], "127.0.0.1", l.port())))
	if err != nil {
		panic(err)
	}
	s, err := l.accept()
	if err != nil {
		panic(err)
	}
	return c, s
}

// late writes text to s after a delay longer than short.
task late(s net.Conn, text str in static) pool 2 {
	time.sleep(3 * short)
	s.write_string(text)
}

fn show(what str, n int, err error) {
	if err != nil {
		println(what, "->", err.message())
		return
	}
	println(what, "->", n, "bytes")
}

// lines reads lines from src until an error, which it repeats once to show it sticks.
fn lines(what str, r *bufio.Reader, src anytype) {
	print(what, ":")
	loop {
		line, err := r.read_line(src)
		if err != nil {
			_, again := r.read_line(src)
			print(" <", err.message(), "> <", again.message(), ">\n")
			return
		}
		print(" [", line, "]")
	}
}

fn timeouts() {
	c, s := pair()
	var buf u8[16]
	n, err := c.with_timeout(short).read(buf[:])
	show("WithTimeout(short), nothing sent", n, err)
	n, err = c.read_timeout(buf[:], short)
	show("ReadTimeout(short), nothing sent", n, err)

	start late(s, "late")
	start := time.now()
	n, err = c.with_timeout(0).read(buf[:])
	show("WithTimeout(0), a late write", n, err)
	println("  waited for it:", time.since(start) >= 2*short)
	start late(s, "later")
	n, err = c.read_timeout(buf[:], -time.second)
	show("ReadTimeout(-1s), a late write", n, err)

	s.write_string("ready")
	n, err = c.with_timeout(short).read(buf[:])
	show("WithTimeout(short), input waiting", n, err)
	c.close()
	s.close()
}

// partial sends text, then either closes the connection (EOF) or leaves it open (a timeout), and
// reads it back in lines through a buffer of size bytes.
fn partial(text str, size int, eof bool) {
	c, s := pair()
	s.write_string(text)
	if eof {
		s.close()
	}
	var store u8[8]
	r := bufio.new_reader(store[:size])
	what := "timeout"
	if eof {
		what = "eof"
	}
	lines(what, &r, c.with_timeout(short))
	c.close()
	if not eof {
		s.close()
	}
}

fn main() {
	var err error
	l, err = net.listen("127.0.0.1:0")
	if err != nil {
		panic(err)
	}
	timeouts()

	partial("one\ntwo\nthr", 8, true)
	partial("one\ntwo\nthr", 8, false)
	partial("one\r\ntwo\r", 8, true)
	partial("one\r\ntwo\r", 8, false)
	partial("abcd\nwxyz", 4, true) // a last line that fills the buffer
	partial("abcd\nwxyz", 4, false)
	partial("abcd\nwxyz\r", 4, true)
	partial("abcd\nwxyz\r", 4, false)
}
