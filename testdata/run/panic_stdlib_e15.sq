program

// net.Conn.CloseWrite (the peer reads EOF and the connection still reads), json.Decoder
// Offset/Line, and a zero bytes.Buffer refusing writes.

use bytes, json, net, strconv

arena str_ 64

task peer(l net.Listener) pool 1 {
	c, _ := l.accept()
	var buf u8[64]
	total := 0
	loop {
		n, err := c.read(buf[total:])
		total += n
		if err != nil or n == 0 {
			break // EOF: the other side closed its sending half
		}
	}
	c.write_string("got:" + str(buf[:total]) in str_)
	c.close()
}

fn main() {
	l, _ := net.listen("127.0.0.1:0")
	start peer(l)
	var b u8[32]
	c, _ := net.dial(str(strconv.append_int(append(b[:0], "127.0.0.1:"...), l.port())))
	c.write_string("hello")
	c.close_write()
	var reply u8[64]
	n := 0
	loop {
		m, err := c.read(reply[n:])
		n += m
		if err != nil or m == 0 {
			break
		}
	}
	println(str(reply[:n]))

	var doc u8[64]
	n = copy(doc[:], "{\n  \"a\": 1,\n  \"b\": oops\n}")
	d := json.new_decoder(doc[:n])
	var key u8[8]
	d.begin_object()
	loop {
		k, ok := d.field(key[:])
		if not ok {
			break
		}
		if k == "a" {
			d.int()
		} else {
			d.skip()
		}
	}
	println(d.err != nil, d.line(), d.offset())

	var zero bytes.Buffer
	zero.write_string("lost?") // panics: no storage
}
