program

// constant composites: tables and structs built from constants, read-only and shared by every
// scheduler thread

struct Point {
	x, y int
	name str
}

const primes = int[5]{2, 3, 5, 7, 11}
const origin = Point{0, 0, "origin"}
const grid = Point[2][2]{{{1, 2, "a"}, {3, 4, "b"}}, {{5, 6, "c"}, {7, 8, "d"}}}
fault X 7 "x"
const errs = error[2]{X, error(8, "y")}

impl Point {
	fn move(&self)      { self.x++ }
	fn sum(self) -> int { return self.x + self.y }
}

fn main() {
	sum := 0
	for p in primes {
		sum += p
	}
	c := origin
	c.move()
	println(sum, len(primes), primes[3], origin.name, origin.sum(), c.x, grid[1][0].name, errs[1].message())
}
