program

// len and cap of a fixed-size operand still evaluate it when it calls a function or receives

thread calls int

fn arr() -> int[3]     { calls++; return int[3]{} }
fn parr() -> *(int[4])   { calls++; return nil }
fn vec() -> int[..5]   { calls++; var v int[..5]; return v }

const n = len(int[2]{}) // still a constant

fn main() {
	var a int[6]
	println(len(arr()), len(parr()), cap(vec()), calls)
	println(len(a), cap(a), n)
	var c int[2] chan[1]
	c <- int[2]{}
	println(len(<-c), len(c))
}
