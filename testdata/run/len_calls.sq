package main

// len and cap of a fixed-size operand still evaluate it when it calls a function or receives

var calls int

func arr() [3]int     { calls++; return [3]int{} }
func parr() *[4]int   { calls++; return nil }
func vec() [..5]int   { calls++; var v [..5]int; return v }

const n = len([2]int{}) // still a constant

func main() {
	var a [6]int
	println(len(arr()), len(parr()), cap(vec()), calls)
	println(len(a), cap(a), n)
	var c chan [2]int cap 1
	c <- [2]int{}
	println(len(<-c), len(c))
}
