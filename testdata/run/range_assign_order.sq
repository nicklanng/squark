package main

// Assigning range key and value to existing variables evaluates the value's index before the key
// is stored (spec §5), as in Go.
func main() {
	var arr [3]string
	i := 0
	for i, arr[i] = range [3]string{"x", "y", "z"} {
	}
	println(arr[0], arr[1], arr[2] == "", i)
	var out [3]int
	j := 2
	for j, out[j] = range []int{5, 6} {
	}
	println(out[0], out[1], out[2], j)
}
