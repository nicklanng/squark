program

// json.Decoder.TextMax: a string up to max decoded bytes is kept at its exact size; a longer one
// is ErrTooLong, uses none of the arena and leaves the decoder at its opening quote; escapes and
// invalid UTF-8 count as the bytes they decode to; Text has no limit

use json

fn main() {
	var data u8[128]
	with arena a 1K {
		k := copy(data[:], `["abcd", "abcde",
  "ééx", "a`+"\xff"+`b", "long"]`)
		d := json.new_decoder_in(data[:k], a)
		d.begin_array()
		d.more()
		s, ok := d.text_max(4)
		println("at the limit:", ok, s, a.used())
		d.more()
		used := a.used()
		_, ok = d.text_max(4)
		println("one over:", ok, d.err == json.TooLong, d.err.message(), a.used()-used, d.offset(), d.line())

		// escapes count decoded: é is 2 bytes, so 5 in all
		d = json.new_decoder_in(data[:k], a)
		d.begin_array()
		d.more()
		d.skip()
		d.more()
		d.skip()
		d.more()
		s, ok = d.text_max(5)
		println("escapes:", ok, s, len(s))
		d.more()
		s, ok = d.text_max(4) // \xff becomes U+FFFD: 5 bytes
		println("invalid byte:", ok, d.err.message(), d.line())

		d = json.new_decoder_in(data[:k], a)
		d.begin_array()
		d.more()
		d.skip()
		d.more()
		s, ok = d.text_max(0)
		println("max 0:", ok, d.err == json.TooLong)
		d = json.new_decoder_in(data[1:3], a) // `"a`: unterminated is still a syntax error
		_, ok = d.text_max(100)
		println("unterminated:", ok, d.err == json.Syntax)
		k = copy(data[:], `""`)
		d = json.new_decoder_in(data[:k], a)
		s, ok = d.text_max(0)
		println("empty at max 0:", ok, len(s))

		// Text: no limit
		k = copy(data[:], `"0123456789012345678901234567890123456789"`)
		d = json.new_decoder_in(data[:k], a)
		s, ok = d.text()
		println("text:", ok, len(s))
	}
}
