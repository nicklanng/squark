package main

// squark identifiers that map onto each other's C names must stay distinct

type T struct{ n int }

func (t T) M() int { return t.n + 1 }
func T__M(t T) int  { return t.n + 2 }

func k_1() int   { return 7 }
func other() int { return 8 }

var g__x = 30

func g_x_2() int { return 31 }

func main() {
	main__k := other // C local must not shadow the function k_1 (main__k_1)
	println(k_1(), main__k())

	t := T{n: 10}
	println(t.M(), T__M(t))

	G_main__g := 40 // must not shadow the global g__x
	println(g__x, G_main__g, g_x_2())

	x__ := 1
	x_ := 2
	println(x__, x_)
}
