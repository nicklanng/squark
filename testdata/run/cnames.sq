program

// squark identifiers that map onto each other's C names must stay distinct

struct T {
	n int
}

impl T {
	fn m(self) -> int { return self.n + 1 }
}

fn t__m(t T) -> int  { return t.n + 2 }

fn k_1() -> int   { return 7 }
fn other() -> int { return 8 }

thread g__x = 30

fn g_x_2() -> int { return 31 }

fn main() {
	main__k := other // C local must not shadow the function k_1 (main__k_1)
	println(k_1(), main__k())

	t := T{n: 10}
	println(t.m(), t__m(t))

	g_main__g := 40 // must not shadow the global g__x
	println(g__x, g_main__g, g_x_2())

	x__ := 1
	x_ := 2
	println(x__, x_)
}
