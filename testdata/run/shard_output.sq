package main

// With threads, os.Exit on one thread writes what the other threads have buffered too: a print
// without a newline stays in its thread's buffer until then.

import (
	"os"
	"runtime"
	"time"
)

threads 2

shared var ready chan int cap 1

func main() {
	if runtime.Shard() == 1 {
		print("partial line from thread 1")
		ready <- 1
		time.Sleep(time.Hour)
	}
	<-ready
	println("thread 0 exits")
	os.Exit(0)
}
