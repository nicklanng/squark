program {
	threads 4
}

// shared: initialized once, on the first scheduler thread, before the others start; every
// shard then reads the same copy

use runtime

shared crc_table = make_table()

shared answer = 42

fn make_table() -> u32[256] {
	println("table built")
	var t u32[256]
	for i in 0..256 {
		c := u32(i)
		for k := 0; k < 8; k++ {
			if c&1 == 1 {
				c = 0xEDB88320 ^ (c >> 1)
			} else {
				c >>= 1
			}
		}
		t[i] = c
	}
	return t
}

fn main() {
	// every shard must see the finished table
	if crc_table[1] != 0x77073096 or crc_table[255] != 0x2D02EF8D or answer != 42 {
		panic("shared var not initialized before this shard started")
	}
	if runtime.shard() == 0 {
		println("ok", runtime.shards())
	}
}
