package main

// shared var: initialized once, on the first scheduler thread, before the others start; every
// shard then reads the same copy

import "runtime"

threads 4

shared var crcTable = makeTable()

shared var answer = 42

func makeTable() [256]uint32 {
	println("table built")
	var t [256]uint32
	for i := range 256 {
		c := uint32(i)
		for k := 0; k < 8; k++ {
			if c&1 == 1 {
				c = 0xEDB88320 ^ (c >> 1)
			} else {
				c >>= 1
			}
		}
		t[i] = c
	}
	return t
}

func main() {
	// every shard must see the finished table
	if crcTable[1] != 0x77073096 || crcTable[255] != 0x2D02EF8D || answer != 42 {
		panic("shared var not initialized before this shard started")
	}
	if runtime.Shard() == 0 {
		println("ok", runtime.Shards())
	}
}
