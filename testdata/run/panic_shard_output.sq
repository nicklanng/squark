program {
	threads 2
}

// With threads, a panic on one thread writes what the other threads have buffered first: a print
// without a newline stays in its thread's buffer until then.

use runtime, time

shared ready int chan[1]

fn main() {
	if runtime.shard() == 1 {
		print("partial line from thread 1")
		ready <- 1
		time.sleep(time.hour)
	}
	<-ready
	print("thread 0 panics")
	panic("stop")
}
