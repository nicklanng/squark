package main

// 1 << n takes its type from the context, as in Go

func main() {
	n := 40
	var mask uint64
	mask |= 1 << n
	var b uint8 = 1 << (n - 33)
	var b2 uint8 = 1 << (n - 32) // wraps to 0 at run time
	x := 1 << (n + 22)
	y := 1<<n + 1
	var f int32 = -(1 << (n - 37))
	var u uint32 = 1<<31 | 1<<(n-40)
	println(mask, b, b2, x, y, f, u)
	println(1<<n, uint16(1<<(n-30)))
}
