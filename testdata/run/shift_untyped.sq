program

// 1 << n takes its type from the context, as in Go

fn main() {
	n := 40
	var mask u64
	mask |= 1 << n
	var b u8 = 1 << (n - 33)
	var b2 u8 = 1 << (n - 32) // wraps to 0 at run time
	x := 1 << (n + 22)
	y := 1<<n + 1
	var f i32 = -(1 << (n - 37))
	var u u32 = 1<<31 | 1<<(n-40)
	println(mask, b, b2, x, y, f, u)
	println(1<<n, u16(1<<(n-30)))
}
