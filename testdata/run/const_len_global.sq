package main

// len of a package-level array is a constant at package level too, wherever the array is declared
// (the constant and the pool size are resolved before the variables).

const N = len(peers)
const M = len(grid[0]) * 2

var peers [5]int
var grid [3][4]byte

var done chan int cap len(peers)

task work(i int) pool len(peers) {
	done <- i
}

func main() {
	for i := 0; i < N; i++ {
		go work(i)
	}
	sum := 0
	for i := 0; i < N; i++ {
		sum += <-done
	}
	println(N, M, sum, cap(done))
}
