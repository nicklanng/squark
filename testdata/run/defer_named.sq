program

// deferred calls see and can change named results, as in Go

fault Bad 1 "bad"

fn set(p *int)          { *p = 42 }
fn double(p *int)       { *p *= 2 }
fn wrap(e *error)       { if *e != nil { *e = Wrapped } }
fn fail() -> int !  { return 0, Bad }

fault Wrapped 2 "wrapped"

fn f() -> (res int) {
	defer set(&res)
	return 1
}

fn g() -> (res int) {
	defer double(&res)
	res = 5
	return
}

fn h() -> (n int, err error) {
	defer double(&n)
	return 21, nil
}

fn t() -> (n int, err error) {
	defer wrap(&err)
	n = 7
	_ = fail()!
	return n, nil
}

fn plain() -> int {
	x := 3
	defer set(&x)
	return x
}

fn main() {
	n, err := h()
	n2, err2 := t()
	println(f(), g(), n, err == nil, n2, err2.message(), plain())
}
