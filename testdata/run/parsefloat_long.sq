package main

// ParseFloat (and json.Decoder.Float) with more digits than the 800 the decimal keeps: the digits
// dropped before the point still count toward the exponent.

import (
	"json"
	"strconv"
)

func show(s string) {
	f, err := strconv.ParseFloat(s)
	var b [64]byte
	println(len(s), string(strconv.AppendFloat(b[:0], f, -1)), err == nil)
}

func main() {
	var buf [2048]byte
	// "1" + 800 zeros + "e-800" = 1
	s := append(buf[:0], '1')
	for range 800 {
		s = append(s, '0')
	}
	show(string(append(s, "e-800"...)))
	// "1" + 1000 zeros + "e-1000" = 1
	s = append(buf[:0], '1')
	for range 1000 {
		s = append(s, '0')
	}
	show(string(append(s, "e-1000"...)))
	// "2" + 900 zeros + ".5e-900" = 2
	s = append(buf[:0], '2')
	for range 900 {
		s = append(s, '0')
	}
	show(string(append(s, ".5e-900"...)))
	// 900 nines + "e-900" rounds to 1
	s = buf[:0]
	for range 900 {
		s = append(s, '9')
	}
	show(string(append(s, "e-900"...)))
	// leading zeros don't count: "0000.1" + 900 zeros + "1"
	s = append(buf[:0], "0000.1"...)
	for range 900 {
		s = append(s, '0')
	}
	show(string(append(s, '1')))
	// through json.Decoder.Float
	s = append(buf[:0], '[', '3')
	for range 850 {
		s = append(s, '0')
	}
	s = append(s, "e-850]"...)
	d := json.NewDecoder(s)
	d.BeginArray()
	d.More()
	f, ok := d.Float()
	var b [64]byte
	println(string(strconv.AppendFloat(b[:0], f, -1)), ok)
}
