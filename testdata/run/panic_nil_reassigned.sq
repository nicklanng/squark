program

// A local declared with &x skips its nil checks only while it can't have changed: reassigned (or
// changed through its address), it is checked again.
struct P { v int }

//squark:noinline
fn via_addr(pp **P) { *pp = nil }

fn main() {
	x := P{1}
	p := &x
	println(p.v)
	q := &x
	via_addr(&q)
	r := &x
	r = nil
	println("before")
	println(r.v + q.v)
}
