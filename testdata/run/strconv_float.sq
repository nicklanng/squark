program

// strconv.append_float against Go's strconv.FormatFloat(v, 'f', prec, 64); the .out file was
// produced by the equivalent Go program

use math, os, strconv

thread seed u64 = 88172645463325252

fn next() -> u64 {
	seed ^= seed << 13
	seed ^= seed >> 7
	seed ^= seed << 17
	return seed
}

thread buf u8[2400]

fn show(v f64, prec int) {
	b := strconv.append_float(buf[:0], v, prec)
	b = append(b, '\n')
	os.stdout.write(b)
}

thread precs = int[4]{0, 2, 17, 30}

fn main() {
	zero := 0.0
	special := f64[...]{0, -zero, 1, -1, 0.5, 1.5, 2.5, -2.5, 0.125, 0.375, 9.995, 99.5, 0.05, 1e19, 1.8446744073709552e19,
		-1e300, 1e308, 1.7976931348623157e308, 5e-324, 2.2250738585072014e-308, 123456.789, 3.141592653589793,
		1 / zero, -1 / zero, zero / zero}
	for v in special {
		for p in precs {
			show(v, p)
		}
	}
	show(1.5, 25)
	show(5e-324, 1100)
	show(0.1, 60)
	show(1, -3)
	for i := 0; i < 200; i++ {
		v := math.float64frombits(next())
		show(v, precs[i%4])
	}
	// values with a moderate exponent, where rounding ties are common
	for i := 0; i < 200; i++ {
		v := f64(int(next()%2000000)-1000000) / 64
		show(v, i%4)
	}
}
