package main

// net.AppendHostPort joins a host and a port as Go's net.JoinHostPort does: an IPv6 literal (a
// host with a ':') goes in brackets, and an empty host gives ":port", Listen's form for every
// interface. The result is usable with Listen and Dial.

import (
	"net"
)

func show(host string, port int) {
	var b [64]byte
	print("[", host, "] ", port, " -> ", string(net.AppendHostPort(b[:0], host, port)), "\n")
}

func main() {
	show("127.0.0.1", 8080)
	show("localhost", 80)
	show("", 7070)
	show("::1", 443)
	show("fe80::1%lo0", 0)
	show("example.com", 65535)

	var b [64]byte
	dst := append(b[:0], "addr="...) // appends to what dst holds
	println(string(net.AppendHostPort(dst, "10.0.0.1", 22)))

	l, err := net.Listen(string(net.AppendHostPort(b[:0], "127.0.0.1", 0)))
	if err != nil {
		panic(err)
	}
	c, err := net.Dial(string(net.AppendHostPort(b[:0], "127.0.0.1", l.Port())))
	println("dial:", err == nil)
	c.Close()
	l.Close()
}
