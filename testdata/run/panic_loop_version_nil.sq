package main

type T struct{ data []int }

// a nil t with a loop that runs: the checked copy panics on the first read of t.data
func (t *T) sum(n int) int {
	s := 0
	for i := 0; i < n; i++ {
		println(i)
		s += t.data[i]
	}
	return s
}

func main() {
	var t *T
	println(t.sum(0))
	println(t.sum(2))
}
