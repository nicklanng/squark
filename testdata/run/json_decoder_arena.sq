program

// json.new_decoder_in: Key and Text decode into the arena at the exact size, results kept in
// variables outside the loop; String and Field still work; without an arena Key and Text fail with
// ErrNoArena; a full arena is ErrBuffer, not a panic

use json

struct Note {
	title str
	tags  str[..4]
	body  str
}

// parse fills n from data: n may keep strings from Text, which live in the arena (the checker ties
// them to the data too, as it does everything from the decoder)
fn parse(data u8[], a arena, n *Note) -> ! {
	d := json.new_decoder_in(data, a)
	if not d.begin_object() {
		return d.err
	}
	loop {
		key, ok := d.key()
		if not ok {
			break
		}
		switch key {
		case "title":
			before := a.used()
			n.title, _ = d.text()
			println("  title used", a.used()-before, "len", len(n.title))
		case "body":
			n.body, _ = d.text()
		case "tags":
			if d.begin_array() {
				while d.more() {
					t, ok := d.text()
					if ok {
						n.tags.try_push(t)
					}
				}
			}
		case "note":
			var buf u8[32] // String still decodes into a caller buffer
			s, _ := d.string(buf[:])
			println("  note:", s)
		default:
			println("  skip", key)
			d.skip()
		}
	}
	if not d.end() {
		return d.err
	}
	return nil
}

fn main() {
	var src u8[256]
	with arena a 1K {
		var n Note // request-scoped: inside the arena's block
		k := copy(src[:], `{"title": "café \"q\" 😀 \ud800x", "xAy": [1, {"a": null}], "tags": ["a", "\t", ""], "note": "plain", "body": "b`+"\xff"+`c"}`)
		err := parse(src[:k], a, &n)
		println("err nil:", err == nil)
		println("title:", n.title)
		println("tags:", len(n.tags), n.tags[0], n.tags[1] == "\t", n.tags[2] == "")
		println("body:", n.body == "b�c", len(n.body))

		// an escaped key comes out decoded
		var data u8[64]
		k = copy(data[:], `{"xAy\n": 1}`)
		d := json.new_decoder_in(data[:k], a)
		d.begin_object()
		key, ok := d.key()
		println("key:", ok, key == "xAy\n")

		// errors: not a string, a bad escape, an unterminated string
		k = copy(data[:], `[1, "a\qb", "open`)
		d = json.new_decoder_in(data[:k], a)
		d.begin_array()
		d.more()
		_, ok = d.text()
		println("number:", ok, d.err == json.Type)
		d = json.new_decoder_in(data[4:k], a)
		_, ok = d.text()
		println("bad escape:", ok, d.err == json.Syntax)
		d = json.new_decoder_in(data[11:k], a)
		_, ok = d.text()
		println("unterminated:", ok, d.err == json.Syntax)

		// a key that isn't a string
		k = copy(data[:], `{1: 2}`)
		d = json.new_decoder_in(data[:k], a)
		d.begin_object()
		_, ok = d.key()
		println("bad key:", ok, d.err == json.Type)
	}

	// no arena: Text and Key fail, String and Field work
	var data u8[64]
	k := copy(data[:], `{"k": "v", "k2": "v2"}`)
	d := json.new_decoder(data[:k])
	d.begin_object()
	var kb, vb u8[8]
	key, ok := d.field(kb[:])
	println("field:", ok, key)
	_, ok = d.text()
	println("text without arena:", ok, d.err.message())
	d = json.new_decoder(data[:k])
	d.begin_object()
	_, ok = d.key()
	println("key without arena:", ok, d.err.message())
	d = json.new_decoder(data[:k])
	d.begin_object()
	d.field(kb[:])
	s, ok := d.string(vb[:])
	println("string:", ok, s)

	// a full arena
	with arena small 16 {
		k = copy(data[:], `["0123456789abcdef", "x"]`)
		d := json.new_decoder_in(data[:k], small)
		d.begin_array()
		d.more()
		s, ok := d.text()
		println("fits:", ok, s, small.left())
		d.more()
		_, ok = d.text()
		println("too big:", ok, d.err.message(), small.left())
	}
}
