program

use time

thread a int chan[1]
thread b str chan[0]
thread quit bool chan[0]
thread both1 int chan[100]
thread both2 int chan[100]

task sender() pool 1 {
	b <- "hello"
}

thread x int chan[0]
thread y int chan[0]
thread got int chan[4]

// selector waits on x and y; both senders run before it resumes, so only the first may complete
// its select: the second must wait for the next select instead of handing its value to this one.
task selector() pool 1 {
	for i := 0; i < 2; i++ {
		select {
		case v := <-x:
			got <- v
		case v := <-y:
			got <- v
		}
	}
}

task send_to(c int chan, v int) pool 2 {
	c <- v
}

// wait ends in a select, which needs no return after it
fn wait(c int chan) -> int {
	select {
	case v := <-c:
		return v
	case <-time.after(time.millisecond):
		return -1
	}
}

fn main() {
	a <- 7
	select {
	case v := <-a:
		println("a", v)
	case s := <-b:
		println("b", s)
	}

	start sender()
	select {
	case v, ok := <-a:
		println("a again", v, ok)
	case s := <-b:
		println("b", s)
	}

	select {
	case <-quit:
		println("quit")
	default:
		println("nothing ready")
	}

	start := time.now()
	select {
	case <-quit:
		println("quit")
	case <-time.after(20 * time.millisecond):
		println("timeout waited", time.since(start).milliseconds() >= 20)
	}

	for i := 0; i < 3; i++ {
		select {
		case a <- i:
			println("sent", i)
		default:
			println("full", i)
		}
	}
	println(wait(a), wait(a))

	// break leaves the select, not the loop; a labeled break leaves the loop
	n := 0
loop:
	for i := 0; i < 10; i++ {
		a <- i
		select {
		case v := <-a:
			if v == 2 {
				break
			}
			if v == 4 {
				break loop
			}
			n += v
		}
		n += 100
	}
	println("n", n)

	// a nil channel is never ready
	var none int chan
	select {
	case <-none:
		println("nil ready?")
	case <-time.after(time.millisecond):
		println("nil never ready")
	}

	// both ready every time: each is picked sometimes
	for i := 0; i < 100; i++ {
		both1 <- i
		both2 <- i
	}
	c1, c2 := 0, 0
	for i := 0; i < 100; i++ {
		select {
		case <-both1:
			c1++
		case <-both2:
			c2++
		}
	}
	println("fair", c1 > 10, c2 > 10, c1+c2)

	start selector()
	time.sleep(time.millisecond) // the selector is waiting on x and y
	start send_to(x, 1)
	start send_to(y, 2)
	g1 := <-got
	g2 := <-got
	println("one case per select:", g1, g2)

	close(a)
	select {
	case v, ok := <-a:
		println("closed", v, ok)
	}
}
