package main

import "time"

var a chan int cap 1
var b chan string cap 0
var quit chan bool cap 0
var both1 chan int cap 100
var both2 chan int cap 100

task sender() pool 1 {
	b <- "hello"
}

var x chan int cap 0
var y chan int cap 0
var got chan int cap 4

// selector waits on x and y; both senders run before it resumes, so only the first may complete
// its select: the second must wait for the next select instead of handing its value to this one.
task selector() pool 1 {
	for i := 0; i < 2; i++ {
		select {
		case v := <-x:
			got <- v
		case v := <-y:
			got <- v
		}
	}
}

task sendTo(c chan int, v int) pool 2 {
	c <- v
}

// wait ends in a select, which needs no return after it
func wait(c chan int) int {
	select {
	case v := <-c:
		return v
	case <-time.After(time.Millisecond):
		return -1
	}
}

func main() {
	a <- 7
	select {
	case v := <-a:
		println("a", v)
	case s := <-b:
		println("b", s)
	}

	go sender()
	select {
	case v, ok := <-a:
		println("a again", v, ok)
	case s := <-b:
		println("b", s)
	}

	select {
	case <-quit:
		println("quit")
	default:
		println("nothing ready")
	}

	start := time.Now()
	select {
	case <-quit:
		println("quit")
	case <-time.After(20 * time.Millisecond):
		println("timeout waited", time.Since(start).Milliseconds() >= 20)
	}

	for i := 0; i < 3; i++ {
		select {
		case a <- i:
			println("sent", i)
		default:
			println("full", i)
		}
	}
	println(wait(a), wait(a))

	// break leaves the select, not the loop; a labeled break leaves the loop
	n := 0
loop:
	for i := 0; i < 10; i++ {
		a <- i
		select {
		case v := <-a:
			if v == 2 {
				break
			}
			if v == 4 {
				break loop
			}
			n += v
		}
		n += 100
	}
	println("n", n)

	// a nil channel is never ready
	var none chan int
	select {
	case <-none:
		println("nil ready?")
	case <-time.After(time.Millisecond):
		println("nil never ready")
	}

	// both ready every time: each is picked sometimes
	for i := 0; i < 100; i++ {
		both1 <- i
		both2 <- i
	}
	c1, c2 := 0, 0
	for i := 0; i < 100; i++ {
		select {
		case <-both1:
			c1++
		case <-both2:
			c2++
		}
	}
	println("fair", c1 > 10, c2 > 10, c1+c2)

	go selector()
	time.Sleep(time.Millisecond) // the selector is waiting on x and y
	go sendTo(x, 1)
	go sendTo(y, 2)
	g1 := <-got
	g2 := <-got
	println("one case per select:", g1, g2)

	close(a)
	select {
	case v, ok := <-a:
		println("closed", v, ok)
	}
}
