program

// bufio.Reader's longest line is the buffer's capacity (not counting "\n" or "\r\n"), and a last
// line ending in "\r" at EOF loses the "\r", as with Go's bufio.Scanner.

use bufio, io, os

fn read_all(path str, text str) {
	f, _ := os.create(path)
	f.write_string(text)
	f.close()
	var store u8[8]
	r := bufio.new_reader(store[:])
	g, _ := os.open(path)
	loop {
		line, err := r.read_line(g)
		if err == io.EOF {
			println("<eof>")
			break
		}
		if err != nil {
			print("<", err.message(), ">\n")
			continue
		}
		print("[", line, "]\n")
	}
	g.close()
}

fn main() {
	path := "/tmp/squark_bufio_full_line.txt"
	read_all(path, "12345678\n1234567\r\n12345678\r\n123456789\nab\n12345678\rx\nlast\r")
	read_all(path, "abcdefgh")
	read_all(path, "abcdefgh\r")
	read_all(path, "abcdefg\r")
	read_all(path, "abcdefgh\nabcdefgh\n")
}
