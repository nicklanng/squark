program

// json.Encoder: commas and nesting, every kind of value, escapes matching AppendString, misuse and
// depth errors, a full buffer (each call all or nothing), streaming through a small buffer with
// Clear, and growing into an arena

use bytes, json, math

fn show(label str, e *json.Encoder) {
	err := e.finish()
	if err != nil {
		println(label, str(e.bytes()), "err:", err.message())
	} else {
		println(label, str(e.bytes()))
	}
}

fn kinds() {
	var buf u8[512]
	e := json.new_encoder(buf[:0])
	e.object()
	e.key("s")
	e.string("tab\t\"q\" \\ é\x01")
	e.key("i")
	e.int(-9223372036854775807 - 1)
	e.key("f")
	e.array()
	e.float(1.5)
	e.float(0.1)
	e.float(1e21)
	e.float(1e-7)
	e.float(123456789)
	e.float(0)
	e.float(-2.5e-300)
	e.end()
	e.key("b")
	e.bool(true)
	e.key("nb")
	e.bool(false)
	e.key("n")
	e.null()
	e.key("raw")
	var raw u8[32]
	n := copy(raw[:], ` {"pre": [1, 2]} `)
	e.raw(raw[:n])
	e.key("empty")
	e.object()
	e.end()
	e.key("nested")
	e.array()
	e.array()
	e.end()
	e.object()
	e.key("k\n")
	e.array()
	e.int(1)
	e.object()
	e.end()
	e.end()
	e.end()
	e.string("")
	e.end()
	e.end()
	show("kinds:", &e)

	var b2 u8[16]
	t := json.new_encoder(b2[:0])
	t.int(42)
	show("scalar:", &t)
}

fn strings() {
	encode := str[...]{"a\xffb", "\xe2\x80\xa8|\xe2\x80\xa9", "ok é 世", "\x00\x1f", "\xed\xa0\x80", "\xf0\x9f\x98\x80", "\xc3", "<&>", "\x7f"}
	for s in encode {
		var b1, b2 u8[64]
		e := json.new_encoder(b1[:0])
		e.string(s)
		want := json.append_string(b2[:0], s)
		println("string", str(e.bytes()) == str(want), len(e.bytes()), e.finish() == nil)
		// a buffer exactly the size of the string, and one byte short
		var b3 u8[64]
		f := json.new_encoder(b3[:0:len(want)])
		f.string(s)
		g := json.new_encoder(b3[:0 : len(want)-1])
		g.string(s)
		println("  exact", f.err == nil, "short", g.err == json.Full, len(g.bytes()))
	}
}

fn misuse() {
	var buf u8[64]
	e := json.new_encoder(buf[:0])
	e.object()
	e.int(1) // no key
	show("value without key:", &e)

	e = json.new_encoder(buf[:0])
	e.key("x")
	show("key at top level:", &e)

	e = json.new_encoder(buf[:0])
	e.array()
	e.key("x")
	show("key in array:", &e)

	e = json.new_encoder(buf[:0])
	e.object()
	e.key("x")
	e.key("y")
	show("key twice:", &e)

	e = json.new_encoder(buf[:0])
	e.end()
	show("end with nothing open:", &e)

	e = json.new_encoder(buf[:0])
	e.array()
	e.end()
	e.end()
	show("end once too often:", &e)

	e = json.new_encoder(buf[:0])
	e.object()
	e.key("x")
	e.end()
	show("end after key:", &e)

	e = json.new_encoder(buf[:0])
	e.int(1)
	e.int(2)
	show("two top-level values:", &e)

	e = json.new_encoder(buf[:0])
	e.object()
	e.key("a")
	e.array()
	show("still open:", &e)

	e = json.new_encoder(buf[:0])
	show("nothing written:", &e)

	e = json.new_encoder(buf[:0])
	e.array()
	e.int(1)
	e.object() // no error yet
	e.int(2)   // misuse: the first error is kept, and nothing more is written
	e.end()
	e.end()
	e.string("more")
	show("after an error:", &e)

	floats := f64[...]{math.na_n(), math.inf(1), math.inf(-1)}
	for f in floats {
		e = json.new_encoder(buf[:0])
		e.array()
		e.float(f)
		show("float:", &e)
	}

	raws := str[...]{"", "{", "1 2", "[1,]", `{"a"}`, "nul", `"\x"`, "  [ ]  ", "-0.5e3", `"é"`}
	for r in raws {
		var rb u8[16]
		n := copy(rb[:], r)
		e = json.new_encoder(buf[:0])
		e.array()
		e.raw(rb[:n])
		e.end()
		show("raw:", &e)
	}
}

fn depth() {
	var buf u8[2100]
	e := json.new_encoder(buf[:0])
	for i := 0; i < json.max_depth; i++ {
		e.array()
	}
	for i := 0; i < json.max_depth; i++ {
		e.end()
	}
	println("depth MaxDepth:", e.finish() == nil, len(e.bytes()))

	e = json.new_encoder(buf[:0])
	for i := 0; i <= json.max_depth; i++ {
		e.array()
	}
	println("depth MaxDepth+1:", e.finish().message(), len(e.bytes()))
}

fn full() {
	var buf u8[12]
	e := json.new_encoder(buf[:0])
	e.array()
	e.int(12345)
	e.string("abcdef") // doesn't fit: nothing of it is written
	e.int(1)           // after the error: ignored
	println("full:", str(e.bytes()), e.err.message())

	// drain, clear the error and retry: the document continues
	var out u8[..64]
	out.append(e.bytes())
	e.clear()
	e.err = nil
	e.string("abcdef")
	e.end()
	out.append(e.bytes())
	println("retried:", str(out[:]), e.finish() == nil)
}

// streamed writes a document through a 16-byte buffer, draining into out whenever a call doesn't
// fit; strings too long for the buffer go through raw_start and json.write_string.
struct Streamer {
	e   json.Encoder
	out *bytes.Buffer
}

impl Streamer {
	fn drain(&self) {
		self.out.write(self.e.bytes())
		self.e.clear()
	}

	// retry runs after each call: if it didn't fit, drain and report that it must be made again
	fn retry(&self) -> bool {
		if self.e.err != json.Full {
			return false
		}
		self.drain()
		self.e.err = nil
		return true
	}

	fn str(&self, v str) {
		self.e.string(v)
		if self.retry() {
			self.e.string(v)
			if self.retry() { // longer than the buffer: write it straight through
				if self.e.raw_start() {
					self.drain()
					json.write_string(self.out, v)
				}
			}
		}
	}

	fn key(&self, k str) {
		self.e.key(k)
		if self.retry() {
			self.e.key(k)
		}
	}

	fn num(&self, v int) {
		self.e.int(v)
		if self.retry() {
			self.e.int(v)
		}
	}

	fn open(&self, obj bool) {
		if obj {
			self.e.object()
		} else {
			self.e.array()
		}
		if self.retry() {
			if obj {
				self.e.object()
			} else {
				self.e.array()
			}
		}
	}

	fn end(&self) {
		self.e.end()
		if self.retry() {
			self.e.end()
		}
	}
}

fn doc(s *Streamer) {
	s.open(true)
	s.key("items")
	s.open(false)
	for i := 0; i < 5; i++ {
		s.open(true)
		s.key("id")
		s.num(i * 1000)
		s.key("name")
		s.str("item\t\"x\"")
		s.end()
	}
	s.end()
	s.key("long")
	s.str("a string much longer than the sixteen-byte buffer, with \"quotes\" and é")
	s.key("after")
	s.open(false)
	s.end()
	s.end()
}

fn stream() {
	var small u8[16]
	var store u8[1024]
	out := bytes.new_buffer(store[:0])
	s := Streamer{e: json.new_encoder(small[:0]), out: &out}
	doc(&s)
	err := s.e.finish()
	s.drain()

	var big u8[1024]
	var store2 u8[1024]
	out2 := bytes.new_buffer(store2[:0])
	t := Streamer{e: json.new_encoder(big[:0]), out: &out2}
	doc(&t)
	t.drain()
	println("streamed:", err == nil, str(out.bytes()) == str(out2.bytes()), out.len())
	println(str(out.bytes()))
}

fn in_arena() {
	with arena a 8K {
		e := json.new_encoder_in(nil, a)
		e.array()
		for i := 0; i < 300; i++ {
			e.int(i)
		}
		e.end()
		println("arena:", e.finish() == nil, len(e.bytes()), cap(e.bytes()), a.used())

		// a buffer that isn't the arena's latest allocation is copied once, then grows in place
		var small u8[8]
		f := json.new_encoder_in(small[:0], a)
		f.array()
		f.string("0123456789") // copied into a 64-byte block
		x := new(int) in a     // so f's buffer isn't the latest allocation: copied again, once
		*x = 1
		for i := 1; i < 100; i++ {
			f.string("0123456789")
		}
		f.end()
		println("arena copy:", f.finish() == nil, len(f.bytes()), cap(f.bytes()), a.used())
	}
	with arena b 256 {
		e := json.new_encoder_in(nil, b)
		e.array()
		for i := 0; i < 100 and e.err == nil; i++ {
			e.string("0123456789")
		}
		println("arena full:", e.err.message(), len(e.bytes()), b.used() <= b.cap())
	}
}

fn main() {
	kinds()
	strings()
	misuse()
	depth()
	full()
	stream()
	in_arena()
}
