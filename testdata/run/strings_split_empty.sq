program

// strings.split and Fields with an empty or small out: nothing to fill gives nothing, not a panic.

use strings

fn main() {
	var none str[0]
	println(len(strings.split("abc", "", none[:])), len(strings.split("a,b", ",", none[:])))
	println(len(strings.fields("a b", none[:])))
	var one str[1]
	r := strings.split("abc", "", one[:])
	println(len(r), r[0])
	var two str[2]
	r = strings.split("abc", "", two[:])
	println(len(r), r[0], r[1])
	r = strings.fields(" x  y z ", two[:])
	println(len(r), r[0], r[1])
}
