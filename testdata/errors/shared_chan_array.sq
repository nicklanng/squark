program

struct Msg {
	id   int
	body str
}

struct Pair {
	in  Msg chan[4]
	out int chan[4]
}

shared good int chan[2][3]
shared bad Msg chan[4][2] // ERROR "shared bad: a shared channel's elements can't hold references (Msg.body is a str)"
shared pairs Pair[2] // ERROR "shared pairs: a shared channel's elements can't hold references (Msg.body is a str)"
shared with_value = int[1]{1}
shared not_data *int[2] // ERROR "shared not_data: *int can't be shared"

fn main() {
	good[0] <- 1
	println(<-good[0], with_value[0])
}
