program

use strings

// A call without a result, a builtin or a package used as a value: these have no type but had
// no error either, so they used to reach C (or pass 0).

struct P { a int }

task t(x int) pool 1 {}

fn f() {}
fn g(x int) {}
fn r() -> int { return f() } // ERROR "f() (no value) used as value"

fn main() {
	var c int chan[1]
	var v int[..2]
	var s int[2]
	g(f()) // ERROR "f() (no value) used as value"
	c <- f() // ERROR "f() (no value) used as value"
	_ = int[]{f()} // ERROR "f() (no value) used as value"
	_ = P{f()} // ERROR "f() (no value) used as value"
	_ = &P{a: f()} // ERROR "f() (no value) used as value"
	v.push(f()) // ERROR "f() (no value) used as value"
	_ = v.try_push(f()) // ERROR "f() (no value) used as value"
	_ = append(s[:0], f()) // ERROR "f() (no value) used as value"
	start t(f()) // ERROR "f() (no value) used as value"
	defer g(f()) // ERROR "f() (no value) used as value"
	select {
	case c <- f(): // ERROR "f() (no value) used as value"
	default:
	}
	s = int[2]{f(), 1} // ERROR "f() (no value) used as value"
	x := f() // ERROR "f() (no value) used as value"
	var y int = f() // ERROR "f() (no value) used as value"
	_, _ = x, y
	g(len)       // ERROR "len (built-in function) must be called"
	g(strings)   // ERROR "use of package strings without selector"
	g(println)   // ERROR "println (built-in function) must be called"
}
