program

// map and channel storage inside a struct or array points into itself once used, so copying the
// struct or array out of a variable would alias it
struct Reg {
	n int
	m int[int; 4]
}

struct Pipe { c int chan[2] }

fn take(r Reg) {}

fn mk() -> Reg {
	var a Reg
	a.m[1] = 111
	return a // ERROR "cannot copy a: Reg contains int[int; 4] storage"
}

fn fresh() -> Reg { return Reg{n: 1} }

fn main() {
	var a Reg
	b := a        // ERROR "cannot copy a into b: Reg contains"
	var c = a     // ERROR "cannot copy a into c: Reg contains"
	take(a)       // ERROR "cannot copy a: Reg contains"
	var d Reg
	d = a         // ERROR "cannot copy a: Reg contains"
	p := &a
	e := *p       // ERROR "cannot copy *p into e: Reg contains"

	var arr int[int; 4][2]
	arr2 := arr   // ERROR "cannot copy arr into arr2: int[int; 4][2] contains int[int; 4] storage"
	var pipes Pipe[2]
	for q in pipes { // ERROR "cannot copy elements of pipes into q: Pipe contains int chan[2] storage"
		_ = q
	}

	// fine: pointers, fresh values, index-only ranges
	f := Reg{n: 2}
	g := fresh()
	take(Reg{})
	q := &a
	for i, _ in pipes {
		pipes[i].c <- i
	}
	println(b.n, c.n, d.n, e.n, len(arr2), f.n, g.n, q.n)
}
