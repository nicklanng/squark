program

// Every way of copying map or channel storage that is in use is rejected (L2 covered `=`, `:=`
// and arguments; these are the rest).
struct R {
	m int[int
	4]
}

impl R {
	fn put(self, k, v int) { self.m[k] = v }

	fn put_p(&self, k, v int) { self.m[k] = v }
}

Store: int[str; 8]

impl Store {
	fn add(self, k str) { self[k] = 1 }
}

fn fill(dst R[]) {
	var a R[1]
	a[0].m[1] = 111
	copy(dst, a[:])          // ERROR "cannot copy the elements of a[:]"
	_ = append(dst[:0], a[:]...) // ERROR "cannot copy the elements of a[:]"
}

fn vec(v *(int[int; 4][..2])) {
	var a int[int; 4][1]
	v.append(a[:]) // ERROR "cannot copy the elements of a[:]: each is int[int; 4] storage"
}

fn grow(s R[], x R) -> R[] {
	with arena a 1K {
		_ = append(s, R{}) in a // ERROR "cannot copy the elements of s"
	}
	return s
}

fn fresh() -> (R, int) { return R{}, 1 } // a fresh value, built by a literal: fine

fn main() {
	var r R
	r.put(1, 2)  // ERROR "cannot call put on a copy of r"
	R{}.put(1, 2) // a fresh value: fine
	r.put_p(1, 2)
	var st Store
	st.add("a") // ERROR "cannot call add on a copy of st"
	var b R[1]
	fill(b[:])
	_, _ = fresh()
}
