program

struct Msg {
	id   int
	body str
}

struct Job {
	id    int
	sizes int[4]
}

shared names str chan[4] // ERROR "shared names: a shared channel's elements can't hold references (str)"
shared msgs Msg chan[4] // ERROR "a shared channel's elements can't hold references"
shared jobs Job chan[4] // fine: no references
shared errs error chan[1] // fine: error messages are constants

fn main() {
	jobs <- Job{id: 1}
	println((<-jobs).id, len(errs))
}
