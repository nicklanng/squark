program

struct T {
	a int
}

impl T {
	fn m(&self) {}
}

fn f(s str, n int) {
	_ = s + "!" // ERROR "string concatenation needs memory: allocate it in an arena"
	_ = make(int[], n) // ERROR "make needs an arena (make(...) in a); otherwise declare an array"
	_ = new(T) // ERROR "new(T) needs memory: allocate it in an arena"
	_ = u8[](s) // ERROR "converting s to u8[] copies it"
	var t T
	m := t.m // ERROR "method values are not supported"
	_ = m
}

fn main() {
	f("x", 1)
}
