program

struct Board {
	cells int[3]
	hist  int[..4]
}

struct T {
	p int[3]
}

impl T {
	fn bump(&self) { self.p[0]++ }
}

shared t = T{}

const c = T{}

fn main() {
	var a, b Board
	println(a == b) // ERROR "Board cannot be compared: Board.hist is a vector"
	s := t.p[:] // ERROR "cannot slice t.p (t is a shared var, read-only after initialization; copy it into a variable first)"
	t.bump() // ERROR "cannot call pointer method bump on t (t is a shared var, read-only after initialization)"
	u := c.p[:] // ERROR "cannot slice c.p (c is a constant; copy it into a variable first)"
	_, _ = s, u
}
