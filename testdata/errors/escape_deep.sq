program

// A linked list is deeper than the analysis tracks (4 pointer levels): the levels past the last
// share its region, so a local stored 3 links down still can't reach a static node.
struct Node {
	next *Node
	val  *int
}

thread tail Node

impl Node {
	fn set_third(&self, p *int) { self.next.next.next.val = p }
}

fn f() {
	x := 1234
	var b, a, n Node
	b.next = &tail // ERROR "cannot escape into static memory"
	a.next = &b
	n.next = &a
	n.set_third(&x)
}

fn main() { f() }
