program

fn two() -> (int, int) { return 1, 2 }

fn main() {
	var x int = "hello" // ERROR "cannot use \"hello\""
	var y u8 = 300 // ERROR "constant 300 overflows u8"
	a := two() // ERROR "assignment mismatch: 1 variable but two() returns 2 values"
	z := undefined_thing // ERROR "undefined: undefined_thing"
	m := int[str]{"a": 1} // ERROR "map literals are not supported"
	_, _, _, _, _ = x, y, a, z, m
}
