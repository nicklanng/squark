program

// ! and `in a` around a call with several results: every result is checked, not just the first
thread g *int

fn two(a *int) -> (*int, *int) ! { return a, a, nil }

fn pair(a *int) -> (int, *int) { return 1, a }

fn three(a *int) -> (int, *int, error) ! { return 1, a, nil, nil }

arena pa 1K

fn via_try_decl() -> ! {
	x := 1
	var p, q = two(&x)!
	_ = p
	g = q // ERROR "cannot escape into static memory"
	return nil
}

fn via_in() {
	x := 1
	_, q := pair(&x) in pa
	g = q // ERROR "cannot escape into static memory"
}

fn via_try_return() -> (int, *int) ! {
	x := 1
	return three(&x)! // ERROR "cannot return reference to variable x"
}

fn main() {
	_ = via_try_decl()
	via_in()
	_, _, _ = via_try_return()
}
