package main

// try and `in a` around a call with several results: every result is checked, not just the first
var g *int

func two(a *int) (*int, *int, error) { return a, a, nil }

func pair(a *int) (int, *int) { return 1, a }

func three(a *int) (int, *int, error, error) { return 1, a, nil, nil }

arena pa 1K

func viaTryDecl() error {
	x := 1
	var p, q = try two(&x)
	_ = p
	g = q // ERROR "cannot escape into static memory"
	return nil
}

func viaIn() {
	x := 1
	_, q := pair(&x) in pa
	g = q // ERROR "cannot escape into static memory"
}

func viaTryReturn() (int, *int, error) {
	x := 1
	return try three(&x) // ERROR "cannot return reference to variable x"
}

func main() {
	_ = viaTryDecl()
	viaIn()
	_, _, _ = viaTryReturn()
}
