program

thread global int[str; 8]

fn get() -> int[..4] {
	var v int[..4]
	return v
}

fn main() {
	var m int[str; 8]
	m2 := m // ERROR "cannot copy int[str; 8] storage into m2"
	var view int[str] = m
	_ = view
	s := make(u8[], 16) // ERROR "make needs an arena"
	ch := make(int chan, 4) // ERROR "make needs an arena (make(...) in a); otherwise declare storage at package level: thread ch int chan[N]"
	get().push(1) // ERROR "cannot call push on get() (not addressable)"
	_, _, _ = m2, s, ch
}
