program

thread seen int[str; 16]

// m[k]++ and m[k] op= v insert k just like m[k] = v does
fn count(m int[str], w str) { m[w]++ }
fn add(m int[str], w str) { m[w] += 10 }

fn main() {
	var b1, b2, b3, b4 u8[8]
	seen[str(b1[:])]++     // ERROR "cannot escape into static memory (used as a key in seen)"
	seen[str(b2[:])] += 10 // ERROR "cannot escape into static memory (used as a key in seen)"
	count(seen, str(b3[:])) // ERROR "cannot escape into static memory (count stores argument 2 inside argument 1)"
	add(seen, str(b4[:]))   // ERROR "cannot escape into static memory (add stores argument 2 inside argument 1)"

	// fine: static keys, or a local map with a local key
	seen["hello"]++
	count(seen, "hello")
	var buf u8[8]
	w := str(buf[:])
	var local int[str; 4]
	local[w]++
	local[w] += 2
	count(local, w)
	println(len(seen), len(local))
}
