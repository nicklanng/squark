// a vector type's built-in methods take these names: a user method would never be called
Stack: int[..3]

impl Stack {
	fn push(&self, x int) {} // ERROR "method Stack.push would be hidden by the vector method push"

	fn clear(&self) {} // ERROR "method Stack.clear would be hidden by the vector method clear"

	fn top(&self) -> int { return self[len(self)-1] }
}

fn main() {}
