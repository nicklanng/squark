program

const two = 2

fn main() {
	x := 2
	switch x {
	case 1, two:
	case 2: // ERROR "duplicate case 2 in expression switch"
	case 3, 1+2: // ERROR "duplicate case 1 + 2 in expression switch"
	}
	switch s := "a"; s {
	case "a":
	case "b", "a": // ERROR "duplicate case \"a\" in expression switch"
	}
l:
	for i in 0..3 {
		_ = i
		break l
	}
l: // ERROR "label l already defined"
	loop {
		break l
	}
}
