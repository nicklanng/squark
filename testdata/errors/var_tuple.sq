package main

func f() (int, int)     { return 4096, 8192 }
func g() (*int, string) { return nil, "" }

func main() {
	var p, q *int = f() // ERROR "cannot assign int to p (type *int)" // ERROR "cannot assign int to q (type *int)"
	var s, t string = g() // ERROR "cannot assign *int to s (type string)"
	var a, b int = f()
	println(p, q, s, t, a, b)
}
