program

// strings from a decoder's arena (Text, Key) and an Encoder's output live as long as the arena
// and the data: request-scoped variables may keep them, package variables may not

use json

thread last_title str
thread last_key str
thread last_out u8[]
thread static u8[64] // even with static data, Text's result is in the arena

arena interned 1K

struct Req {
	title str
	tags  str[..4]
}

// handle is shaped like an HTTP handler (body and a are the request's body and arena): req lives
// as long as the request, so it may keep what Text returns
fn handle(body u8[], a arena, req *Req) -> u8[] {
	d := json.new_decoder_in(body, a)
	d.begin_object()
	d.key()
	title, ok := d.text()
	if ok {
		req.title = title
		req.tags.try_push(title)
	}
	e := json.new_encoder_in(nil, a)
	e.string(title)
	return e.bytes()
}

fn main() {
	var body u8[64]
	var outer str
	with arena a 1K {
		var req Req
		out := handle(body[:], a, &req)
		_ = out
		last_out = handle(body[:], a, &req) // ERROR "cannot escape into static memory (assigned to last_out)"

		d := json.new_decoder_in(body[:], a)
		d.begin_object()
		key, _ := d.key()
		last_key = key // ERROR "cannot escape into static memory (assigned to last_key)"
		title, _ := d.text()
		req.title = title
	}

	with arena b 1K {
		d := json.new_decoder_in(static[:], b)
		title, _ := d.text()
		last_title = title // ERROR "cannot escape into static memory (assigned to last_title)"
	}
	with arena c 1K {
		d := json.new_decoder_in(body[:], c)
		title, _ := d.text()
		outer = title // ERROR "does not live long enough to be stored in variable outer"
	}
	_ = outer
	with arena e 1K {
		enc := json.new_encoder_in(nil, e)
		enc.string("x")
		last_out = enc.bytes() // ERROR "cannot escape into static memory (assigned to last_out)"
	}

	// fine: the data and the arena are both static
	d := json.new_decoder_in(static[:], interned)
	t, _ := d.text()
	last_title = t
}
