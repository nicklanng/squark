program

struct Node {
	name str
	next *Node
}

thread head *Node
thread keep u8[]

fn set_head(n *Node) { head = n }

fn link(a, b *Node) { a.next = b }

fn main() {
	var n Node
	set_head(&n) // ERROR "cannot escape into static memory (set_head keeps argument 1 in static memory)"

	var buf u8[8]
	keep = buf[:] // ERROR "cannot escape into static memory (assigned to keep)"

	var outer Node
	{
		var inner Node
		link(&outer, &inner) // ERROR "does not live long enough to be stored in variable outer (declared at main.sq:22) (link stores argument 2 inside argument 1)"
	}

	var p *Node
	{
		var q Node
		p = &q // ERROR "does not live long enough to be stored in variable p"
	}
	_ = p

	// fine: same scope, or static data
	var a, b Node
	link(&a, &b)
	set_head(head)
	keep = keep[:0]
}
