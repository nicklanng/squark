program

struct Node { next *Node }

// one missing `into` is reported once, not with its consequences
fn attach3(a *Node, b *Node) -> *Node in a { // ERROR "stores b inside a, but its signature does not say so"
	a.next = b
	return a
}

// independent problems are all reported
fn both(a *Node, b *Node, c *Node) -> *Node in a { // ERROR "stores b inside a" // ERROR "returns a reference into c"
	a.next = b
	return c
}

fn main() {
	var x, y, z Node
	attach3(&x, &y)
	both(&x, &y, &z)
}
