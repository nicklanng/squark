program

struct Node { next *Node }

thread keep str

// honest contracts
fn prefix(b u8[]) -> u8[] in b { return b[:1] }
fn link(a *Node, b *Node in a) { a.next = b }
fn remember(s str in static) { keep = s }
fn name() -> str in static { return "squark" }

// contracts that leave out what the body does
fn first(a, b u8[]) -> u8[] in a { // ERROR "main.first returns a reference into b, but its signature does not say so: add `in b` after the results"
	if len(a) > 0 {
		return a
	}
	return b
}

fn attach(a *Node, b *Node) { a.next = b }

fn attach3(a *Node, b *Node) -> *Node in a { // ERROR "main.attach3 stores b inside a, but its signature does not say so: declare the parameter as `b T in a`"
	a.next = b
	return a
}

fn main() {
	var buf u8[4]
	_ = prefix(buf[:])
	var x, y Node
	link(&x, &y)
	remember("ok")
	_ = name()
	_ = first(buf[:], buf[:])
	attach(&x, &y)
	_ = attach3(&x, &y)
}
