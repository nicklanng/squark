program

fn main() {
	const u u8 = 1
	v := u << 8 // ERROR "constant 256 overflows"
	n := 3
	var f f64 = 1 << n // ERROR "shifted operand 1 (type f64) must be integer"
	var b u8 = 300 << n // ERROR "constant 300 overflows"
	println(v, f, b)
}

fn float_shift(s uint) -> f64 {
	return f64(1 << s) // ERROR "shifted operand 1 (type f64) must be integer"
}
