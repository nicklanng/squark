program

// With deferred calls every return goes through the named results, and a deferred call can
// point one at a local after the return statement ran.
thread g int = 5

fn set(pp **int, q *int) { *pp = q }

fn f() -> (res *int) { // ERROR "cannot return reference to variable local"
	var local int = 1234
	defer set(&res, &local)
	return &g
}

// without a defer the named result is just a variable
fn h() -> (res *int) {
	var local int = 1
	res = &local
	return &g
}

fn main() {
	_ = f()
	_ = h()
}
