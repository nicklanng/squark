program

fn leak_int() -> *int {
	x := 42
	return &x // ERROR "cannot return reference to variable x"
}

fn leak_slice() -> u8[] {
	var buf u8[64]
	return buf[:] // ERROR "cannot return reference to variable buf"
}

fn leak_literal() -> *Point {
	return &Point{1, 2} // ERROR "cannot return reference to a temporary"
}

fn leak_vec() -> int[] {
	var v int[..8]
	v.push(1)
	return v[:] // ERROR "cannot return reference to variable v"
}

fn leak_variadic(xs ...int) -> int[] {
	return xs
}

fn call_variadic() -> int[] {
	return leak_variadic(1, 2, 3) // ERROR "cannot return reference to the variadic argument list"
}

struct Point { x, y int }

// returning views of parameters is fine
fn prefix(b u8[]) -> u8[] { return b[:2] }
fn field(p *Point) -> *int    { return &p.x }

fn main() {
	var b u8[4]
	_ = prefix(b[:])
	var p Point
	_ = field(&p)
}
