program

use errors

// Error messages and shared vars must be constant data: package variables can change (and with
// threads N each thread changes its own), so neither may view one.
thread buf u8[8]

thread greeting = "hello" // a variable: it could be reassigned to view buf

const hello = "hello"

fn name() -> str {
	n := copy(buf[:], "hello")
	return str(buf[:n])
}

fn pass(s str) -> str { return s }

shared s1 = name() // ERROR "cannot be used as constant data (stored in shared var s1"

shared s2 = hello

shared s3 = pass("literal")

fn via_error() -> ! {
	return error(1, name()) // ERROR "cannot be used as constant data (used as an error message"
}

fn via_var() -> ! {
	return error(2, greeting) // ERROR "cannot be used as constant data"
}

fn via_new() -> ! {
	return errors.new(str(buf[:3])) // ERROR "cannot be used as constant data (errors.new uses argument 1 as constant data)"
}

fn fine(err error) -> ! {
	_ = errors.new(hello)
	_ = error(3, pass("x"))
	_ = error(4, s2) // shared vars are constant after initialization
	return error(5, err.message())
}

fn main() {
	_ = via_error()
	_ = via_var()
	_ = via_new()
	_ = fine(nil)
	println(s1, s2, s3)
}

// a string copied into a package arena is constant data: the arena is never freed
arena names 1K

fn copied() -> str {
	n := copy(buf[:], "hello")
	return str(buf[:n]) in names
}

shared s4 = copied()

fn via_arena() -> ! { return error(6, copied()) }

// constant data can be stored in a package variable (which is then ordinary static memory)
thread last str

fn save(err error) { last = err.message() }
