program

// Test program for TestDetach (internal/driver): C code that runs long moves its goroutine to a
// helper thread mid-call (sq_detach) and back (sq_reattach); meanwhile a ticker on the same thread
// keeps running, and two such calls overlap. No blocking externs: the driver starts helper threads
// because the C code uses sq_detach.

use time

extern fn crunch(ms int) -> int stack 16K

thread ticks int
thread done int chan[4]

task ticker() pool 1 {
	while len(done) < 2 {
		time.sleep(5 * time.millisecond)
		ticks++
	}
}

task worker() pool 2 {
	done <- crunch(200)
}

fn main() {
	start := time.now()
	start ticker()
	start worker()
	start worker()
	moved := <-done + <-done
	ms := time.since(start).milliseconds()
	println("moved and back:", moved)
	if ms >= 380 {
		println("calls did not overlap:", ms, "ms")
	}
	if ticks < 10 {
		println("the thread was blocked: ticks", ticks)
	}
}
