program

// Blocking externs run on helper threads: while one task waits in a 300ms C call, the others
// on its thread keep running (the ticker ticks), and two slow calls overlap.

use time

extern fn slow_ms(ms int) -> int stack 8K blocking c"slow_ms"
extern fn slow_fill(p *u8, n int, v int) stack 8K blocking c"slow_fill"

thread ticks int
thread done int chan[4]

task ticker() pool 1 {
	for i := 0; i < 1000; i++ {
		time.sleep(10 * time.millisecond)
		ticks++
		if len(done) == 2 {
			return
		}
	}
}

task sleeper(ms int) pool 2 {
	done <- slow_ms(ms)
}

fn main() {
	var buf u8[8]
	slow_fill(&buf[0], len(buf), 7) // arguments point into the task's stack
	println(buf[0], buf[7])

	start := time.now()
	start ticker()
	start sleeper(300)
	start sleeper(300)
	sum := <-done + <-done
	elapsed := time.since(start).milliseconds()
	println(sum)
	if elapsed >= 550 {
		println("slow calls did not overlap:", elapsed, "ms")
	}
	if ticks < 15 {
		println("other tasks were blocked: ticks", ticks)
	}
	println("ok")
}
