program {
	workers 4
}

// Test server for TestWorkers (internal/driver): 4 worker processes on one address. / answers with
// the worker's process id; /crash makes that worker fail.

use http, os, strconv

fn handle(w *http.ResponseWriter, r *http.Request) {
	if r.path == "/crash" {
		os.exit(3)
	}
	var b u8[24]
	w.write(strconv.append_int(b[:0], os.getpid()))
}

fn main() {
	if err := http.listen_and_serve(os.arg(1), handle); err != nil {
		panic(err)
	}
}
