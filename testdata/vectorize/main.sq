// Loops that clang must vectorize. TestVectorize builds this program with clang's
// loop-vectorization remarks and checks that each function marked "want: vectorized" has a
// vectorized loop. The functions are noinline so each loop stays in its own function.
package main

import "os"

var g [64]int32
var pkg []int32
var pkgArr [64]int32

type Buf struct {
	n    int
	data []float32
}

// want: vectorized
//
//squark:noinline
func (b *Buf) add(o *Buf) {
	for i := range b.data {
		b.data[i] += o.data[i]
	}
}

// want: vectorized
//
//squark:noinline
func (b *Buf) scale(k float32) {
	for i := 0; i < len(b.data); i++ {
		b.data[i] *= k
	}
}

// want: vectorized
//
//squark:noinline
func reverse(dst, src []int32) {
	for i := len(src) - 1; i >= 0; i-- {
		dst[len(src)-1-i] = src[i]
	}
}

// want: vectorized
//
//squark:noinline
func sumPkg(n int) int32 {
	var s int32
	for i := 0; i < n; i++ {
		s += pkg[i]
	}
	return s
}

// want: vectorized
//
//squark:noinline
func saxpy(a float32, x []float32, y []float32) {
	for i := range x {
		y[i] += a * x[i]
	}
}

// want: vectorized
//
//squark:noinline
func xorBytes(dst []byte, a []byte, b []byte) {
	for i := range dst {
		dst[i] = a[i] ^ b[i]
	}
}

// want: vectorized
//
//squark:noinline
func dot(a []int32, b []int32) int32 {
	var s int32
	for i := 0; i < len(a); i++ {
		s += a[i] * b[i]
	}
	return s
}

// want: vectorized
//
//squark:noinline
func countByte(b []byte, c byte) int {
	k := 0
	for i := range b {
		if b[i] == c {
			k++
		}
	}
	return k
}

// want: vectorized
//
//squark:noinline
func maxInt32(x []int32) int32 {
	m := x[0]
	for i := 1; i < len(x); i++ {
		if x[i] > m {
			m = x[i]
		}
	}
	return m
}

// want: vectorized
//
//squark:noinline
func addRows(dst []int32, a []int32, b []int32, w int) {
	for r := 0; r < len(dst)/w; r++ {
		base := r * w
		for j := 0; j < w; j++ {
			dst[base+j] = a[base+j] + b[base+j]
		}
	}
}

// want: vectorized
//
//squark:noinline
func brighten(dst []byte, src []byte) {
	for i := range src {
		v := int(src[i]) * 3 / 2
		if v > 255 {
			v = 255
		}
		dst[i] = byte(v)
	}
}

// want: vectorized
//
//squark:noinline
func neighbours(a []int32, b []int32) {
	for i := 1; i < len(a); i++ {
		b[i-1] = a[i] + a[i-1]
	}
}

// want: vectorized
//
//squark:noinline
func inclusive(a []int32, b []int32, n int) {
	for i := 0; i <= n; i++ {
		b[i] = a[i] * 2
	}
}

// want: vectorized
//
//squark:noinline
func viaPointer(dst *[64]int32, a []int32) {
	for i := range 64 {
		dst[i] = a[i] + g[i]
	}
}

// want: vectorized
//
//squark:noinline
func countIn(s string, c byte, n int) int {
	k := 0
	for i := 0; i < n; i++ {
		if s[i] == c {
			k++
		}
	}
	return k
}

// want: vectorized
//
//squark:noinline
func interleave(dst []int32, a []int32, b []int32) {
	for i := range a {
		dst[2*i] = a[i]
		dst[2*i+1] = b[i]
	}
}

// The sizes come from the command line (64 with no arguments) so clang can't specialize the
// functions for constant lengths, which unrolls the loops instead.
func main() {
	n := 64 / os.NArgs()
	var f [64]float32
	var h [64]float32
	var p [64]byte
	var q [64]byte
	var x [64]int32
	var y [64]int32
	saxpy(2, f[:n], h[:n])
	xorBytes(p[:n], p[:n], q[:n])
	addRows(y[:n], x[:n], y[:n], n/8)
	brighten(p[:n], q[:n])
	neighbours(x[:n], y[:n])
	inclusive(x[:n], y[:n], n-1)
	viaPointer(&y, x[:n])
	fb := Buf{0, f[:n]}
	hb := Buf{0, h[:n]}
	fb.add(&hb)
	fb.scale(2)
	reverse(y[:n], x[:n])
	var z [128]int32
	interleave(z[:2*n], x[:n], y[:n])
	pkg = pkgArr[:n]
	println(sumPkg(n), maxInt32(x[:n]), dot(x[:n], y[:n]), countByte(p[:n], 0), countIn(string(q[:n]), 0, n), z[1])
}
