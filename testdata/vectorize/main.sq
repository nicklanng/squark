// Loops that clang must vectorize. TestVectorize builds this program with clang's
// loop-vectorization remarks and checks that each function marked "want: vectorized" has a
// vectorized loop. The functions are noinline so each loop stays in its own function.
program

use os

thread g i32[64]
thread pkg i32[]
thread pkg_arr i32[64]

struct Buf {
	n    int
	data f32[]
}

impl Buf {
	// want: vectorized
	//
	//squark:noinline
	fn add(&self, o *Buf) {
		for i, _ in self.data {
			self.data[i] += o.data[i]
		}
	}

	// want: vectorized
	//
	//squark:noinline
	fn clamp_all(&self) {
		for i, _ in self.data {
			self.data[i] = clamp01(self.data[i]) // a call that can't change self.data
		}
	}

	// want: vectorized
	//
	//squark:noinline
	fn scale(&self, k f32) {
		for i := 0; i < len(self.data); i++ {
			self.data[i] *= k
		}
	}
}

fn clamp01(x f32) -> f32 { return min(max(x, 0), 1) }

// want: vectorized
//
//squark:noinline
fn sum_pkg_scaled(n int) -> i32 {
	var s i32
	for i := 0; i < n; i++ {
		s += twice(pkg[i]) // a call that can't change pkg
	}
	return s
}

fn twice(x i32) -> i32 { return 2 * x }

// want: vectorized
//
//squark:noinline
fn reverse(dst, src i32[]) {
	for i := len(src) - 1; i >= 0; i-- {
		dst[len(src)-1-i] = src[i]
	}
}

// want: vectorized
//
//squark:noinline
fn sum_pkg(n int) -> i32 {
	var s i32
	for i := 0; i < n; i++ {
		s += pkg[i]
	}
	return s
}

// want: vectorized
//
//squark:noinline
fn saxpy(a f32, x f32[], y f32[]) {
	for i, _ in x {
		y[i] += a * x[i]
	}
}

// want: vectorized
//
//squark:noinline
fn xor_bytes(dst u8[], a u8[], b u8[]) {
	for i, _ in dst {
		dst[i] = a[i] ^ b[i]
	}
}

// want: vectorized
//
//squark:noinline
fn dot(a i32[], b i32[]) -> i32 {
	var s i32
	for i := 0; i < len(a); i++ {
		s += a[i] * b[i]
	}
	return s
}

// want: vectorized
//
//squark:noinline
fn count_byte(b u8[], c u8) -> int {
	k := 0
	for i, _ in b {
		if b[i] == c {
			k++
		}
	}
	return k
}

// want: vectorized
//
//squark:noinline
fn max_int32(x i32[]) -> i32 {
	m := x[0]
	for i := 1; i < len(x); i++ {
		if x[i] > m {
			m = x[i]
		}
	}
	return m
}

// want: vectorized
//
//squark:noinline
fn add_rows(dst i32[], a i32[], b i32[], w int) {
	for r := 0; r < len(dst)/w; r++ {
		base := r * w
		for j := 0; j < w; j++ {
			dst[base+j] = a[base+j] + b[base+j]
		}
	}
}

// want: vectorized
//
//squark:noinline
fn brighten(dst u8[], src u8[]) {
	for i, _ in src {
		v := int(src[i]) * 3 / 2
		if v > 255 {
			v = 255
		}
		dst[i] = u8(v)
	}
}

// want: vectorized
//
//squark:noinline
fn neighbours(a i32[], b i32[]) {
	for i := 1; i < len(a); i++ {
		b[i-1] = a[i] + a[i-1]
	}
}

// want: vectorized
//
//squark:noinline
fn inclusive(a i32[], b i32[], n int) {
	for i := 0; i <= n; i++ {
		b[i] = a[i] * 2
	}
}

// want: vectorized
//
//squark:noinline
fn via_pointer(dst *(i32[64]), a i32[]) {
	for i in 0..64 {
		dst[i] = a[i] + g[i]
	}
}

// want: vectorized
//
//squark:noinline
fn count_in(s str, c u8, n int) -> int {
	k := 0
	for i := 0; i < n; i++ {
		if s[i] == c {
			k++
		}
	}
	return k
}

// want: vectorized
//
//squark:noinline
fn interleave(dst i32[], a i32[], b i32[]) {
	for i, _ in a {
		dst[2*i] = a[i]
		dst[2*i+1] = b[i]
	}
}

// want: vectorized
//
//squark:noinline
fn pair_sums(dst, src i32[]) {
	for i := 0; i < len(src)-1; i += 2 {
		dst[i] = src[i] + src[i+1]
		dst[i+1] = src[i] - src[i+1]
	}
}

// want: vectorized
//
//squark:noinline
fn swap_bytes(b u8[]) {
	for i := 0; i < len(b)-1; i += 2 {
		b[i], b[i+1] = b[i+1], b[i]
	}
}

// The sizes come from the command line (64 with no arguments) so clang can't specialize the
// functions for constant lengths, which unrolls the loops instead.
fn main() {
	n := 64 / os.n_args()
	var f f32[64]
	var h f32[64]
	var p u8[64]
	var q u8[64]
	var x i32[64]
	var y i32[64]
	saxpy(2, f[:n], h[:n])
	xor_bytes(p[:n], p[:n], q[:n])
	add_rows(y[:n], x[:n], y[:n], n/8)
	brighten(p[:n], q[:n])
	neighbours(x[:n], y[:n])
	inclusive(x[:n], y[:n], n-1)
	via_pointer(&y, x[:n])
	fb := Buf{0, f[:n]}
	hb := Buf{0, h[:n]}
	fb.add(&hb)
	fb.scale(2)
	fb.clamp_all()
	reverse(y[:n], x[:n])
	var z i32[128]
	interleave(z[:2*n], x[:n], y[:n])
	pair_sums(x[:n], y[:n])
	swap_bytes(p[:n])
	pkg = pkg_arr[:n]
	println(sum_pkg_scaled(n), sum_pkg(n), max_int32(x[:n]), dot(x[:n], y[:n]), count_byte(p[:n], 0), count_in(str(q[:n]), 0, n), z[1])
}
