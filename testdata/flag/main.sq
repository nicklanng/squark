program

// Run by TestFlag with several command lines: it prints the parsed flags and the arguments left.

use flag, time

fn main() {
	port := flag.int_flag("port", 8080, "port to listen on")
	db := flag.str_flag("db", "notes.db", "a `file` to keep the notes in")
	verbose := flag.bool_flag("v", false, "verbose")
	idle := flag.duration_flag("idle", 30*time.second, "close a connection idle\nfor this long")
	name := flag.str_flag("name", "", "who to greet")
	count := flag.int_flag("count", 0, "how many")
	color := flag.bool_flag("color", true, "color the output")
	before := flag.parsed()
	flag.parse()
	var buf u8[32]
	println("port", *port, "db", *db, "v", *verbose, "idle", idle.string(buf[:]))
	println("name", *name, "count", *count, "color", *color)
	println("parsed", before, flag.parsed(), "nflag", flag.n_flag(), "narg", flag.n_arg())
	for i, a in flag.args() {
		println("arg", i, a, flag.arg(i))
	}
	println("out of range:", flag.arg(-1) == "", flag.arg(flag.n_arg()) == "")
}
