program

// A duration too large to add to the clock (time.Duration(math.max_int64)) means "never": it must
// not wrap into the past or stop the thread's other timers. Test program for TestHugeDurations
// (internal/driver), which kills it if it hangs.

use math, net, strconv, time

const forever = time.Duration(math.max_int64)

thread never int chan[1]

task sleeper() pool 1 {
	time.sleep(forever)
	println("sleeper woke")
}

task selecter() pool 1 {
	select {
	case <-never:
		println("received")
	case <-time.after(forever):
		println("select timed out")
	}
}

task waiter(c net.Conn) pool 1 {
	println("readable:", c.wait_readable(forever))
}

fn main() {
	l, err := net.listen("127.0.0.1:0")
	if err != nil {
		panic(err)
	}
	var b u8[32]
	a := str(strconv.append_int(append(b[:0], "127.0.0.1:"...), l.port()))
	c, err := net.dial(a)
	if err != nil {
		panic(err)
	}
	server, err := l.accept()
	if err != nil {
		panic(err)
	}
	_ = c
	start waiter(server)
	start sleeper()
	start selecter()
	start := time.now()
	time.sleep(100 * time.millisecond)
	d := time.since(start)
	println(d >= 100*time.millisecond, d < 5*time.second)
	select {
	case <-never:
	case <-time.after(50 * time.millisecond):
		println("main's select timed out")
	}
}
