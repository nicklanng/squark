package main

// Test program for TestSQLiteThreads (internal/driver): four scheduler threads, each with its own
// connection to one database and eight goroutines sharing it. Every goroutine inserts rows and reads
// each back by its rowid. Writers on four connections find the database locked, so their steps
// wait on helper threads while other goroutines queue for the connection; if two goroutines ever
// interleaved on a connection, a rowid or value would come back wrong.

import (
	"os"
	"runtime"
	"sqlite"
)

threads 4

thread var db sqlite.DB
thread var ins sqlite.Stmt
thread var get sqlite.Stmt

thread var done chan int cap 8  // per thread: each writer's count of wrong reads
shared var results chan int cap 64 // each thread's total, to shard 0

func insert(v int) int {
	defer ins.Reset()
	if err := ins.BindInt(1, v); err != nil {
		panic(err)
	}
	if _, err := ins.Step(); err != nil {
		panic(err)
	}
	return db.LastInsertRowID()
}

func read(id int) int {
	defer get.Reset()
	get.BindInt(1, id)
	row, err := get.Step()
	if err != nil {
		panic(err)
	}
	if !row {
		return -1
	}
	return get.ColumnInt(0)
}

task writer(id int) pool 8 {
	bad := 0
	for i := 0; i < 100; i++ {
		v := runtime.Shard()*1000000 + id*1000 + i
		if read(insert(v)) != v {
			bad++
		}
	}
	done <- bad
}

func main() {
	var err error
	if db, err = sqlite.Open(os.Arg(1)); err != nil {
		panic(err)
	}
	if err := db.Exec("PRAGMA journal_mode=WAL; CREATE TABLE IF NOT EXISTS t(id INTEGER PRIMARY KEY, v INTEGER)"); err != nil {
		panic(err)
	}
	if ins, err = db.Prepare("INSERT INTO t(v) VALUES(?)"); err != nil {
		panic(err)
	}
	if get, err = db.Prepare("SELECT v FROM t WHERE id = ?"); err != nil {
		panic(err)
	}
	for g := 0; g < 8; g++ {
		go writer(g)
	}
	bad := 0
	for g := 0; g < 8; g++ {
		bad += <-done
	}
	results <- bad
	if runtime.Shard() == 0 {
		total := 0
		for s := 0; s < runtime.Shards(); s++ {
			total += <-results
		}
		println("wrong reads:", total)
	}
}
