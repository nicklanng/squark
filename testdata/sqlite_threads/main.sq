program {
	threads 4
}

// Test program for TestSQLiteThreads (internal/driver): four scheduler threads, each with its own
// connection to one database and eight tasks sharing it. Every task inserts rows and reads
// each back by its rowid. Writers on four connections find the database locked, so their steps
// wait on helper threads while other tasks queue for the connection; if two tasks ever
// interleaved on a connection, a rowid or value would come back wrong.

use os, runtime, sqlite

thread db sqlite.DB
thread ins sqlite.Stmt
thread get sqlite.Stmt

thread done int chan[8]  // per thread: each writer's count of wrong reads
shared results int chan[64] // each thread's total, to shard 0

fn insert(v int) -> int {
	defer ins.reset()
	if err := ins.bind_int(1, v); err != nil {
		panic(err)
	}
	if _, err := ins.step(); err != nil {
		panic(err)
	}
	return db.last_insert_row_id()
}

fn read(id int) -> int {
	defer get.reset()
	get.bind_int(1, id)
	row, err := get.step()
	if err != nil {
		panic(err)
	}
	if not row {
		return -1
	}
	return get.column_int(0)
}

task writer(id int) pool 8 {
	bad := 0
	for i := 0; i < 100; i++ {
		v := runtime.shard()*1000000 + id*1000 + i
		if read(insert(v)) != v {
			bad++
		}
	}
	done <- bad
}

fn main() {
	var err error
	if db, err = sqlite.open(os.arg(1)); err != nil {
		panic(err)
	}
	if err := db.exec("PRAGMA journal_mode=WAL; CREATE TABLE IF NOT EXISTS t(id INTEGER PRIMARY KEY, v INTEGER)"); err != nil {
		panic(err)
	}
	if ins, err = db.prepare("INSERT INTO t(v) VALUES(?)"); err != nil {
		panic(err)
	}
	if get, err = db.prepare("SELECT v FROM t WHERE id = ?"); err != nil {
		panic(err)
	}
	for g := 0; g < 8; g++ {
		start writer(g)
	}
	bad := 0
	for g := 0; g < 8; g++ {
		bad += <-done
	}
	results <- bad
	if runtime.shard() == 0 {
		total := 0
		for s := 0; s < runtime.shards(); s++ {
			total += <-results
		}
		println("wrong reads:", total)
	}
}
