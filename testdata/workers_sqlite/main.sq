program {
	workers 4
}

// Test program for TestWorkersSQLite (internal/driver): four workers set up the same new database at
// once (WAL mode, schema) and each insert a row, then exit.

use os, sqlite

fn main() {
	db, err := sqlite.open(os.arg(1))
	if err != nil {
		panic(err)
	}
	if err := db.exec("PRAGMA journal_mode=WAL; CREATE TABLE IF NOT EXISTS seen(pid INTEGER)"); err != nil {
		panic(err)
	}
	st, err := db.prepare("INSERT INTO seen(pid) VALUES(?)")
	if err != nil {
		panic(err)
	}
	st.bind_int(1, os.getpid())
	if _, err := st.step(); err != nil {
		panic(err)
	}
	st.finalize()
	db.close()
}
