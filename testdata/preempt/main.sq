program

// Test program for TestPreempt (internal/driver). A preemptible task spinning in a loop (inside a
// function it calls) lets a ticker on the same thread keep ticking; the same loop in an ordinary
// task can't be interrupted, so the ticker doesn't tick at all while it runs (rule 10).

use runtime, time

thread ticks int
thread done int chan[4]

task ticker() pool 1 {
	loop {
		time.sleep(2 * time.millisecond)
		ticks++
		if len(done) > 0 {
			return
		}
	}
}

// spin runs for ms milliseconds without blocking; a counter keeps the loop from being optimized
fn spin(ms int) -> int {
	start := time.now()
	n := 0
	while time.since(start).milliseconds() < ms {
		n++
	}
	return n
}

task cruncher() pool 1 preemptible {
	spin(200)
	done <- 1
}

task hog() pool 1 {
	before := ticks
	spin(150)
	done <- ticks - before
}

task yielder() pool 1 {
	before := ticks
	start := time.now()
	while time.since(start).milliseconds() < 100 {
		runtime.gosched()
	}
	done <- ticks - before
}

fn main() {
	start ticker()
	time.sleep(10 * time.millisecond)

	before := ticks
	start cruncher()
	<-done
	println("preemptible: ticker kept running", ticks-before >= 5)

	start hog()
	println("ordinary task: ticks while it ran", <-done)

	start yielder()
	println("Gosched: ticker kept running", <-done >= 10)
	done <- 0 // stop the ticker
}
