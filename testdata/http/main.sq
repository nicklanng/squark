program

// Test server for TestHTTP (internal/driver): /n?n=N writes N bytes in one Write, /p?n=N writes
// them 1000 bytes at a time. Byte i is 'a'+i%26, so the client can check every byte. /who answers
// "one". With a second address argument, a second server answers "two" to everything.

use http, os, strconv

thread body u8[100000]

fn handle(w *http.ResponseWriter, r *http.Request) {
	if r.path == "/who" {
		w.write_string("one")
		return
	}
	n, err := strconv.atoi(r.query_value("n"))
	if err != nil or n < 0 or n > len(body) {
		w.write_header(400)
		return
	}
	if r.path == "/p" {
		for i := 0; i < n; i += 1000 {
			w.write(body[i:min(i+1000, n)])
		}
		return
	}
	w.write(body[:n])
}

fn handle2(w *http.ResponseWriter, r *http.Request) { w.write_string("two") }

task serve2(addr str) pool 1 {
	if err := http.listen_and_serve(addr, handle2); err != nil {
		panic(err)
	}
}

fn main() {
	for i in 0..len(body) {
		body[i] = u8('a' + i%26)
	}
	if os.n_args() > 2 {
		start serve2(os.arg(2))
	}
	if err := http.listen_and_serve(os.arg(1), handle); err != nil {
		panic(err)
	}
}
