program {
	threads auto
}

// The note `squark check` prints with threads: package variables each thread has its own copy of,
// that the program changes. TestPerThreadNote checks which are listed.

use runtime, strings, ./counter

struct Stats {
	hits int
}

impl Stats {
	fn bump(&self) { self.hits++ }
}

thread stats Stats             // listed: changed by a pointer method
thread jobs int chan[4]     // listed: sent on
thread seen int[int; 8]  // listed: passed to fill, which changes it
thread cell int                // listed: address taken
thread buf u8[16]            // listed: sliced
thread limit = 10              // not listed: only read
thread thread int              // not listed: only read (and `thread` is still an identifier)
thread mine int         // not listed: per thread on purpose
shared all int chan[4] // not listed: one channel for every thread

thread vec int[..4]             // listed: sliced, so written through the slice
thread aliased int[int; 4] // listed: a view of it is declared with var

fn fill(m int[int]) { m[1] = 1 }

fn fill_all(s int[]) {
	for i, _ in s {
		s[i] = 1
	}
}

fn set(p *int) { *p = 1 }

fn main() {
	stats.bump()
	fill(seen)
	set(&cell)
	b := buf[:]
	b[0] = 'x'
	mine++
	fill_all(vec[:])
	var view int[int] = aliased
	view[2] = 2
	counter.add(limit + thread)
	if runtime.shard() == 0 {
		jobs <- 1
		close(jobs)
		for j in jobs {
			all <- j
		}
		println(<-all, strings.contains("abc", "b"))
	}
}
