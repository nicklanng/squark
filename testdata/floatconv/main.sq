program

// Test program for TestFloatConversions (internal/driver): for each input line "<bits> <text>",
// prints the shortest form of the float64 with those bits, and the bits ParseFloat gives for text.

use bufio, io, math, os, strconv, strings

fn parse_uint(s str) -> u64 {
	var v u64
	for i := 0; i < len(s); i++ {
		v = v*10 + u64(s[i]-'0')
	}
	return v
}

fn main() {
	var store u8[256]
	r := bufio.new_reader(store[:])
	var out u8[128]
	w := os.stdout
	loop {
		line, err := r.read_line(os.stdin)
		if err == io.EOF {
			return
		}
		bits_text, text, _ := strings.cut(line, " ")
		v := math.float64frombits(parse_uint(bits_text))
		o := strconv.append_float(out[:0], v, -1)
		o = append(o, ' ')
		f, perr := strconv.parse_float(text)
		if perr != nil and perr != strconv.Range {
			o = append(o, "error"...)
		} else {
			o = strconv.append_uint(o, math.float64bits(f))
		}
		o = append(o, '\n')
		w.write(o)
	}
}
