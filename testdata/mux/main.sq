program

// Test server for TestMux (internal/driver): patterns registered with http.handle_func, served by
// ListenAndServe(addr, nil). Each handler answers with what it saw, so the test can check which
// pattern won and what its wildcards held.

use http, os, strconv

fn health(w *http.ResponseWriter, r *http.Request) { w.text(200, "ok") }

fn list_notes(w *http.ResponseWriter, r *http.Request) { w.text(200, "list") }

fn create_note(w *http.ResponseWriter, r *http.Request) { w.text(201, "create") }

fn get_note(w *http.ResponseWriter, r *http.Request) {
	id, ok := r.path_int("id")
	if not ok {
		http.send_error(w, 404)
		return
	}
	w.text(200, "note ")
	w.write_int(id)
}

fn delete_note(w *http.ResponseWriter, r *http.Request) {
	w.text(200, "delete ")
	w.write_string(r.path_value("id"))
}

fn static(w *http.ResponseWriter, r *http.Request) {
	w.text(200, "static ")
	w.write_string(r.path)
}

fn file(w *http.ResponseWriter, r *http.Request) {
	w.text(200, "file ")
	w.write_string(r.path_value("path"))
}

fn root(w *http.ResponseWriter, r *http.Request) { w.text(200, "root") }

fn user_post(w *http.ResponseWriter, r *http.Request) {
	w.text(200, "user ")
	w.write_string(r.path_value("name"))
	w.write_string(" post ")
	w.write_string(r.path_value("pid"))
}

fn admin_post(w *http.ResponseWriter, r *http.Request) {
	w.text(200, "admin post ")
	w.write_string(r.path_value("pid"))
}

fn query(w *http.ResponseWriter, r *http.Request) {
	n, ok := r.query_int("n")
	w.text(200, r.query_param("name"))
	w.write_byte(' ')
	if ok {
		w.write_int(n)
	} else {
		w.write_string("none")
	}
}

fn enc(w *http.ResponseWriter, r *http.Request) { w.text(200, r.path_value("v")) }

fn any_method(w *http.ResponseWriter, r *http.Request) {
	w.text(200, "any ")
	w.write_string(r.method)
}

thread long u8[600]

fn doc(w *http.ResponseWriter, r *http.Request) {
	w.write_header(201)
	j := w.json()
	j.object()
	j.key("id")
	j.int(7)
	j.key("name")
	j.string("quote \" and \\ and \n")
	j.key("long")
	j.string(str(long[:]))
	j.key("list")
	j.array()
	for i in 0..3 {
		j.object()
		j.key("i")
		j.int(i)
		j.key("half")
		j.float(f64(i) / 2)
		j.end()
	}
	j.end()
	j.key("ok")
	j.bool(true)
	j.key("none")
	j.null()
	j.key("raw")
	j.raw(u8[](`{"a":[1,2]}`) in r.arena)
	j.end()
	if err := j.finish(); err != nil {
		panic(err)
	}
}

thread huge u8[3000]

// big is larger than the write buffer several times over: the encoder's buffer-full retry, and
// strings and Raw values long enough to go to the response directly.
fn big(w *http.ResponseWriter, r *http.Request) {
	j := w.json()
	j.array()
	for i in 0..3000 {
		j.object()
		j.key("i")
		j.int(i)
		j.key("s")
		j.string(str(long[:i%len(long)]))
		j.end()
	}
	j.string(str(huge[:]))
	raw := make(u8[], 0, 2200) in r.arena
	raw = append(raw, '[')
	for i in 0..700 {
		if i > 0 {
			raw = append(raw, ',')
		}
		raw = append(raw, '1', '2')
	}
	raw = append(raw, ']')
	j.raw(raw)
	j.end()
	if err := j.finish(); err != nil {
		panic(err)
	}
}

fn misuse(w *http.ResponseWriter, r *http.Request) {
	j := w.json()
	j.object()
	j.int(1) // no key
	if err := j.finish(); err != nil {
		w.write_string(" ")
		w.write_string(err.message())
	}
}

fn main() {
	for i in 0..len(long) {
		long[i] = 'a' + u8(i%26)
	}
	for i in 0..len(huge) {
		huge[i] = 'A' + u8(i%26)
	}
	http.handle_func("GET /big", big)
	http.handle_func("GET /doc", doc)
	http.handle_func("GET /misuse", misuse)
	http.handle_func("GET /health", health)
	http.handle_func("GET /notes", list_notes)
	http.handle_func("POST /notes", create_note)
	http.handle_func("GET /notes/{id}", get_note)
	http.handle_func("DELETE /notes/{id}", delete_note)
	http.handle_func("/static/", static)
	http.handle_func("GET /files/{path...}", file)
	http.handle_func("GET /{$}", root)
	http.handle_func("GET /users/{name}/posts/{pid}", user_post)
	http.handle_func("GET /users/admin/posts/{pid}", admin_post)
	http.handle_func("GET /q", query)
	http.handle_func("GET /enc/{v}", enc)
	http.handle_func("/any", any_method)
	port, _ := strconv.atoi(os.arg(1))
	if err := http.listen_and_serve(http.port(port), nil); err != nil {
		panic(err)
	}
}
