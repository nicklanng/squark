// hello: a first squark program.
//
//	squark run examples/hello
//
// It shows:
//   - structs, pointer-receiver methods and variadic functions, as in Go
//   - a vector ([..16]int): fixed storage with a length, filled with Push and viewed as a slice
//   - a map with a declared capacity, ready to use without make
//   - range over a string, which yields runes
package main

import "os"

type Point struct {
	X, Y int
}

func (p *Point) Move(dx, dy int) {
	p.X += dx
	p.Y += dy
}

func sum(xs ...int) int {
	total := 0
	for _, x := range xs {
		total += x
	}
	return total
}

func main() {
	println("hello, squark")
	p := Point{X: 1, Y: 2}
	p.Move(3, 4)
	println("point:", p.X, p.Y)

	// a vector holds its 16 elements inline, here on main's stack: no allocation
	var squares [..16]int
	for i := range 10 {
		squares.Push(i * i)
	}
	println("len", len(squares), "cap", cap(squares), "sum", sum(squares[:]...), sum(1, 2, 3))

	// declaring the map is the allocation: room for 8 entries
	var m map[string]int cap 8
	m["a"] = 1
	m["b"] += 41
	v, ok := m["b"]
	println("map", len(m), v, ok)

	for i, r := range "héllo" {
		print(i, ":", r, " ")
	}
	println()
	os.Stdout.WriteString("written via os\n")
}
