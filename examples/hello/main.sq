// hello: a first squark program.
//
//	squark run examples/hello
//
// It shows:
//   - structs, pointer-receiver methods and variadic functions
//   - a vector (int[..16]): fixed storage with a length, filled with push and viewed as a slice
//   - a map with a declared capacity, ready to use without make
//   - range over a string, which yields runes
program

use os

struct Point {
	x, y int
}

impl Point {
	fn move(&self, dx, dy int) {
		self.x += dx
		self.y += dy
	}
}

fn sum(xs ...int) -> int {
	total := 0
	for x in xs {
		total += x
	}
	return total
}

fn main() {
	println("hello, squark")
	p := Point{x: 1, y: 2}
	p.move(3, 4)
	println("point:", p.x, p.y)

	// a vector holds its 16 elements inline, here on main's stack: no allocation
	var squares int[..16]
	for i in 0..10 {
		squares.push(i * i)
	}
	println("len", len(squares), "cap", cap(squares), "sum", sum(squares[:]...), sum(1, 2, 3))

	// declaring the map is the allocation: room for 8 entries
	var m int[str; 8]
	m["a"] = 1
	m["b"] += 41
	v, ok := m["b"]
	println("map", len(m), v, ok)

	for i, r in "héllo" {
		print(i, ":", r, " ")
	}
	println()
	os.stdout.write_string("written via os\n")
}
