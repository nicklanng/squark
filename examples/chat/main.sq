// chat is a TCP chat room. A client sends "NICK name", then lines of text, which the room sends
// to everyone as "name: text", with notices when people join and leave. "WHO" lists the room and
// "QUIT" leaves it.
//
// Run: squark run examples/chat :7070, then connect a few times with: nc localhost 7070
// With no arguments it tests itself: scripted clients over real TCP (selftest.sq).
//
// It shows:
//   - a server spread over scheduler threads that share no memory (threads 4)
//   - shared channels between threads, carrying fixed-size values
//   - state owned by one goroutine (the hub's room) instead of locks
//   - a line protocol read with bufio.Reader, with login and idle timeouts
//   - select with time.After, so one stuck relay can't hold up the room
package main

import (
	"bufio"
	"net"
	"os"
	"runtime"
	"sort"
	"strings"
	"time"
)

threads 4

const (
	MaxLine      = 256 // longest line a client may send, without its newline
	MaxNick      = 16
	MaxClients   = 16
	Relays       = 4 // shards that take clients: one shared channel each
	LoginTimeout = 30 * time.Second
	IdleTimeout  = 5 * time.Minute
)

const (
	// sessions (any shard) to the hub (shard 0)
	EvAccept   = iota // Conn is a new client
	EvLine            // client ID said Line
	EvNotice          // tell client ID Line, and only them
	EvLeave           // client ID is gone; Line is the last thing to tell them, if anything
	EvShutdown        // stop once the room is empty
	// the hub to the relay of a client's shard
	DoAttach // Conn is client ID: start its session here
	DoSend   // write Line to client ID
	DoDetach // write Line (if any) to client ID, then close it
)

// Line is text that can cross threads: room for a nick, ": ", a client's line and a newline.
type Line struct {
	N    int
	Text [MaxNick + 2 + MaxLine + 1]byte
}

type Msg struct {
	Kind, ID int
	Conn     net.Conn
	Line     Line
}

type Client struct {
	Used, Joined bool
	Shard        int
	Nick         [MaxNick]byte
	NickLen      int
}

// Hub is the room. It lives on the hub task's stack: no other goroutine can touch it.
type Hub struct {
	room               [MaxClients]Client
	online, shards, rr int
	sent, dropped      int
}

// timedConn is a connection whose reads give up with net.ErrTimeout after d without input.
// bufio.Reader reads from anything with a Read method.
type timedConn struct {
	c net.Conn
	d time.Duration
}

// Threads share no memory, so the room is split by owner: shard 0 runs the hub, which keeps the
// room's state, and each shard runs a relay that owns the sockets of the clients handed to it.
// They talk over shared channels, whose elements can't hold references: text crosses threads in
// a fixed-size Line, and a net.Conn, being only a descriptor, crosses as it is.
shared var toHub chan Msg cap 64
shared var relays [Relays]chan Msg cap 64 // one per relay

// how long a new client has to say something: shared, since sessions run on every thread, so
// it is set before the threads start (the self-test shortens it)
shared var loginTimeout = selfTestTimeout(LoginTimeout)

thread var relayDone chan bool cap 1

// ---- lines ----

func (l *Line) String() string { return string(l.Text[:l.N]) }

func (l *Line) Set(parts ...string) {
	l.N = 0
	l.Add(parts...)
}

// Add appends the parts to l, keeping the last byte free for the newline.
func (l *Line) Add(parts ...string) {
	for _, s := range parts {
		l.N += copy(l.Text[l.N:len(l.Text)-1], s)
	}
}

func (t timedConn) Read(p []byte) (int, error) { return t.c.ReadTimeout(p, t.d) }

// ---- clients' shards: sessions and relays ----

// session reads one client's lines and passes them to the hub; its relay does the writing.
task session(c net.Conn, id int) pool MaxClients {
	var buf [MaxLine]byte
	r := bufio.NewReader(buf[:])
	src := timedConn{c, loginTimeout}
	m := Msg{ID: id}
	for m.Kind != EvLeave {
		text, err := r.ReadLine(src)
		src.d = IdleTimeout
		m.Kind = EvLeave
		switch {
		case err == bufio.ErrTooLong:
			m.Kind = EvNotice
			m.Line.Set("ERR line too long")
		case err == net.ErrTimeout:
			m.Line.Set("ERR timed out")
		case err != nil:
			m.Line.Set("") // hung up
		case text == "QUIT":
			m.Line.Set("BYE")
		default:
			m.Kind = EvLine
			m.Line.Set(text)
		}
		toHub <- m
	} // the relay closes c once the hub has seen the client leave
}

// relay owns its shard's client sockets: it starts their sessions and writes to them.
task relay(shard int) pool 1 {
	var conns [MaxClients]net.Conn
	for m := range relays[shard] {
		c := &conns[m.ID]
		if m.Kind == DoAttach {
			*c = m.Conn
			go session(m.Conn, m.ID)
			continue
		}
		if m.Line.N > 0 {
			m.Line.Text[m.Line.N] = '\n'
			c.Write(m.Line.Text[:m.Line.N+1])
		}
		if m.Kind == DoDetach {
			c.Close()
		}
	}
	relayDone <- true
}

// ---- the hub (shard 0) ----

func (c *Client) nick() string { return string(c.Nick[:c.NickLen]) }

func (h *Hub) send(kind, id int, line *Line) {
	select {
	case relays[h.room[id].Shard] <- Msg{Kind: kind, ID: id, Line: *line}:
		h.sent++
	case <-time.After(time.Second):
		h.dropped++ // that relay is stuck: don't let it hold up the whole room
	}
}

func (h *Hub) broadcast(line *Line) {
	for i := range h.room {
		if h.room[i].Joined {
			h.send(DoSend, i, line)
		}
	}
}

func (h *Hub) accept(c net.Conn) {
	for i := range h.room {
		if !h.room[i].Used {
			h.room[i] = Client{Used: true, Shard: h.rr % h.shards} // spread clients over relays
			h.rr++
			h.online++
			relays[h.room[i].Shard] <- Msg{Kind: DoAttach, ID: i, Conn: c}
			return
		}
	}
	c.WriteString("ERR room full\n")
	c.Close()
}

func (h *Hub) said(id int, text string) {
	c := &h.room[id]
	var out Line
	if nick, ok := strings.CutPrefix(text, "NICK "); ok {
		taken := false
		for i := range h.room {
			taken = taken || h.room[i].Joined && h.room[i].nick() == nick
		}
		switch {
		case c.Joined:
			out.Set("ERR you already have a nick")
		case nick == "" || len(nick) > MaxNick || strings.IndexByte(nick, ' ') >= 0:
			out.Set("ERR bad nick")
		case taken:
			out.Set("ERR nick in use")
		default:
			c.NickLen = copy(c.Nick[:], nick)
			c.Joined = true
			out.Set("* ", nick, " joined")
			h.broadcast(&out)
			return
		}
	} else if !c.Joined {
		out.Set("ERR say NICK name first")
	} else if text == "WHO" {
		var names [..MaxClients]string
		for i := range h.room {
			if h.room[i].Joined {
				names.Push(h.room[i].nick())
			}
		}
		sort.Strings(names[:])
		out.Set("users:")
		for _, name := range names {
			out.Add(" ", name)
		}
	} else {
		out.Set(c.nick(), ": ", text)
		h.broadcast(&out)
		return
	}
	h.send(DoSend, id, &out)
}

func (h *Hub) leave(id int, last *Line) {
	c := &h.room[id]
	h.send(DoDetach, id, last)
	if c.Joined {
		c.Joined = false
		var out Line
		out.Set("* ", c.nick(), " left")
		h.broadcast(&out)
	}
	*c = Client{}
	h.online--
}

task hub() pool 1 {
	h := Hub{shards: min(runtime.Shards(), Relays)}
	for stopping := false; !stopping || h.online > 0; {
		m := <-toHub
		switch m.Kind {
		case EvAccept:
			h.accept(m.Conn)
		case EvLine:
			h.said(m.ID, m.Line.String())
		case EvNotice:
			h.send(DoSend, m.ID, &m.Line)
		case EvLeave:
			h.leave(m.ID, &m.Line)
		case EvShutdown:
			stopping = true
		}
	}
	println("room closed:", h.sent, "lines sent,", h.dropped, "dropped")
	for s := 0; s < h.shards; s++ {
		close(relays[s])
	}
}

task acceptor(l net.Listener) pool 1 {
	for {
		c, err := l.Accept()
		if err != nil {
			println("accept:", err.Error())
			return
		}
		toHub <- Msg{Kind: EvAccept, Conn: c}
	}
}

// ---- main ----

// start listens on addr and opens the room, on shard 0; it returns the port.
func start(addr string) int {
	l, err := net.Listen(addr)
	if err != nil {
		println("listen:", err.Error())
		os.Exit(1)
	}
	go hub()
	go acceptor(l)
	return l.Port()
}

func main() {
	shard := runtime.Shard()
	if shard >= Relays {
		return // more threads than relay channels (SQUARK_THREADS): this one takes no clients
	}
	go relay(shard)
	if shard == 0 {
		if os.NArgs() < 2 {
			selfTest()
		} else {
			println("chat on port", start(os.Arg(1)))
		}
	}
	<-relayDone
}
