// The self-test, run when chat has no arguments: scripted clients on shard 0 talk to the room over
// real TCP. Each line is awaited by everyone who should hear it before the next is sent, so the
// transcript is the same on every run.
program

use bufio, net, os, strings, time

// Who is one of the scripted clients (an index into peers).
enum Who { alice, bob, carol, dave, eve }

struct Peer {
	name   str
	c      net.Conn
	hangup bool // close the connection after the next line
	log    u8[1024]
	n      int
}

thread peers Peer[5]
thread heard Who chan[64] // a peer's listener sends who heard each line

// ---- peers ----

// listen records what peer i hears. A peer hangs up from here, not from script: Close doesn't
// wake a task blocked in Read on the same connection.
task listen(i Who) pool 5 {
	p := &peers[i]
	var buf u8[max_nick + 2 + max_line] // the longest line the room sends
	r := bufio.new_reader(buf[:])
	loop {
		text, err := r.read_line(p.c)
		if err != nil {
			text = "(disconnected)"
		}
		p.n += copy(p.log[p.n:], "  ")
		p.n += copy(p.log[p.n:], text)
		p.n += copy(p.log[p.n:], "\n")
		if p.hangup and err == nil {
			p.n += copy(p.log[p.n:], "  (hung up)\n")
		}
		heard <- i
		if err != nil or p.hangup {
			p.c.close()
			return
		}
	}
}

fn connect(i Who, name str in static, port int) {
	var buf u8[32]
	c, err := net.dial(str(net.append_host_port(buf[:0], "127.0.0.1", port)))
	if err != nil {
		panic(err)
	}
	peers[i].name = name
	peers[i].c = c
	start listen(i)
}

// say sends a line from peer i and waits until each peer in who has heard a line (a peer listed
// twice, two lines).
fn say(i Who, text str, who ...Who) {
	var buf u8[max_line * 2]
	peers[i].c.write(append(append(buf[:0], text...), '\n'))
	await(who...)
}

fn await(who ...Who) {
	var want int[len(peers)]
	for i in who {
		want[i]++
	}
	for _ in who {
		select {
		case i := <-heard:
			if want[i] == 0 {
				panic("chat: a client heard a line it shouldn't have")
			}
			want[i]--
		case <-time.after(5 * time.second):
			panic("chat: a client is missing a line")
		}
	}
}

// ---- the script ----

// self_test_timeout returns d, or a short timeout in the self-test, so dave, who says nothing, is
// timed out quickly.
fn self_test_timeout(d time.Duration) -> time.Duration {
	if os.n_args() < 2 {
		return 100 * time.millisecond
	}
	return d
}

fn self_test() {
	port := start("127.0.0.1:0")
	connect(.alice, "alice", port)
	say(.alice, "hello?", .alice)
	say(.alice, "NICK alice", .alice)
	connect(.bob, "bob", port)
	say(.bob, "NICK bob", .alice, .bob)
	connect(.carol, "carol", port)
	say(.carol, "NICK alice", .carol)
	say(.carol, "NICK carol", .alice, .bob, .carol)
	say(.alice, "hi all", .alice, .bob, .carol)
	say(.bob, "hey alice", .alice, .bob, .carol)
	say(.carol, "WHO", .carol)
	connect(.dave, "dave", port) // says nothing and is timed out
	await(.dave, .dave)
	var long u8[max_line + 50]
	say(.carol, str(strings.append_repeat(long[:0], "x", len(long))), .carol)
	say(.carol, "sorry, cat on keyboard", .alice, .bob, .carol)
	say(.bob, "QUIT", .bob, .bob, .alice, .carol)
	connect(.eve, "eve", port)
	say(.eve, "NICK eve", .alice, .carol, .eve)
	say(.eve, "WHO", .eve)
	peers[Who.carol].hangup = true
	say(.eve, "bye carol", .alice, .carol, .eve)
	await(.alice, .eve) // carol left
	say(.alice, "QUIT", .alice, .alice, .eve)
	say(.eve, "QUIT", .eve, .eve)

	for i, _ in peers {
		println(peers[i].name, "heard:")
		os.stdout.write(peers[i].log[:peers[i].n])
	}
	to_hub <- Msg{kind: .shutdown}
}
