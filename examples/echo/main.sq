// echo is a TCP echo server: whatever a client sends comes straight back.
//
// Run: squark run examples/echo, then try: nc localhost 7007
//
// It shows:
//   - a task per connection, from a task pool of fixed size
//   - a read buffer on each task's stack, whose size the compiler proves
//   - blocking reads and writes that park only the task that makes them
program

use net, os, time

// handle echoes one connection. At most 1000 run at once (pool 1000): each has its own stack,
// sized at compile time to hold buf and every call below.
task handle(c net.Conn) pool 1000 {
	defer c.close()
	var buf u8[4096]
	start := time.now()
	total := 0
	loop {
		n, err := c.read(buf[:])
		if err != nil {
			break
		}
		if _, err := c.write(buf[:n]); err != nil {
			break
		}
		total += n
	}
	ms := time.since(start).milliseconds()
	println("connection closed after", ms, "ms,", total, "bytes echoed")
}

fn main() {
	l, err := net.listen(":7007")
	if err != nil {
		println("listen:", err.message())
		os.exit(1)
	}
	println("echo server on :7007")
	loop {
		c, err := l.accept()
		if err != nil {
			println("accept:", err.message())
			continue
		}
		start handle(c) // waits for a free slot when 1000 connections are open
	}
}
