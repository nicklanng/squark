// echo is a TCP echo server: whatever a client sends comes straight back.
//
// Run: squark run examples/echo, then try: nc localhost 7007
//
// It shows:
//   - a goroutine per connection, from a task pool of fixed size
//   - a read buffer on each goroutine's stack, whose size the compiler proves
//   - blocking reads and writes that park only the goroutine that makes them
package main

import (
	"net"
	"os"
	"time"
)

// handle echoes one connection. At most 1000 run at once (pool 1000): each has its own stack,
// sized at compile time to hold buf and every call below.
task handle(c net.Conn) pool 1000 {
	defer c.Close()
	var buf [4096]byte
	start := time.Now()
	total := 0
	for {
		n, err := c.Read(buf[:])
		if err != nil {
			break
		}
		if _, err := c.Write(buf[:n]); err != nil {
			break
		}
		total += n
	}
	ms := time.Since(start).Milliseconds()
	println("connection closed after", ms, "ms,", total, "bytes echoed")
}

func main() {
	l, err := net.Listen(":7007")
	if err != nil {
		println("listen:", err.Error())
		os.Exit(1)
	}
	println("echo server on :7007")
	for {
		c, err := l.Accept()
		if err != nil {
			println("accept:", err.Error())
			continue
		}
		go handle(c) // waits for a free slot when 1000 connections are open
	}
}
