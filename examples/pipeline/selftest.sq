program

use time

// selftest runs when the pipeline is done: a few language checks that ride along with this
// example's test (expected.out), then a wait for the ticker and a check of the clock.
fn selftest(start time.Time) {
	q, r := divmod(17, 5)
	println("17/5 =", q, "rem", r, classify(-3), classify(0), classify(4), classify(7))

	a := Job{id: 1, input: 2}
	b := Job{id: 1, input: 2}
	println("struct equality:", a == b, a != Job{id: 2})

outer:
	for i := 0; i < 5; i++ {
		for j := 0; j < 5; j++ {
			if i*j == 6 {
				println("found", i, j)
				break outer
			}
			if j > i {
				continue outer
			}
		}
	}

	time.sleep(10 * time.millisecond)
	println("elapsed > 10ms:", time.since(start) > 10*time.millisecond)
}

fn classify(n int) -> str {
	switch {
	case n < 0:
		return "negative"
	case n == 0:
		return "zero"
	case n%2 == 0:
		return "even"
	}
	return "odd"
}

fn divmod(a, b int) -> (q, r int) {
	q = a / b
	r = a % b
	return
}
