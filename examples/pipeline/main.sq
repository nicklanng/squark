// pipeline: a worker pool fed by channels. A producer sends 1000 jobs (Collatz chain lengths) to
// four workers, and a collector reports the longest chain and how many results came back, while
// a ticker runs alongside.
//
//	squark run examples/pipeline
//
// It shows:
//   - tasks with fixed-size pools, started with go
//   - channels declared as storage (T chan[N]), ranged over and closed
//   - time.sleep parking one task while the others run
program

use time

const (
	num_workers = 4
	num_jobs    = 1000
)

struct Job {
	id    int
	input int
}

struct Result {
	id     int
	output int
	worker int
}

// The channels are package-level storage, so they live in static memory and every task can
// use them (a start argument can't refer to a stack, so main couldn't hand out a channel of its own).
thread jobs Job chan[16]
thread results Result chan[16]
thread done bool chan[0]

// ---- the work ----

// collatz counts the steps to reach 1.
fn collatz(n int) -> int {
	steps := 0
	while n != 1 {
		if n%2 == 0 {
			n /= 2
		} else {
			n = 3*n + 1
		}
		steps++
	}
	return steps
}

// ---- the tasks ----

task worker(id int) pool num_workers {
	for j in jobs {
		results <- Result{id: j.id, output: collatz(j.input), worker: id}
	}
}

task producer(n int) pool 1 {
	defer close(jobs)
	for i := 1; i <= n; i++ {
		jobs <- Job{id: i, input: i * 7919}
	}
}

task collector(n int) pool 1 {
	best := Result{}
	per_worker := int[num_workers]{}
	for i := 0; i < n; i++ {
		r := <-results
		per_worker[r.worker]++
		if r.output > best.output {
			best = r
		}
	}
	println("longest chain: job", best.id, "steps", best.output)
	total := 0
	for c in per_worker {
		total += c
	}
	println("results collected:", total)
	done <- true
}

task ticker() pool 1 {
	for i := 0; i < 3; i++ {
		time.sleep(2 * time.millisecond)
		println("tick", i)
	}
}

fn main() {
	start := time.now()
	start ticker()
	for w := 0; w < num_workers; w++ {
		start worker(w)
	}
	start producer(num_jobs)
	start collector(num_jobs)
	<-done
	selftest(start)
}
