// pipeline: a worker pool fed by channels. A producer sends 1000 jobs (Collatz chain lengths) to
// four workers, and a collector reports the longest chain and how many results came back, while
// a ticker runs alongside.
//
//	squark run examples/pipeline
//
// It shows:
//   - tasks with fixed-size pools, started with go
//   - channels declared as storage (chan T cap N), ranged over and closed
//   - time.Sleep parking one goroutine while the others run
package main

import "time"

const (
	numWorkers = 4
	numJobs    = 1000
)

type Job struct {
	ID    int
	Input int
}

type Result struct {
	ID     int
	Output int
	Worker int
}

// The channels are package-level storage, so they live in static memory and every goroutine can
// use them (a go argument can't refer to a stack, so main couldn't hand out a channel of its own).
var jobs chan Job cap 16
var results chan Result cap 16
var done chan bool cap 0

// ---- the work ----

// collatz counts the steps to reach 1.
func collatz(n int) int {
	steps := 0
	for n != 1 {
		if n%2 == 0 {
			n /= 2
		} else {
			n = 3*n + 1
		}
		steps++
	}
	return steps
}

// ---- the goroutines ----

task worker(id int) pool numWorkers {
	for j := range jobs {
		results <- Result{ID: j.ID, Output: collatz(j.Input), Worker: id}
	}
}

task producer(n int) pool 1 {
	defer close(jobs)
	for i := 1; i <= n; i++ {
		jobs <- Job{ID: i, Input: i * 7919}
	}
}

task collector(n int) pool 1 {
	best := Result{}
	perWorker := [numWorkers]int{}
	for i := 0; i < n; i++ {
		r := <-results
		perWorker[r.Worker]++
		if r.Output > best.Output {
			best = r
		}
	}
	println("longest chain: job", best.ID, "steps", best.Output)
	total := 0
	for _, c := range perWorker {
		total += c
	}
	println("results collected:", total)
	done <- true
}

task ticker() pool 1 {
	for i := 0; i < 3; i++ {
		time.Sleep(2 * time.Millisecond)
		println("tick", i)
	}
}

func main() {
	start := time.Now()
	go ticker()
	for w := 0; w < numWorkers; w++ {
		go worker(w)
	}
	go producer(numJobs)
	go collector(numJobs)
	<-done
	selftest(start)
}
