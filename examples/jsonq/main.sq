// jsonq: a report over a JSON array of orders: totals per customer, the best-selling items,
// counts by status, and the large settled orders re-emitted as JSON. Bad records are reported
// with their number and line, and skipped.
//
//	squark run examples/jsonq [FILE]     (no FILE: a built-in sample with bad records)
//
// It shows:
//   - the json pull decoder, decoding strings straight into an arena (NewDecoderIn, TextMax)
//   - one arena holding every decoded string and item slice, sized from the input
//   - json.Encoder writing JSON without hand-placed quotes and commas
//   - error values with codes, and try
//   - sort.slice with plain functions as comparators
program

use io, json, os, sort, strconv, strings

const (
	max_input  = 64K
	max_orders = 512
	max_items  = 16   // per order
	max_keys   = 256  // distinct customers, distinct SKUs
	max_name   = 64   // bytes in a customer name or sku, so that report lines have a bound
	big_order  = 1500 // cents: settled orders at least this large are re-emitted as JSON
)

fault (
	NotArray 100 "input is not a JSON array"
	Truncated 101 "input ends inside the array"
	Trailing 102 "data after the closing ]"
	NotObject 103 "record is not an object"
	NoID 104 "missing or non-positive id"
	DupID 105 "duplicate id"
	NoName 106 "missing customer"
	NoItems 107 "order has no items"
	BadQty 108 "item quantity must be positive"
	BadPrice 109 "item price must not be negative"
	BadStatus 110 "unknown status"
	TooLarge 111 "input larger than 64K"
	TooMany 112 "too many orders"
	ManyItems 113 "too many items in one order"
	ManyKeys 114 "too many distinct customers or SKUs"
	LongName 115 "customer or SKU longer than 64 bytes"
)

const statuses = str[4]{"paid", "pending", "shipped", "refunded"}

struct Item {
	sku   str
	qty   int
	price int // cents
}

struct Order {
	id       int
	customer str
	status   int // index into statuses
	items    Item[]
}

impl Order {
	fn total(&self) -> int {
		t := 0
		for it in self.items {
			t += it.qty * it.price
		}
		return t
	}
}

struct Tally {
	key    str
	count  int // orders (for customers) or units (for items)
	amount int // cents
}

// Scanner hands out the top-level array's elements one at a time, so that a bad record can be
// reported with its line and skipped: a json.Decoder stops at its first error.
struct Scanner {
	data      u8[]
	pos, line int
}

impl Scanner {
	fn space(&self) {
		for ; self.pos < len(self.data); self.pos++ {
			switch self.data[self.pos] {
			case '\n':
				self.line++
			case ' ', '\t', '\r':
			default:
				return
			}
		}
	}

	// next returns the next element and the line it starts on, or ok == false after the final ']'.
	fn next(&self) -> (rec u8[], line int, ok bool, err error) {
		self.space()
		line = self.line
		if self.pos < len(self.data) and self.data[self.pos] == ']' {
			self.pos++
			self.space()
			if self.pos < len(self.data) {
				return nil, self.line, false, Trailing
			}
			return nil, line, false, nil
		}
		start, depth, in_str := self.pos, 0, false
		for ; self.pos < len(self.data); self.pos++ {
			c := self.data[self.pos]
			switch {
			case c == '\n':
				self.line++
			case in_str and c == '\\':
				self.pos++
			case c == '"':
				in_str = not in_str
			case in_str:
			case c == '{' or c == '[':
				depth++
			case c == '}' or c == ']':
				depth--
			}
			if depth < 0 or depth == 0 and not in_str and c == ',' {
				break
			}
		}
		if self.pos >= len(self.data) {
			return nil, line, false, Truncated
		}
		rec = self.data[start:self.pos]
		if self.data[self.pos] == ',' {
			self.pos++
		}
		return rec, line, true, nil
	}
}

thread input u8[max_input]

// ---- decoding and validating a record ----

// number and text turn the decoder's (value, ok) results into (value, error) for !.
fn number(d *json.Decoder) -> int ! {
	n, ok := d.int()
	if not ok {
		return 0, d.err
	}
	return n, nil
}

// text decodes a string of at most max_name bytes into the decoder's arena, at its exact size; a
// longer one is LongName, and takes no room in the arena.
fn text(d *json.Decoder) -> str ! {
	s, ok := d.text_max(max_name)
	if d.err == json.TooLong {
		return "", LongName
	}
	if not ok {
		return "", d.err
	}
	return s, nil
}

fn decode_item(d *json.Decoder) -> Item ! {
	var it Item
	var key u8[64]
	if not d.begin_object() {
		return it, NotObject
	}
	for k, ok := d.field(key[:]); ok; k, ok = d.field(key[:]) {
		switch k {
		case "sku":
			it.sku = text(d)!
		case "qty":
			it.qty = number(d)!
		case "price":
			it.price = number(d)!
		default:
			d.skip()
		}
	}
	return it, d.err
}

// decode_order decodes one record. The strings it keeps (customer, SKUs) are decoded into a; keys
// and the status are only compared, so they are decoded into buffers on the stack.
fn decode_order(rec u8[], a arena) -> Order ! {
	o := Order{status: -1}
	var key, status u8[64]
	d := json.new_decoder_in(rec, a)
	if not d.begin_object() {
		return o, NotObject
	}
	for k, ok := d.field(key[:]); ok; k, ok = d.field(key[:]) {
		switch k {
		case "id":
			o.id = number(&d)!
		case "customer":
			o.customer = text(&d)!
		case "status":
			s, _ := d.string(status[:])
			o.status = status_index(s)
		case "items":
			if not d.begin_array() {
				return o, d.err
			}
			// collect the items on the stack, then copy them into the arena at their exact size
			// (append(o.items, it) in a would leave each outgrown slice behind in the arena)
			var items Item[..max_items]
			while d.more() {
				if not items.try_push(decode_item(&d)!) {
					return o, ManyItems
				}
			}
			o.items = make(Item[], len(items)) in a
			copy(o.items, items[:])
		default:
			d.skip()
		}
	}
	if not d.end() {
		return o, d.err
	}
	return o, nil
}

fn status_index(s str) -> int {
	for i, name in statuses {
		if s == name {
			return i
		}
	}
	return -1
}

fn validate(o *Order, seen bool[int]) -> ! {
	switch {
	case o.id <= 0:
		return NoID
	case seen[o.id]:
		return DupID
	case o.customer == "":
		return NoName
	case len(o.items) == 0:
		return NoItems
	case o.status < 0:
		return BadStatus
	}
	for it in o.items {
		if it.qty <= 0 {
			return BadQty
		}
		if it.price < 0 {
			return BadPrice
		}
	}
	return nil
}

fn reject(n, line int, err error) {
	var msg u8[128]
	out := strconv.append_int(append(msg[:0], "record "...), n)
	out = strconv.append_int(append(out, " (line "...), line)
	out = append(append(out, "): "...), err.message()...)
	out = strconv.append_int(append(out, " [code "...), err.code())
	os.stdout.write(append(out, "]\n"...))
}

// decode_all decodes the array in data into orders, reporting and skipping the bad records, and
// returns how many it skipped.
fn decode_all(data u8[], a arena, orders *(Order[..max_orders])) -> int ! {
	s := Scanner{data: data, line: 1}
	if s.space(); s.pos >= len(data) or data[s.pos] != '[' {
		return 0, NotArray
	}
	s.pos++
	var seen bool[int; max_orders]
	bad := 0
	for n := 1; ; n++ {
		rec, line, ok, err := s.next()
		if not ok {
			if err != nil {
				reject(n, line, err) // the array itself is broken: report what was read so far
				bad++
			}
			return bad, nil
		}
		o, err := decode_order(rec, a)
		if err == nil {
			err = validate(&o, seen)
		}
		if err != nil {
			reject(n, line, err)
			bad++
			continue
		}
		if not orders.try_push(o) {
			return bad, TooMany
		}
		seen[o.id] = true
	}
}

// ---- the report ----

fn by_amount(a, b Tally) -> bool {
	if a.amount != b.amount {
		return a.amount > b.amount
	}
	return a.key < b.key
}

fn by_count(a, b Tally) -> bool {
	if a.count != b.count {
		return a.count > b.count
	}
	return a.key < b.key
}

// add adds to key's tally in v, creating it if index doesn't have it yet.
fn add(v *(Tally[..max_keys]), index int[str], key str, count, amount int) -> ! {
	i, ok := index[key]
	if not ok {
		i = len(v)
		if not v.try_push(Tally{key: key}) {
			return ManyKeys
		}
		index[key] = i
	}
	v[i].count += count
	v[i].amount += amount
	return nil
}

fn append_cents(dst u8[], c int) -> u8[] {
	dst = strconv.append_int(append(dst, '$'), c/100)
	return strconv.append_int_pad(append(dst, '.'), c%100, 2, '0')
}

fn print_tallies(title str, ts Tally[], unit str) {
	println(title)
	var line u8[128]
	for t in ts {
		out := strings.append_pad_right(append(line[:0], "  "...), t.key, 14, ' ')
		out = strings.append_pad_right(strconv.append_int(out, t.count), unit, 9, ' ')
		os.stdout.write(append(append_cents(out, t.amount), '\n'))
	}
}

// emit_json writes the settled orders of at least big_order cents as a JSON array, one order per
// line. An Encoder writes each order; the array around them is written by hand, since an Encoder
// writes either no line breaks or (with SetIndent) one before every member.
fn emit_json(orders Order[]) -> ! {
	var buf u8[8K] // the largest order: 17 strings of max_name bytes, escaped 6 bytes to one
	os.stdout.write_string("[")
	sep := "\n  "
	for i, _ in orders {
		o := &orders[i]
		if s := statuses[o.status]; s != "paid" and s != "shipped" or o.total() < big_order {
			continue
		}
		e := json.new_encoder(buf[:0])
		e.object()
		e.key("id")
		e.int(o.id)
		e.key("customer")
		e.string(o.customer)
		e.key("skus")
		e.array()
		for it in o.items {
			e.string(it.sku)
		}
		e.end()
		e.key("total")
		e.int(o.total())
		e.end()
		e.finish()!
		os.stdout.write_string(sep)
		os.stdout.write(e.bytes())
		sep = ",\n  "
	}
	os.stdout.write_string("\n]\n")
	return nil
}

fn report(data u8[], a arena) -> ! {
	var orders Order[..max_orders]
	bad := decode_all(data, a, &orders)!
	println(len(orders), "orders accepted,", bad, "rejected")
	println()

	var customers, items Tally[..max_keys]
	var cust_index, sku_index int[str; max_keys]
	var by_status int[len(statuses)]
	for i, _ in orders {
		o := &orders[i]
		add(&customers, cust_index, o.customer, 1, o.total())!
		by_status[o.status]++
		for it in o.items {
			add(&items, sku_index, it.sku, it.qty, it.qty*it.price)!
		}
	}
	sort.slice(customers, by_amount)
	print_tallies("totals by customer:", customers, " orders")
	sort.slice(items, by_count)
	print_tallies("top items:", items[:min(len(items), 3)], " units")
	println("orders by status:")
	var line u8[64]
	for i, name in statuses {
		out := strings.append_pad_right(append(line[:0], "  "...), name, 14, ' ')
		os.stdout.write(append(strconv.append_int(out, by_status[i]), '\n'))
	}
	println()
	println("settled orders of", big_order/100, "dollars or more:")
	return emit_json(orders[:])
}

fn main() {
	var data u8[]
	var err error
	if os.n_args() > 1 {
		data, err = os.read_file(os.arg(1), input[:])
	} else {
		data = sample_input(input[:]) // selftest.sq
	}
	if err == io.TooLarge {
		err = TooLarge // say what the limit is
	}
	if err != nil {
		println("jsonq:", os.arg(1), ":", err.message())
		os.exit(1)
	}
	// A decoded string is no longer than its JSON text and an Item (32 bytes) little more than
	// the shortest JSON item ({"sku":"","qty":1,"price":0}), so twice the input always fits.
	with arena store 2 * max_input {
		if err := report(data, store); err != nil {
			println("jsonq:", err.message())
			os.exit(1)
		}
		println("arena used", store.used(), "of", store.cap(), "bytes")
	}
}
