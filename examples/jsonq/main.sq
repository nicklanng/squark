// jsonq: a report over a JSON array of orders: totals per customer, the best-selling items,
// counts by status, and the large settled orders re-emitted as JSON. Bad records are reported
// with their number and line, and skipped.
//
//	squark run examples/jsonq [FILE]     (no FILE: a built-in sample with bad records)
//
// It shows:
//   - the json pull decoder, decoding strings straight into an arena (NewDecoderIn, TextMax)
//   - one arena holding every decoded string and item slice, sized from the input
//   - json.Encoder writing JSON without hand-placed quotes and commas
//   - error values with codes, and try
//   - sort.Slice with plain functions as comparators
package main

import (
	"io"
	"json"
	"os"
	"sort"
	"strconv"
	"strings"
)

const (
	maxInput  = 64K
	maxOrders = 512
	maxItems  = 16   // per order
	maxKeys   = 256  // distinct customers, distinct SKUs
	maxName   = 64   // bytes in a customer name or SKU, so that report lines have a bound
	bigOrder  = 1500 // cents: settled orders at least this large are re-emitted as JSON
)

const (
	ErrNotArray  = error(100, "input is not a JSON array")
	ErrTruncated = error(101, "input ends inside the array")
	ErrTrailing  = error(102, "data after the closing ]")
	ErrNotObject = error(103, "record is not an object")
	ErrNoID      = error(104, "missing or non-positive id")
	ErrDupID     = error(105, "duplicate id")
	ErrNoName    = error(106, "missing customer")
	ErrNoItems   = error(107, "order has no items")
	ErrBadQty    = error(108, "item quantity must be positive")
	ErrBadPrice  = error(109, "item price must not be negative")
	ErrBadStatus = error(110, "unknown status")
	ErrTooLarge  = error(111, "input larger than 64K")
	ErrTooMany   = error(112, "too many orders")
	ErrManyItems = error(113, "too many items in one order")
	ErrManyKeys  = error(114, "too many distinct customers or SKUs")
	ErrLongName  = error(115, "customer or SKU longer than 64 bytes")
)

const statuses = [4]string{"paid", "pending", "shipped", "refunded"}

type Item struct {
	SKU   string
	Qty   int
	Price int // cents
}

type Order struct {
	ID       int
	Customer string
	Status   int // index into statuses
	Items    []Item
}

type Tally struct {
	Key    string
	Count  int // orders (for customers) or units (for items)
	Amount int // cents
}

// scanner hands out the top-level array's elements one at a time, so that a bad record can be
// reported with its line and skipped: a json.Decoder stops at its first error.
type scanner struct {
	data      []byte
	pos, line int
}

var input [maxInput]byte

// ---- splitting the array into records ----

func (s *scanner) space() {
	for ; s.pos < len(s.data); s.pos++ {
		switch s.data[s.pos] {
		case '\n':
			s.line++
		case ' ', '\t', '\r':
		default:
			return
		}
	}
}

// next returns the next element and the line it starts on, or ok == false after the final ']'.
func (s *scanner) next() (rec []byte, line int, ok bool, err error) {
	s.space()
	line = s.line
	if s.pos < len(s.data) && s.data[s.pos] == ']' {
		s.pos++
		s.space()
		if s.pos < len(s.data) {
			return nil, s.line, false, ErrTrailing
		}
		return nil, line, false, nil
	}
	start, depth, inStr := s.pos, 0, false
	for ; s.pos < len(s.data); s.pos++ {
		c := s.data[s.pos]
		switch {
		case c == '\n':
			s.line++
		case inStr && c == '\\':
			s.pos++
		case c == '"':
			inStr = !inStr
		case inStr:
		case c == '{' || c == '[':
			depth++
		case c == '}' || c == ']':
			depth--
		}
		if depth < 0 || depth == 0 && !inStr && c == ',' {
			break
		}
	}
	if s.pos >= len(s.data) {
		return nil, line, false, ErrTruncated
	}
	rec = s.data[start:s.pos]
	if s.data[s.pos] == ',' {
		s.pos++
	}
	return rec, line, true, nil
}

// ---- decoding and validating a record ----

// number and text turn the decoder's (value, ok) results into (value, error) for try.
func number(d *json.Decoder) (int, error) {
	n, ok := d.Int()
	if !ok {
		return 0, d.Err
	}
	return n, nil
}

// text decodes a string of at most maxName bytes into the decoder's arena, at its exact size; a
// longer one is ErrLongName, and takes no room in the arena.
func text(d *json.Decoder) (string, error) {
	s, ok := d.TextMax(maxName)
	if d.Err == json.ErrTooLong {
		return "", ErrLongName
	}
	if !ok {
		return "", d.Err
	}
	return s, nil
}

func decodeItem(d *json.Decoder) (Item, error) {
	var it Item
	var key [64]byte
	if !d.BeginObject() {
		return it, ErrNotObject
	}
	for k, ok := d.Field(key[:]); ok; k, ok = d.Field(key[:]) {
		switch k {
		case "sku":
			it.SKU = try text(d)
		case "qty":
			it.Qty = try number(d)
		case "price":
			it.Price = try number(d)
		default:
			d.Skip()
		}
	}
	return it, d.Err
}

// decodeOrder decodes one record. The strings it keeps (customer, SKUs) are decoded into a; keys
// and the status are only compared, so they are decoded into buffers on the stack.
func decodeOrder(rec []byte, a arena) (Order, error) {
	o := Order{Status: -1}
	var key, status [64]byte
	d := json.NewDecoderIn(rec, a)
	if !d.BeginObject() {
		return o, ErrNotObject
	}
	for k, ok := d.Field(key[:]); ok; k, ok = d.Field(key[:]) {
		switch k {
		case "id":
			o.ID = try number(&d)
		case "customer":
			o.Customer = try text(&d)
		case "status":
			s, _ := d.String(status[:])
			o.Status = statusIndex(s)
		case "items":
			if !d.BeginArray() {
				return o, d.Err
			}
			// collect the items on the stack, then copy them into the arena at their exact size
			// (append(o.Items, it) in a would leave each outgrown slice behind in the arena)
			var items [..maxItems]Item
			for d.More() {
				if !items.TryPush(try decodeItem(&d)) {
					return o, ErrManyItems
				}
			}
			o.Items = make([]Item, len(items)) in a
			copy(o.Items, items[:])
		default:
			d.Skip()
		}
	}
	if !d.End() {
		return o, d.Err
	}
	return o, nil
}

func statusIndex(s string) int {
	for i, name := range statuses {
		if s == name {
			return i
		}
	}
	return -1
}

func validate(o *Order, seen map[int]bool) error {
	switch {
	case o.ID <= 0:
		return ErrNoID
	case seen[o.ID]:
		return ErrDupID
	case o.Customer == "":
		return ErrNoName
	case len(o.Items) == 0:
		return ErrNoItems
	case o.Status < 0:
		return ErrBadStatus
	}
	for _, it := range o.Items {
		if it.Qty <= 0 {
			return ErrBadQty
		}
		if it.Price < 0 {
			return ErrBadPrice
		}
	}
	return nil
}

func reject(n, line int, err error) {
	var msg [128]byte
	out := strconv.AppendInt(append(msg[:0], "record "...), n)
	out = strconv.AppendInt(append(out, " (line "...), line)
	out = append(append(out, "): "...), err.Error()...)
	out = strconv.AppendInt(append(out, " [code "...), err.Code())
	os.Stdout.Write(append(out, "]\n"...))
}

// decodeAll decodes the array in data into orders, reporting and skipping the bad records, and
// returns how many it skipped.
func decodeAll(data []byte, a arena, orders *[..maxOrders]Order) (int, error) {
	s := scanner{data: data, line: 1}
	if s.space(); s.pos >= len(data) || data[s.pos] != '[' {
		return 0, ErrNotArray
	}
	s.pos++
	var seen map[int]bool cap maxOrders
	bad := 0
	for n := 1; ; n++ {
		rec, line, ok, err := s.next()
		if !ok {
			if err != nil {
				reject(n, line, err) // the array itself is broken: report what was read so far
				bad++
			}
			return bad, nil
		}
		o, err := decodeOrder(rec, a)
		if err == nil {
			err = validate(&o, seen)
		}
		if err != nil {
			reject(n, line, err)
			bad++
			continue
		}
		if !orders.TryPush(o) {
			return bad, ErrTooMany
		}
		seen[o.ID] = true
	}
}

// ---- the report ----

func (o *Order) Total() int {
	t := 0
	for _, it := range o.Items {
		t += it.Qty * it.Price
	}
	return t
}

func byAmount(a, b Tally) bool {
	if a.Amount != b.Amount {
		return a.Amount > b.Amount
	}
	return a.Key < b.Key
}

func byCount(a, b Tally) bool {
	if a.Count != b.Count {
		return a.Count > b.Count
	}
	return a.Key < b.Key
}

// add adds to key's tally in v, creating it if index doesn't have it yet.
func add(v *[..maxKeys]Tally, index map[string]int, key string, count, amount int) error {
	i, ok := index[key]
	if !ok {
		i = len(v)
		if !v.TryPush(Tally{Key: key}) {
			return ErrManyKeys
		}
		index[key] = i
	}
	v[i].Count += count
	v[i].Amount += amount
	return nil
}

func appendCents(dst []byte, c int) []byte {
	dst = strconv.AppendInt(append(dst, '$'), c/100)
	return strconv.AppendIntPad(append(dst, '.'), c%100, 2, '0')
}

func printTallies(title string, ts []Tally, unit string) {
	println(title)
	var line [128]byte
	for _, t := range ts {
		out := strings.AppendPadRight(append(line[:0], "  "...), t.Key, 14, ' ')
		out = strings.AppendPadRight(strconv.AppendInt(out, t.Count), unit, 9, ' ')
		os.Stdout.Write(append(appendCents(out, t.Amount), '\n'))
	}
}

// emitJSON writes the settled orders of at least bigOrder cents as a JSON array, one order per
// line. An Encoder writes each order; the array around them is written by hand, since an Encoder
// writes either no line breaks or (with SetIndent) one before every member.
func emitJSON(orders []Order) error {
	var buf [8K]byte // the largest order: 17 strings of maxName bytes, escaped 6 bytes to one
	os.Stdout.WriteString("[")
	sep := "\n  "
	for i := range orders {
		o := &orders[i]
		if s := statuses[o.Status]; s != "paid" && s != "shipped" || o.Total() < bigOrder {
			continue
		}
		e := json.NewEncoder(buf[:0])
		e.Object()
		e.Key("id")
		e.Int(o.ID)
		e.Key("customer")
		e.String(o.Customer)
		e.Key("skus")
		e.Array()
		for _, it := range o.Items {
			e.String(it.SKU)
		}
		e.End()
		e.Key("total")
		e.Int(o.Total())
		e.End()
		try e.Finish()
		os.Stdout.WriteString(sep)
		os.Stdout.Write(e.Bytes())
		sep = ",\n  "
	}
	os.Stdout.WriteString("\n]\n")
	return nil
}

func report(data []byte, a arena) error {
	var orders [..maxOrders]Order
	bad := try decodeAll(data, a, &orders)
	println(len(orders), "orders accepted,", bad, "rejected")
	println()

	var customers, items [..maxKeys]Tally
	var custIndex, skuIndex map[string]int cap maxKeys
	var byStatus [len(statuses)]int
	for i := range orders {
		o := &orders[i]
		try add(&customers, custIndex, o.Customer, 1, o.Total())
		byStatus[o.Status]++
		for _, it := range o.Items {
			try add(&items, skuIndex, it.SKU, it.Qty, it.Qty*it.Price)
		}
	}
	sort.Slice(customers, byAmount)
	printTallies("totals by customer:", customers, " orders")
	sort.Slice(items, byCount)
	printTallies("top items:", items[:min(len(items), 3)], " units")
	println("orders by status:")
	var line [64]byte
	for i, name := range statuses {
		out := strings.AppendPadRight(append(line[:0], "  "...), name, 14, ' ')
		os.Stdout.Write(append(strconv.AppendInt(out, byStatus[i]), '\n'))
	}
	println()
	println("settled orders of", bigOrder/100, "dollars or more:")
	return emitJSON(orders[:])
}

func main() {
	var data []byte
	var err error
	if os.NArgs() > 1 {
		data, err = os.ReadFile(os.Arg(1), input[:])
	} else {
		data = sampleInput(input[:]) // selftest.sq
	}
	if err == io.ErrTooLarge {
		err = ErrTooLarge // say what the limit is
	}
	if err != nil {
		println("jsonq:", os.Arg(1), ":", err.Error())
		os.Exit(1)
	}
	// A decoded string is no longer than its JSON text and an Item (32 bytes) little more than
	// the shortest JSON item ({"sku":"","qty":1,"price":0}), so twice the input always fits.
	arena store 2 * maxInput {
		if err := report(data, store); err != nil {
			println("jsonq:", err.Error())
			os.Exit(1)
		}
		println("arena used", store.Used(), "of", store.Cap(), "bytes")
	}
}
