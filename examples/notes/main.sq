// notes is a JSON REST API backed by SQLite, and the benchmark server (bench/run.sh):
//
//	GET    /health       -> ok
//	GET    /notes        -> the newest 100 notes
//	POST   /notes        -> {"title": "...", "body": "..."} -> 201 {"id": N}
//	GET    /notes/{id}   -> the note, or 404
//	DELETE /notes/{id}   -> 204, or 404
//
//	squark run examples/notes [-port 8080] [-db notes.db]
//
// It shows:
//   - requests served without a heap: buffers on the connection goroutine's proven stack
//   - a memory budget the build checks, with the connection pool sized to fit it
//   - http.HandleFunc routing, w.JSON() and a JSON request body decoded into r.Arena
//   - SQLite prepared statements, one connection per scheduler thread (thread var)
package main

import (
	"http"
	"json"
	"os"
	"sqlite"
	"strconv"
)

// At most 512 connections are served at once (more wait for a slot; idle keep-alive
// connections don't count). That bounds the server's own worst-case memory.
budget 128M
pool http.serveConn 512

const (
	maxTitle = 200
	maxBody  = 4000
)

const (
	sqlPragmas = "PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL;"
	sqlSchema  = "CREATE TABLE IF NOT EXISTS notes(" +
		"id INTEGER PRIMARY KEY, title TEXT NOT NULL, body TEXT NOT NULL)"
	sqlInsert = "INSERT INTO notes(title, body) VALUES(?, ?)"
	sqlGet    = "SELECT id, title, body FROM notes WHERE id = ?"
	sqlList   = "SELECT id, title, body FROM notes ORDER BY id DESC LIMIT 100"
	sqlDelete = "DELETE FROM notes WHERE id = ?"
)

// Store holds the connection and prepared statements. A statement holds the connection from its
// first Bind or Step until Reset (hence `defer st.Reset()`), so other requests that use it wait
// meanwhile: it is never used by two requests at once.
type Store struct {
	db     sqlite.DB
	insert sqlite.Stmt
	get    sqlite.Stmt
	list   sqlite.Stmt
	del    sqlite.Stmt
}

thread var store Store // each scheduler thread opens its own connection

// ---- store ----

func openStore(path string) error {
	db := try sqlite.Open(path)
	try db.Exec(sqlPragmas)
	try db.Exec(sqlSchema)
	store.db = db
	store.insert = try db.Prepare(sqlInsert)
	store.get = try db.Prepare(sqlGet)
	store.list = try db.Prepare(sqlList)
	store.del = try db.Prepare(sqlDelete)
	return nil
}

// insertNote adds a note and returns its id.
func insertNote(title, body string) (int, error) {
	st := store.insert
	defer st.Reset()
	try st.BindText(1, title)
	try st.BindText(2, body)
	try st.Step()
	return store.db.LastInsertRowID(), nil // read before Reset gives the connection back
}

// ---- responses ----

// fail answers with status and {"error": msg}.
func fail(w *http.ResponseWriter, status int, msg string) {
	w.WriteHeader(status)
	j := w.JSON()
	j.Object()
	j.Key("error")
	j.String(msg)
	j.End()
}

func internalError(w *http.ResponseWriter, err error) {
	println("error:", err.Error())
	fail(w, 500, "internal error")
}

// writeNote writes the current row of st as {"id":..,"title":..,"body":..}. The column text is
// copied into buffers on this goroutine's stack, sized for the longest note createNote accepts.
func writeNote(j *http.JSON, st sqlite.Stmt) error {
	var title [maxTitle]byte
	var body [maxBody]byte
	t := try st.ColumnText(1, title[:])
	b := try st.ColumnText(2, body[:])
	j.Object()
	j.Key("id")
	j.Int(st.ColumnInt(0))
	j.Key("title")
	j.String(t)
	j.Key("body")
	j.String(b)
	j.End()
	return nil
}

// writeNotes writes each remaining row of st.
func writeNotes(j *http.JSON, st sqlite.Stmt) error {
	for try st.Step() {
		try writeNote(j, st)
	}
	return nil
}

// ---- handlers ----

// GET /health
func health(w *http.ResponseWriter, r *http.Request) { w.Text(200, "ok") }

// GET /notes: the newest 100 notes
func listNotes(w *http.ResponseWriter, r *http.Request) {
	st := store.list
	defer st.Reset()
	j := w.JSON()
	j.Array()
	if err := writeNotes(j, st); err != nil {
		internalError(w, err)
		return
	}
	j.End()
}

// GET /notes/{id}
func getNote(w *http.ResponseWriter, r *http.Request) {
	id, ok := r.PathInt("id")
	if !ok {
		fail(w, 404, "not found")
		return
	}
	st := store.get
	defer st.Reset()
	st.BindInt(1, id)
	row, err := st.Step()
	if err != nil {
		internalError(w, err)
		return
	}
	if !row {
		fail(w, 404, "not found")
		return
	}
	if err := writeNote(w.JSON(), st); err != nil {
		internalError(w, err)
	}
}

// POST /notes {"title": "...", "body": "..."}
func createNote(w *http.ResponseWriter, r *http.Request) {
	title, body := "", ""
	d := json.NewDecoderIn(r.Body, r.Arena) // decoded strings live in the request's arena
	if !d.BeginObject() {
		fail(w, 400, "bad request")
		return
	}
	for {
		k, ok := d.Key()
		if !ok {
			break
		}
		switch k {
		case "title":
			title, _ = d.Text()
		case "body":
			body, _ = d.Text()
		default:
			d.Skip()
		}
	}
	if d.Err != nil || !d.End() || title == "" || len(title) > maxTitle || len(body) > maxBody {
		fail(w, 400, "bad request")
		return
	}
	id, err := insertNote(title, body)
	if err != nil {
		internalError(w, err)
		return
	}
	w.WriteHeader(201)
	j := w.JSON()
	j.Object()
	j.Key("id")
	j.Int(id)
	j.End()
}

// DELETE /notes/{id}
func deleteNote(w *http.ResponseWriter, r *http.Request) {
	id, ok := r.PathInt("id")
	if !ok {
		fail(w, 404, "not found")
		return
	}
	st := store.del
	defer st.Reset()
	st.BindInt(1, id)
	if _, err := st.Step(); err != nil {
		internalError(w, err)
		return
	}
	if store.db.Changes() == 0 {
		fail(w, 404, "not found")
		return
	}
	w.WriteHeader(204)
}

func main() {
	port := 8080
	dbPath := "notes.db"
	for i := 1; i < os.NArgs(); i++ {
		switch os.Arg(i) {
		case "-port", "--port":
			i++
			port, _ = strconv.Atoi(os.Arg(i))
		case "-db", "--db":
			i++
			dbPath = os.Arg(i)
		}
	}
	if err := openStore(dbPath); err != nil {
		println("cannot open database:", err.Error())
		os.Exit(1)
	}
	http.HandleFunc("GET /health", health)
	http.HandleFunc("GET /notes", listNotes)
	http.HandleFunc("POST /notes", createNote)
	http.HandleFunc("GET /notes/{id}", getNote)
	http.HandleFunc("DELETE /notes/{id}", deleteNote)
	println("squark notes listening on port", port, "db", dbPath)
	if err := http.ListenAndServe(http.Port(port), nil); err != nil {
		println("serve:", err.Error())
		os.Exit(1)
	}
}
