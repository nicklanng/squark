// notes is a JSON REST API backed by SQLite. Every request is served without touching the heap:
// request and response buffers live on the connection goroutine's stack, whose size the compiler
// proves; SQLite manages its own memory behind the C boundary.
//
//	GET    /health       -> ok
//	GET    /notes        -> newest 100 notes
//	POST   /notes        -> {"title": "...", "body": "..."} -> 201 {"id": N}
//	GET    /notes/{id}   -> the note, or 404
//	DELETE /notes/{id}   -> 204, or 404
package main

import (
	"http"
	"json"
	"os"
	"sqlite"
	"strconv"
	"strings"
)

// At most 512 connections are served at once (more wait for a slot; idle keep-alive
// connections don't count). That bounds the server's own worst-case memory.
budget 128M
pool http.serveConn 512

const (
	maxTitle  = 200
	maxBody   = 4000
	listLimit = 100
)

// Store holds the connection and prepared statements. All goroutines share one OS thread and
// SQLite calls never yield, so a statement is never used by two requests at once.
type Store struct {
	db     sqlite.DB
	insert sqlite.Stmt
	get    sqlite.Stmt
	list   sqlite.Stmt
	del    sqlite.Stmt
}

var store Store

func openStore(path string) error {
	db, err := sqlite.Open(path)
	if err != nil {
		return err
	}
	if err := db.Exec("PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL;"); err != nil {
		return err
	}
	if err := db.Exec("CREATE TABLE IF NOT EXISTS notes(id INTEGER PRIMARY KEY, title TEXT NOT NULL, body TEXT NOT NULL)"); err != nil {
		return err
	}
	store.db = db
	if store.insert, err = db.Prepare("INSERT INTO notes(title, body) VALUES(?, ?)"); err != nil {
		return err
	}
	if store.get, err = db.Prepare("SELECT id, title, body FROM notes WHERE id = ?"); err != nil {
		return err
	}
	if store.list, err = db.Prepare("SELECT id, title, body FROM notes ORDER BY id DESC LIMIT 100"); err != nil {
		return err
	}
	if store.del, err = db.Prepare("DELETE FROM notes WHERE id = ?"); err != nil {
		return err
	}
	return nil
}

// ---- responses ----

func writeError(w *http.ResponseWriter, status int, msg string) {
	w.SetHeader("Content-Type", "application/json")
	w.WriteHeader(status)
	w.WriteString(`{"error":"`)
	w.WriteString(msg)
	w.WriteString(`"}`)
}

func notFound(w *http.ResponseWriter)         { writeError(w, 404, "not found") }
func badRequest(w *http.ResponseWriter)       { writeError(w, 400, "bad request") }
func methodNotAllowed(w *http.ResponseWriter) { writeError(w, 405, "method not allowed") }
func internalError(w *http.ResponseWriter, err error) {
	println("error:", err.Error())
	writeError(w, 500, "internal error")
}

// writeJSONString streams s as a JSON string literal, escaping as it goes.
func writeJSONString(w *http.ResponseWriter, s string) {
	var esc [64]byte
	w.WriteByte('"')
	start := 0
	for i := 0; i < len(s); i++ {
		c := s[i]
		if c >= 0x20 && c != '"' && c != '\\' {
			continue
		}
		w.WriteString(s[start:i])
		e := json.AppendString(esc[:0], s[i:i+1])
		w.Write(e[1 : len(e)-1])
		start = i + 1
	}
	w.WriteString(s[start:])
	w.WriteByte('"')
}

// writeNote writes the current row of st as {"id":..,"title":..,"body":..}.
func writeNote(w *http.ResponseWriter, st sqlite.Stmt) error {
	var title [1024]byte
	var body [maxBody + 1024]byte
	t, err := st.ColumnText(1, title[:])
	if err != nil {
		return err
	}
	b, err := st.ColumnText(2, body[:])
	if err != nil {
		return err
	}
	w.WriteString(`{"id":`)
	w.WriteInt(st.ColumnInt(0))
	w.WriteString(`,"title":`)
	writeJSONString(w, t)
	w.WriteString(`,"body":`)
	writeJSONString(w, b)
	w.WriteByte('}')
	return nil
}

// ---- handlers ----

func parseID(s string) (int, bool) {
	if s == "" {
		return 0, false
	}
	for i := 0; i < len(s); i++ {
		if s[i] < '0' || s[i] > '9' {
			return 0, false
		}
	}
	id, err := strconv.Atoi(s)
	return id, err == nil
}

func listNotes(w *http.ResponseWriter) {
	st := store.list
	defer st.Reset()
	w.SetHeader("Content-Type", "application/json")
	w.WriteByte('[')
	for n := 0; ; n++ {
		row, err := st.Step()
		if err != nil {
			internalError(w, err)
			return
		}
		if !row {
			break
		}
		if n > 0 {
			w.WriteByte(',')
		}
		if err := writeNote(w, st); err != nil {
			internalError(w, err)
			return
		}
	}
	w.WriteByte(']')
}

func getNote(w *http.ResponseWriter, id int) {
	st := store.get
	defer st.Reset()
	st.BindInt(1, id)
	row, err := st.Step()
	if err != nil {
		internalError(w, err)
		return
	}
	if !row {
		notFound(w)
		return
	}
	w.SetHeader("Content-Type", "application/json")
	if err := writeNote(w, st); err != nil {
		internalError(w, err)
	}
}

func createNote(w *http.ResponseWriter, r *http.Request) {
	var key [32]byte
	title, body := "", ""
	hasTitle := false
	d := json.NewDecoder(r.Body)
	if !d.BeginObject() {
		badRequest(w)
		return
	}
	for {
		k, ok := d.Field(key[:])
		if !ok {
			break
		}
		switch k {
		case "title":
			// decoded strings live in the request's arena, gone once the response is sent
			title, hasTitle = d.String(make([]byte, maxTitle) in r.Arena)
		case "body":
			body, _ = d.String(make([]byte, maxBody) in r.Arena)
		default:
			d.Skip()
		}
	}
	if d.Err != nil || !d.End() || !hasTitle || title == "" {
		badRequest(w)
		return
	}
	st := store.insert
	defer st.Reset()
	if err := st.BindText(1, title); err != nil {
		internalError(w, err)
		return
	}
	if err := st.BindText(2, body); err != nil {
		internalError(w, err)
		return
	}
	if _, err := st.Step(); err != nil {
		internalError(w, err)
		return
	}
	w.SetHeader("Content-Type", "application/json")
	w.WriteHeader(201)
	w.WriteString(`{"id":`)
	w.WriteInt(store.db.LastInsertRowID())
	w.WriteByte('}')
}

func deleteNote(w *http.ResponseWriter, id int) {
	st := store.del
	defer st.Reset()
	st.BindInt(1, id)
	if _, err := st.Step(); err != nil {
		internalError(w, err)
		return
	}
	if store.db.Changes() == 0 {
		notFound(w)
		return
	}
	w.WriteHeader(204)
}

func handle(w *http.ResponseWriter, r *http.Request) {
	path := r.Path
	switch {
	case path == "/health":
		if r.Method != "GET" {
			methodNotAllowed(w)
			return
		}
		w.SetHeader("Content-Type", "text/plain")
		w.WriteString("ok")
	case path == "/notes":
		switch r.Method {
		case "GET":
			listNotes(w)
		case "POST":
			createNote(w, r)
		default:
			methodNotAllowed(w)
		}
	case strings.HasPrefix(path, "/notes/"):
		id, ok := parseID(path[len("/notes/"):])
		if !ok {
			notFound(w)
			return
		}
		switch r.Method {
		case "GET":
			getNote(w, id)
		case "DELETE":
			deleteNote(w, id)
		default:
			methodNotAllowed(w)
		}
	default:
		notFound(w)
	}
}

func main() {
	port := 8080
	dbPath := "notes.db"
	for i := 1; i < os.NArgs(); i++ {
		switch os.Arg(i) {
		case "-port", "--port":
			i++
			port, _ = strconv.Atoi(os.Arg(i))
		case "-db", "--db":
			i++
			dbPath = os.Arg(i)
		}
	}
	if err := openStore(dbPath); err != nil {
		println("cannot open database:", err.Error())
		os.Exit(1)
	}
	var addrBuf [32]byte
	addr := strconv.AppendInt(append(addrBuf[:0], ':'), port)
	println("squark notes listening on", string(addr), "db", dbPath)
	if err := http.ListenAndServe(string(addr), handle); err != nil {
		println("serve:", err.Error())
		os.Exit(1)
	}
}
