// notes is a JSON REST API backed by SQLite. Every request is served without touching the heap:
// request and response buffers live on the connection goroutine's stack, whose size the compiler
// proves; SQLite manages its own memory behind the C boundary.
//
//	GET    /health       -> ok
//	GET    /notes        -> newest 100 notes
//	POST   /notes        -> {"title": "...", "body": "..."} -> 201 {"id": N}
//	GET    /notes/{id}   -> the note, or 404
//	DELETE /notes/{id}   -> 204, or 404
package main

import (
	"http"
	"json"
	"os"
	"sqlite"
	"strconv"
	"strings"
)

// At most 512 connections are served at once (more wait for a slot; idle keep-alive
// connections don't count). That bounds the server's own worst-case memory.
budget 128M
pool http.serveConn 512

const (
	maxTitle  = 200
	maxBody   = 4000
	listLimit = 100
)

// Store holds the connection and prepared statements. All goroutines share one OS thread and
// SQLite calls never yield, so a statement is never used by two requests at once.
type Store struct {
	db     sqlite.DB
	insert sqlite.Stmt
	get    sqlite.Stmt
	list   sqlite.Stmt
	del    sqlite.Stmt
}

thread var store Store // each scheduler thread opens its own connection

func openStore(path string) error {
	db, err := sqlite.Open(path)
	if err != nil {
		return err
	}
	if err := db.Exec("PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL;"); err != nil {
		return err
	}
	if err := db.Exec("CREATE TABLE IF NOT EXISTS notes(id INTEGER PRIMARY KEY, title TEXT NOT NULL, body TEXT NOT NULL)"); err != nil {
		return err
	}
	store.db = db
	if store.insert, err = db.Prepare("INSERT INTO notes(title, body) VALUES(?, ?)"); err != nil {
		return err
	}
	if store.get, err = db.Prepare("SELECT id, title, body FROM notes WHERE id = ?"); err != nil {
		return err
	}
	if store.list, err = db.Prepare("SELECT id, title, body FROM notes ORDER BY id DESC LIMIT 100"); err != nil {
		return err
	}
	if store.del, err = db.Prepare("DELETE FROM notes WHERE id = ?"); err != nil {
		return err
	}
	return nil
}

// ---- responses ----

// fail answers with status and {"error": msg}.
func fail(w *http.ResponseWriter, status int, msg string) {
	w.WriteHeader(status)
	j := w.JSON()
	j.Object()
	j.Key("error")
	j.String(msg)
	j.End()
}

func internalError(w *http.ResponseWriter, err error) {
	println("error:", err.Error())
	fail(w, 500, "internal error")
}

// writeNote writes the current row of st as {"id":..,"title":..,"body":..}.
func writeNote(j *http.JSON, st sqlite.Stmt) error {
	var title [maxTitle]byte
	var body [maxBody]byte
	t := try st.ColumnText(1, title[:])
	b := try st.ColumnText(2, body[:])
	j.Object()
	j.Key("id")
	j.Int(st.ColumnInt(0))
	j.Key("title")
	j.String(t)
	j.Key("body")
	j.String(b)
	j.End()
	return nil
}

// ---- handlers ----

// GET /health
func health(w *http.ResponseWriter, r *http.Request) { w.Text(200, "ok") }

// GET /notes: the newest listLimit notes
func listNotes(w *http.ResponseWriter, r *http.Request) {
	st := store.list
	defer st.Reset()
	j := w.JSON()
	j.Array()
	for {
		row, err := st.Step()
		if err == nil && row {
			err = writeNote(j, st)
		}
		if err != nil {
			internalError(w, err)
			return
		}
		if !row {
			break
		}
	}
	j.End()
}

// GET /notes/{id}
func getNote(w *http.ResponseWriter, r *http.Request) {
	id, ok := r.PathInt("id")
	if !ok {
		fail(w, 404, "not found")
		return
	}
	st := store.get
	defer st.Reset()
	st.BindInt(1, id)
	row, err := st.Step()
	if err != nil {
		internalError(w, err)
		return
	}
	if !row {
		fail(w, 404, "not found")
		return
	}
	if err := writeNote(w.JSON(), st); err != nil {
		internalError(w, err)
	}
}

// POST /notes {"title": "...", "body": "..."}
func createNote(w *http.ResponseWriter, r *http.Request) {
	title, body := "", ""
	d := json.NewDecoderIn(r.Body, r.Arena) // decoded strings live in the request's arena
	if !d.BeginObject() {
		fail(w, 400, "bad request")
		return
	}
	for {
		k, ok := d.Key()
		if !ok {
			break
		}
		switch k {
		case "title":
			title, _ = d.Text()
		case "body":
			body, _ = d.Text()
		default:
			d.Skip()
		}
	}
	if d.Err != nil || !d.End() || title == "" || len(title) > maxTitle || len(body) > maxBody {
		fail(w, 400, "bad request")
		return
	}
	st := store.insert
	defer st.Reset()
	if err := st.BindText(1, title); err != nil {
		internalError(w, err)
		return
	}
	if err := st.BindText(2, body); err != nil {
		internalError(w, err)
		return
	}
	if _, err := st.Step(); err != nil {
		internalError(w, err)
		return
	}
	w.WriteHeader(201)
	j := w.JSON()
	j.Object()
	j.Key("id")
	j.Int(store.db.LastInsertRowID())
	j.End()
}

// DELETE /notes/{id}
func deleteNote(w *http.ResponseWriter, r *http.Request) {
	id, ok := r.PathInt("id")
	if !ok {
		fail(w, 404, "not found")
		return
	}
	st := store.del
	defer st.Reset()
	st.BindInt(1, id)
	if _, err := st.Step(); err != nil {
		internalError(w, err)
		return
	}
	if store.db.Changes() == 0 {
		fail(w, 404, "not found")
		return
	}
	w.WriteHeader(204)
}

func main() {
	port := 8080
	dbPath := "notes.db"
	for i := 1; i < os.NArgs(); i++ {
		switch os.Arg(i) {
		case "-port", "--port":
			i++
			port, _ = strconv.Atoi(os.Arg(i))
		case "-db", "--db":
			i++
			dbPath = os.Arg(i)
		}
	}
	if err := openStore(dbPath); err != nil {
		println("cannot open database:", err.Error())
		os.Exit(1)
	}
	http.HandleFunc("GET /health", health)
	http.HandleFunc("GET /notes", listNotes)
	http.HandleFunc("POST /notes", createNote)
	http.HandleFunc("GET /notes/{id}", getNote)
	http.HandleFunc("DELETE /notes/{id}", deleteNote)
	println("squark notes listening on port", port, "db", dbPath)
	if err := http.ListenAndServe(http.Port(port), nil); err != nil {
		println("serve:", err.Error())
		os.Exit(1)
	}
}
