// The self-test, run when kv has no -port: it serves on a port the system picks and drives a
// scripted client over real TCP, printing both sides of the conversation.
program

use bufio, io, net, os, runtime, strconv, strings, time

const client_timeout = 2 * time.second

// script is what the client sends on its first connection, one command per line.
const script = str[...]{
	"PING",
	"",
	"SET greeting hello world",
	"GET greeting",
	"GET missing",
	"SET",
	"SET lonely",
	"GET a b",
	"DEL",
	"INCR counter",
	"INCR counter",
	"incr counter",
	"INCR greeting",
	"INCR a b",
	"set Name squark",
	"DEL greeting",
	"DEL greeting",
	"SET zebra 1",
	"SET apple 2",
	"SET zebra 26",
	"KEYS",
	"SET 0123456789012345678901234567890123456789012345678901234567890123456789 too-long",
}

// Client is the test's end of a connection.
struct Client {
	c net.Conn
	r bufio.Reader
}

impl Client {
	fn read_line(&self) -> str ! in self {
		return self.r.read_line(self.c.with_timeout(client_timeout))
	}

	// read_reply reads one reply (a *n reply is followed by n lines) and prints it.
	fn read_reply(&self) -> ! {
		line := self.read_line()!
		println("<", line)
		if not strings.has_prefix(line, "*") {
			return nil
		}
		n := strconv.atoi(line[1:])!
		for i := 0; i < n; i++ {
			println("<", self.read_line()!)
		}
		return nil
	}

	fn send(&self, cmd str) -> ! {
		if cmd == "" {
			println("> (empty line)")
		} else {
			println(">", cmd)
		}
		var buf u8[max_line]
		self.c.write(append(append(buf[:0], cmd...), '\n'))!
		return self.read_reply()
	}

	// expect_close reads until the server closes the connection.
	fn expect_close(&self) {
		loop {
			line, err := self.read_line()
			if err == io.EOF {
				println("  (server closed the connection)")
				return
			}
			if err != nil {
				println("  (read error:", err.message(), ")")
				return
			}
			println("<", line)
		}
	}
}

thread closed ConnStats chan[8] // the server reports each finished connection here

// ---- the client ----

fn dial(port int, buf u8[]) -> Client ! in buf {
	var addr u8[32]
	c := net.dial(str(net.append_host_port(addr[:0], "127.0.0.1", port)))!
	return Client{c: c, r: bufio.new_reader(buf)}, nil
}

// ---- the server's side ----

fn report_closed(s ConnStats) { closed <- s }

// wait_closed waits for the server's report on a finished connection.
fn wait_closed() {
	select {
	case s := <-closed:
		println("  server: connection ended after", s.commands, "commands:", err_text(s.reason))
	case <-time.after(client_timeout):
		println("  server: no report")
	}
}

// ---- the script ----

fn run_script() -> ! {
	l := net.listen("127.0.0.1:0")!
	start accept_loop(l, 50*time.millisecond)
	port := l.port()
	var buf u8[max_line] // each connection's replies, one at a time

	println("== connection 1: every command")
	c := dial(port, buf[:])!
	defer c.c.close()
	for cmd in script {
		c.send(cmd)!
	}

	println("> GET counter / INCR counter (pipelined in one write)")
	c.c.write_string("GET counter\nINCR counter\n")!
	c.read_reply()!
	c.read_reply()!

	println("> GET apple (split across two writes)")
	c.c.write_string("GE")!
	time.sleep(5 * time.millisecond)
	c.c.write_string("T apple\r\n")!
	c.read_reply()!

	c.send("QUIT")!
	c.expect_close()
	wait_closed()

	println("== connection 2: the store outlives connections; then idle")
	c2 := dial(port, buf[:])!
	defer c2.c.close()
	c2.send("GET counter")!
	println("  (client goes quiet)")
	c2.expect_close()
	wait_closed()

	println("== connection 3: a line longer than the server's buffer")
	c3 := dial(port, buf[:])!
	defer c3.c.close()
	// exactly max_line bytes: the server reads all of them before closing, so the close is a clean
	// FIN (closing with unread data would send a reset, which can overtake the error reply)
	var long u8[max_line]
	println(">", max_line, "bytes without a newline")
	c3.c.write(strings.append_repeat(long[:0], "x", max_line))!
	c3.expect_close()
	wait_closed()
	return nil
}

fn self_test() {
	// Every thread runs main, but only the first serves and runs the client, so the transcript
	// is the same with any number of threads.
	if runtime.shard() != 0 {
		return
	}
	on_close = report_closed
	if err := run_script(); err != nil {
		println("self-test:", err.message())
		os.exit(1)
	}
}
