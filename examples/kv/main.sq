// kv is a small Redis-like key-value server over TCP with a line protocol:
//
//	SET key value   -> +OK              (value is the rest of the line)
//	GET key         -> $value, or _ when the key is missing
//	DEL key         -> :1 if it existed, else :0
//	INCR key        -> :n, the value after adding 1 (a missing key counts as 0)
//	KEYS            -> *n, then one $key line per key, sorted
//	QUIT            -> +BYE, and the server closes the connection
//
// Errors are lines starting with -ERR. A connection that sends nothing for a while is closed.
//
// Run: squark run examples/kv -port 6380 [-idle 30s], then try: nc localhost 6380
// With no arguments it tests itself: a scripted client over real TCP (selftest.sq).
//
// It shows:
//   - a store without a heap: fixed slots, a free list and a map whose keys view the slots
//   - a line protocol read with bufio.Reader, with an idle timeout
//   - replies built in a stack buffer, counted in the task's proven stack size
//   - !, sort.strings, and threads auto with per-thread state
program {
	threads auto
}

use bufio, flag, net, os, runtime, sort, strconv, strings, time

const (
	max_keys  = 1024
	max_key   = 64
	max_value = 256
	max_line  = 512 // longest command line, with its newline
)

fault (
	LineTooLong 1 "line too long"
	Idle 2 "idle timeout"
	StoreFull 3 "store full"
	Unknown 4 "unknown command"
	Args 5 "wrong number of arguments"
	NotInteger 6 "value is not an integer"
	TooLong 7 "key or value too long"
)

struct Entry {
	key  u8[max_key]
	klen int
	val  u8[max_value]
	vlen int
}

struct ConnStats {
	commands int
	reason   error // why the connection ended: nil after QUIT
}

// The store. Every scheduler thread runs main, so each has its own (thread): under threads
// auto a key is seen only by connections on the thread that set it. Run with SQUARK_THREADS=1 for
// one store shared by every connection.
thread slots Entry[max_keys]
thread index int[str; max_keys] // key -> slot; a key views its slot's bytes
thread free int[..max_keys]
thread used int // slots handed out so far; free holds the ones given back

// on_close is told how each connection ended (the self-test swaps in its own).
thread on_close = log_close

// ---- the store ----

fn get(key str) -> (str, bool) {
	i, ok := index[key]
	if not ok {
		return "", false
	}
	return str(slots[i].val[:slots[i].vlen]), true
}

fn set(key str, val str) -> ! {
	i, ok := index[key]
	if not ok {
		switch {
		case len(free) > 0:
			i = free.pop()
		case used < max_keys:
			i = used
			used++
		default:
			return StoreFull
		}
		e := &slots[i]
		e.klen = copy(e.key[:], key)
		index[str(e.key[:e.klen])] = i
	}
	slots[i].vlen = copy(slots[i].val[:], val)
	return nil
}

fn del(key str) -> bool {
	i, ok := index[key]
	if ok {
		delete(index, key)
		free.push(i)
	}
	return ok
}

// ---- commands ----

// err_line appends err as a -ERR reply line.
fn err_line(out u8[], err error) -> u8[] {
	return append(append(append(out, "-ERR "...), err.message()...), '\n')
}

// execute runs one command line and appends its reply to out. A failure is an error constant,
// which the caller sends as a -ERR line; quit reports QUIT.
fn execute(line str, out u8[]) -> (reply u8[], quit bool, err error) {
	name, rest, _ := strings.cut(strings.trim_space(line), " ")
	var fields str[2] // one more than any command takes, to notice extra arguments
	args := strings.fields(rest, fields[:])
	var lower u8[8]
	cmd := name
	if len(name) <= len(lower) {
		cmd = str(strings.append_lower(lower[:0], name))
	}
	switch cmd {
	case "set":
		key, val, ok := strings.cut(strings.trim_space(rest), " ")
		if not ok {
			return out, false, Args
		}
		if len(key) > max_key or len(val) > max_value {
			return out, false, TooLong
		}
		set(key, val)!
		return append(out, "+OK\n"...), false, nil
	case "get", "del", "incr":
		if len(args) != 1 {
			return out, false, Args
		}
	case "keys":
		var keys str[..max_keys]
		for k, _ in index {
			keys.push(k)
		}
		sort.strings(keys[:])
		out = append(strconv.append_int(append(out, '*'), len(keys)), '\n')
		for k in keys {
			out = append(append(append(out, '$'), k...), '\n')
		}
		return out, false, nil
	case "quit":
		return append(out, "+BYE\n"...), true, nil
	default:
		return out, false, Unknown
	}

	key := args[0]
	v, ok := get(key)
	n := 0
	switch cmd {
	case "get":
		if not ok {
			return append(out, "_\n"...), false, nil
		}
		return append(append(append(out, '$'), v...), '\n'), false, nil
	case "del":
		if ok {
			del(key)
			n = 1
		}
	case "incr":
		if ok {
			if n, err = strconv.atoi(v); err != nil {
				return out, false, NotInteger
			}
		}
		n++
		var num u8[24]
		set(key, str(strconv.append_int(num[:0], n)))!
	}
	return append(strconv.append_int(append(out, ':'), n), '\n'), false, nil
}

// ---- connections ----

task serve_conn(c net.Conn, idle time.Duration) pool 64 {
	defer c.close()
	var lines u8[max_line - 1] // room for the longest line (bufio needn't store its newline)
	r := bufio.new_reader(lines[:])
	// room for the largest reply, KEYS with a full store: the compiler counts it in the stack size
	// it proves for this task (squark build -v shows 64 x 96 KiB)
	var out u8[max_keys*(max_key+2) + 32]
	stats := ConnStats{}
	loop {
		// each read gives up with net.Timeout after idle without input (never, if idle <= 0)
		line, err := r.read_line(c.with_timeout(idle))
		switch err {
		case net.Timeout:
			err = Idle
		case bufio.TooLong:
			err = LineTooLong
		}
		if err != nil {
			if err == Idle or err == LineTooLong {
				c.write(err_line(out[:0], err)) // say why before hanging up
			}
			stats.reason = err
			break
		}
		stats.commands++
		reply, quit, err := execute(line, out[:0])
		if err != nil {
			reply = err_line(out[:0], err)
		}
		if _, err := c.write(reply); err != nil {
			stats.reason = err
			break
		}
		if quit {
			break
		}
	}
	on_close(stats)
}

fn log_close(s ConnStats) {
	println("connection closed after", s.commands, "commands:", err_text(s.reason))
}

fn err_text(err error) -> str {
	if err == nil {
		return "quit"
	}
	return err.message()
}

task accept_loop(l net.Listener, idle time.Duration) pool 1 {
	loop {
		c, err := l.accept()
		if err != nil {
			println("accept:", err.message())
			return
		}
		start serve_conn(c, idle)
	}
}

// ---- main ----

fn main() {
	port := flag.int_flag("port", -1, "port to listen on (without it, kv tests itself)")
	idle := flag.duration_flag("idle", 30*time.second, "close a connection idle for this long")
	flag.parse()
	if *port < 0 {
		self_test()
		return
	}

	var buf u8[32]
	addr := str(net.append_host_port(buf[:0], "", *port))
	l, err := net.listen(addr) // every thread listens: the kernel spreads connections over them
	if err != nil {
		println("listen:", err.message())
		os.exit(1)
	}
	if runtime.shard() == 0 {
		println("kv listening on", addr, "with", runtime.shards(), "threads")
	}
	start accept_loop(l, *idle)
	select {} // serve until killed
}
