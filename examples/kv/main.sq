// kv is a small Redis-like key-value server over TCP with a line protocol:
//
//	SET key value   -> +OK              (value is the rest of the line)
//	GET key         -> $value, or _ when the key is missing
//	DEL key         -> :1 if it existed, else :0
//	INCR key        -> :n, the value after adding 1 (a missing key counts as 0)
//	KEYS            -> *n, then one $key line per key, sorted
//	QUIT            -> +BYE, and the server closes the connection
//
// Errors are lines starting with -ERR. A connection that sends nothing for a while is closed.
//
// Run: squark run examples/kv -port 6380 [-idle ms], then try: nc localhost 6380
// With no arguments it tests itself: a scripted client over real TCP (selftest.sq).
//
// It shows:
//   - a store without a heap: fixed slots, a free list and a map whose keys view the slots
//   - a line protocol read with bufio.Reader, with an idle timeout
//   - replies built in a stack buffer, counted in the task's proven stack size
//   - try, sort.Strings, and threads auto with per-thread state
package main

import (
	"bufio"
	"net"
	"os"
	"runtime"
	"sort"
	"strconv"
	"strings"
	"time"
)

threads auto

const (
	maxKeys  = 1024
	maxKey   = 64
	maxValue = 256
	maxLine  = 512 // longest command line, with its newline
)

const (
	ErrLineTooLong = error(1, "line too long")
	ErrIdle        = error(2, "idle timeout")
	ErrStoreFull   = error(3, "store full")
	ErrUnknown     = error(4, "unknown command")
	ErrArgs        = error(5, "wrong number of arguments")
	ErrNotInteger  = error(6, "value is not an integer")
	ErrTooLong     = error(7, "key or value too long")
)

type entry struct {
	key  [maxKey]byte
	klen int
	val  [maxValue]byte
	vlen int
}

type connStats struct {
	commands int
	reason   error // why the connection ended: nil after QUIT
}

// timedConn is a connection whose reads give up with net.ErrTimeout after d without input (never,
// if d <= 0). bufio.Reader reads from anything with a Read method.
type timedConn struct {
	c net.Conn
	d time.Duration
}

// The store. Every scheduler thread runs main, so each has its own (thread var): under threads
// auto a key is seen only by connections on the thread that set it. Run with SQUARK_THREADS=1 for
// one store shared by every connection.
thread var slots [maxKeys]entry
thread var index map[string]int cap maxKeys // key -> slot; a key views its slot's bytes
thread var free [..maxKeys]int
thread var used int // slots handed out so far; free holds the ones given back

// onClose is told how each connection ended (the self-test swaps in its own).
thread var onClose = logClose

// ---- the store ----

func get(key string) (string, bool) {
	i, ok := index[key]
	if !ok {
		return "", false
	}
	return string(slots[i].val[:slots[i].vlen]), true
}

func set(key string, val string) error {
	i, ok := index[key]
	if !ok {
		switch {
		case len(free) > 0:
			i = free.Pop()
		case used < maxKeys:
			i = used
			used++
		default:
			return ErrStoreFull
		}
		e := &slots[i]
		e.klen = copy(e.key[:], key)
		index[string(e.key[:e.klen])] = i
	}
	slots[i].vlen = copy(slots[i].val[:], val)
	return nil
}

func del(key string) bool {
	i, ok := index[key]
	if ok {
		delete(index, key)
		free.Push(i)
	}
	return ok
}

// ---- commands ----

// errLine appends err as a -ERR reply line.
func errLine(out []byte, err error) []byte {
	return append(append(append(out, "-ERR "...), err.Error()...), '\n')
}

// execute runs one command line and appends its reply to out. A failure is an error constant,
// which the caller sends as a -ERR line; quit reports QUIT.
func execute(line string, out []byte) (reply []byte, quit bool, err error) {
	name, rest, _ := strings.Cut(strings.TrimSpace(line), " ")
	var fields [2]string // one more than any command takes, to notice extra arguments
	args := strings.Fields(rest, fields[:])
	var lower [8]byte
	cmd := name
	if len(name) <= len(lower) {
		cmd = string(strings.AppendLower(lower[:0], name))
	}
	switch cmd {
	case "set":
		key, val, ok := strings.Cut(strings.TrimSpace(rest), " ")
		if !ok {
			return out, false, ErrArgs
		}
		if len(key) > maxKey || len(val) > maxValue {
			return out, false, ErrTooLong
		}
		try set(key, val)
		return append(out, "+OK\n"...), false, nil
	case "get", "del", "incr":
		if len(args) != 1 {
			return out, false, ErrArgs
		}
	case "keys":
		var keys [..maxKeys]string
		for k := range index {
			keys.Push(k)
		}
		sort.Strings(keys[:])
		out = append(strconv.AppendInt(append(out, '*'), len(keys)), '\n')
		for _, k := range keys {
			out = append(append(append(out, '$'), k...), '\n')
		}
		return out, false, nil
	case "quit":
		return append(out, "+BYE\n"...), true, nil
	default:
		return out, false, ErrUnknown
	}

	key := args[0]
	v, ok := get(key)
	n := 0
	switch cmd {
	case "get":
		if !ok {
			return append(out, "_\n"...), false, nil
		}
		return append(append(append(out, '$'), v...), '\n'), false, nil
	case "del":
		if ok {
			del(key)
			n = 1
		}
	case "incr":
		if ok {
			if n, err = strconv.Atoi(v); err != nil {
				return out, false, ErrNotInteger
			}
		}
		n++
		var num [24]byte
		try set(key, string(strconv.AppendInt(num[:0], n)))
	}
	return append(strconv.AppendInt(append(out, ':'), n), '\n'), false, nil
}

// ---- connections ----

func (t timedConn) Read(p []byte) (int, error) {
	if t.d <= 0 {
		return t.c.Read(p)
	}
	return t.c.ReadTimeout(p, t.d)
}

task serveConn(c net.Conn, idle time.Duration) pool 64 {
	defer c.Close()
	var lines [maxLine - 1]byte // room for the longest line (bufio needn't store its newline)
	r := bufio.NewReader(lines[:])
	// room for the largest reply, KEYS with a full store: the compiler counts it in the stack size
	// it proves for this task (squark build -v shows 64 x 96 KiB)
	var out [maxKeys*(maxKey+2) + 32]byte
	stats := connStats{}
	for {
		line, err := r.ReadLine(timedConn{c, idle})
		switch err {
		case net.ErrTimeout:
			err = ErrIdle
		case bufio.ErrTooLong:
			err = ErrLineTooLong
		}
		if err != nil {
			if err == ErrIdle || err == ErrLineTooLong {
				c.Write(errLine(out[:0], err)) // say why before hanging up
			}
			stats.reason = err
			break
		}
		stats.commands++
		reply, quit, err := execute(line, out[:0])
		if err != nil {
			reply = errLine(out[:0], err)
		}
		if _, err := c.Write(reply); err != nil {
			stats.reason = err
			break
		}
		if quit {
			break
		}
	}
	onClose(stats)
}

func logClose(s connStats) {
	println("connection closed after", s.commands, "commands:", errText(s.reason))
}

func errText(err error) string {
	if err == nil {
		return "quit"
	}
	return err.Error()
}

task acceptLoop(l net.Listener, idle time.Duration) pool 1 {
	for {
		c, err := l.Accept()
		if err != nil {
			println("accept:", err.Error())
			return
		}
		go serveConn(c, idle)
	}
}

// ---- main ----

func main() {
	port := -1
	idle := 30 * time.Second
	for i := 1; i < os.NArgs(); i++ {
		switch os.Arg(i) {
		case "-port", "--port":
			i++
			port, _ = strconv.Atoi(os.Arg(i))
		case "-idle", "--idle":
			i++
			ms, _ := strconv.Atoi(os.Arg(i))
			idle = time.Duration(ms) * time.Millisecond
		}
	}
	if port < 0 {
		selfTest()
		return
	}

	var buf [32]byte
	addr := string(strconv.AppendInt(append(buf[:0], ':'), port))
	l, err := net.Listen(addr) // every thread listens: the kernel spreads connections over them
	if err != nil {
		println("listen:", err.Error())
		os.Exit(1)
	}
	if runtime.Shard() == 0 {
		println("kv listening on", addr, "with", runtime.Shards(), "threads")
	}
	go acceptLoop(l, idle)
	select {} // serve until killed
}
