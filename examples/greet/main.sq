// greet is a one-route HTTP server.
//
//	squark run examples/greet
//	curl 'localhost:8080/hello?name=world'
//
// It shows:
//   - a memory budget, checked at build time against the proven worst case
//   - a string built in the request's arena, which is freed when the response is done
package main

import "http"

budget 128M             // the build fails if the worst case can exceed this
pool http.serveConn 512 // at most 512 connections served at once

// GET /hello?name=world
func hello(w *http.ResponseWriter, r *http.Request) {
	w.Text(200, "hello, " + r.QueryParam("name") + "\n" in r.Arena) // per-request arena
}

func main() {
	http.HandleFunc("GET /hello", hello)
	if err := http.ListenAndServe(":8080", nil); err != nil {
		panic(err)
	}
}
