// Package os is a thin, heap-free interface to the operating system.
module os

use io

// File is an open file descriptor. It is a plain value; copying it does not duplicate the descriptor.
pub struct File {
	sysfd int
}

pub thread stdin = File{sysfd: 0}
pub thread stdout = File{sysfd: 1}
pub thread stderr = File{sysfd: 2}

const (
	pub o_rdonly = 0
	pub o_wronly = 1
	pub o_rdwr   = 2
	pub o_create = 0x40
	pub o_trunc  = 0x200
	pub o_append = 0x400
)

extern fn sys_write(fd int, b u8[]) -> int stack 8K c"sq_write"

extern fn sys_write_str(fd int, s str) -> int stack 8K c"sq_write_str"

extern fn sys_read(fd int, b u8[]) -> int stack 8K c"sq_read"

extern fn sys_close(fd int) -> int stack 8K c"sq_close"

extern fn sys_open(path str, flags int, mode int) -> int stack 8K c"sq_open"

extern fn strerror(errno int) -> str stack 8K c"sq_strerror"

pub extern fn exit(code int) stack 8K c"sq_exit"

// getpid returns the process id (with workers N, each worker has its own).
pub extern fn getpid() -> int stack 1K c"sq_getpid"

extern fn argc() -> int stack 8K c"sq_argc"

extern fn argv(i int) -> str stack 8K c"sq_argv"

pub extern fn getenv(name str) -> str stack 8K c"sq_getenv"

// errno converts a positive errno value into an error.
pub fn errno(n int) -> ! {
	return error(n, strerror(n))
}

// n_args returns the number of command-line arguments, including the program name.
pub fn n_args() -> int { return argc() }

// arg returns command-line argument i ("" if out of range). Arg(0) is the program name.
pub fn arg(i int) -> str { return argv(i) }

pub fn open(path str) -> File ! { return open_file(path, o_rdonly, 0) }

pub fn create(path str) -> File ! {
	return open_file(path, o_wronly|o_create|o_trunc, 0o644)
}

pub fn open_file(path str, flag int, perm int) -> File ! {
	fd := sys_open(path, flag, perm)
	if fd < 0 {
		return File{sysfd: -1}, errno(-fd)
	}
	return File{sysfd: fd}, nil
}

// from_fd wraps an existing descriptor.
pub fn from_fd(fd int) -> File { return File{sysfd: fd} }

impl File {
	pub fn fd(self) -> int { return self.sysfd }

	pub fn read(self, p u8[]) -> int ! {
		n := sys_read(self.sysfd, p)
		if n < 0 {
			return 0, errno(-n)
		}
		if n == 0 and len(p) > 0 {
			return 0, io.EOF
		}
		return n, nil
	}

	pub fn write(self, p u8[]) -> int ! {
		n := sys_write(self.sysfd, p)
		if n < 0 {
			return 0, errno(-n)
		}
		if n < len(p) {
			return n, io.ShortWrite
		}
		return n, nil
	}

	pub fn write_string(self, s str) -> int ! {
		n := sys_write_str(self.sysfd, s)
		if n < 0 {
			return 0, errno(-n)
		}
		if n < len(s) {
			return n, io.ShortWrite
		}
		return n, nil
	}

	pub fn close(self) -> ! {
		if r := sys_close(self.sysfd); r < 0 {
			return errno(-r)
		}
		return nil
	}

	// read_full reads into p until it is full, returning how many bytes it read. If the file ends
	// first, the error is io.EOF if nothing was read and io.UnexpectedEOF otherwise, as with Go's
	// io.read_full.
	pub fn read_full(self, p u8[]) -> int ! {
		n := 0
		while n < len(p) {
			m, err := self.read(p[n:])
			n += m
			if err == io.EOF and n > 0 {
				return n, io.UnexpectedEOF
			}
			if err != nil {
				return n, err
			}
		}
		return n, nil
	}
}

// read_file reads the whole file at path into buf and returns the part it fills. A file that
// doesn't fit is io.TooLarge (buf then holds its beginning).
pub fn read_file(path str, buf u8[]) -> u8[] ! in buf {
	f, err := open(path)
	if err != nil {
		return buf[:0], err
	}
	defer f.close()
	n := 0
	while n < len(buf) {
		m, err := f.read(buf[n:])
		n += m
		if err == io.EOF {
			return buf[:n], nil
		}
		if err != nil {
			return buf[:n], err
		}
	}
	var probe u8[1] // a full buffer: is that the whole file?
	if m, _ := f.read(probe[:]); m > 0 {
		return buf[:n], io.TooLarge
	}
	return buf[:n], nil
}
