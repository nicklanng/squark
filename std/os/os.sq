// Package os is a thin, heap-free interface to the operating system.
package os

import "io"

// File is an open file descriptor. It is a plain value; copying it does not duplicate the descriptor.
type File struct {
	fd int
}

var Stdin = File{fd: 0}
var Stdout = File{fd: 1}
var Stderr = File{fd: 2}

const (
	O_RDONLY = 0
	O_WRONLY = 1
	O_RDWR   = 2
	O_CREATE = 0x40
	O_TRUNC  = 0x200
	O_APPEND = 0x400
)

extern "sq_write" func sysWrite(fd int, b []byte) int stack 8K

extern "sq_write_str" func sysWriteStr(fd int, s string) int stack 8K

extern "sq_read" func sysRead(fd int, b []byte) int stack 8K

extern "sq_close" func sysClose(fd int) int stack 8K

extern "sq_open" func sysOpen(path string, flags int, mode int) int stack 8K

extern "sq_strerror" func strerror(errno int) string stack 8K

extern "sq_exit" func Exit(code int) stack 8K

// Getpid returns the process id (with workers N, each worker has its own).
extern "sq_getpid" func Getpid() int stack 1K

extern "sq_argc" func argc() int stack 8K

extern "sq_argv" func argv(i int) string stack 8K

extern "sq_getenv" func Getenv(name string) string stack 8K

// Errno converts a positive errno value into an error.
func Errno(n int) error {
	return error(n, strerror(n))
}

// NArgs returns the number of command-line arguments, including the program name.
func NArgs() int { return argc() }

// Arg returns command-line argument i ("" if out of range). Arg(0) is the program name.
func Arg(i int) string { return argv(i) }

func Open(path string) (File, error) { return OpenFile(path, O_RDONLY, 0) }

func Create(path string) (File, error) {
	return OpenFile(path, O_WRONLY|O_CREATE|O_TRUNC, 0o644)
}

func OpenFile(path string, flag int, perm int) (File, error) {
	fd := sysOpen(path, flag, perm)
	if fd < 0 {
		return File{fd: -1}, Errno(-fd)
	}
	return File{fd: fd}, nil
}

// FromFd wraps an existing descriptor.
func FromFd(fd int) File { return File{fd: fd} }

func (f File) Fd() int { return f.fd }

func (f File) Read(p []byte) (int, error) {
	n := sysRead(f.fd, p)
	if n < 0 {
		return 0, Errno(-n)
	}
	if n == 0 && len(p) > 0 {
		return 0, io.EOF
	}
	return n, nil
}

func (f File) Write(p []byte) (int, error) {
	n := sysWrite(f.fd, p)
	if n < 0 {
		return 0, Errno(-n)
	}
	if n < len(p) {
		return n, io.ErrShortWrite
	}
	return n, nil
}

func (f File) WriteString(s string) (int, error) {
	n := sysWriteStr(f.fd, s)
	if n < 0 {
		return 0, Errno(-n)
	}
	if n < len(s) {
		return n, io.ErrShortWrite
	}
	return n, nil
}

func (f File) Close() error {
	if r := sysClose(f.fd); r < 0 {
		return Errno(-r)
	}
	return nil
}

// ReadFull reads into p until it is full or the file ends, returning the bytes read.
// ReadFull reads exactly len(p) bytes. If the file ends first it returns what it read and
// io.EOF (nothing read) or io.ErrUnexpectedEOF (some read), as Go's io.ReadFull does.
func (f File) ReadFull(p []byte) (int, error) {
	n := 0
	for n < len(p) {
		m, err := f.Read(p[n:])
		n += m
		if err == io.EOF && n > 0 {
			return n, io.ErrUnexpectedEOF
		}
		if err != nil {
			return n, err
		}
	}
	return n, nil
}

// ReadFile reads the whole file at path into buf and returns the part it fills. A file that
// doesn't fit is io.ErrTooLarge (buf then holds its beginning).
func ReadFile(path string, buf []byte) ([]byte, error) from buf {
	f, err := Open(path)
	if err != nil {
		return buf[:0], err
	}
	defer f.Close()
	n := 0
	for n < len(buf) {
		m, err := f.Read(buf[n:])
		n += m
		if err == io.EOF {
			return buf[:n], nil
		}
		if err != nil {
			return buf[:n], err
		}
	}
	var probe [1]byte // a full buffer: is that the whole file?
	if m, _ := f.Read(probe[:]); m > 0 {
		return buf[:n], io.ErrTooLarge
	}
	return buf[:n], nil
}
