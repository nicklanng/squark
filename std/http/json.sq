package http

import "json"

// JSON writes a JSON document into a response as it is built, with commas, nesting and escaping
// handled (a json.Encoder underneath, writing into the response's own buffer). A document of any
// size takes no memory beyond the response's buffer, and long strings are written without being
// copied:
//
//	j := w.JSON()
//	j.Object()
//	j.Key("id")
//	j.Int(7)
//	j.Key("tags")
//	j.Array()
//	j.String("a")
//	j.End()
//	j.End()                    // {"id":7,"tags":["a"]}
//
// A call out of place (a value in an object without a Key, End with nothing open) records an
// error instead of writing invalid JSON, and later calls write nothing: Finish reports it.
type JSON ResponseWriter // the response, seen as a JSON document (its encoder is a field of it)

// jsonDirect is the length from which String and Raw write a value straight to the response
// instead of through the encoder (which must fit a whole value in the write buffer).
const jsonDirect = 1024

// JSON sets the response's Content-Type to application/json (unless already set) and returns a
// JSON writer for its body, which builds the document straight into the response's buffer. Set
// the status with WriteHeader first if it isn't 200, and don't write to w directly while the
// document is open.
func (w *ResponseWriter) JSON() *JSON from w {
	if !w.hasType {
		w.SetHeader("Content-Type", "application/json")
	}
	w.enc = json.NewEncoder(w.buf)
	return (*JSON)(w)
}

// full takes the encoder's output as the response's staged bytes. If the last call didn't fit, it
// sends what is staged so the caller can make the call again, and reports true.
func (j *JSON) full() bool {
	w := (*ResponseWriter)(j)
	w.buf = j.enc.Bytes()
	if j.enc.Err != json.ErrFull {
		return false
	}
	w.spill()
	j.enc.Clear()
	j.enc.Err = nil
	return true
}

// direct prepares for writing a value to the response without the encoder: the encoder has
// written what precedes it, and everything staged is sent so the encoder can start afresh after.
func (j *JSON) direct() bool {
	if !j.enc.RawStart() && !(j.full() && j.enc.RawStart()) {
		return false
	}
	j.full()
	(*ResponseWriter)(j).spill()
	j.enc.Clear()
	return true
}

// resume lines the encoder up with the response again after a direct write.
func (j *JSON) resume() {
	(*ResponseWriter)(j).spill()
	j.enc.Clear()
}

// Object starts an object; End closes it.
func (j *JSON) Object() {
	if j.enc.Object(); j.full() {
		j.enc.Object()
		j.full()
	}
}

// Array starts an array; End closes it.
func (j *JSON) Array() {
	if j.enc.Array(); j.full() {
		j.enc.Array()
		j.full()
	}
}

// End closes the innermost object or array.
func (j *JSON) End() {
	if j.enc.End(); j.full() {
		j.enc.End()
		j.full()
	}
}

// Key names the next value inside an object.
func (j *JSON) Key(name string) {
	if j.enc.Key(name); j.full() {
		j.enc.Key(name)
		j.full()
	}
}

// String writes a string value (invalid UTF-8 becomes U+FFFD, as json.AppendString does).
func (j *JSON) String(s string) {
	if len(s) >= jsonDirect {
		if j.direct() {
			json.WriteString((*ResponseWriter)(j), s)
			j.resume()
		}
		return
	}
	if j.enc.String(s); j.full() {
		j.enc.String(s)
		j.full()
	}
}

// Int writes an integer value.
func (j *JSON) Int(v int) {
	if j.enc.Int(v); j.full() {
		j.enc.Int(v)
		j.full()
	}
}

// Float writes a number in its shortest form; NaN and infinities have none (Finish reports it).
func (j *JSON) Float(v float64) {
	if j.enc.Float(v); j.full() {
		j.enc.Float(v)
		j.full()
	}
}

// Bool writes true or false.
func (j *JSON) Bool(v bool) {
	if j.enc.Bool(v); j.full() {
		j.enc.Bool(v)
		j.full()
	}
}

// Null writes null.
func (j *JSON) Null() {
	if j.enc.Null(); j.full() {
		j.enc.Null()
		j.full()
	}
}

// Raw writes b, which must be one complete JSON value (it is checked).
func (j *JSON) Raw(b []byte) {
	if len(b) >= jsonDirect {
		d := json.NewDecoder(b)
		if !d.Skip() || !d.End() {
			j.enc.Raw(b) // records the error
		} else if j.direct() {
			(*ResponseWriter)(j).Write(b)
			j.resume()
		}
		return
	}
	if j.enc.Raw(b); j.full() {
		j.enc.Raw(b)
		j.full()
	}
}

// Finish reports the first misuse (json.ErrMisuse, ErrDepth, ErrFloat, ...), or an unclosed
// document. It writes nothing.
func (j *JSON) Finish() error { return j.enc.Finish() }
