module http

// The client: one keep-alive connection per Client, reading responses into a buffer the caller
// provides. Requests are written from that buffer (or from the caller's own bytes, round_trip), so
// nothing is allocated.

use io, net, strings, time

// Malformed means a response that isn't HTTP/1.x: a bad status line, header, Content-Length
// or chunk.
pub fault Malformed -40 "http: malformed response"

// HeaderTooLarge means a response's status line and headers don't fit in the client's buffer.
pub fault HeaderTooLarge -41 "http: response header larger than the client's buffer"

// BodyTooLarge means a response's body doesn't fit in the rest of the client's buffer. The
// Response returned with it has the status and headers, and the part of the body that fit.
pub fault BodyTooLarge -42 "http: response body larger than the client's buffer"

// RequestTooLarge means a request's line and headers don't fit in the buffer they are built in.
pub fault RequestTooLarge -43 "http: request larger than the buffer"

// InvalidRequest means a method or header name isn't an HTTP token, or the path is empty or
// holds a space or control character.
pub fault InvalidRequest -44 "http: invalid method, path or header name"

// Closed is returned by a Client made with new_client once its connection has been closed (a
// Client from dial dials again instead).
pub fault Closed -45 "http: client connection closed"

// client_timeout is a new Client's timeout.
pub const client_timeout = 30 * time.second

// Response is a response read by a Client. Its strings and body are views of the client's buffer,
// valid until the client's next request.
pub struct Response {
	pub status_code int // 200
	pub reason      str // "OK"
	pub proto       str // "HTTP/1.1"
	pub body        u8[]
	// content_length is the Content-Length header's value, or -1 without one (a chunked body or one
	// that ends with the connection).
	pub content_length int
	// close reports that the connection was closed after this response (the server asked for it,
	// or the body ended with the connection). The client's next request dials again.
	pub close bool

	headers  Header[max_headers]
	nheaders int
}

impl Response {
	// header_value returns the first value of the named header (case-insensitive), or "".
	pub fn header_value(&self, name str) -> str {
		for i := 0; i < self.nheaders; i++ {
			if strings.equal_fold(self.headers[i].name, name) {
				return self.headers[i].value
			}
		}
		return ""
	}

	// num_headers and header_at iterate the response headers (the first max_headers of them).
	pub fn num_headers(&self) -> int       { return self.nheaders }

	pub fn header_at(&self, i int) -> Header { return self.headers[i] }
}

// Client is an HTTP/1.1 client on one keep-alive connection. Responses are read into the buffer
// given to dial or new_client: the status line, headers and body together must fit in it (bodies
// are de-chunked in place), or the request fails with HeaderTooLarge or BodyTooLarge. The
// request line and headers are built in the same buffer before the response arrives; a request
// body is sent from the caller's memory. A Client is used by one goroutine at a time.
//
// After an error the connection is closed, since its state is unknown. A Client from dial then
// dials again for its next request; a GET or HEAD sent on a reused connection that the server had
// closed meanwhile (nothing came back) is sent again on a new one, once.
pub struct Client {
	// timeout bounds the wait for each response, from when its request has been sent to the end
	// of its body (client_timeout by default; 0 or less waits forever). A response that takes
	// longer fails with net.Timeout. Writes and dials aren't bounded.
	pub timeout time.Duration
	// discard_body makes the client read response bodies and drop them: Body stays empty, and a
	// body of any size fits.
	pub discard_body bool

	nc     net.Conn
	open   bool
	reused bool // the connection has carried a response
	got    bool // some of the current response has arrived
	addr   str
	host   str
	buf    u8[]
	r      int // buf[r:n] has been read but not consumed
	n      int
	w      int // the end of the body read so far
}

// dial connects to addr ("host:port"; see net.dial for names and IPv6) and returns a Client
// for it that reads responses into buf. Requests carry addr as their Host header. When the
// connection closes, the next request dials again.
pub fn dial(addr str, buf u8[]) -> Client ! {
	c := Client{timeout: client_timeout, addr: addr, host: addr, buf: buf[:cap(buf)]}
	conn, err := net.dial(addr)
	if err != nil {
		return c, err
	}
	c.nc = conn
	c.open = true
	return c, nil
}

// new_client returns a Client on an open connection, sending host as the Host header. Once the
// connection closes, requests fail with Closed.
pub fn new_client(conn net.Conn, host str, buf u8[]) -> Client {
	return Client{timeout: client_timeout, nc: conn, open: true, host: host, buf: buf[:cap(buf)]}
}

impl Client {
	// conn returns the client's current connection.
	pub fn conn(&self) -> net.Conn { return self.nc }

	// close closes the connection (a Client from dial dials again if used afterwards).
	pub fn close(&self) -> ! {
		if not self.open {
			return nil
		}
		self.open = false
		self.r, self.n = 0, 0
		return self.nc.close()
	}

	// get sends a GET request for path and reads the response.
	pub fn get(&self, path str) -> Response ! {
		return self.do("GET", path, nil, nil)
	}

	// post sends body to path with the given Content-Type and reads the response.
	pub fn post(&self, path str, content_type str, body u8[]) -> Response ! {
		h := Header[1]{{name: "Content-Type", value: content_type}}
		return self.do("POST", path, h[:], body)
	}

	// do sends a request and reads its response. The request carries the Host header, the given
	// headers and, if body isn't empty or the method is POST, PUT or PATCH, a Content-Length and the
	// body (Host, Content-Length and Transfer-Encoding in headers are ignored). A CR, LF or NUL in a
	// header value is sent as a space. A response to HEAD has no body, whatever its headers say;
	// interim 1xx responses are skipped.
	pub fn do(&self, method str, path str, headers Header[], body u8[]) -> Response ! {
		retry := method == "GET" or method == "HEAD"
		for attempt := 0; ; attempt++ {
			if err := self.connect(); err != nil {
				return Response{}, err
			}
			self.compact()
			head, err := append_head(self.buf[self.n:self.n], method, self.host, path, headers, len(body))
			if err != nil {
				return Response{}, err // nothing was sent: the connection is still usable
			}
			resp, again, err := self.exchange(head, body, method == "HEAD", retry and attempt == 0)
			if not again {
				return resp, err
			}
		}
	}

	// round_trip sends req, one complete request (from append_request, say), as it is and reads the
	// response. A load generator can build its requests once and send them many times.
	pub fn round_trip(&self, req u8[]) -> Response ! {
		s := str(req)
		head := strings.has_prefix(s, "HEAD ")
		retry := head or strings.has_prefix(s, "GET ")
		for attempt := 0; ; attempt++ {
			if err := self.connect(); err != nil {
				return Response{}, err
			}
			self.compact()
			resp, again, err := self.exchange(req, nil, head, retry and attempt == 0)
			if not again {
				return resp, err
			}
		}
	}

	// connect dials if the connection has been closed.
	fn connect(&self) -> ! {
		if self.open {
			return nil
		}
		if self.addr == "" {
			return Closed
		}
		conn, err := net.dial(self.addr)
		if err != nil {
			return err
		}
		self.nc = conn
		self.open = true
		self.reused = false
		self.r, self.n = 0, 0
		return nil
	}

	// compact moves bytes read past the last response to the front of the buffer.
	fn compact(&self) {
		if self.r > 0 {
			copy(self.buf, self.buf[self.r:self.n])
			self.n -= self.r
			self.r = 0
		}
	}

	// drop closes the connection after an error or a response that ends it.
	fn drop(&self) {
		if self.open {
			self.nc.close()
			self.open = false
		}
		self.r, self.n = 0, 0
	}

	// exchange writes a then b and reads the response. On an error it closes the connection, and
	// reports whether the request may be sent again on a new one: the old connection was reused, the
	// server sent nothing, and mayRetry says the request is idempotent.
	fn exchange(&self, a u8[], b u8[], head bool, may_retry bool) -> (Response, bool) ! {
		again := may_retry and self.reused and self.addr != ""
		if _, err := self.nc.write2(a, b); err != nil {
			self.drop()
			return Response{}, again, err
		}
		resp, err := self.read_response(head)
		if err != nil {
			again = again and not self.got and err != net.Timeout
			self.drop()
			return resp, again, err
		}
		if resp.close {
			self.drop()
		} else {
			self.reused = true
		}
		return resp, false, nil
	}

	// read_response reads a response from c.buf[0:c.n] and the connection.
	fn read_response(&self, head bool) -> Response ! {
		var resp Response
		deadline := time.now().add(self.timeout)
		self.got = self.n > 0
		h0 := 0 // where the current response head starts (after interim responses)
		loop {
			end, scan := header_end(self.buf[h0:self.n], 0)
			while end == -1 {
				if self.n == len(self.buf) {
					return resp, HeaderTooLarge
				}
				if err := self.fill(deadline); err != nil {
					if err == io.EOF and self.got {
						return resp, io.UnexpectedEOF
					}
					return resp, err
				}
				end, scan = header_end(self.buf[h0:self.n], scan)
			}
			if end < 0 {
				return resp, Malformed
			}
			resp = Response{}
			framing, err := parse_response(str(self.buf[h0:h0+end]), &resp)
			if err != nil {
				return resp, err
			}
			self.r = h0 + end
			if resp.status_code >= 200 or resp.status_code == 101 {
				if head or resp.status_code < 200 or resp.status_code == 204 or resp.status_code == 304 {
					framing = .none
				}
				if resp.status_code == 101 {
					resp.close = true // the connection has switched protocols: this client is done with it
				}
				return self.read_body(resp, framing, deadline)
			}
			h0 = self.r // an interim response (100 Continue, 103 Early Hints): the real one follows
		}
	}

	// read_body reads the body that follows resp's head (at c.r) and sets resp.body.
	fn read_body(&self, resp Response, framing Framing, deadline time.Time) -> Response ! {
		start := self.r
		self.w = start
		var err error
		switch framing {
		case .length:
			err = self.read_fixed(resp.content_length, deadline)
		case .chunked:
			err = self.read_chunked(deadline)
		case .to_close:
			resp.close = true
			while err == nil {
				if self.r == self.n {
					if err = self.fill(deadline); err == io.EOF {
						err = nil
						break
					}
				}
				self.take(self.n - self.r)
			}
		}
		resp.body = self.buf[start:self.w]
		return resp, err
	}

	// fill reads more input into the buffer. It first moves unconsumed input down to the end of the
	// body (c.w), reclaiming the room of chunk headers and of bytes already consumed.
	fn fill(&self, deadline time.Time) -> ! {
		if self.n == len(self.buf) and self.r > self.w {
			copy(self.buf[self.w:], self.buf[self.r:self.n])
			self.n -= self.r - self.w
			self.r = self.w
		}
		if self.n == len(self.buf) {
			return BodyTooLarge
		}
		m := 0
		var err error
		if self.timeout <= 0 {
			m, err = self.nc.read(self.buf[self.n:])
		} else {
			left := deadline.sub(time.now())
			if left <= 0 {
				return net.Timeout
			}
			m, err = self.nc.read_timeout(self.buf[self.n:], left)
		}
		if err != nil {
			return err
		}
		self.got = true
		self.n += m
		return nil
	}

	// take consumes k bytes of body at c.r, moving them to c.w (or dropping them with discard_body).
	fn take(&self, k int) {
		if not self.discard_body {
			if self.w != self.r {
				copy(self.buf[self.w:self.w+k], self.buf[self.r:self.r+k])
			}
			self.w += k
		}
		self.r += k
	}

	// read_fixed reads need bytes of body.
	fn read_fixed(&self, need int, deadline time.Time) -> ! {
		while need > 0 {
			if self.r == self.n {
				if err := self.fill(deadline); err != nil {
					if err == io.EOF {
						return io.UnexpectedEOF
					}
					return err
				}
			}
			k := min(need, self.n-self.r)
			self.take(k)
			need -= k
		}
		return nil
	}

	// read_line consumes a CRLF-terminated line of a chunked body and returns it without the CRLF.
	fn read_line(&self, deadline time.Time) -> str ! {
		scan := self.r
		loop {
			i := strings.index_byte(str(self.buf[scan:self.n]), '\n')
			if i >= 0 {
				end := scan + i
				if end == self.r or self.buf[end-1] != '\r' {
					return "", Malformed
				}
				line := str(self.buf[self.r : end-1])
				self.r = end + 1
				return line, nil
			}
			scanned := self.n - self.r
			if err := self.fill(deadline); err != nil {
				if err == io.EOF {
					return "", io.UnexpectedEOF
				}
				return "", err
			}
			scan = self.r + scanned // fill may have moved the line down
		}
	}

	// read_chunked reads a chunked body, then its trailers (which are dropped).
	fn read_chunked(&self, deadline time.Time) -> ! {
		loop {
			line, err := self.read_line(deadline)
			if err != nil {
				return err
			}
			size := parse_chunk_size(line)
			if size < 0 {
				return Malformed
			}
			if size == 0 {
				break
			}
			if err := self.read_fixed(size, deadline); err != nil {
				return err
			}
			crlf, err := self.read_line(deadline)
			if err != nil {
				return err
			}
			if crlf != "" {
				return Malformed
			}
		}
		loop {
			line, err := self.read_line(deadline)
			if err != nil {
				return err
			}
			if line == "" {
				return nil
			}
		}
	}
}

// append_request appends a request to dst as do would send it, for round_trip. It fails with
// RequestTooLarge, appending nothing, if the request doesn't fit in cap(dst).
pub fn append_request(dst u8[], method str, host str, path str, headers Header[], body u8[]) -> u8[] ! {
	out, err := append_head(dst, method, host, path, headers, len(body))
	if err != nil {
		return dst, err
	}
	if method != "POST" and method != "PUT" and method != "PATCH" and len(body) == 0 {
		return out, nil
	}
	if len(out)+len(body) > cap(out) {
		return dst, RequestTooLarge
	}
	return append(out, body...), nil
}

// append_head appends the request line and headers (with a Content-Length when the request has a
// body), or fails without appending.
fn append_head(dst u8[], method str, host str, path str, headers Header[], body_len int) -> u8[] ! {
	if not is_token(method) or len(path) == 0 or has_ctl(path) or strings.index_byte(path, ' ') >= 0 or strings.index_byte(path, '\t') >= 0 {
		return dst, InvalidRequest
	}
	for i := 0; i < len(headers); i++ {
		if not is_token(headers[i].name) {
			return dst, InvalidRequest
		}
	}
	ok := true
	b := dst
	b, ok = put(b, method, ok)
	b, ok = put(b, " ", ok)
	b, ok = put(b, path, ok)
	b, ok = put(b, " HTTP/1.1\r\nHost: ", ok)
	b, ok = put_value(b, host, ok)
	for i := 0; i < len(headers); i++ {
		name := headers[i].name
		if strings.equal_fold(name, "Host") or strings.equal_fold(name, "Content-Length") or strings.equal_fold(name, "Transfer-Encoding") {
			continue
		}
		b, ok = put(b, "\r\n", ok)
		b, ok = put(b, name, ok)
		b, ok = put(b, ": ", ok)
		b, ok = put_value(b, headers[i].value, ok)
	}
	if body_len > 0 or method == "POST" or method == "PUT" or method == "PATCH" {
		var num u8[24]
		b, ok = put(b, "\r\nContent-Length: ", ok)
		b, ok = put(b, str(append_decimal(num[:0], body_len)), ok)
	}
	b, ok = put(b, "\r\n\r\n", ok)
	if not ok {
		return dst, RequestTooLarge
	}
	return b, nil
}

// put appends s to dst if it fits in cap(dst) and ok is still true.
fn put(dst u8[], s str, ok bool) -> (u8[], bool) {
	if not ok or len(s) > cap(dst)-len(dst) {
		return dst, false
	}
	return append(dst, s...), true
}

// put_value is put for a header value: a CR, LF or NUL becomes a space.
fn put_value(dst u8[], s str, ok bool) -> (u8[], bool) {
	start := len(dst)
	dst, ok = put(dst, s, ok)
	if ok {
		for i := start; i < len(dst); i++ {
			if dst[i] == '\r' or dst[i] == '\n' or dst[i] == 0 {
				dst[i] = ' '
			}
		}
	}
	return dst, ok
}

fn append_decimal(dst u8[], v int) -> u8[] {
	var tmp u8[20]
	i := len(tmp)
	loop {
		i--
		tmp[i] = u8('0' + v%10)
		v /= 10
		if v == 0 {
			break
		}
	}
	return append(dst, tmp[i:]...)
}

// Framing is how a response's body is delimited (RFC 9112 section 6.3).
enum Framing { none, length, chunked, to_close }

// parse_chunk_size parses a chunk-size line (hex digits, then optional extensions after ';'). It
// returns -1 if the line isn't one.
fn parse_chunk_size(line str) -> int {
	s, _, _ := strings.cut(line, ";")
	s = trim_ows(s)
	if len(s) == 0 or len(s) > 15 { // 15 hex digits can't overflow an int
		return -1
	}
	n := 0
	for i := 0; i < len(s); i++ {
		c := s[i]
		d := 0
		switch {
		case c >= '0' and c <= '9':
			d = int(c - '0')
		case c >= 'a' and c <= 'f':
			d = int(c-'a') + 10
		case c >= 'A' and c <= 'F':
			d = int(c-'A') + 10
		default:
			return -1
		}
		n = n*16 + d
	}
	return n
}

// parse_response parses a response head (which header_end has checked for stray CRs and LFs) into
// r, and returns how its body is framed.
fn parse_response(head str, r *Response) -> Framing ! {
	line, rest, _ := strings.cut(head, "\r\n")
	proto, after, ok := strings.cut(line, " ")
	code, reason, _ := strings.cut(after, " ")
	if not ok or len(proto) != 8 or not strings.has_prefix(proto, "HTTP/1.") or proto[7] < '0' or proto[7] > '9' {
		return .none, Malformed
	}
	if len(code) != 3 or has_ctl(reason) {
		return .none, Malformed
	}
	status := 0
	for i := 0; i < 3; i++ {
		if code[i] < '0' or code[i] > '9' {
			return .none, Malformed
		}
		status = status*10 + int(code[i]-'0')
	}
	if status < 100 {
		return .none, Malformed
	}
	r.status_code = status
	r.reason = reason
	r.proto = proto
	r.content_length = -1
	r.close = proto == "HTTP/1.0" // HTTP/1.0 closes unless the server says keep-alive
	saw_length := false
	chunked := false
	coded := false // a Transfer-Encoding other than chunked: the body ends with the connection
	while len(rest) > 0 {
		hl, more, _ := strings.cut(rest, "\r\n")
		rest = more
		if len(hl) == 0 {
			break
		}
		name, value, ok := strings.cut(hl, ":")
		if not ok or not is_token(name) {
			return .none, Malformed
		}
		value = trim_ows(value)
		if has_ctl(value) {
			return .none, Malformed
		}
		if r.nheaders < max_headers {
			r.headers[r.nheaders] = Header{name: name, value: value}
			r.nheaders++
		}
		switch {
		case strings.equal_fold(name, "Content-Length"):
			cl := parse_length(value)
			if cl < 0 or saw_length and cl != r.content_length {
				return .none, Malformed
			}
			saw_length = true
			r.content_length = cl
		case strings.equal_fold(name, "Transfer-Encoding"):
			// the final coding decides: chunked frames the body, anything else runs to the close
			last := value
			if i := strings.last_index_byte(value, ','); i >= 0 {
				last = value[i+1:]
			}
			chunked = strings.equal_fold(trim_ows(last), "chunked")
			coded = not chunked
		case strings.equal_fold(name, "Connection"):
			if has_token(value, "close") {
				r.close = true
			} else if has_token(value, "keep-alive") {
				r.close = false
			}
		}
	}
	switch {
	case chunked:
		r.content_length = -1
		return .chunked, nil
	case coded:
		r.content_length = -1
		return .to_close, nil
	case saw_length:
		return .length, nil
	}
	return .to_close, nil
}
