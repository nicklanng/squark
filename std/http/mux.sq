module http

use strconv, strings

// max_routes is how many patterns handle_func can register.
pub const max_routes = 64

// max_path_params is how many {name} wildcards one pattern may have.
pub const max_path_params = 8

const max_segments = 16

// Segment is one /-separated piece of a pattern: a literal, or a {name} wildcard.
struct Segment {
	lit   str
	param str
}

struct Route {
	pattern   str
	method    str // "" matches every method
	segs      Segment[max_segments]
	nsegs     int
	rest      str  // {name...}: the last segment matches the rest of the path
	subtree   bool // the pattern ends in "/" (without {$}): everything below it matches
	slash_end bool // the pattern ends in "/{$}": only the path ending in that "/" matches
	h         HandlerFunc
}

// routes are the patterns handle_func registered (with threads, each scheduler thread registers
// its own when it runs main).
thread routes Route[..max_routes]

// handle_func registers h for pattern ("GET /notes/{id}", "/static/{path...}"). Serve with
// listen_and_serve(addr, nil) to dispatch to the registered patterns.
//
// A pattern is [METHOD ]PATH. A method matches only that method ("GET" also matches HEAD); without
// one every method matches. PATH is a sequence of /-separated segments, each a literal or a
// wildcard: {name} matches one segment, {name...} (last) matches the rest of the path, and {$}
// (last) matches only the path ending there. A path ending in / matches every path below it
// ("/static/" matches "/static/a/b"); "/{$}" matches only "/". Wildcard values are read with
// Request.path_value or path_int.
//
// When several patterns match, the most specific wins: literal segments before wildcards, an
// exact path before a subtree, a longer subtree before a shorter, the request's own method before
// GET for a HEAD, and a method before none. A path that matches only patterns for other methods
// gets 405 method Not Allowed with an Allow header; one that matches none gets 404 Not Found. A
// path with a . or .. segment (raw or %2e) gets 400 Bad Request, so {name...} never holds one. Registering a malformed or duplicate pattern, or more
// than max_routes, panics.
pub fn handle_func(pattern str, h HandlerFunc) {
	var rt Route
	rt.pattern = pattern
	rt.h = h
	p := pattern
	if sp := strings.index_byte(p, ' '); sp >= 0 {
		rt.method = p[:sp]
		p = strings.trim_space(p[sp+1:])
		if not is_token(rt.method) {
			panic("http.HandleFunc: invalid method in pattern")
		}
	}
	if len(p) == 0 or p[0] != '/' {
		panic("http.HandleFunc: a pattern's path must start with /")
	}
	p = p[1:]
	nparams := 0
	while len(p) > 0 {
		seg := p
		more := false
		if i := strings.index_byte(p, '/'); i >= 0 {
			seg, p, more = p[:i], p[i+1:], true
		} else {
			p = ""
		}
		if len(seg) >= 2 and seg[0] == '{' and seg[len(seg)-1] == '}' {
			name := seg[1 : len(seg)-1]
			switch {
			case name == "$":
				if more or len(p) > 0 {
					panic("http.HandleFunc: {$} must end the pattern")
				}
				rt.subtree, rt.slash_end = false, true
				add_route(rt)
				return
			case strings.has_suffix(name, "..."):
				if more {
					panic("http.HandleFunc: {name...} must end the pattern")
				}
				rt.rest = name[:len(name)-3]
				if not is_wildcard_name(rt.rest) {
					panic("http.HandleFunc: invalid wildcard name in pattern")
				}
				rt.subtree = false
				add_route(rt)
				return
			default:
				if not is_wildcard_name(name) {
					panic("http.HandleFunc: invalid wildcard name in pattern")
				}
				nparams++
				if nparams > max_path_params {
					panic("http.HandleFunc: too many wildcards in one pattern (MaxPathParams)")
				}
				add_segment(&rt, Segment{param: name})
			}
		} else {
			if strings.index_byte(seg, '{') >= 0 or strings.index_byte(seg, '}') >= 0 {
				panic("http.HandleFunc: a wildcard must be a whole segment")
			}
			if seg == "" and more {
				panic("http.HandleFunc: empty segment (//) in pattern")
			}
			if seg != "" {
				add_segment(&rt, Segment{lit: seg})
			}
		}
		if more and len(p) == 0 {
			rt.subtree = true // ends in "/"
		}
	}
	if rt.nsegs == 0 {
		rt.subtree = true // "/" matches everything
	}
	add_route(rt)
}

fn add_segment(rt *Route, s Segment) {
	if rt.nsegs == max_segments {
		panic("http.HandleFunc: too many segments in pattern")
	}
	rt.segs[rt.nsegs] = s
	rt.nsegs++
}

fn add_route(rt Route) {
	for i in 0..len(routes) {
		if same_route(&routes[i], &rt) {
			panic("http.HandleFunc: pattern registered twice")
		}
	}
	if len(routes) == max_routes {
		panic("http.HandleFunc: more than MaxRoutes patterns")
	}
	routes.push(rt)
}

// same_route reports two patterns that match exactly the same requests.
fn same_route(a, b *Route) -> bool {
	if a.method != b.method or a.nsegs != b.nsegs or a.subtree != b.subtree or a.slash_end != b.slash_end or (a.rest == "") != (b.rest == "") {
		return false
	}
	for i in 0..a.nsegs {
		if (a.segs[i].param == "") != (b.segs[i].param == "") or a.segs[i].lit != b.segs[i].lit {
			return false
		}
	}
	return true
}

fn is_wildcard_name(s str) -> bool {
	if s == "" {
		return false
	}
	for i in 0..len(s) {
		c := s[i]
		if not (c == '_' or c >= 'a' and c <= 'z' or c >= 'A' and c <= 'Z' or i > 0 and c >= '0' and c <= '9') {
			return false
		}
	}
	return true
}

impl Route {
	// match reports whether rt's path matches path, and records the wildcard values in r.
	fn match(&self, path str, r *Request) -> bool {
		if len(path) == 0 or path[0] != '/' {
			return false
		}
		r.nparams, r.decoded = 0, 0
		p := path[1:]
		slash := self.nsegs == 0 // whether the last segment matched was followed by "/" ("/" counts)
		for i in 0..self.nsegs {
			if p == "" {
				return false // the path is shorter than the pattern
			}
			seg := p
			slash = false
			if j := strings.index_byte(p, '/'); j >= 0 {
				seg, p, slash = p[:j], p[j+1:], true
			} else {
				p = ""
			}
			if s := self.segs[i]; s.param != "" {
				if seg == "" {
					return false
				}
				r.add_param(s.param, seg)
			} else if not seg_equal(seg, s.lit) {
				return false
			}
		}
		switch {
		case self.rest != "": // "/files/{path...}" matches "/files/" and below, not "/files"
			if not slash {
				return false
			}
			r.add_param(self.rest, p)
			return true
		case self.slash_end: // "/notes/{$}" matches only "/notes/"
			return slash and p == ""
		case self.subtree: // "/static/" matches "/static/" and below
			return slash
		}
		return not slash and p == "" // exact
	}
}

// seg_equal compares a raw path segment, %XX escapes and all, with a literal.
fn seg_equal(raw, lit str) -> bool {
	j := 0
	for i := 0; i < len(raw); i++ {
		c := raw[i]
		if c == '%' and i+2 < len(raw) and is_hex(raw[i+1]) and is_hex(raw[i+2]) {
			c = unhex(raw[i+1])<<4 | unhex(raw[i+2])
			i += 2
		}
		if j >= len(lit) or lit[j] != c {
			return false
		}
		j++
	}
	return j == len(lit)
}

// more_specific reports whether a should win over b when both match a request with method.
fn more_specific(a, b *Route, method str) -> bool {
	n := min(a.nsegs, b.nsegs)
	for i in 0..n {
		al, bl := a.segs[i].param == "", b.segs[i].param == ""
		if al != bl {
			return al // a literal before a wildcard
		}
	}
	a_exact := not a.subtree and a.rest == "" // slash_end counts as exact
	b_exact := not b.subtree and b.rest == ""
	if a_exact != b_exact {
		return a_exact // an exact path before a subtree or {rest...}
	}
	if a.nsegs != b.nsegs {
		return a.nsegs > b.nsegs // a longer prefix before a shorter
	}
	if (a.rest != "") != (b.rest != "") {
		return a.rest != "" // {rest...} names its tail; equal otherwise
	}
	if (a.method == method) != (b.method == method) {
		return a.method == method // HEAD /x before GET /x for a HEAD
	}
	return a.method != "" and b.method == ""
}

// has_dot_segment reports whether path has a "." or ".." segment, raw or escaped (%2e): the mux
// answers 400 rather than pass one to a {name...} wildcard, where it could climb out of a directory.
fn has_dot_segment(path str) -> bool {
	while len(path) > 0 {
		seg, rest, _ := strings.cut(path, "/")
		if seg_equal(seg, ".") or seg_equal(seg, "..") {
			return true
		}
		path = rest
	}
	return false
}

impl Request {
	fn add_param(&self, name, value str) {
		if self.nparams < len(self.params) {
			self.params[self.nparams] = Header{name: name, value: value}
			self.nparams++
		}
	}

	// path_value returns the value of the {name} or {name...} wildcard in the pattern that matched
	// this request, unescaped (%XX), or "" if there is none.
	pub fn path_value(&self, name str) -> str in self {
		for i in 0..self.nparams {
			if self.params[i].name == name {
				// decoded once: calling it again takes no more of the request's arena
				if self.decoded & (1 << i) == 0 {
					self.params[i].value = unescape(self.params[i].value, false, self.arena)
					self.decoded |= 1 << i
				}
				return self.params[i].value
			}
		}
		return ""
	}

	// path_int returns the {name} wildcard as a decimal integer; ok is false if it is missing or isn't
	// one (the handler decides what that means: usually http.send_error(w, 404)).
	pub fn path_int(&self, name str) -> (int, bool) {
		return atoi_strict(self.path_value(name))
	}

	// query_param returns the value of key in the query string, unescaped (%XX, and + as a space), or
	// "" (query_value returns it raw). An unescaped copy is made in the request's arena only when the
	// value has escapes.
	pub fn query_param(&self, key str) -> str in self {
		return unescape(self.query_value(key), true, self.arena)
	}

	// query_int returns the query value of key as a decimal integer; ok is false if it is missing or
	// isn't one.
	pub fn query_int(&self, key str) -> (int, bool) {
		return atoi_strict(self.query_param(key))
	}
}

fn method_matches(pattern, method str) -> bool {
	return pattern == "" or pattern == method or pattern == "GET" and method == "HEAD"
}

// serve_mux dispatches to the patterns handle_func registered (listen_and_serve(addr, nil)).
fn serve_mux(w *ResponseWriter, r *Request) {
	if has_dot_segment(r.path) {
		send_error(w, 400)
		return
	}
	best := -1
	var allow str[..max_routes]
	for i in 0..len(routes) {
		rt := &routes[i]
		if not rt.match(r.path, r) {
			continue
		}
		if not method_matches(rt.method, r.method) {
			allow.try_push(rt.method)
			continue
		}
		if best < 0 or more_specific(rt, &routes[best], r.method) {
			best = i
		}
	}
	if best < 0 {
		if len(allow) == 0 {
			send_error(w, 404)
			return
		}
		var buf u8[256]
		b := buf[:0]
		for i, m in allow {
			if i > 0 {
				b = append(b, ", "...)
			}
			if len(b)+len(m)+6 > len(buf) {
				break
			}
			b = append(b, m...)
			if m == "GET" {
				b = append(b, ", HEAD"...)
			}
		}
		w.set_header("Allow", str(b))
		send_error(w, 405)
		return
	}
	routes[best].match(r.path, r) // the winner's wildcard values
	routes[best].h(w, r)
}

fn atoi_strict(s str) -> (int, bool) {
	if s == "" {
		return 0, false
	}
	n, err := strconv.atoi(s)
	return n, err == nil
}

// unescape decodes %XX escapes (and + as a space, for queries) into memory from a; s itself is
// returned when there is nothing to decode. A % not followed by two hex digits is kept as it is.
fn unescape(s str, plus bool, a arena) -> str in s, a {
	need := false
	n := len(s) // the decoded length: each %XX is one byte
	for i in 0..len(s) {
		if s[i] == '%' and i+2 < len(s) and is_hex(s[i+1]) and is_hex(s[i+2]) {
			need = true
			n -= 2
		} else if plus and s[i] == '+' {
			need = true
		}
	}
	if not need {
		return s
	}
	b := make(u8[], n) in a
	k := 0
	for i := 0; i < len(s); i++ {
		c := s[i]
		switch {
		case c == '%' and i+2 < len(s) and is_hex(s[i+1]) and is_hex(s[i+2]):
			c = unhex(s[i+1])<<4 | unhex(s[i+2])
			i += 2
		case c == '+' and plus:
			c = ' '
		}
		b[k] = c
		k++
	}
	return str(b[:k])
}

fn is_hex(c u8) -> bool { return c >= '0' and c <= '9' or c >= 'a' and c <= 'f' or c >= 'A' and c <= 'F' }

fn unhex(c u8) -> u8 {
	switch {
	case c >= 'a':
		return c - 'a' + 10
	case c >= 'A':
		return c - 'A' + 10
	}
	return c - '0'
}

// Error replies with status code and its standard text as a plain-text body ("404 Not Found").
// It doesn't end the handler: return after calling it.
pub fn send_error(w *ResponseWriter, code int) {
	w.set_header("Content-Type", "text/plain; charset=utf-8")
	w.write_header(code)
	w.write_int(code)
	w.write_byte(' ')
	w.write_string(status_text(code))
	w.write_byte('\n')
}

impl ResponseWriter {
	// text replies with status code and s as a plain-text body.
	pub fn text(&self, code int, s str) {
		self.set_header("Content-Type", "text/plain; charset=utf-8")
		self.write_header(code)
		self.write_string(s)
	}

	// content_type sets the response's Content-Type header.
	pub fn content_type(&self, t str) {
		self.set_header("Content-Type", t)
	}
}

thread port_buf u8[8]

// port returns the listen address ":n" for listen_and_serve(http.port(8080), nil). The string is in
// a buffer the next call reuses.
pub fn port(n int) -> str {
	return str(strconv.append_int(append(port_buf[:0], ':'), n))
}
