// Package http is an HTTP/1.1 server and client. The server runs each connection in its own
// goroutine, whose read and write buffers live on its (statically sized) stack: no allocation per
// request. The client (Dial, Client) reads responses into a buffer the caller provides.
module http

use json, metrics, net, runtime, strconv, strings, time

const (
	// read_buffer_size bounds request line + headers + body.
	pub read_buffer_size = 16384
	// write_buffer_size is the response staging buffer; larger bodies stream as chunks.
	pub write_buffer_size = 16384
	// request_arena_size is the per-request arena (Request.arena), freed when the response is done.
	pub request_arena_size = 16K
	header_buffer_size     = 1024
	pub max_headers        = 32
)

// idle_release is how long a keep-alive connection may sit idle before its goroutine exits and the
// connection moves to the runtime's idle set (where it costs no stack until its next request).
pub const idle_release = 100 * time.millisecond

// read_header_timeout (5 seconds) is how long a client has to send a request's line and headers,
// counted from when the request starts arriving. A connection that takes longer gets a 408 and is
// closed, so slow clients can't hold connection goroutines. Set it in main before serving (with
// threads, each scheduler thread runs main and sets its own copy).
pub thread read_header_timeout = 5 * time.second

// read_timeout (10 seconds) is how long a client has to send a whole request, headers and body,
// counted the same way. A connection that takes longer gets a 408 and is closed.
pub thread read_timeout = 10 * time.second

pub struct Header {
	pub name  str
	pub value str
}

// Request fields are views into the connection's read buffer, valid until the handler returns.
pub struct Request {
	pub method         str
	pub path           str
	pub query          str
	pub proto          str
	pub body           u8[]
	pub content_length int

	// arena is scratch memory for this request: allocate with `x in r.arena`. Everything in it is
	// gone once the response has been written.
	pub arena arena

	headers    Header[max_headers]
	nheaders   int
	params     Header[max_path_params + 1] // the matched pattern's wildcard values (see handle_func)
	nparams    int
	keep_alive bool
	http10     bool
	expect100  bool
}

impl Request {
	// header_value returns the first value of the named header (case-insensitive), or "".
	pub fn header_value(&self, name str) -> str {
		for i := 0; i < self.nheaders; i++ {
			if strings.equal_fold(self.headers[i].name, name) {
				return self.headers[i].value
			}
		}
		return ""
	}

	// num_headers and header_at iterate the request headers.
	pub fn num_headers(&self) -> int        { return self.nheaders }

	pub fn header_at(&self, i int) -> Header  { return self.headers[i] }

	// query_value returns the raw (not unescaped) value of key in the query string; query_param
	// unescapes it.
	pub fn query_value(&self, key str) -> str {
		q := self.query
		while len(q) > 0 {
			pair := q
			if i := strings.index_byte(q, '&'); i >= 0 {
				pair = q[:i]
				q = q[i+1:]
			} else {
				q = ""
			}
			k, v, _ := strings.cut(pair, "=")
			if k == key {
				return v
			}
		}
		return ""
	}
}

// ResponseWriter stages the response in the connection goroutine's write buffer.
pub struct ResponseWriter {
	conn         net.Conn
	buf          u8[]
	hdr          u8[]
	status_code  int
	wrote_header bool
	chunked      bool
	keep_alive   bool
	head         bool
	failed       bool
	has_type     bool
	http10       bool         // an HTTP/1.0 request: no chunked encoding
	crlf         bool         // a chunk's data went out; its closing CRLF leads the next write
	dropped      int          // body bytes not sent: HEAD (counted for Content-Length) or a status without a body
	scratch      arena        // the request's arena (for JSON's buffer)
	enc          json.Encoder // JSON's state
}

impl ResponseWriter {
	// set_header adds a response header. Content-Length, Transfer-Encoding and Date are managed for
	// you and ignored here, as is a name that isn't an HTTP token. "Connection: close" closes the
	// connection after the response. A CR, LF or NUL in value is sent as a space, so a value (say,
	// echoed from the request) can't start a header of its own.
	pub fn set_header(&self, name, value str) {
		if self.wrote_header or not is_token(name) {
			return
		}
		switch {
		case strings.equal_fold(name, "Content-Type"):
			self.has_type = true
		case strings.equal_fold(name, "Content-Length"), strings.equal_fold(name, "Transfer-Encoding"), strings.equal_fold(name, "Date"):
			return
		case strings.equal_fold(name, "Connection"):
			if has_token(value, "close") {
				self.keep_alive = false
			}
			return
		}
		if len(self.hdr)+len(name)+len(value)+4 > cap(self.hdr) {
			return
		}
		self.hdr = append(self.hdr, name...)
		self.hdr = append(self.hdr, ':', ' ')
		for i := 0; i < len(value); i++ {
			c := value[i]
			if c == '\r' or c == '\n' or c == 0 {
				c = ' '
			}
			self.hdr = append(self.hdr, c)
		}
		self.hdr = append(self.hdr, '\r', '\n')
	}

	// write_header sets the status code (it is sent with the first flush). A code outside 100..999 is
	// sent as 500. Once part of the body has been flushed, the status can't change.
	pub fn write_header(&self, code int) {
		if self.wrote_header or self.dropped > 0 {
			return
		}
		if code < 100 or code > 999 {
			code = 500
		}
		self.status_code = code
	}

	// bodyless reports whether the status forbids a body (1xx, 204 and 304).
	fn bodyless(&self) -> bool {
		return self.status_code < 200 or self.status_code == 204 or self.status_code == 304
	}

	pub fn write(&self, p u8[]) -> int ! {
		n := 0
		while n < len(p) {
			if len(self.buf) == cap(self.buf) {
				self.spill()
			}
			k := min(len(p)-n, cap(self.buf)-len(self.buf))
			self.buf = append(self.buf, p[n:n+k]...)
			n += k
		}
		return n, nil
	}

	pub fn write_string(&self, s str) -> int ! {
		n := 0
		while n < len(s) {
			if len(self.buf) == cap(self.buf) {
				self.spill()
			}
			k := min(len(s)-n, cap(self.buf)-len(self.buf))
			self.buf = append(self.buf, s[n:n+k]...)
			n += k
		}
		return n, nil
	}

	pub fn write_byte(&self, c u8) -> ! {
		if len(self.buf) == cap(self.buf) {
			self.spill()
		}
		self.buf = append(self.buf, c)
		return nil
	}

	pub fn write_int(&self, v int) {
		var tmp u8[24]
		self.write(strconv.append_int(tmp[:0], v))
	}

	// status returns the status code that will be (or was) sent.
	pub fn status(&self) -> int { return self.status_code }
}

extern fn http_date(dst u8[]) -> int stack 8K c"sq_httpdate"

impl ResponseWriter {
	fn status_line(&self, dst u8[]) -> u8[] {
		dst = append(dst, "HTTP/1.1 "...)
		dst = strconv.append_int(dst, self.status_code)
		dst = append(dst, ' ')
		dst = append(dst, status_text(self.status_code)...)
		dst = append(dst, "\r\nDate: "...)
		var date u8[32]
		n := http_date(date[:])
		dst = append(dst, date[:n]...)
		dst = append(dst, "\r\n"...)
		if runtime.stopping() {
			self.keep_alive = false // a graceful stop began while the handler ran
		}
		if not self.keep_alive {
			dst = append(dst, "Connection: close\r\n"...)
		} else if self.http10 {
			dst = append(dst, "Connection: keep-alive\r\n"...) // HTTP/1.0 closes without it
		}
		if not self.has_type and not self.bodyless() {
			dst = append(dst, "Content-Type: text/plain; charset=utf-8\r\n"...)
		}
		return dst
	}

	// spill empties a full w.buf: it sends it as a chunk, or, when the response has no body (HEAD, or
	// a status like 204), only counts it.
	fn spill(&self) {
		if self.head or self.bodyless() {
			self.dropped += len(self.buf)
			self.buf = self.buf[:0]
			return
		}
		self.flush_chunk()
	}

	// flush_chunk sends the buffered body as a chunk, switching to chunked encoding if needed. An
	// HTTP/1.0 client doesn't know chunks: its body is sent as is, and ends when the connection closes.
	fn flush_chunk(&self) {
		var head u8[header_buffer_size + 256]
		h := head[:0]
		if not self.wrote_header {
			self.wrote_header = true
			if self.http10 {
				self.keep_alive = false
			} else {
				self.chunked = true
			}
			h = self.status_line(h)
			h = append(h, self.hdr...)
			if self.chunked {
				h = append(h, "Transfer-Encoding: chunked\r\n"...)
			}
			h = append(h, "\r\n"...)
		}
		if self.crlf {
			h = append(h, "\r\n"...)
			self.crlf = false
		}
		if len(self.buf) > 0 and self.chunked {
			// w.buf may be full, so the chunk's CRLF is sent with the next write instead
			h = append_hex(h, len(self.buf))
			h = append(h, "\r\n"...)
			self.crlf = true
		}
		if _, err := self.conn.write2(h, self.buf); err != nil {
			self.failed = true
		}
		self.buf = self.buf[:0]
	}

	// finish sends whatever remains of the response.
	fn finish(&self) {
		if self.wrote_header and not self.chunked { // HTTP/1.0, unframed: the rest of the body, then close
			if len(self.buf) > 0 {
				if _, err := self.conn.write(self.buf); err != nil {
					self.failed = true
				}
			}
			return
		}
		if self.chunked {
			const term = "\r\n0\r\n\r\n"
			if len(self.buf) > 0 and cap(self.buf)-len(self.buf) < len(term) {
				self.flush_chunk() // no room for the terminator after the data
			}
			var tail u8[32]
			t := tail[:0]
			if self.crlf {
				t = append(t, "\r\n"...)
			}
			if len(self.buf) > 0 {
				t = append_hex(t, len(self.buf))
				t = append(t, "\r\n"...)
				self.buf = append(self.buf, term...)
			} else {
				t = append(t, "0\r\n\r\n"...)
			}
			if _, err := self.conn.write2(t, self.buf); err != nil {
				self.failed = true
			}
			return
		}
		var head u8[header_buffer_size + 256]
		h := self.status_line(head[:0])
		h = append(h, self.hdr...)
		body := self.buf
		if self.bodyless() {
			body = self.buf[:0]
		} else {
			h = append(h, "Content-Length: "...)
			h = strconv.append_int(h, self.dropped+len(self.buf))
			h = append(h, "\r\n"...)
		}
		h = append(h, "\r\n"...)
		if self.head {
			body = self.buf[:0]
		}
		if _, err := self.conn.write2(h, body); err != nil {
			self.failed = true
		}
	}
}

fn append_hex(dst u8[], v int) -> u8[] {
	const digits = "0123456789abcdef"
	var tmp u8[16]
	i := len(tmp)
	loop {
		i--
		tmp[i] = digits[v&15]
		v >>= 4
		if v == 0 {
			break
		}
	}
	return append(dst, tmp[i:]...)
}

// HandlerFunc handles one request.
pub HandlerFunc: fn(w *ResponseWriter, r *Request)

// listen_and_serve listens on addr and serves each connection in its own goroutine. With a nil h it
// dispatches to the patterns registered with handle_func. It returns nil after a graceful stop
// (see serve).
pub fn listen_and_serve(addr str, h HandlerFunc) -> ! {
	l, err := net.listen(addr)
	if err != nil {
		return err
	}
	return serve(l, h)
}

// max_servers is how many serve calls one process may run.
pub const max_servers = 16

pub fault TooManyServers 503 "http: too many servers in one process"

// handlers holds each running server's handler; idle connections are tagged with its index.
thread handlers HandlerFunc[..max_servers]
thread waker_started bool

// active counts this thread's connections being served (not those in the idle set).
thread active int

// The server's metrics (see metrics.write_text and handle_metrics): requests by status class, and
// handlers that panicked.
thread requests = Counter5{
	c1: metrics.counter("http_requests_total", `code="1xx"`, "HTTP requests answered, by status class."),
	c2: metrics.counter("http_requests_total", `code="2xx"`, "HTTP requests answered, by status class."),
	c3: metrics.counter("http_requests_total", `code="3xx"`, "HTTP requests answered, by status class."),
	c4: metrics.counter("http_requests_total", `code="4xx"`, "HTTP requests answered, by status class."),
	c5: metrics.counter("http_requests_total", `code="5xx"`, "HTTP requests answered, by status class."),
}
thread handler_panics = metrics.counter("http_handler_panics_total", "", "HTTP handlers that panicked (the connection is closed).")

struct Counter5 {
	c1, c2, c3, c4, c5 metrics.Counter
}

fn count_status(code int) {
	switch code / 100 {
	case 1:
		requests.c1.inc()
	case 2:
		requests.c2.inc()
	case 3:
		requests.c3.inc()
	case 4:
		requests.c4.inc()
	default:
		requests.c5.inc()
	}
}

// handle_metrics serves metrics.write_text at pattern ("GET /metrics"): the program's metrics, the
// server's and the runtime's, in Prometheus' text format.
pub fn handle_metrics(pattern str in static) {
	handle_func(pattern, serve_metrics)
}

fn serve_metrics(w *ResponseWriter, r *Request) {
	w.content_type("text/plain; version=0.0.4; charset=utf-8")
	metrics.write_text(w)
}

// not_ready is what /readyz on the admin port says, besides a graceful stop: a gauge, so every
// thread (threads N) sees the same one.
thread not_ready = metrics.gauge("http_not_ready", "", "1 while the program says it isn't ready (http.set_ready(false)).")

// set_ready sets what the admin port's /readyz reports (true at start): false while the program
// can't serve (warming a cache, a dependency down), so a load balancer sends it nothing. During a
// graceful stop /readyz is 503 whatever this says.
pub fn set_ready(r bool) {
	if r {
		not_ready.set(0)
	} else {
		not_ready.set(1)
	}
}

// serve_admin listens on addr and serves, from a small pool of its own (so a full serve_conn pool
// can't make probes fail): GET /healthz (200 while the program runs), GET /readyz (200, or 503
// during a graceful stop or after set_ready(false)) and GET /metrics (handle_metrics). It keeps
// answering during a graceful stop, until the program exits. It returns once listening; call it
// before listen_and_serve. Kubernetes: point livenessProbe at /healthz, readinessProbe at /readyz.
pub fn serve_admin(addr str) -> ! {
	l := net.listen(addr)!
	start admin_accept(l)
	return nil
}

task admin_accept(l net.Listener) pool 1 {
	loop {
		c, err := l.accept_always()
		if err != nil {
			if err.code() == 24 or err.code() == 23 or err.code() == 53 or err.code() == 54 {
				continue
			}
			return
		}
		start admin_conn(c) else {
			c.close() // two probes at once already: this one can try again
		}
	}
}

task admin_conn(c net.Conn) pool 2 isolate {
	var rbuf u8[4K]
	var wbuf u8[8K]
	n := 0
	loop {
		if n == 0 and not c.wait_readable(5 * time.second) {
			c.close()
			return
		}
		ok := false
		n, ok = serve_request(c, admin_handle, rbuf[:], n, wbuf[:])
		if not ok {
			c.close()
			return
		}
	}
}

fn admin_handle(w *ResponseWriter, r *Request) {
	if r.method != "GET" and r.method != "HEAD" {
		send_error(w, 405)
		return
	}
	switch r.path {
	case "/healthz":
		w.text(200, "ok\n")
	case "/readyz":
		if runtime.stopping() {
			w.text(503, "stopping\n")
		} else if not_ready.value() != 0 {
			w.text(503, "not ready\n")
		} else {
			w.text(200, "ready\n")
		}
	case "/metrics":
		serve_metrics(w, r)
	default:
		send_error(w, 404)
	}
}

// shed_load (false by default) makes a server answer a new connection that finds every
// serve_conn slot busy with 503 Service Unavailable and Retry-After: 1, then close it, instead of
// leaving it to wait for a slot. Shedding suits a service with replicas behind a load balancer,
// where a quick 503 sends the client elsewhere; waiting suits a lone server, where a burst then
// costs latency rather than errors. Set it before serving (with threads N, on each thread).
pub thread shed_load = false

// serve accepts connections on l and serves each in its own goroutine. Requests are read strictly:
// a CR or LF outside a CRLF, a header name that isn't a token (`name : v`, folded lines), a
// Content-Length that isn't plain digits or differs from an earlier one, and Transfer-Encoding all
// get a 400 and a closed connection. `Expect: 100-continue` is answered before the body is read;
// other expectations get a 417. HTTP/1.0 clients get `Connection: keep-alive` when they ask for it,
// and a body too long to buffer is sent unframed, ending with the connection, since HTTP/1.0 has
// no chunked encoding.
//
// SIGTERM and SIGINT stop it gracefully (runtime.stop_gracefully): it stops accepting and closes
// l, requests in progress are finished and answered with `Connection: close`, idle keep-alive
// connections are closed (with the process), and serve returns nil once no request is left, so
// main can return. SQUARK_SHUTDOWN (10s by default) limits how long that may take.
pub fn serve(l net.Listener, h HandlerFunc) -> ! {
	if len(handlers) == max_servers {
		return TooManyServers
	}
	runtime.stop_gracefully()
	id := len(handlers)
	handlers.push(h)
	if not waker_started {
		waker_started = true
		start wake_idle() // one for all servers: the idle set has a single consumer
	}
	loop {
		c, err := l.accept()
		if err == net.Stopping {
			l.close()
			while active > 0 {
				time.sleep(5 * time.millisecond)
			}
			return nil
		}
		if err != nil {
			if err.code() == 24 or err.code() == 23 or err.code() == 53 or err.code() == 54 {
				continue // EMFILE / ENFILE / ECONNABORTED / ECONNRESET: keep serving
			}
			return err
		}
		if shed_load {
			start serve_conn(c, id) else {
				start shed(c) else {
					c.close() // shedding is overloaded too
				}
			}
		} else {
			start serve_conn(c, id)
		}
	}
}

// shed answers a connection that no serve_conn slot is free for with 503, reading what the client
// sends for a moment first so that closing doesn't reset the connection before it reads the answer.
task shed(c net.Conn) pool 16 {
	var b u8[2048]
	reject(c, "503 Service Unavailable\r\nRetry-After: 1", b[:])
	c.close()
}

// write_error answers a request that won't be served with status and closes the sending side.
fn write_error(c net.Conn, status str) {
	var b u8[128]
	m := append(b[:0], "HTTP/1.1 "...)
	m = append(m, status...)
	m = append(m, "\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"...)
	c.write(m)
	c.close_write()
}

// error_linger is how long a rejected request's connection stays open to read what the client is
// still sending: closing a socket with unread input resets it, and the client could miss the answer.
const error_linger = 500 * time.millisecond

// reject answers with status, then reads and drops the client's input for up to error_linger
// (at most 1 MiB) before the caller closes the connection.
fn reject(c net.Conn, status str, rbuf u8[]) {
	write_error(c, status)
	start := time.now()
	for i := 0; i < (1<<20)/len(rbuf); i++ {
		left := error_linger - time.since(start)
		if left <= 0 {
			return
		}
		if m, err := c.read_timeout(rbuf, left); err != nil or m == 0 {
			return
		}
	}
}

// wake_idle restarts connections from the idle set when they have a new request.
task wake_idle() pool 1 {
	loop {
		c, id := net.next_idle()
		start serve_conn(c, id)
	}
}

// serve_conn runs one keep-alive connection while it is busy. At most 10000 run at once; further
// connections wait for a slot. A connection that stays quiet for idle_release is parked in the
// runtime's idle set and this goroutine exits, returning its whole stack to the OS.
// During a graceful stop it closes the connection once no request is pending. It is isolate: a
// handler that panics ends only its own connection (closed, as Go's net/http does), while the
// server goes on.
task serve_conn(c net.Conn, id int) pool 10000 isolate {
	active++
	open := true // until the connection is closed or parked: if a handler panics, it is still open
	defer conn_done(c, &open)
	h := handlers[id]
	var rbuf u8[read_buffer_size]
	var wbuf u8[write_buffer_size]
	n := 0
	loop {
		if n == 0 and (runtime.stopping() or not c.wait_readable(idle_release)) {
			open = false
			if runtime.stopping() {
				c.close()
			} else {
				c.park_idle(id)
			}
			return
		}
		ok := false
		n, ok = serve_request(c, h, rbuf[:], n, wbuf[:])
		if not ok {
			open = false
			c.close()
			return
		}
	}
}

fn conn_done(c net.Conn, open *bool) {
	active--
	if *open {
		c.close() // a handler panicked
		handler_panics.inc()
	}
}

// read_more reads into rbuf[n:] until start+limit. It returns how many bytes it read, or 0 if the
// connection is done (an error, EOF, or the deadline, which gets a 408).
fn read_more(c net.Conn, rbuf u8[], n int, start time.Time, limit time.Duration) -> int {
	left := limit - time.since(start)
	m := 0
	err := net.Timeout
	if left > 0 {
		m, err = c.read_timeout(rbuf[n:], left)
	}
	if err == net.Timeout {
		write_error(c, "408 Request Timeout")
	}
	if err != nil {
		return 0
	}
	return m
}

// serve_request serves one request whose first n bytes are already in rbuf. It returns how many
// bytes of the next (pipelined) request remain buffered, and whether to keep the connection.
//
//squark:noinline
fn serve_request(c net.Conn, h HandlerFunc, rbuf u8[], n int, wbuf u8[]) -> (int, bool) {
	var hbuf u8[header_buffer_size]
	start := time.now() // the request has started arriving: its read deadlines count from here
	end, scan := header_end(rbuf[:n], 0)
	while end == -1 {
		if n == len(rbuf) {
			reject(c, "431 Request Header Fields Too Large", rbuf)
			return 0, false
		}
		m := read_more(c, rbuf, n, start, read_header_timeout)
		if m == 0 {
			return 0, false
		}
		n += m
		end, scan = header_end(rbuf[:n], scan)
	}
	if end < 0 {
		reject(c, "400 Bad Request", rbuf)
		return 0, false
	}
	with arena scratch request_arena_size {
		var req Request
		req.arena = scratch
		if status := parse_request(str(rbuf[:end]), &req); status != "" {
			reject(c, status, rbuf)
			return 0, false
		}
		if req.content_length > len(rbuf)-end { // not end+content_length: that can overflow
			reject(c, "413 Request Entity Too Large", rbuf)
			return 0, false
		}
		total := end + req.content_length
		if n < total and req.expect100 {
			if _, err := c.write_string("HTTP/1.1 100 Continue\r\n\r\n"); err != nil {
				return 0, false
			}
		}
		while n < total {
			m := read_more(c, rbuf, n, start, read_timeout)
			if m == 0 {
				return 0, false
			}
			n += m
		}
		req.body = rbuf[end:total]
		w := ResponseWriter{conn: c, buf: wbuf[:0], hdr: hbuf[:0], status_code: 200, keep_alive: req.keep_alive, http10: req.http10, head: req.method == "HEAD", scratch: scratch}
		if h == nil {
			serve_mux(&w, &req) // called directly: as a func value it would look recursive
		} else {
			h(&w, &req)
		}
		w.finish()
		count_status(w.status_code)
		if not w.keep_alive or w.failed {
			return 0, false
		}
		// keep pipelined bytes
		copy(rbuf, rbuf[total:n])
		return n - total, true
	}
}

// header_end scans b from i for the blank line that ends a request head. It returns the index just
// past it; or -1, and where to go on once more input has arrived; or -2 if b has a CR or LF that
// isn't part of a CRLF (the request line and headers can't contain one).
fn header_end(b u8[], i int) -> (int, int) {
	while i < len(b) {
		switch b[i] {
		case '\r':
			if i+1 == len(b) {
				return -1, i
			}
			if b[i+1] != '\n' {
				return -2, 0
			}
			if i >= 2 and b[i-1] == '\n' and b[i-2] == '\r' {
				return i + 2, 0
			}
			i += 2
		case '\n':
			return -2, 0
		default:
			i++
		}
	}
	return -1, i
}

// is_token reports whether s is an HTTP token (a method or header name).
fn is_token(s str) -> bool {
	if len(s) == 0 {
		return false
	}
	for i := 0; i < len(s); i++ {
		c := s[i]
		if not (c >= 'a' and c <= 'z' or c >= 'A' and c <= 'Z' or c >= '0' and c <= '9' or strings.index_byte("!#$%&'*+-.^_`|~", c) >= 0) {
			return false
		}
	}
	return true
}

// has_ctl reports whether s has a control character other than tab.
fn has_ctl(s str) -> bool {
	for i := 0; i < len(s); i++ {
		if s[i] < ' ' and s[i] != '\t' or s[i] == 0x7f {
			return true
		}
	}
	return false
}

// trim_ows trims the spaces and tabs around a header value.
fn trim_ows(s str) -> str {
	while len(s) > 0 and (s[0] == ' ' or s[0] == '\t') {
		s = s[1:]
	}
	while len(s) > 0 and (s[len(s)-1] == ' ' or s[len(s)-1] == '\t') {
		s = s[:len(s)-1]
	}
	return s
}

// has_token reports whether the comma-separated list v contains tok (case-insensitive).
fn has_token(v, tok str) -> bool {
	while len(v) > 0 {
		item, rest, _ := strings.cut(v, ",")
		if strings.equal_fold(trim_ows(item), tok) {
			return true
		}
		v = rest
	}
	return false
}

// parse_length parses a Content-Length: decimal digits only. It returns -1 if s isn't one.
fn parse_length(s str) -> int {
	if len(s) == 0 {
		return -1
	}
	n := 0
	for i := 0; i < len(s); i++ {
		d := int(s[i]) - '0'
		if d < 0 or d > 9 or n > (9223372036854775807-d)/10 {
			return -1
		}
		n = n*10 + d
	}
	return n
}

const bad_request = "400 Bad Request"

// parse_request parses a request head (which header_end has checked for stray CRs and LFs). It returns
// "", or the status to answer with if the request can't be served.
fn parse_request(head str, r *Request) -> str {
	line, rest, ok := strings.cut(head, "\r\n")
	if not ok {
		return bad_request
	}
	method, line2, ok1 := strings.cut(line, " ")
	target, proto, ok2 := strings.cut(line2, " ")
	if not ok1 or not ok2 or not is_token(method) or len(target) == 0 or has_ctl(target) {
		return bad_request
	}
	switch {
	case proto == "HTTP/1.1":
		r.keep_alive = true
	case proto == "HTTP/1.0":
		r.http10 = true
	case len(proto) == 8 and strings.has_prefix(proto, "HTTP/") and proto[6] == '.' and proto[5] >= '0' and proto[5] <= '9' and proto[7] >= '0' and proto[7] <= '9':
		if proto[5] != '1' {
			return "505 HTTP Version Not Supported"
		}
		r.keep_alive = true // a later HTTP/1.x: served as 1.1
	default:
		return bad_request
	}
	r.method = method
	r.proto = proto
	path, query, _ := strings.cut(target, "?")
	r.path = path
	r.query = query
	r.content_length = 0
	saw_length := false
	while len(rest) > 0 {
		hl, more, _ := strings.cut(rest, "\r\n")
		rest = more
		if len(hl) == 0 {
			break
		}
		// "name : v" and folded lines (" v") are errors, so a header is never misread as another
		name, value, ok := strings.cut(hl, ":")
		if not ok or not is_token(name) {
			return bad_request
		}
		value = trim_ows(value)
		if has_ctl(value) {
			return bad_request
		}
		if r.nheaders < max_headers {
			r.headers[r.nheaders] = Header{name: name, value: value}
			r.nheaders++
		}
		switch {
		case strings.equal_fold(name, "Content-Length"):
			cl := parse_length(value)
			if cl < 0 or saw_length and cl != r.content_length {
				return bad_request // also two different lengths: which one is meant is ambiguous
			}
			saw_length = true
			r.content_length = cl
		case strings.equal_fold(name, "Connection"):
			if has_token(value, "close") {
				r.keep_alive = false
			} else if has_token(value, "keep-alive") {
				r.keep_alive = true
			}
		case strings.equal_fold(name, "Transfer-Encoding"):
			return bad_request // chunked request bodies are not supported
		case strings.equal_fold(name, "Expect"):
			if not strings.equal_fold(value, "100-continue") {
				return "417 Expectation Failed"
			}
			r.expect100 = not r.http10
		}
	}
	return ""
}

// status_text returns the reason phrase for a status code.
pub fn status_text(code int) -> str {
	switch code {
	case 200:
		return "OK"
	case 201:
		return "Created"
	case 202:
		return "Accepted"
	case 204:
		return "No Content"
	case 301:
		return "Moved Permanently"
	case 302:
		return "Found"
	case 304:
		return "Not Modified"
	case 400:
		return "Bad Request"
	case 401:
		return "Unauthorized"
	case 403:
		return "Forbidden"
	case 404:
		return "Not Found"
	case 405:
		return "Method Not Allowed"
	case 409:
		return "Conflict"
	case 413:
		return "Request Entity Too Large"
	case 422:
		return "Unprocessable Entity"
	case 429:
		return "Too Many Requests"
	case 500:
		return "Internal Server Error"
	case 503:
		return "Service Unavailable"
	}
	return "Unknown"
}
