// Package flag parses command-line flags, as Go's flag package does for its default set
// (flag.CommandLine, which exits on an error). Define flags, call parse, then read them:
//
//	port := flag.int_flag("port", 8080, "port to listen on")
//	flag.parse()
//	serve(*port)
//
// The values live in the package's storage, not on a heap: at most max_flags flags, and the
// pointers that Int, String, Bool and Duration return point into it. Names, usage texts and
// default strings must be constant data (string constants, as usual); a String flag's value is a
// view of the program's arguments.
//
// Parse accepts -name, --name, -name=value and -name value (not for bool flags, which take
// -name or -name=false); flag parsing stops at the first argument that isn't a flag, or after
// "--". -h and -help, unless defined, print the usage to stderr and exit 0. An undefined flag, a
// missing value or a bad value prints Go's message ("flag provided but not defined: -x",
// `invalid value "abc" for flag -port: parse error`) and the usage to stderr and exits 2.
//
// With threads N every scheduler thread runs main, so each parses into its own copy of the
// package: they all see the same arguments, and only the first prints a usage message.
module flag

use os, runtime, time

// max_flags is how many flags can be defined. Defining more panics.
pub const max_flags = 32

// max_args is how many positional arguments args can return; n_arg and arg have no limit.
pub const max_args = 1024

// what a flag holds
enum Kind { int, str, bool, duration }

// a defined flag: its value and its default
struct Entry {
	name  str
	usage str
	kind  Kind
	set   bool // set on the command line
	i     int
	s     str
	b     bool
	d     time.Duration
	def_i int
	def_s str
	def_b bool
	def_d time.Duration
}

thread flags Entry[..max_flags]

thread parse_done bool

// first is the index (in os.arg numbering) of the first argument after the flags.
thread first int

thread rest str[..max_args]

// usage prints the usage message to stderr: by default "usage of <program>:" and print_defaults.
// Parse calls it on -h or an error; set it to a function of your own to print something else.
pub thread usage = default_usage

fn default_usage() {
	put("Usage of ")
	put(os.arg(0))
	put(":\n")
	print_defaults()
}

fn define(name str in static, usage str in static, kind Kind) -> *Entry {
	if name == "" or name[0] == '-' {
		panic("flag: a flag's name can't be empty or begin with -")
	}
	for i := 0; i < len(name); i++ {
		if name[i] == '=' {
			panic("flag: a flag's name can't contain =")
		}
	}
	if lookup(name) >= 0 {
		var buf u8[128]
		msg := append(append(buf[:0], "flag redefined: "...), name...)
		panic(str(msg))
	}
	if len(flags) == max_flags {
		panic("flag: more than MaxFlags flags defined")
	}
	flags.push(Entry{name: name, usage: usage, kind: kind})
	return &flags[len(flags)-1]
}

fn lookup(name str) -> int {
	for i := 0; i < len(flags); i++ {
		if flags[i].name == name {
			return i
		}
	}
	return -1
}

// Int defines an int flag. Its value is read as Go's strconv.ParseInt(s, 0, 64) reads it:
// decimal, or with a 0x, 0o, 0b or 0 (octal) prefix, and _ between digits.
pub fn int_flag(name str in static, value int, usage str in static) -> *int {
	e := define(name, usage, .int)
	e.i = value
	e.def_i = value
	return &e.i
}

// String defines a string flag.
pub fn str_flag(name str in static, value str in static, usage str in static) -> *str {
	e := define(name, usage, .str)
	e.s = value
	e.def_s = value
	return &e.s
}

// Bool defines a bool flag: -name sets it, -name=false clears it (values as strconv.ParseBool).
pub fn bool_flag(name str in static, value bool, usage str in static) -> *bool {
	e := define(name, usage, .bool)
	e.b = value
	e.def_b = value
	return &e.b
}

// Duration defines a time.Duration flag, read by time.parse_duration ("30s", "1h30m").
pub fn duration_flag(name str in static, value time.Duration, usage str in static) -> *time.Duration {
	e := define(name, usage, .duration)
	e.d = value
	e.def_d = value
	return &e.d
}

// parse parses the command-line flags (os.arg(1) on). Call it after defining the flags and
// before reading them. On -h, -help or an error it prints to stderr and exits (see the package
// comment).
pub fn parse() {
	parse_done = true
	i := 1
	n := os.n_args()
	while i < n {
		s := os.arg(i)
		if len(s) < 2 or s[0] != '-' {
			break // the first positional argument
		}
		name := s[1:]
		if s[1] == '-' {
			if len(s) == 2 {
				i++ // "--" ends the flags
				break
			}
			name = s[2:]
		}
		i++
		if len(name) == 0 or name[0] == '-' or name[0] == '=' {
			failf("bad flag syntax: ", s, "", "")
		}
		value := ""
		has_value := false
		for j := 1; j < len(name); j++ {
			if name[j] == '=' {
				value = name[j+1:]
				has_value = true
				name = name[:j]
				break
			}
		}
		k := lookup(name)
		if k < 0 {
			if name == "help" or name == "h" {
				exit(0)
			}
			failf("flag provided but not defined: -", name, "", "")
		}
		e := &flags[k]
		if e.kind == .bool {
			if has_value {
				if not set_value(e, value) {
					failq("invalid boolean value ", value, " for -", name)
				}
			} else {
				e.b = true
			}
		} else {
			if not has_value and i < n {
				value = os.arg(i)
				has_value = true
				i++
			}
			if not has_value {
				failf("flag needs an argument: -", name, "", "")
			}
			if not set_value(e, value) {
				failq("invalid value ", value, " for flag -", name)
			}
		}
		e.set = true
	}
	first = i
}

// err_text is why the last set_value failed: Go's "parse error" or "value out of range".
thread err_text = ""

// set_value sets e from s; on a bad value it sets err_text and returns false.
fn set_value(e *Entry, s str in static) -> bool {
	switch e.kind {
	case .int:
		v, ok := parse_int(s)
		e.i = v
		return ok
	case .str:
		e.s = s
	case .bool:
		switch s {
		case "1", "t", "T", "TRUE", "true", "True":
			e.b = true
		case "0", "f", "F", "FALSE", "false", "False":
			e.b = false
		default:
			err_text = "parse error"
			return false
		}
	case .duration:
		d, err := time.parse_duration(s)
		if err != nil {
			err_text = "parse error"
			return false
		}
		e.d = d
	}
	return true
}

// parse_int reads s as Go's strconv.ParseInt(s, 0, 64) does: an optional sign, then decimal, or
// a 0b, 0o, 0x or 0 (octal) prefix, with '_' allowed between digits. A bad value sets err_text.
fn parse_int(s str) -> (int, bool) {
	err_text = "parse error"
	t := s
	neg := false
	if t != "" and (t[0] == '+' or t[0] == '-') {
		neg = t[0] == '-'
		t = t[1:]
	}
	if t == "" {
		return 0, false
	}
	base := u64(10)
	if t[0] == '0' {
		base = 8
		t = t[1:]
		if len(t) >= 2 {
			switch t[0] | 0x20 {
			case 'b':
				base = 2
				t = t[1:]
			case 'o':
				t = t[1:]
			case 'x':
				base = 16
				t = t[1:]
			}
		}
	}
	cutoff := (1<<64-1)/base + 1
	var u u64
	underscores := false
	for k := 0; k < len(t); k++ {
		c := t[k]
		var d u64
		switch {
		case c == '_':
			underscores = true
			continue
		case '0' <= c and c <= '9':
			d = u64(c - '0')
		case 'a' <= c|0x20 and c|0x20 <= 'z':
			d = u64(c|0x20-'a') + 10
		default:
			return 0, false
		}
		if d >= base {
			return 0, false
		}
		if u >= cutoff {
			return out_of_range(neg)
		}
		u *= base
		if u+d < u {
			return out_of_range(neg)
		}
		u += d
	}
	if underscores and not underscore_ok(s) {
		return 0, false
	}
	if not neg and u > 1<<63-1 or neg and u > 1<<63 {
		return out_of_range(neg)
	}
	if neg {
		return int(0 - u), true
	}
	return int(u), true
}

fn out_of_range(neg bool) -> (int, bool) {
	err_text = "value out of range"
	return 0, false
}

// underscore_ok reports whether the '_'s in s are between digits (or after a base prefix), as in
// Go's strconv.
fn underscore_ok(s str) -> bool {
	saw := u8('^') // the last thing seen: ^ the start, 0 a digit or prefix, _ an underscore, ! other
	i := 0
	if len(s) >= 1 and (s[0] == '-' or s[0] == '+') {
		s = s[1:]
	}
	hex := false
	if len(s) >= 2 and s[0] == '0' and (s[1]|0x20 == 'b' or s[1]|0x20 == 'o' or s[1]|0x20 == 'x') {
		i = 2
		saw = '0'
		hex = s[1]|0x20 == 'x'
	}
	for ; i < len(s); i++ {
		if '0' <= s[i] and s[i] <= '9' or hex and 'a' <= s[i]|0x20 and s[i]|0x20 <= 'f' {
			saw = '0'
			continue
		}
		if s[i] == '_' {
			if saw != '0' {
				return false
			}
			saw = '_'
			continue
		}
		if saw == '_' {
			return false
		}
		saw = '!'
	}
	return saw != '_'
}

// failf prints a+b+c+d as the error, then the usage, and exits 2.
fn failf(a str, b str, c str, d str) {
	put(a)
	put(b)
	put(c)
	put(d)
	put("\n")
	exit(2)
}

// failq prints Go's bad-value message, with the value quoted, and exits 2.
fn failq(a str, value str, c str, name str) {
	put(a)
	put_quoted(value)
	put(c)
	put(name)
	put(": ")
	put(err_text)
	put("\n")
	exit(2)
}

// exit prints the usage and exits. With threads only the first scheduler thread prints and exits;
// the others (which parse the same arguments) wait for it.
fn exit(code int) {
	if runtime.shard() != 0 {
		out.clear()
		loop {
			time.sleep(time.hour)
		}
	}
	flush() // the message, before a usage of the program's own writes
	usage()
	flush()
	os.exit(code)
}

// parsed reports whether parse has been called.
pub fn parsed() -> bool { return parse_done }

// n_flag returns the number of flags set on the command line.
pub fn n_flag() -> int {
	n := 0
	for i := 0; i < len(flags); i++ {
		if flags[i].set {
			n++
		}
	}
	return n
}

// n_arg returns the number of arguments left after the flags (0 before parse).
pub fn n_arg() -> int {
	if not parse_done {
		return 0
	}
	return os.n_args() - first
}

// arg returns argument i of those left after the flags, or "" if there is no such argument.
pub fn arg(i int) -> str in static {
	if i < 0 or i >= n_arg() {
		return ""
	}
	return os.arg(first + i)
}

// args returns the arguments left after the flags, as a view of the package's storage. More than
// max_args of them panics: use n_arg and arg.
pub fn args() -> str[] {
	rest.clear()
	for i := 0; i < n_arg(); i++ {
		if not rest.try_push(os.arg(first + i)) {
			panic("flag.Args: more than MaxArgs arguments (use NArg and Arg)")
		}
	}
	return rest[:]
}

// print_defaults prints, to stderr, each flag's name, type, usage and default (unless it is the
// zero value), sorted by name, in Go's format:
//
//	  -port int
//	    	port to listen on (default 8080)
//
// A name in back quotes in the usage ("a `file` to read") is shown as the type: "-db file".
pub fn print_defaults() {
	var order int[max_flags]
	for i := 0; i < len(flags); i++ {
		j := i
		while j > 0 and flags[order[j-1]].name > flags[i].name {
			order[j] = order[j-1]
			j--
		}
		order[j] = i
	}
	for k := 0; k < len(flags); k++ {
		print_flag(&flags[order[k]])
	}
	flush()
}

fn print_flag(e *Entry) {
	var buf u8[32]
	put("  -")
	put(e.name)
	// a back-quoted name in the usage, or the type, is shown after the flag
	usage := e.usage
	tname := ""
	q1, q2 := -1, -1
	for i := 0; i < len(usage); i++ {
		if usage[i] == '`' {
			if q1 < 0 {
				q1 = i
			} else {
				q2 = i
				break
			}
		}
	}
	if q2 >= 0 {
		tname = usage[q1+1 : q2]
	} else {
		switch e.kind {
		case .int:
			tname = "int"
		case .str:
			tname = "string"
		case .duration:
			tname = "duration"
		}
	}
	if tname != "" {
		put(" ")
		put(tname)
	}
	if tname == "" and len(e.name) == 1 {
		put("\t") // a one-letter bool flag: the usage goes on the same line
	} else {
		put("\n    \t")
	}
	if q2 >= 0 {
		put_usage(usage[:q1])
		put_usage(tname)
		put_usage(usage[q2+1:])
	} else {
		put_usage(usage)
	}
	switch e.kind {
	case .int:
		if e.def_i != 0 {
			put(" (default ")
			n := len(fmt_int_to(buf[:], e.def_i))
			put(str(buf[:n]))
			put(")")
		}
	case .str:
		if e.def_s != "" {
			put(" (default ")
			put_quoted(e.def_s)
			put(")")
		}
	case .bool:
		if e.def_b {
			put(" (default true)")
		}
	case .duration:
		if e.def_d != 0 {
			put(" (default ")
			put(e.def_d.string(buf[:]))
			put(")")
		}
	}
	put("\n")
}

// put_usage writes s with each newline followed by the usage indent.
fn put_usage(s str) {
	start := 0
	for i := 0; i < len(s); i++ {
		if s[i] == '\n' {
			put(s[start : i+1])
			put("    \t")
			start = i + 1
		}
	}
	put(s[start:])
}

fn fmt_int_to(buf u8[], v int) -> u8[] in buf {
	var arr u8[24]
	w := len(arr)
	u := u64(v)
	if v < 0 {
		u = 0 - u
	}
	loop {
		w--
		arr[w] = u8(u%10) + '0'
		u /= 10
		if u == 0 {
			break
		}
	}
	if v < 0 {
		w--
		arr[w] = '-'
	}
	return buf[:copy(buf, arr[w:])]
}

// out buffers what goes to stderr.
thread out u8[..512]

fn put(s str) {
	if not out.try_append(s) {
		flush()
		if not out.try_append(s) {
			os.stderr.write_string(s)
		}
	}
}

fn flush() {
	if len(out) > 0 {
		os.stderr.write(out[:])
		out.clear()
	}
}

// put_quoted writes s in double quotes with Go's escapes for quotes, backslashes and control
// characters (bytes from 0x80 up are written as they are).
fn put_quoted(s str) {
	const hex = "0123456789abcdef"
	put("\"")
	start := 0
	for i := 0; i < len(s); i++ {
		c := s[i]
		if c >= 0x20 and c != 0x7f and c != '"' and c != '\\' {
			continue
		}
		put(s[start:i])
		start = i + 1
		switch c {
		case '"':
			put("\\\"")
		case '\\':
			put("\\\\")
		case '\a':
			put("\\a")
		case '\b':
			put("\\b")
		case '\f':
			put("\\f")
		case '\n':
			put("\\n")
		case '\r':
			put("\\r")
		case '\t':
			put("\\t")
		case '\v':
			put("\\v")
		default:
			var esc u8[4]
			esc[0] = '\\'
			esc[1] = 'x'
			esc[2] = hex[c>>4]
			esc[3] = hex[c&15]
			put(str(esc[:]))
		}
	}
	put(s[start:])
	put("\"")
}
