module net

use bufio, io, os, strconv, strings, time

extern fn sys_random() -> u64 stack 1K c"sq_random_u64"

// NoSuchHost is returned by lookup_ip (and dial) for a name that doesn't exist or has no
// addresses.
pub fault NoSuchHost -21 "no such host"

// NameServer is returned by lookup_ip when no name server gave a usable answer: each failed,
// refused or sent something malformed.
pub fault NameServer -22 "dns: no usable answer from the name servers"

// resolv_conf and hosts_file are the files lookup_ip reads. resolv_conf is read again when it
// changes here or 5 seconds after it was last read; the hosts file is read on each lookup.
pub thread resolv_conf = "/etc/resolv.conf"
pub thread hosts_file = "/etc/hosts"

const max_name = 255 // an encoded name: length bytes, labels and the root's 0
const udp_size = 1232 // the UDP reply size offered with EDNS(0), as DNS flag day 2020 recommends
const type_a = 1
const type_aaaa = 28
const type_cname = 5

// Server is a name server from resolv.conf.
struct Server {
	ip   IP
	port int
}

// Config is what resolv.conf says, held by value: a lookup works on its own copy, so a reload
// while it waits for a reply changes nothing under it.
struct Config {
	servers  Server[..3] // as the C library, at most 3
	search   u8[..1024]  // the search domains, each followed by a space
	ndots    int
	timeout  time.Duration
	attempts int
}

thread conf Config
thread conf_path str
thread conf_at time.Time
thread conf_loaded bool

// file_buf is the line buffer for reading resolv.conf and the hosts file. Reading a regular file
// never parks, so the tasks of a thread can't use it at the same time.
thread file_buf u8[4K]

// lookup_ip returns host's addresses as a view of out, IPv4 ones first. An IP literal is itself.
// A name is looked up in hosts_file, and then through the name servers of resolv_conf with its
// search domains, as the C library does: a name with fewer than ndots dots is tried with each
// search domain before it is tried alone, and one ending in "." is only tried alone. Each server
// gets timeout per attempt (resolv.conf's options ndots, timeout and attempts; the defaults are
// 1, 5s and 2); a reply too long for UDP is asked for again over TCP. "localhost" and names
// ending in ".localhost" are the loopback addresses if the hosts file doesn't say otherwise.
// Errors: NoSuchHost, NameServer, Timeout, or io.ShortBuffer for an out with no capacity.
pub fn lookup_ip(host str, out IP[]) -> IP[] ! in out {
	out = out[:0]
	if cap(out) == 0 {
		return out, io.ShortBuffer
	}
	if ip, ok := parse_ip(host); ok {
		return append(out, ip), nil
	}
	name := strings.trim_suffix(host, ".")
	var probe u8[max_name]
	if _, ok := encode_name(probe[:], name, ""); not ok {
		return out, NoSuchHost
	}
	out = lookup_hosts(name, out)
	if len(out) == 0 and is_localhost(name) {
		out = append(out, ipv4(127, 0, 0, 1))
		if cap(out) > 1 {
			out = append(out, ipv6_loopback())
		}
	}
	if len(out) > 0 {
		return v4_first(out), nil
	}
	c := current_config()
	res, err := lookup_dns(&c, host, out)
	if err != nil {
		return out, err
	}
	return v4_first(res), nil
}

fn is_localhost(name str) -> bool {
	const suffix = ".localhost"
	return strings.equal_fold(name, "localhost") or len(name) > len(suffix) and strings.equal_fold(name[len(name)-len(suffix):], suffix)
}

// v4_first moves the IPv4 addresses of ips in front of the IPv6 ones, keeping each in order.
fn v4_first(ips IP[]) -> IP[] in ips {
	k := 0
	for i in 0..len(ips) {
		if ips[i].is_v4() {
			ip := ips[i]
			for j := i; j > k; j-- {
				ips[j] = ips[j-1]
			}
			ips[k] = ip
			k++
		}
	}
	return ips
}

// add appends ip to out unless it is there already or out is full.
fn add(out IP[], ip IP) -> IP[] in out {
	for x in out {
		if x.equal(ip) {
			return out
		}
	}
	if len(out) < cap(out) {
		out = append(out, ip)
	}
	return out
}

// lookup_hosts appends the addresses hosts_file gives name to out.
fn lookup_hosts(name str, out IP[]) -> IP[] in out {
	f, err := os.open(hosts_file)
	if err != nil {
		return out
	}
	defer f.close()
	r := bufio.new_reader(file_buf[:])
	loop {
		line, err := r.read_line(f)
		if err == bufio.TooLong {
			continue
		}
		if err != nil {
			break
		}
		if i := strings.index_byte(line, '#'); i >= 0 {
			line = line[:i]
		}
		// the address, then any number of names (scanned one at a time: no limit on them)
		addr, names := next_word(line)
		if addr == "" or names == "" {
			continue
		}
		ip, ok := parse_ip(addr)
		if not ok {
			continue
		}
		while names != "" {
			w := ""
			w, names = next_word(names)
			if w != "" and strings.equal_fold(strings.trim_suffix(w, "."), name) {
				out = add(out, ip)
				break
			}
		}
	}
	return out
}

// current_config returns what resolv_conf says, reading it if it hasn't been read, if
// resolv_conf names another file now, or if it was read over 5 seconds ago.
fn current_config() -> Config {
	if not conf_loaded or conf_path != resolv_conf or time.since(conf_at) > 5*time.second {
		conf = load_config(resolv_conf)
		conf_path = resolv_conf
		conf_at = time.now()
		conf_loaded = true
	}
	return conf
}

// load_config reads a resolv.conf. Without one, or without a nameserver line in it, the name
// servers are 127.0.0.1 and ::1.
fn load_config(path str) -> Config {
	var c Config
	c.ndots = 1
	c.timeout = 5 * time.second
	c.attempts = 2
	if f, err := os.open(path); err == nil {
		r := bufio.new_reader(file_buf[:])
		loop {
			line, err := r.read_line(f)
			if err == bufio.TooLong {
				continue
			}
			if err != nil {
				break
			}
			config_line(&c, line)
		}
		f.close()
	}
	if len(c.servers) == 0 {
		c.servers.push(Server{ip: ipv4(127, 0, 0, 1), port: 53})
		c.servers.push(Server{ip: ipv6_loopback(), port: 53})
	}
	return c
}

// config_line applies one line of a resolv.conf to c: nameserver, search, domain and options
// (ndots, timeout, attempts) as the C library reads them; anything else is ignored. A nameserver
// may also be "ip:port" or "[ip]:port", which the C library doesn't accept, for a server on
// another port (in tests, say).
fn config_line(c *Config, line str) {
	var fs str[8]
	words := strings.fields(line, fs[:])
	if len(words) < 2 or words[0][0] == '#' or words[0][0] == ';' {
		return
	}
	switch words[0] {
	case "nameserver":
		if len(c.servers) < cap(c.servers) {
			if s, ok := parse_server(words[1]); ok {
				c.servers.push(s)
			}
		}
	case "search", "domain":
		// the last search or domain line wins; domain names one domain
		c.search.clear()
		doms := words[1:]
		if words[0] == "domain" {
			doms = doms[:1]
		}
		n := 0
		for d in doms {
			d = strings.trim_suffix(d, ".")
			if d == "" or n == 6 or len(c.search)+len(d)+1 > cap(c.search) {
				continue
			}
			c.search.append(d)
			c.search.push(' ')
			n++
		}
	case "options":
		for o in words[1:] {
			if v, ok := strings.cut_prefix(o, "ndots:"); ok {
				c.ndots = option_int(v, 0, 15, c.ndots)
			} else if v, ok := strings.cut_prefix(o, "timeout:"); ok {
				c.timeout = time.Duration(option_int(v, 1, 30, 5)) * time.second
			} else if v, ok := strings.cut_prefix(o, "attempts:"); ok {
				c.attempts = option_int(v, 1, 5, c.attempts)
			}
		}
	}
}

// option_int reads an option's number, limited to lo..hi as the C library limits it; def if it
// isn't a number.
fn option_int(s str, lo, hi, def int) -> int {
	n, err := strconv.atoi(s)
	if err != nil {
		return def
	}
	return min(max(n, lo), hi)
}

fn parse_server(s str) -> (Server, bool) {
	if ip, ok := parse_ip(s); ok {
		return Server{ip: ip, port: 53}, true
	}
	host, port, err := split_host_port(s)
	if err != nil {
		return Server{}, false
	}
	ip, ok := parse_ip(host)
	return Server{ip: ip, port: port}, ok
}

// lookup_dns asks the name servers for host, trying the search domains as the C library does.
fn lookup_dns(c *Config, host str, out IP[]) -> IP[] ! in out {
	rooted := strings.has_suffix(host, ".")
	name := strings.trim_suffix(host, ".")
	var ds str[6]
	search := strings.fields(str(c.search[:]), ds[:])
	if rooted {
		search = search[:0]
	}
	alone_first := rooted or strings.count(name, ".") >= c.ndots
	err := NoSuchHost
	for i in 0..len(search)+1 {
		suffix := ""
		if alone_first {
			if i > 0 {
				suffix = search[i-1]
			}
		} else if i < len(search) {
			suffix = search[i]
		}
		var qname u8[max_name]
		q, ok := encode_name(qname[:], name, suffix)
		if not ok {
			continue
		}
		res, e := query(c, q, out)
		if e == nil {
			return res, nil
		}
		if e != NoSuchHost {
			err = e
		}
	}
	return out[:0], err
}

// encode_name writes name.suffix (suffix may be empty) in DNS form into dst: each label after its
// length, then a 0. ok is false for an empty label, a label over 63 bytes or a name over 255.
fn encode_name(dst u8[], name, suffix str) -> (u8[], bool) in dst {
	dst = dst[:0]
	ok := true
	dst, ok = append_labels(dst, name)
	if ok and suffix != "" {
		dst, ok = append_labels(dst, suffix)
	}
	if not ok or len(dst)+1 > max_name or len(dst)+1 > cap(dst) {
		return dst[:0], false
	}
	return append(dst, 0), true
}

fn append_labels(dst u8[], s str) -> (u8[], bool) in dst {
	if s == "" {
		return dst, false
	}
	while len(s) > 0 {
		label := s
		s = ""
		if i := strings.index_byte(label, '.'); i >= 0 {
			s = label[i+1:]
			label = label[:i]
			if s == "" {
				return dst, false // "a." inside a name: an empty last label
			}
		}
		if len(label) == 0 or len(label) > 63 or len(dst)+1+len(label) >= min(max_name, cap(dst)) {
			return dst, false
		}
		dst = append(dst, u8(len(label)))
		dst = append(dst, label...)
	}
	return dst, true
}

// query asks the servers for qname's addresses, attempts times round, and stops at the first
// server that answers: with addresses, or that the name doesn't exist (NoSuchHost).
fn query(c *Config, qname u8[], out IP[]) -> IP[] ! in out {
	err := NameServer
	for _ in 0..c.attempts {
		for s in c.servers {
			res, e := exchange(s, qname, c.timeout, out)
			if e == nil or e == NoSuchHost {
				return res, e
			}
			err = e
		}
	}
	return out[:0], err
}

// exchange asks one server for qname's A and AAAA records at once, over UDP, and appends the
// addresses to out. An error leaves out empty: NoSuchHost if the server says the name doesn't
// exist or has no addresses, Timeout if it doesn't reply in time, NameServer if it fails.
fn exchange(s Server, qname u8[], timeout time.Duration, out IP[]) -> IP[] ! in out {
	var qa, q6 u8[300]
	id_a := int(sys_random() & 0xffff)
	id_6 := (id_a + 1 + int(sys_random()%65535)) & 0xffff // never id_a
	a := build_query(qa[:], id_a, qname, type_a, true)
	b := build_query(q6[:], id_6, qname, type_aaaa, true)
	plain_a, plain_6 := false, false // asked again without EDNS, after a FORMERR
	conn, err := dial_proto(s.ip, s.port, 1)
	if err != nil {
		return out[:0], NameServer
	}
	defer conn.close()
	if _, err := conn.write(a); err != nil {
		return out[:0], NameServer
	}
	if _, err := conn.write(b); err != nil {
		return out[:0], NameServer
	}
	var buf u8[udp_size]
	var tcp u8[4K]
	deadline := time.now().add(timeout)
	done_a, done_6 := false, false
	missing, failed := false, false
	while not (done_a and done_6) {
		left := deadline.sub(time.now())
		if left <= 0 {
			break
		}
		n, err := conn.read_timeout(buf[:], left)
		if err == Timeout {
			break
		}
		if err != nil {
			failed = true // nothing listens there (ECONNREFUSED), say
			break
		}
		msg := buf[:n]
		if len(msg) < 12 {
			continue
		}
		id := int(msg[0])<<8 | int(msg[1])
		qtype := type_a
		q := a
		if id == id_a and not done_a {
			done_a = true
		} else if id == id_6 and not done_6 {
			done_6 = true
			qtype = type_aaaa
			q = b
		} else {
			continue // a reply to something else, or a repeat
		}
		// FORMERR: a server that doesn't understand the EDNS record; ask once more without it
		if msg[3]&0x0f == 1 and msg[2]&0x80 != 0 and not (qtype == type_a and plain_a or qtype == type_aaaa and plain_6) {
			if qtype == type_a {
				plain_a, done_a = true, false
				a = build_query(qa[:], id_a, qname, type_a, false)
				q = a
			} else {
				plain_6, done_6 = true, false
				b = build_query(q6[:], id_6, qname, type_aaaa, false)
				q = b
			}
			if _, err := conn.write(q); err != nil {
				failed = true
			}
			continue
		}
		if msg[2]&0x02 != 0 { // truncated: ask again over TCP
			m, err := exchange_tcp(s, q, deadline, tcp[:])
			if err != nil {
				failed = true // the UDP reply's records can't be trusted to be all of them
				continue
			}
			msg = m
		}
		res, rcode, ok := parse_reply(msg, qname, qtype, out)
		if not ok {
			failed = true
			continue
		}
		out = res
		if len(out) > 0 and not (done_a and done_6) {
			// one family has answered: wait only a moment more for the other (its reply may be
			// lost, and a lookup shouldn't then take the whole timeout)
			if soon := time.now().add(100 * time.millisecond); soon.before(deadline) {
				deadline = soon
			}
		}
		if rcode == 3 { // NXDOMAIN
			missing = true
		} else if rcode != 0 {
			failed = true
		}
	}
	if len(out) > 0 {
		return out, nil
	}
	if failed {
		return out[:0], NameServer
	}
	if missing or done_a and done_6 {
		return out[:0], NoSuchHost
	}
	return out[:0], Timeout
}

// exchange_tcp sends query over TCP and reads the reply into buf; a reply longer than buf is cut
// short (parse_reply reads the records that fit).
fn exchange_tcp(s Server, query u8[], deadline time.Time, buf u8[]) -> u8[] ! in buf {
	// the dial and write are bounded by the same deadline as the reads: where TCP/53 is dropped,
	// the connect would otherwise wait for the system's own timeout (a minute or more)
	var conn Conn
	var hdr u8[2]
	hdr[0] = u8(len(query) >> 8)
	hdr[1] = u8(len(query))
	with deadline deadline.sub(time.now()) {
		conn = dial_proto(s.ip, s.port, 0)!
		if _, err := conn.write2(hdr[:], query); err != nil {
			conn.close()
			return buf[:0], err
		}
	}
	defer conn.close()
	read_full_by(conn, hdr[:], deadline)!
	n := min(int(hdr[0])<<8|int(hdr[1]), len(buf))
	read_full_by(conn, buf[:n], deadline)!
	return buf[:n], nil
}

// read_full_by fills p from conn, returning Timeout if the deadline passes first.
fn read_full_by(conn Conn, p u8[], deadline time.Time) -> ! {
	got := 0
	while got < len(p) {
		left := deadline.sub(time.now())
		if left <= 0 {
			return Timeout
		}
		n := conn.read_timeout(p[got:], left)!
		got += n
	}
	return nil
}

// build_query writes a query for qname's records of type qtype, recursion desired, with an
// EDNS(0) record offering udp_size-byte replies.
fn build_query(dst u8[], id int, qname u8[], qtype int, edns bool) -> u8[] in dst {
	dst = dst[:0]
	extra := u8(0)
	if edns {
		extra = 1
	}
	dst = append(dst, u8(id>>8), u8(id), 0x01, 0x00, 0, 1, 0, 0, 0, 0, 0, extra)
	dst = append(dst, qname...)
	dst = append(dst, u8(qtype>>8), u8(qtype), 0, 1)
	if not edns {
		return dst
	}
	return append(dst, 0, 0, 41, u8(udp_size>>8), u8(udp_size&0xff), 0, 0, 0, 0, 0, 0)
}

// next_word returns the first word of s (split at spaces and tabs) and what follows it.
fn next_word(s str) -> (str, str) in s {
	while len(s) > 0 and (s[0] == ' ' or s[0] == '\t' or s[0] == '\r') {
		s = s[1:]
	}
	for i in 0..len(s) {
		if s[i] == ' ' or s[i] == '\t' or s[i] == '\r' {
			return s[:i], s[i:]
		}
	}
	return s, ""
}

fn u16_at(msg u8[], off int) -> int { return int(msg[off])<<8 | int(msg[off+1]) }

// parse_reply reads a reply to the query for qname's qtype records and appends the addresses it
// holds to out. ok is false if msg isn't a reply to that question. Answer records that don't
// fit in msg (a reply cut short) are left out.
fn parse_reply(msg u8[], qname u8[], qtype int, out IP[]) -> (IP[], int, bool) in out {
	if len(msg) < 12 or msg[2]&0x80 == 0 or u16_at(msg, 4) != 1 {
		return out, 0, false
	}
	rcode := int(msg[3] & 0x0f)
	answers := u16_at(msg, 6)
	off, ok := match_name(msg, 12, qname)
	if not ok or off+4 > len(msg) or u16_at(msg, off) != qtype or u16_at(msg, off+2) != 1 {
		return out, 0, false
	}
	start := off + 4
	// follow the CNAME chain from qname, in any order: only records owned by its end are answers
	// (a server's reply may carry others, which aren't for this name)
	var names u8[max_name][2] // two names: the current target and the next
	target := qname
	for hop in 0..8 {
		next := -1
		off = start
		for _ in 0..answers {
			owner := off
			off, ok = skip_name(msg, off)
			if not ok or off+10 > len(msg) {
				break
			}
			typ, class, size := u16_at(msg, off), u16_at(msg, off+2), u16_at(msg, off+8)
			off += 10
			if off+size > len(msg) {
				break
			}
			if typ == type_cname and class == 1 and owns(msg, owner, target) {
				next = off
				break
			}
			off += size
		}
		if next < 0 {
			break
		}
		n, ok := read_name(msg, next, names[hop%2][:])
		if not ok {
			return out, rcode, true
		}
		target = names[hop%2][:n]
	}
	off = start
	for _ in 0..answers {
		owner := off
		off, ok = skip_name(msg, off)
		if not ok or off+10 > len(msg) {
			break
		}
		typ := u16_at(msg, off)
		class := u16_at(msg, off+2)
		size := u16_at(msg, off+8)
		off += 10
		if off+size > len(msg) {
			break
		}
		if class == 1 and typ == qtype and (typ == type_a and size == 4 or typ == type_aaaa and size == 16) and owns(msg, owner, target) {
			var ip IP
			copy(ip.b[:], msg[off:off+size])
			ip.n = size
			out = add(out, ip)
		}
		off += size
	}
	return out, rcode, true
}

// owns reports whether the record at msg[off:] is owned by name (an encoded name).
fn owns(msg u8[], off int, name u8[]) -> bool {
	_, ok := match_name(msg, off, name)
	return ok
}

// read_name copies the name at msg[off:], following compression pointers, into dst as an encoded
// name (length bytes, labels, the root's 0) and returns its length.
fn read_name(msg u8[], off int, dst u8[]) -> (int, bool) {
	n, jumps := 0, 0
	loop {
		if off >= len(msg) {
			return 0, false
		}
		l := int(msg[off])
		if l&0xc0 == 0xc0 {
			if off+1 >= len(msg) or jumps == 32 {
				return 0, false
			}
			off = (l&0x3f)<<8 | int(msg[off+1])
			jumps++
			continue
		}
		if l&0xc0 != 0 or off+1+l > len(msg) or n+1+l > len(dst) {
			return 0, false
		}
		copy(dst[n:], msg[off:off+1+l])
		n += 1 + l
		off += 1 + l
		if l == 0 {
			return n, true
		}
	}
}

fn lower(c u8) -> u8 {
	if c >= 'A' and c <= 'Z' {
		return c + 32
	}
	return c
}

// match_name reports whether the name at msg[off:] (which may use compression pointers) is want,
// ignoring case, and returns the offset just after it.
fn match_name(msg u8[], off int, want u8[]) -> (int, bool) {
	end := -1 // where the name ends, once a pointer has been followed
	w := 0
	jumps := 0
	loop {
		if off >= len(msg) {
			return 0, false
		}
		l := int(msg[off])
		if l&0xc0 == 0xc0 {
			if off+1 >= len(msg) or jumps == 32 {
				return 0, false
			}
			if end < 0 {
				end = off + 2
			}
			off = (l&0x3f)<<8 | int(msg[off+1])
			jumps++
			continue
		}
		if l&0xc0 != 0 or w >= len(want) or int(want[w]) != l or off+1+l > len(msg) or w+1+l > len(want) {
			return 0, false
		}
		for i in 0..l {
			if lower(msg[off+1+i]) != lower(want[w+1+i]) {
				return 0, false
			}
		}
		w += 1 + l
		off += 1 + l
		if l == 0 {
			if end < 0 {
				end = off
			}
			return end, w == len(want)
		}
	}
}

// skip_name returns the offset just after the name at msg[off:].
fn skip_name(msg u8[], off int) -> (int, bool) {
	loop {
		if off >= len(msg) {
			return 0, false
		}
		l := int(msg[off])
		if l&0xc0 == 0xc0 {
			return off + 2, off+2 <= len(msg)
		}
		if l&0xc0 != 0 {
			return 0, false
		}
		off += 1 + l
		if l == 0 {
			return off, true
		}
	}
}
