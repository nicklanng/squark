module net

extern fn sys_ip_parse(s str, out u8[]) -> int stack 8K c"sq_ip_parse"

extern fn sys_ip_format(ip u8[], dst u8[]) -> int stack 8K c"sq_ip_format"

// IP is an IPv4 or IPv6 address, held by value. The zero IP is no address.
pub struct IP {
	b u8[16]
	n int // 4 or 16; 0 for the zero IP
}

// parse_ip reads an IPv4 ("10.0.0.1") or IPv6 ("::1", "2001:db8::7") literal; ok is false for
// anything else (a name, brackets, a port, a zone).
pub fn parse_ip(s str) -> (IP, bool) {
	var ip IP
	ip.n = sys_ip_parse(s, ip.b[:])
	return ip, ip.n != 0
}

// ipv4 returns the IPv4 address a.b.c.d.
pub fn ipv4(a, b, c, d u8) -> IP {
	var ip IP
	ip.b[0] = a
	ip.b[1] = b
	ip.b[2] = c
	ip.b[3] = d
	ip.n = 4
	return ip
}

// ipv6_loopback returns ::1.
pub fn ipv6_loopback() -> IP {
	var ip IP
	ip.b[15] = 1
	ip.n = 16
	return ip
}

impl IP {
	pub fn is_v4(self) -> bool { return self.n == 4 }
	pub fn is_v6(self) -> bool { return self.n == 16 }

	// equal reports whether ip and o are the same address (an IPv4 address never equals an IPv6
	// one, not even ::ffff:a.b.c.d).
	pub fn equal(self, o IP) -> bool {
		if self.n != o.n {
			return false
		}
		for i in 0..self.n {
			if self.b[i] != o.b[i] {
				return false
			}
		}
		return true
	}

	// string writes ip's text form ("10.0.0.1", "2001:db8::7") into buf and returns it as a view of
	// buf; the zero IP gives "". 46 bytes hold any address; a shorter buf gets the beginning.
	pub fn string(self, buf u8[]) -> str in buf {
		if self.n == 0 {
			return str(buf[:0])
		}
		n := sys_ip_format(self.b[:self.n], buf[:cap(buf)])
		return str(buf[:n])
	}
}
