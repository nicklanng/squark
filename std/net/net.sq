// Package net provides TCP listeners and connections over IPv4 and IPv6, and name lookup
// (lookup_ip: the hosts file, then DNS as resolv.conf says). Blocking calls park only the calling
// goroutine; the runtime multiplexes them with kqueue (macOS) or epoll (Linux).
module net

use io, os, strconv, strings, time

pub struct Listener {
	sysfd int
}

pub struct Conn {
	sysfd int
}

extern fn listen_tcp(host str, port int, backlog int) -> int stack 8K c"sq_listen_tcp"

extern fn local_port(fd int) -> int stack 8K c"sq_local_port"

extern fn close_write(fd int) -> int stack 8K c"sq_close_write"

extern fn accept(fd int) -> int stack 8K c"sq_accept"

extern fn sys_dial(ip u8[], port int, udp int) -> int stack 8K c"sq_dial"

extern fn sys_read(fd int, b u8[]) -> int stack 8K c"sq_read"

extern fn sys_read_timeout(fd int, b u8[], timeout_ns int) -> int stack 8K c"sq_read_timeout"

extern fn sys_write(fd int, b u8[]) -> int stack 8K c"sq_write"

extern fn sys_write_str(fd int, s str) -> int stack 8K c"sq_write_str"

extern fn sys_writev2(fd int, a u8[], b u8[]) -> int stack 8K c"sq_writev2"

extern fn sys_close(fd int) -> int stack 8K c"sq_close"

extern fn wait_idle(fd int, grace_ns int) -> int stack 8K c"sq_wait_idle"

extern fn park_idle(fd int, tag int) stack 8K c"sq_park_idle"

extern fn sys_next_idle() -> int stack 8K c"sq_next_idle"

extern fn sys_idle_count() -> int stack 8K c"sq_idle_count"

pub fault BadAddress 22 "invalid address (want host:port)"

// Timeout is returned by read_timeout when nothing arrived in time, and by every blocking call
// once the goroutine's deadline (with deadline) has passed.
pub fault Timeout -20 "i/o timeout"

const sq_e_timeout = 65536 // sq_read_timeout returns -sq_e_timeout for a timeout

// Stopping is returned by accept once a graceful stop has begun (runtime.stop_gracefully).
pub fault Stopping -23 "stopping: the program got a stop signal"

const sq_e_stop = 65537 // sq_accept returns -sq_e_stop during a graceful stop

// TooManyConnections is returned by dial and listen when the program already has the most sockets
// its connections N directive allows (accept waits for one to close instead).
pub fault TooManyConnections -24 "too many connections (the program's connections limit)"

const sq_e_toomany = 65538

// fd_error is the error for a runtime call's negative result: Timeout or an errno.
fn fd_error(n int) -> error {
	if n == -sq_e_timeout {
		return Timeout
	}
	if n == -sq_e_toomany {
		return TooManyConnections
	}
	return os.errno(-n)
}

// split_host_port splits "host:port", "[ipv6]:port" or ":port".
fn split_host_port(addr str) -> (str, int) ! {
	i := strings.last_index_byte(addr, ':')
	if i < 0 {
		return "", 0, BadAddress
	}
	port, err := strconv.atoi(addr[i+1:])
	if err != nil or port < 0 or port > 65535 {
		return "", 0, BadAddress
	}
	host := addr[:i]
	if strings.has_prefix(host, "[") {
		h, ok := strings.cut_suffix(host[1:], "]")
		if not ok or strings.index_byte(h, ':') < 0 {
			return "", 0, BadAddress
		}
		return h, port, nil
	}
	if strings.index_byte(host, ':') >= 0 or strings.index_byte(host, ']') >= 0 {
		return "", 0, BadAddress // an IPv6 address needs its brackets: "[::1]:80"
	}
	return host, port, nil
}

// append_host_port appends "host:port" to dst, as Go's JoinHostPort: a host containing ':' (an IPv6
// literal) is put in brackets, "[::1]:80". An empty host gives ":port", which listen takes as
// every interface.
pub fn append_host_port(dst u8[], host str, port int) -> u8[] in dst {
	if strings.index_byte(host, ':') >= 0 {
		dst = append(append(append(dst, '['), host...), ']')
	} else {
		dst = append(dst, host...)
	}
	return strconv.append_int(append(dst, ':'), port)
}

// listen opens a TCP listener on addr: "host:port", "[ipv6]:port" or ":port". An empty host is
// every interface, IPv6 and IPv4 (IPv4 alone where the system has no IPv6); "localhost" is
// 127.0.0.1, and another name is its first address (lookup_ip).
pub fn listen(addr str) -> Listener ! {
	host, port, err := split_host_port(addr)
	if err != nil {
		return Listener{sysfd: -1}, err
	}
	var text u8[46]
	if strings.equal_fold(host, "localhost") {
		host = "127.0.0.1"
	} else if _, ok := parse_ip(host); not ok and host != "" {
		var ips IP[1]
		found, err := lookup_ip(host, ips[:])
		if err != nil {
			return Listener{sysfd: -1}, err
		}
		host = found[0].string(text[:])
	}
	fd := listen_tcp(host, port, 4096)
	if fd < 0 {
		return Listener{sysfd: -1}, fd_error(fd)
	}
	return Listener{sysfd: fd}, nil
}

impl Listener {
	// accept waits for the next connection. During a graceful stop it returns Stopping.
	pub fn accept(self) -> Conn ! {
		fd := accept(self.sysfd)
		if fd == -sq_e_stop {
			return Conn{sysfd: -1}, Stopping
		}
		if fd == -sq_e_timeout {
			return Conn{sysfd: -1}, Timeout
		}
		if fd < 0 {
			return Conn{sysfd: -1}, os.errno(-fd)
		}
		return Conn{sysfd: fd}, nil
	}

	// port returns the port l listens on: the one the system chose, after listen(":0").
	pub fn port(self) -> int { return local_port(self.sysfd) }

	pub fn close(self) -> ! {
		if r := sys_close(self.sysfd); r < 0 {
			return os.errno(-r)
		}
		return nil
	}
}

// dial connects to a TCP address: "host:port" or "[ipv6]:port". A name is looked up with
// lookup_ip and its addresses are tried in turn, IPv4 first, until one connects; an empty host is
// the local system (127.0.0.1).
pub fn dial(addr str) -> Conn ! {
	host, port, err := split_host_port(addr)
	if err != nil {
		return Conn{sysfd: -1}, err
	}
	var ips IP[8]
	list := ips[:0]
	if host == "" {
		list = append(list, ipv4(127, 0, 0, 1))
	} else {
		list, err = lookup_ip(host, ips[:])
		if err != nil {
			return Conn{sysfd: -1}, err
		}
	}
	for ip in list {
		c, e := dial_ip(ip, port)
		if e == nil {
			return c, nil
		}
		err = e
	}
	return Conn{sysfd: -1}, err
}

// dial_ip connects to port at ip over TCP.
pub fn dial_ip(ip IP, port int) -> Conn ! { return dial_proto(ip, port, 0) }

// dial_proto connects over TCP (udp 0) or makes a connected UDP socket (udp 1), whose reads and
// writes are single datagrams from and to ip:port.
fn dial_proto(ip IP, port int, udp int) -> Conn ! {
	if ip.n == 0 or port < 0 or port > 65535 {
		return Conn{sysfd: -1}, BadAddress
	}
	fd := sys_dial(ip.b[:ip.n], port, udp)
	if fd < 0 {
		return Conn{sysfd: -1}, fd_error(fd)
	}
	return Conn{sysfd: fd}, nil
}

impl Conn {
	pub fn fd(self) -> int { return self.sysfd }

	// read reads into p. Like every blocking call here, it returns Timeout once the goroutine's
	// deadline (with deadline) has passed.
	pub fn read(self, p u8[]) -> int ! {
		n := sys_read(self.sysfd, p)
		if n < 0 {
			return 0, fd_error(n)
		}
		if n == 0 and len(p) > 0 {
			return 0, io.EOF
		}
		return n, nil
	}

	// read_timeout is read that waits at most d for input: if nothing arrives in time it returns 0 and
	// Timeout. Input that is already waiting is read at once, whatever d is. d <= 0 means no
	// deadline (a plain read), so a caller counting down to a deadline checks there is time left.
	pub fn read_timeout(self, p u8[], d time.Duration) -> int ! {
		if d <= 0 {
			return self.read(p)
		}
		n := sys_read_timeout(self.sysfd, p, int(d))
		if n < 0 {
			return 0, fd_error(n)
		}
		if n == 0 and len(p) > 0 {
			return 0, io.EOF
		}
		return n, nil
	}

	// with_timeout returns c as a source whose read is c.read_timeout(p, d), for readers that take
	// anything with a read method: r.read_line(c.with_timeout(idle)) returns Timeout when no input
	// comes for d. The limit applies to each read, not to a whole line. d <= 0 means no deadline.
	pub fn with_timeout(self, d time.Duration) -> TimedConn { return TimedConn{c: self, d: d} }

	pub fn write(self, p u8[]) -> int ! {
		n := sys_write(self.sysfd, p)
		if n < 0 {
			return 0, fd_error(n)
		}
		if n < len(p) {
			return n, io.ShortWrite
		}
		return n, nil
	}

	pub fn write_string(self, s str) -> int ! {
		n := sys_write_str(self.sysfd, s)
		if n < 0 {
			return 0, fd_error(n)
		}
		if n < len(s) {
			return n, io.ShortWrite
		}
		return n, nil
	}

	// write2 writes a then b, using a single writev where possible.
	pub fn write2(self, a, b u8[]) -> int ! {
		n := sys_writev2(self.sysfd, a, b)
		if n < 0 {
			return 0, fd_error(n)
		}
		if n < len(a)+len(b) {
			return n, io.ShortWrite
		}
		return n, nil
	}

	// wait_readable parks until c is readable and returns true, or returns false if nothing arrives
	// within grace.
	pub fn wait_readable(self, grace time.Duration) -> bool {
		return wait_idle(self.sysfd, int(grace)) == 0
	}

	// park_idle hands c to the runtime's idle set with a tag (0..255) that next_idle returns with it,
	// e.g. to say which server it belongs to. No goroutine waits for it: when it becomes readable it is
	// returned by next_idle. The calling goroutine's stack is returned to the OS when it exits, so an
	// idle connection costs no memory beyond the kernel's socket.
	pub fn park_idle(self, tag int) {
		park_idle(self.sysfd, tag)
	}

	// close_write shuts down the sending side: the peer reads EOF once it has read everything sent,
	// while c can still read. Close a connection this way after a final reply, so the reply isn't
	// lost to a reset when unread input remains.
	pub fn close_write(self) -> ! {
		if r := close_write(self.sysfd); r < 0 {
			return os.errno(-r)
		}
		return nil
	}

	pub fn close(self) -> ! {
		if r := sys_close(self.sysfd); r < 0 {
			return os.errno(-r)
		}
		return nil
	}
}

// TimedConn is a Conn whose reads time out: see Conn.with_timeout.
pub struct TimedConn {
	c Conn
	d time.Duration
}

impl TimedConn {
	// read is read_timeout with t's limit.
	pub fn read(self, p u8[]) -> int ! { return self.c.read_timeout(p, self.d) }
}

// next_idle blocks until a parked connection becomes readable and returns it with its tag.
// Only one goroutine may call next_idle at a time.
pub fn next_idle() -> (Conn, int) {
	v := sys_next_idle()
	return Conn{sysfd: v & 0xffffffff}, v >> 32
}

// idle_count reports how many connections are parked in the idle set.
pub fn idle_count() -> int { return sys_idle_count() }

