// Package time measures and waits.
module time

pub Duration: int

const (
	pub nanosecond  Duration = 1
	pub microsecond = 1000 * nanosecond
	pub millisecond = 1000 * microsecond
	pub second      = 1000 * millisecond
	pub minute      = 60 * second
	pub hour        = 60 * minute
)

extern fn nanotime() -> int stack 8K c"sq_nanotime"

extern fn unixnano() -> int stack 8K c"sq_unixnano"

extern fn sys_sleep(ns int) stack 8K c"sq_sleep"

// Time is a monotonic instant plus the wall clock reading when it was taken.
pub struct Time {
	mono int
	wall int
}

pub fn now() -> Time { return Time{mono: nanotime(), wall: unixnano()} }

impl Time {
	pub fn sub(self, u Time) -> Duration { return Duration(self.mono - u.mono) }
	pub fn unix(self) -> int             { return self.wall / 1000000000 }
	pub fn unix_nano(self) -> int        { return self.wall }
	pub fn add(self, d Duration) -> Time { return Time{mono: self.mono + int(d), wall: self.wall + int(d)} }
	pub fn before(self, u Time) -> bool  { return self.mono < u.mono }
}

pub fn since(t Time) -> Duration { return Duration(nanotime() - t.mono) }

// sleep parks the calling goroutine for at least d.
pub fn sleep(d Duration) { sys_sleep(int(d)) }

// after is for select only: `case <-time.after(d):` runs if no other case is ready within d.
// (squark has no heap to make a channel per call, so the compiler turns the case into a timer;
// anywhere else, after is an error.)
pub fn after(d Duration) -> Time chan {
	var c Time chan
	return c
}

impl Duration {
	pub fn nanoseconds(self) -> int  { return int(self) }
	pub fn microseconds(self) -> int { return int(self) / 1000 }
	pub fn milliseconds(self) -> int { return int(self) / 1000000 }
	pub fn seconds(self) -> f64      { return f64(self) / 1e9 }

	// string writes d as Go's Duration.string does ("1h2m3.5s", "1.5ms", "0s") into buf and returns
	// it as a view of buf. 32 bytes hold any duration; a shorter buf gets the beginning.
	pub fn string(self, buf u8[]) -> str in buf {
		var arr u8[32]
		w := len(arr)
		u := u64(self)
		neg := self < 0
		if neg {
			u = 0 - u
		}
		if u < u64(second) {
			// under a second: a smaller unit, so 1.5ms rather than 0.0015s
			prec := 0
			w--
			arr[w] = 's'
			w--
			switch {
			case u == 0:
				arr[w] = '0'
				return str(buf[:copy(buf, arr[w:])])
			case u < u64(microsecond):
				arr[w] = 'n'
			case u < u64(millisecond):
				prec = 3
				w-- // the micro sign is two bytes
				copy(arr[w:], "µ")
			default:
				prec = 6
				arr[w] = 'm'
			}
			w, u = fmt_frac(arr[:w], u, prec)
			w = fmt_int(arr[:w], u)
		} else {
			w--
			arr[w] = 's'
			w, u = fmt_frac(arr[:w], u, 9)
			w = fmt_int(arr[:w], u%60)
			u /= 60
			if u > 0 {
				w--
				arr[w] = 'm'
				w = fmt_int(arr[:w], u%60)
				u /= 60
				if u > 0 {
					w--
					arr[w] = 'h'
					w = fmt_int(arr[:w], u)
				}
			}
		}
		if neg {
			w--
			arr[w] = '-'
		}
		return str(buf[:copy(buf, arr[w:])])
	}
}

// InvalidDuration is parse_duration's error for any string that isn't a duration (Go's messages name
// the string; a squark error's message is constant).
pub fault InvalidDuration 22 "time: invalid duration"

// fmt_frac writes the fraction of v/10^prec, without trailing zeros, at the end of buf, and returns
// where it starts and v/10^prec.
fn fmt_frac(buf u8[], v u64, prec int) -> (int, u64) {
	w := len(buf)
	print := false
	for i := 0; i < prec; i++ {
		digit := v % 10
		print = print or digit != 0
		if print {
			w--
			buf[w] = u8(digit) + '0'
		}
		v /= 10
	}
	if print {
		w--
		buf[w] = '.'
	}
	return w, v
}

// fmt_int writes v at the end of buf and returns where it starts.
fn fmt_int(buf u8[], v u64) -> int {
	w := len(buf)
	if v == 0 {
		w--
		buf[w] = '0'
		return w
	}
	while v > 0 {
		w--
		buf[w] = u8(v%10) + '0'
		v /= 10
	}
	return w
}

// parse_duration parses a duration as Go's time.parse_duration does: a signed sequence of decimal
// numbers, each with an optional fraction and a unit ("300ms", "-1.5h", "2h45m"). The units are
// "ns", "us" (or "µs"), "ms", "s", "m" and "h". A malformed, unitless (except "0") or
// out-of-range string is InvalidDuration.
pub fn parse_duration(s str) -> Duration ! {
	var d u64
	neg := false
	if s != "" and (s[0] == '-' or s[0] == '+') {
		neg = s[0] == '-'
		s = s[1:]
	}
	if s == "0" {
		return 0, nil
	}
	if s == "" {
		return 0, InvalidDuration
	}
	while s != "" {
		if not (s[0] == '.' or '0' <= s[0] and s[0] <= '9') {
			return 0, InvalidDuration
		}
		// [0-9]*
		var v u64
		i := 0
		for ; i < len(s) and '0' <= s[i] and s[i] <= '9'; i++ {
			if v > 1<<63/10 {
				return 0, InvalidDuration
			}
			v = v*10 + u64(s[i]-'0')
			if v > 1<<63 {
				return 0, InvalidDuration
			}
		}
		pre := i > 0
		s = s[i:]
		// (\.[0-9]*)?
		var f u64
		scale := 1.0
		post := false
		if s != "" and s[0] == '.' {
			s = s[1:]
			overflow := false
			i = 0
			for ; i < len(s) and '0' <= s[i] and s[i] <= '9'; i++ {
				if overflow {
					continue
				}
				if f > (1<<63-1)/10 {
					overflow = true // stop gaining precision
					continue
				}
				y := f*10 + u64(s[i]-'0')
				if y > 1<<63 {
					overflow = true
					continue
				}
				f = y
				scale *= 10
			}
			post = i > 0
			s = s[i:]
		}
		if not pre and not post {
			return 0, InvalidDuration // no digits (".s")
		}
		// the unit
		i = 0
		while i < len(s) and s[i] != '.' and not ('0' <= s[i] and s[i] <= '9') {
			i++
		}
		var unit u64
		switch s[:i] {
		case "ns":
			unit = u64(nanosecond)
		case "us", "µs", "μs": // the micro sign U+00B5, or the Greek mu U+03BC
			unit = u64(microsecond)
		case "ms":
			unit = u64(millisecond)
		case "s":
			unit = u64(second)
		case "m":
			unit = u64(minute)
		case "h":
			unit = u64(hour)
		default:
			return 0, InvalidDuration // a missing or unknown unit
		}
		s = s[i:]
		if v > 1<<63/unit {
			return 0, InvalidDuration
		}
		v *= unit
		if f > 0 {
			// float64 keeps fractions of hours accurate to the nanosecond
			v += u64(f64(f) * (f64(unit) / scale))
			if v > 1<<63 {
				return 0, InvalidDuration
			}
		}
		d += v
		if d > 1<<63 {
			return 0, InvalidDuration
		}
	}
	if neg {
		return Duration(0 - d), nil
	}
	if d > 1<<63-1 {
		return 0, InvalidDuration
	}
	return Duration(d), nil
}
