// Package rand generates pseudo-random numbers with xoshiro256** (Blackman and Vigna), seeded
// through splitmix64. It is fast and statistically good, but predictable: not for keys, tokens
// or anything an attacker must not guess.
//
// A Rand is a plain value (32 bytes of state, no references): keep one in a variable, a struct
// or a package variable; a copy carries on from the same point in the sequence. New(seed) gives
// the same sequence on every run and platform. The package-level functions use one generator per
// scheduler thread, seeded from the clock, the process id and the thread index at its first use;
// as in Go 1.20 and later there is no Seed function: use new(seed) for a repeatable sequence.
module rand

use os, runtime, time

// Rand is a xoshiro256** generator. Make one with new: the zero value yields only zeros.
pub struct Rand {
	s0, s1, s2, s3 u64
}

// splitmix64 advances *x and returns its next output; it spreads a seed over the state.
fn splitmix64(x *u64) -> u64 {
	*x += 0x9e3779b97f4a7c15
	z := *x
	z = (z ^ z>>30) * 0xbf58476d1ce4e5b9
	z = (z ^ z>>27) * 0x94d049bb133111eb
	return z ^ z>>31
}

// new returns a generator seeded with seed. Every seed, 0 included, gives a good state.
pub fn new(seed u64) -> Rand {
	var r Rand
	r.s0 = splitmix64(&seed)
	r.s1 = splitmix64(&seed)
	r.s2 = splitmix64(&seed)
	r.s3 = splitmix64(&seed)
	return r
}

fn rotl(x u64, k uint) -> u64 { return x<<k | x>>(64-k) }

impl Rand {
	// uint64 returns a uniformly distributed 64-bit value.
	pub fn uint64(&self) -> u64 {
		result := rotl(self.s1*5, 7) * 9
		t := self.s1 << 17
		self.s2 ^= self.s0
		self.s3 ^= self.s1
		self.s1 ^= self.s2
		self.s0 ^= self.s3
		self.s2 ^= t
		self.s3 = rotl(self.s3, 45)
		return result
	}

	// int63 returns a non-negative value below 1<<63.
	pub fn int63(&self) -> i64 { return i64(self.uint64() >> 1) }

	// Int returns a non-negative int.
	pub fn next(&self) -> int { return int(self.uint64() >> 1) }

	// intn returns a value in [0, n), without modulo bias. It panics if n <= 0, as Go's does.
	pub fn intn(&self, n int) -> int {
		if n <= 0 {
			panic("invalid argument to Intn")
		}
		return int(self.uint64n(u64(n)))
	}

	// uint64n returns a value in [0, n) for n > 0 by Lemire's multiply-and-reject method: the high
	// half of a random value times n, redrawing in the rare case that would be biased.
	fn uint64n(&self, n u64) -> u64 {
		if n&(n-1) == 0 {
			return self.uint64() & (n - 1)
		}
		if n < 1<<32 {
			// 32 random bits times n fits in 64 bits
			m := (self.uint64() >> 32) * n
			if u32(m) < u32(n) {
				thresh := (u32(0) - u32(n)) % u32(n)
				while u32(m) < thresh {
					m = (self.uint64() >> 32) * n
				}
			}
			return m >> 32
		}
		hi, lo := mul64(self.uint64(), n)
		if lo < n {
			thresh := (u64(0) - n) % n
			while lo < thresh {
				hi, lo = mul64(self.uint64(), n)
			}
		}
		return hi
	}

	// float64 returns a value in [0, 1): one of the 2^53 multiples of 2^-53, uniformly.
	pub fn float64(&self) -> f64 {
		return f64(self.uint64()>>11) * (1.0 / (1 << 53))
	}

	// perm fills dst with a random permutation of 0 .. len(dst)-1 and returns it (Go's perm(n),
	// into the caller's memory).
	pub fn perm(&self, dst int[]) -> int[] in dst {
		for i, _ in dst {
			j := self.intn(i + 1)
			dst[i] = dst[j]
			dst[j] = i
		}
		return dst
	}

	// shuffle puts the elements of s (T[] for any T; a slice of an array or vector) in a random
	// order, each order equally likely. Go's shuffle(n, swap) needs a closure; this takes the slice.
	pub fn shuffle(&self, s anytype) {
		for i := len(s) - 1; i > 0; i-- {
			j := self.intn(i + 1)
			s[i], s[j] = s[j], s[i]
		}
	}
}

// mul64 returns the 128-bit product of x and y as its high and low halves.
fn mul64(x, y u64) -> (u64, u64) {
	const mask32 = 1<<32 - 1
	x0, x1 := x&mask32, x>>32
	y0, y1 := y&mask32, y>>32
	w0 := x0 * y0
	t := x1*y0 + w0>>32
	w1 := t&mask32 + x0*y1
	hi := x1*y1 + t>>32 + w1>>32
	return hi, x * y
}

// ---- the per-thread generator ----

thread (
	global Rand
	seeded bool
)

// state returns this thread's generator, seeding it at first use.
fn state() -> *Rand {
	if not seeded {
		seed := u64(time.now().unix_nano())
		seed ^= u64(os.getpid()) << 32
		seed ^= u64(runtime.shard()) * 0xbf58476d1ce4e5b9
		global = new(seed)
		seeded = true
	}
	return &global
}

// uint64 returns a uniformly distributed 64-bit value from this thread's generator.
pub fn uint64() -> u64 { return state().uint64() }

// int63 returns a non-negative value below 1<<63 from this thread's generator.
pub fn int63() -> i64 { return state().int63() }

// Int returns a non-negative int from this thread's generator.
pub fn next() -> int { return state().next() }

// intn returns a value in [0, n) from this thread's generator. It panics if n <= 0.
pub fn intn(n int) -> int { return state().intn(n) }

// float64 returns a value in [0, 1) from this thread's generator.
pub fn float64() -> f64 { return state().float64() }

// perm fills dst with a random permutation of 0 .. len(dst)-1 from this thread's generator.
pub fn perm(dst int[]) -> int[] in dst { return state().perm(dst) }

// shuffle puts the elements of s (T[] for any T) in a random order, from this thread's generator.
pub fn shuffle(s anytype) { state().shuffle(s) }
