// Package math wraps the C math library. Its functions are leaves that need very little stack.
module math

const (
	pub pi        = 3.14159265358979323846264338327950288419716939937510582097494459
	pub e         = 2.71828182845904523536028747135266249775724709369995957496696763
	pub max_int64 = 1<<63 - 1
	pub min_int64 = -1 << 63
	pub max_int   = max_int64
	pub min_int   = min_int64

	pub max_float64              = 1.79769313486231570814527423731704356798070e+308
	pub smallest_nonzero_float64 = 4.9406564584124654417656879286822137236505980e-324
)

pub extern fn sqrt(x f64) -> f64 stack 1K c"sqrt"

pub extern fn abs(x f64) -> f64 stack 1K c"fabs"

pub extern fn floor(x f64) -> f64 stack 1K c"floor"

pub extern fn ceil(x f64) -> f64 stack 1K c"ceil"

pub extern fn pow(x, y f64) -> f64 stack 1K c"pow"

pub extern fn exp(x f64) -> f64 stack 1K c"exp"

pub extern fn log(x f64) -> f64 stack 1K c"log"

pub extern fn sin(x f64) -> f64 stack 1K c"sin"

pub extern fn cos(x f64) -> f64 stack 1K c"cos"

// float64bits returns the IEEE 754 bits of f.
pub extern fn float64bits(f f64) -> u64 stack 1K c"sq_float64bits"

// float64frombits returns the float64 with IEEE 754 bits b.
pub extern fn float64frombits(b u64) -> f64 stack 1K c"sq_float64frombits"

// round returns x rounded to the nearest integer, halves away from zero.
pub extern fn round(x f64) -> f64 stack 1K c"round"

// trunc returns the integer part of x.
pub extern fn trunc(x f64) -> f64 stack 1K c"trunc"

// mod returns the remainder of x/y, with the sign of x.
pub extern fn mod(x, y f64) -> f64 stack 1K c"fmod"

pub extern fn log2(x f64) -> f64 stack 1K c"log2"

pub extern fn log10(x f64) -> f64 stack 1K c"log10"

pub extern fn tan(x f64) -> f64 stack 1K c"tan"

pub extern fn atan(x f64) -> f64 stack 1K c"atan"

pub extern fn atan2(y, x f64) -> f64 stack 1K c"atan2"

pub extern fn hypot(x, y f64) -> f64 stack 1K c"hypot"

// inf returns positive infinity if sign >= 0, negative infinity otherwise.
pub fn inf(sign int) -> f64 {
	if sign >= 0 {
		return float64frombits(0x7FF0000000000000)
	}
	return float64frombits(0xFFF0000000000000)
}

// na_n returns an IEEE 754 not-a-number value.
pub fn na_n() -> f64 { return float64frombits(0x7FF8000000000001) }

// is_na_n reports whether f is not a number.
pub fn is_na_n(f f64) -> bool { return f != f }

// is_inf reports whether f is an infinity: either one if sign is 0, +inf if sign > 0, -inf if
// sign < 0.
pub fn is_inf(f f64, sign int) -> bool {
	return sign >= 0 and f > max_float64 or sign <= 0 and f < -max_float64
}
