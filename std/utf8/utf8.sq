// Package utf8 encodes and decodes UTF-8.
module utf8

pub const rune_error = 0xFFFD
pub const max_rune = 0x10FFFF

// append_rune appends the UTF-8 encoding of r to dst.
pub fn append_rune(dst u8[], r rune) -> u8[] {
	switch {
	case r >= 0 and r < 0x80:
		return append(dst, u8(r))
	case r >= 0 and r < 0x800:
		return append(dst, u8(0xC0|r>>6), u8(0x80|r&0x3F))
	case r >= 0xD800 and r <= 0xDFFF, r < 0, r > max_rune:
		r = rune_error
	}
	if r < 0x10000 {
		return append(dst, u8(0xE0|r>>12), u8(0x80|(r>>6)&0x3F), u8(0x80|r&0x3F))
	}
	return append(dst, u8(0xF0|r>>18), u8(0x80|(r>>12)&0x3F), u8(0x80|(r>>6)&0x3F), u8(0x80|r&0x3F))
}

// rune_len returns the number of bytes needed to encode r.
pub fn rune_len(r rune) -> int {
	switch {
	case r < 0:
		return -1
	case r < 0x80:
		return 1
	case r < 0x800:
		return 2
	case r >= 0xD800 and r < 0xE000:
		return -1 // surrogates are not valid runes
	case r < 0x10000:
		return 3
	case r <= max_rune:
		return 4
	}
	return -1
}

// decode_rune_in_string returns the first rune of s and its width in bytes. Invalid UTF-8 gives
// (rune_error, 1); an empty string gives (rune_error, 0).
pub fn decode_rune_in_string(s str) -> (rune, int) {
	if len(s) == 0 {
		return rune_error, 0
	}
	first := rune(rune_error)
	for i, r in s {
		if i > 0 {
			return first, i
		}
		first = r
	}
	return first, len(s)
}

// rune_count_in_string counts the runes in s.
pub fn rune_count_in_string(s str) -> int {
	n := 0
	for _ in s {
		n++
	}
	return n
}
