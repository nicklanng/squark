// Package sqlite binds libsqlite3. SQLite manages its own memory, within the heap limit the
// program declares (heap sqlite3 N; 16M by default), which the memory report counts; squark code
// never touches the heap: column text is copied into caller-provided buffers.
module sqlite {
	link "sqlite3"
	heap sqlite3 16M // a program can change it: program { heap sqlite3 64M }
	cflags "-I/opt/homebrew/opt/sqlite/include"
	ldflags "-L/opt/homebrew/opt/sqlite/lib"
}

use os

const (
	pub ok     = 0
	pub misuse = 21 // a closed DB or a finalized Stmt (or one from a failed prepare)
	pub row    = 100
	pub done   = 101
)

const (
	pub type_integer = 1
	pub type_float   = 2
	pub type_text    = 3
	pub type_blob    = 4
	pub type_null    = 5
)

// DB and Stmt are handles: copies name the same connection or statement. Once it is closed or
// finalized, every copy gets misuse.
pub struct DB {
	h   rawptr
	gen int
}

pub struct Stmt {
	h   rawptr
	db  rawptr
	gen int
}

// SQLite calls get a generous stack budget: the query planner and VDBE are not tiny. Statements
// start inline; one that runs long or must wait for another connection's lock moves to a helper
// thread mid-call, so the thread's other tasks keep running. Each connection has a lock that
// keeps one task in it at a time (see shim.c).

extern fn sys_open(path str, db *rawptr) -> int stack 128K blocking c"sq_sqlite_open"

extern fn close_db(db rawptr) -> int stack 64K blocking c"sq_sqlite_close"

extern fn exec(db rawptr, sql str) -> int stack 128K c"sq_sqlite_exec"

extern fn prepare(db rawptr, sql str, st *rawptr) -> int stack 128K blocking c"sq_sqlite_prepare"

extern fn db_use(db rawptr) stack 16K c"sq_sqlite_db_use"

extern fn db_done(db rawptr) stack 16K c"sq_sqlite_db_done"

extern fn stmt_use(st rawptr) stack 16K c"sq_sqlite_stmt_use"

extern fn bind_int(st rawptr, i int, v int) -> int stack 16K c"sq_sqlite_bind_int"

extern fn bind_text(st rawptr, i int, s str) -> int stack 16K c"sq_sqlite_bind_text"

extern fn bind_null(st rawptr, i int) -> int stack 16K c"sq_sqlite_bind_null"

extern fn step(st rawptr) -> int stack 128K c"sq_sqlite_step"

extern fn reset(st rawptr) -> int stack 64K c"sq_sqlite_reset"

extern fn finalize(st rawptr) -> int stack 64K blocking c"sq_sqlite_finalize"

extern fn column_int(st rawptr, i int) -> int stack 16K c"sq_sqlite_column_int"

extern fn column_type(st rawptr, i int) -> int stack 16K c"sq_sqlite_column_type"

extern fn column_count(st rawptr) -> int stack 16K c"sq_sqlite_column_count"

extern fn column_text(st rawptr, i int, buf u8[]) -> int stack 16K c"sq_sqlite_column_text"

extern fn changes(db rawptr) -> int stack 16K c"sq_sqlite_changes"

extern fn last_insert_row_id(db rawptr) -> int stack 16K c"sq_sqlite_last_insert_rowid"

extern fn errstr(rc int) -> str stack 16K c"sq_sqlite_errstr"

extern fn db_gen(db rawptr) -> int stack 1K c"sq_sqlite_db_gen"

extern fn stmt_gen(st rawptr) -> int stack 1K c"sq_sqlite_stmt_gen"

extern fn db_live(db rawptr, gen int) -> bool stack 1K c"sq_sqlite_db_live"

extern fn stmt_live(st rawptr, gen int) -> bool stack 1K c"sq_sqlite_stmt_live"

pub fault Truncated -1 "sqlite: column text larger than buffer"

fn check(rc int) -> ! {
	if rc == ok or rc == row or rc == done {
		return nil
	}
	return error(rc, errstr(rc))
}

// open opens (creating if needed) a database file. When the file is locked by another connection
// (another thread or process, e.g. with threads N or workers N), statements wait up to 5 seconds
// before failing with "database is locked"; only the calling task waits.
//
// A connection serves one task at a time: a statement holds it from its first Bind or step
// until reset (so start with `defer st.reset()`), and other tasks that use the connection
// meanwhile wait for it. Stmt.exec runs a statement from start to end in one call and gives the
// connection back before it returns. DB.exec, prepare, changes and last_insert_row_id hold it for
// the call (or join the statement the task is running: call changes and last_insert_row_id
// before reset).
pub fn open(path str) -> DB ! {
	for i := 0; i < len(path); i++ {
		if path[i] == 0 { // C would stop at the NUL and open another file
			return DB{}, os.errno(22) // EINVAL, as os.open reports it
		}
	}
	var h rawptr
	rc := sys_open(path, &h)
	return DB{h: h, gen: db_gen(h)}, check(rc)
}

impl DB {
	// close closes the connection; nothing may use it afterwards (or be waiting for it).
	pub fn close(self) -> ! {
		if not db_live(self.h, self.gen) {
			return check(misuse)
		}
		db_use(self.h)
		return check(close_db(self.h))
	}

	// exec runs one or more SQL statements that return no rows. Outside a transaction, a statement
	// that finds the database locked (another worker setting it up) is retried for up to 5 seconds.
	pub fn exec(self, sql str) -> ! {
		if not db_live(self.h, self.gen) {
			return check(misuse)
		}
		db_use(self.h)
		rc := exec(self.h, sql)
		db_done(self.h)
		return check(rc)
	}

	// prepare compiles a statement for repeated use.
	pub fn prepare(self, sql str) -> Stmt ! {
		var h rawptr
		if not db_live(self.h, self.gen) {
			return Stmt{}, check(misuse)
		}
		db_use(self.h)
		rc := prepare(self.h, sql, &h)
		db_done(self.h)
		return Stmt{h: h, db: self.h, gen: stmt_gen(h)}, check(rc)
	}

	pub fn changes(self) -> int {
		if not db_live(self.h, self.gen) {
			return 0
		}
		return changes(self.h)
	}

	pub fn last_insert_row_id(self) -> int {
		if not db_live(self.h, self.gen) {
			return 0
		}
		return last_insert_row_id(self.h)
	}
}

impl Stmt {
	// Bind* use 1-based parameter indexes, like SQLite. Text is copied by SQLite.
	pub fn bind_int(self, i int, v int) -> ! {
		if not self.live() {
			return check(misuse)
		}
		return check(bind_int(self.h, i, v))
	}

	pub fn bind_text(self, i int, v str) -> ! {
		if not self.live() {
			return check(misuse)
		}
		return check(bind_text(self.h, i, v))
	}

	pub fn bind_null(self, i int) -> ! {
		if not self.live() {
			return check(misuse)
		}
		return check(bind_null(self.h, i))
	}

	fn live(self) -> bool { return stmt_live(self.h, self.gen) }

	// step advances to the next row; it returns true while a row is available.
	pub fn step(self) -> bool ! {
		if not self.live() {
			return false, check(misuse)
		}
		stmt_use(self.h)
		rc := step(self.h)
		if rc == row {
			return true, nil
		}
		return false, check(rc)
	}

	// reset makes the statement ready to run again, clears its bindings and gives back the
	// connection.
	pub fn reset(self) -> ! {
		if not self.live() {
			return check(misuse)
		}
		return check(reset(self.h))
	}

	// exec runs the statement once with args bound to its parameters in order (?1, ?2, ...): it
	// resets it, binds args, steps it to the end (skipping any rows it returns), reads the Result and
	// resets it again. The statement holds the connection only during the call, so there is no reset
	// to defer.
	pub fn exec(self, args ...Value) -> Result ! {
		if not self.live() {
			return Result{}, check(misuse)
		}
		self.reset()
		err := self.run(args)
		var res Result
		if err == nil {
			res = Result{last_insert_id: last_insert_row_id(self.db), rows_affected: changes(self.db)}
		}
		self.reset()
		return res, err
	}

	// run binds args and steps the statement to its end.
	fn run(self, args Value[]) -> ! {
		for i, v in args {
			switch v.kind {
			case 1:
				self.bind_int(i+1, v.i)!
			case 2:
				self.bind_text(i+1, v.s)!
			default:
				self.bind_null(i + 1)!
			}
		}
		while self.step()! {
		}
		return nil
	}

	pub fn finalize(self) -> ! {
		if not self.live() {
			return check(misuse)
		}
		db_use(self.db)
		rc := finalize(self.h)
		db_done(self.db)
		return check(rc)
	}

	pub fn column_count(self) -> int {
		if not self.live() {
			return 0
		}
		return column_count(self.h)
	}

	pub fn column_type(self, i int) -> int {
		if not self.live() {
			return type_null
		}
		return column_type(self.h, i)
	}

	pub fn column_int(self, i int) -> int {
		if not self.live() {
			return 0
		}
		return column_int(self.h, i)
	}

	// column_text copies column i (0-based) into buf and returns it as a view of buf.
	pub fn column_text(self, i int, buf u8[]) -> str ! {
		if not self.live() {
			return str(buf[:0]), check(misuse)
		}
		n := column_text(self.h, i, buf)
		if n > cap(buf) {
			return str(buf[:cap(buf)]), Truncated
		}
		return str(buf[:n]), nil
	}
}

// Value is an argument to exec: Int(v), text(s) or null() (the zero Value).
pub struct Value {
	kind int // 0 null, 1 int, 2 text
	i    int
	s    str
}

// Int, text and null make exec's arguments (SQLite copies text's string when it is bound).
pub fn integer(v int) -> Value   { return Value{kind: 1, i: v} }
pub fn text(s str) -> Value in s { return Value{kind: 2, s: s} }
pub fn null() -> Value           { return Value{} }

// Result is what exec reports, as SQLite does after the statement: last_insert_row_id and changes,
// which an INSERT, UPDATE or DELETE sets (after another statement they still hold the
// connection's last such values).
pub struct Result {
	pub last_insert_id int // the rowid of the last row inserted
	pub rows_affected  int // how many rows were inserted, updated or deleted
}
