// Package io holds the shared error values for readers and writers.
module io

// EOF is returned by Read when no more input is available.
pub fault EOF -1 "EOF"

// ShortWrite means a write accepted fewer bytes than requested.
pub fault ShortWrite -2 "short write"

// ShortBuffer means a caller-provided buffer was too small for the result.
pub fault ShortBuffer -3 "short buffer"

// UnexpectedEOF means the input ended before a read of a fixed size was complete.
pub fault UnexpectedEOF -4 "unexpected EOF"

// TooLarge means the input doesn't fit in the caller's buffer.
pub fault TooLarge -5 "input larger than the buffer"
