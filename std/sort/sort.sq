// Package sort sorts slices of any element type in place. less(a, b) reports whether a goes
// before b. Heap sort: O(n log n) comparisons, no extra memory, no recursion; not stable (equal
// elements may change order).
module sort

// slice sorts s (T[] for any T) by less (an fn(a, b T) -> bool).
pub fn slice(s anytype, less anytype) {
	n := len(s)
	for start := n/2 - 1; start >= 0; start-- {
		sift_down(s, less, start, n)
	}
	for end := n - 1; end > 0; end-- {
		s[0], s[end] = s[end], s[0]
		sift_down(s, less, 0, end)
	}
}

// sift_down restores the max-heap below root in s[:n].
fn sift_down(s anytype, less anytype, root, n int) {
	loop {
		child := 2*root + 1
		if child >= n {
			return
		}
		if child+1 < n and less(s[child], s[child+1]) {
			child++
		}
		if not less(s[root], s[child]) {
			return
		}
		s[root], s[child] = s[child], s[root]
		root = child
	}
}

// is_sorted reports whether s is sorted by less.
pub fn is_sorted(s anytype, less anytype) -> bool {
	for i := 1; i < len(s); i++ {
		if less(s[i], s[i-1]) {
			return false
		}
	}
	return true
}

fn int_less(a, b int) -> bool { return a < b }

fn string_less(a, b str) -> bool { return a < b }

// ints sorts s in increasing order.
pub fn ints(s int[]) { slice(s, int_less) }

// strings sorts s in increasing order.
pub fn strings(s str[]) { slice(s, string_less) }
