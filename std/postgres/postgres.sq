// Package postgres is a PostgreSQL client, written in squark over net: the v3 wire protocol,
// authentication by trust, password or SCRAM-SHA-256 (Postgres' default since 14), and queries
// with parameters (the extended protocol: values are sent apart from the SQL, never spliced
// into it). It doesn't do TLS: use it inside a cluster, or over a sidecar or mesh that does.
// SCRAM uses the password's bytes as they are, without SASLprep: an ASCII password works with any
// server; one that SASLprep would change (non-ASCII spaces, soft hyphens, compatibility forms)
// fails with Auth.
//
//    c := postgres.connect("postgres://app:secret@db:5432/shop", buf[:])!
//    var p postgres.Params
//    p.int(7)
//    rows := c.query("SELECT id, title FROM notes WHERE owner = $1", &p)!
//    while rows.next() {
//        println(rows.int(0), rows.text(1))
//    }
//    rows.err()!
//
// A Conn is used by one task at a time; a Pool shares a few between a thread's tasks.
// Every call is blocking I/O on the poller, so with deadline bounds it, and a graceful stop's cap
// cuts it off.
module postgres

use crypto/sha256, io, net, runtime, strconv, strings, time

extern fn sys_random() -> u64 stack 1K c"sq_random_u64"

// ServerError is returned when the server reports an error; Conn.error_code and error_message say
// which (the SQLSTATE, such as 23505 for a unique violation, and the server's text).
pub fault ServerError -70 "postgres: the server reported an error (see Conn.error_message)"

// Protocol is returned for a reply the client doesn't understand; the connection is closed.
pub fault Protocol -71 "postgres: unexpected reply from the server"

// Auth is returned when the server asks for an authentication method the client doesn't have
// (MD5, Kerberos, certificates), or its SCRAM signature doesn't match.
pub fault Auth -72 "postgres: authentication failed or not supported (trust, password, SCRAM-SHA-256)"

// TooLarge is returned for a reply (a row, usually) longer than the connection's read buffer, or
// a query that doesn't fit in its write buffer; after a reply, the connection is closed.
pub fault TooLarge -73 "postgres: a message larger than the connection's buffer"

// BadURL is returned by connect for a URL it can't read.
pub fault BadURL -74 "postgres: invalid URL (want postgres://user:password@host:port/database)"

// NoTLS is returned by connect for a URL whose sslmode requires TLS (require, verify-ca,
// verify-full), which this client doesn't have: it doesn't send the password in the clear instead.
pub fault NoTLS -78 "postgres: the URL's sslmode requires TLS, which this client doesn't support"

// TooManyColumns is returned for a row with more columns than Rows holds (max_columns); the rest
// of the reply is read, so the connection can run the next query.
pub fault TooManyColumns -79 "postgres: a row with more than 64 columns (select fewer)"

// max_columns is the most columns a row may have.
pub const max_columns = 64

// Closed is returned by a call on a closed or broken connection.
pub fault Closed -75 "postgres: connection closed"

// Busy is returned for a query on a connection whose previous rows haven't been read to the end
// (or closed).
pub fault Busy -76 "postgres: the previous query's rows haven't been read (or closed)"

// TooManyParams is returned when a query's parameters didn't fit in its Params.
pub fault TooManyParams -77 "postgres: more parameters than Params holds (32, 2 KiB of text)"

// Conn is a connection. The buffer given to connect holds what it reads (rows are views of it,
// valid until the next row) and what it writes (a query and its parameters).
pub struct Conn {
	nc   net.Conn
	rbuf u8[]
	r0   int // replies read but not parsed yet: rbuf[r0:r1]
	r1   int
	wbuf u8[]
	open bool
	busy bool      // a query's rows are being read
	code u8[..5]   // the last error's SQLSTATE
	msg  u8[..200] // and its message
}

// ---- parameters ----

// Params holds a query's parameters, $1, $2, ... in order, as text: the server converts each to
// its column's type, as it does a quoted literal. Up to 32, with 2 KiB of text in all.
pub struct Params {
	text  u8[..2048]
	ends  int[..32] // where each one's text ends
	nulls u64       // bit i: parameter i is NULL
	over  bool
}

impl Params {
	fn add(&self, s str) {
		if len(self.ends) == cap(self.ends) or not self.text.try_append(s) {
			self.over = true
			return
		}
		self.ends.push(len(self.text))
	}

	pub fn str(&self, s str) { self.add(s) }

	pub fn int(&self, v int) {
		var b u8[24]
		self.add(str(strconv.append_int(b[:0], v)))
	}

	pub fn f64(&self, v f64) {
		var b u8[32]
		self.add(str(strconv.append_float(b[:0], v, -1)))
	}

	pub fn bool(&self, v bool) {
		if v {
			self.add("t")
		} else {
			self.add("f")
		}
	}

	pub fn null(&self) {
		i := len(self.ends)
		self.add("")
		if not self.over {
			self.nulls |= u64(1) << u64(i)
		}
	}

	pub fn clear(&self) {
		self.text.clear()
		self.ends.clear()
		self.nulls = 0
		self.over = false
	}
}

// ---- messages ----

// Writer builds messages in a connection's write buffer.
struct Writer {
	b    u8[]
	n    int
	over bool
}

impl Writer {
	fn byte(&self, v u8) {
		if self.n >= len(self.b) {
			self.over = true
			return
		}
		self.b[self.n] = v
		self.n++
	}
	fn i16(&self, v int) {
		self.byte(u8(v >> 8))
		self.byte(u8(v))
	}
	fn i32(&self, v int) {
		self.byte(u8(v >> 24))
		self.byte(u8(v >> 16))
		self.byte(u8(v >> 8))
		self.byte(u8(v))
	}
	fn bytes(&self, s str) {
		if self.n+len(s) > len(self.b) {
			self.over = true
			return
		}
		copy(self.b[self.n:], s)
		self.n += len(s)
	}
	// cstr writes s and a NUL.
	fn cstr(&self, s str) {
		self.bytes(s)
		self.byte(0)
	}
	// begin starts a message of type t (0: the startup message, which has none) and returns
	// where its length goes; end fills it in.
	fn begin(&self, t u8) -> int {
		if t != 0 {
			self.byte(t)
		}
		at := self.n
		self.i32(0)
		return at
	}
	fn end(&self, at int) {
		if self.over {
			return
		}
		v := self.n - at
		self.b[at] = u8(v >> 24)
		self.b[at+1] = u8(v >> 16)
		self.b[at+2] = u8(v >> 8)
		self.b[at+3] = u8(v)
	}
}

fn get_i16(b u8[], i int) -> int { return int(i16(u16(b[i])<<8 | u16(b[i+1]))) }

fn get_i32(b u8[], i int) -> int {
	return int(i32(u32(b[i])<<24 | u32(b[i+1])<<16 | u32(b[i+2])<<8 | u32(b[i+3])))
}

// cstr_at returns the NUL-terminated string at b[i:] and the index after its NUL.
fn cstr_at(b u8[], i int) -> (str, int) in b {
	j := i
	while j < len(b) and b[j] != 0 {
		j++
	}
	return str(b[i:j]), j + 1
}

impl Conn {
	fn writer(&self) -> Writer in self { return Writer{b: self.wbuf} }

	fn send(&self, w *Writer) -> ! {
		if w.over {
			return TooLarge
		}
		if _, err := self.nc.write(self.wbuf[:w.n]); err != nil {
			self.close()
			return err
		}
		return nil
	}

	// read_msg returns the next reply's type and payload (a view of the read buffer, until the
	// next call).
	fn read_msg(&self) -> (u8, u8[]) ! in self {
		if not self.open {
			return 0, nil, Closed
		}
		self.fill(5)!
		t := self.rbuf[self.r0]
		n := get_i32(self.rbuf, self.r0+1) - 4
		if n < 0 or 5+n > len(self.rbuf) {
			self.close()
			return 0, nil, TooLarge
		}
		self.fill(5 + n)!
		p := self.rbuf[self.r0+5 : self.r0+5+n]
		self.r0 += 5 + n
		return t, p, nil
	}

	// fill reads until n unparsed bytes are buffered, moving them to the front first if needed.
	fn fill(&self, n int) -> ! {
		if self.r1-self.r0 >= n {
			return nil
		}
		if self.r0+n > len(self.rbuf) {
			copy(self.rbuf, self.rbuf[self.r0:self.r1])
			self.r1 -= self.r0
			self.r0 = 0
		}
		while self.r1-self.r0 < n {
			m, err := self.nc.read(self.rbuf[self.r1:])
			if err != nil {
				self.close()
				if err == io.EOF {
					return Closed
				}
				return err
			}
			self.r1 += m
		}
		return nil
	}

	// server_error records an ErrorResponse's code and message.
	fn server_error(&self, p u8[]) {
		self.code.clear()
		self.msg.clear()
		i := 0
		while i < len(p) and p[i] != 0 {
			field := p[i]
			s, next := cstr_at(p, i+1)
			if field == 'C' {
				self.code.try_append(s[:min(len(s), 5)])
			} else if field == 'M' {
				self.msg.try_append(s[:min(len(s), cap(self.msg))])
			}
			i = next
		}
	}

	// error_code returns the SQLSTATE of the last ServerError ("23505"), error_message its text.
	pub fn error_code(&self) -> str in self    { return str(self.code[:]) }
	pub fn error_message(&self) -> str in self { return str(self.msg[:]) }

	// until_ready reads replies up to ReadyForQuery, returning the first error among them.
	fn until_ready(&self) -> ! {
		var first error
		loop {
			t, p, err := self.read_msg()
			if err != nil {
				return err
			}
			switch t {
			case 'Z':
				self.busy = false
				return first
			case 'E':
				self.server_error(p)
				if first == nil {
					first = ServerError
				}
			}
		}
	}

	pub fn close(&self) {
		if self.open {
			var w Writer
			w.b = self.wbuf
			at := w.begin('X')
			w.end(at)
			self.nc.write(self.wbuf[:w.n])
			self.nc.close()
		}
		self.open = false
		self.busy = false
	}
}

// ---- connecting ----

// URL is what connect reads from a postgres:// URL.
struct URL {
	user, password, host, database str
	port                           int
}

// parse_url reads url; its user, password and database are percent-decoded (into buf when they
// need it: p%40ss is p@ss). Query options are ignored but sslmode, which must not ask for TLS.
fn parse_url(url str, buf u8[]) -> URL ! in url, buf {
	var u URL
	u.port = 5432
	rest, ok := strings.cut_prefix(url, "postgres://")
	if not ok {
		rest, ok = strings.cut_prefix(url, "postgresql://")
		if not ok {
			return u, BadURL
		}
	}
	if i := strings.index_byte(rest, '?'); i >= 0 {
		var opts str[16]
		for o in strings.split(rest[i+1:], "&", opts[:]) {
			if v, ok := strings.cut_prefix(o, "sslmode="); ok and v != "disable" and v != "allow" and v != "prefer" {
				return u, NoTLS // require, verify-ca, verify-full: there is no TLS
			}
		}
		rest = rest[:i]
	}
	b := buf[:0]
	if i := strings.last_index_byte(rest, '@'); i >= 0 {
		user, password, _ := strings.cut(rest[:i], ":")
		ok1, ok2 := false, false
		u.user, b, ok1 = unescape(user, b)
		u.password, b, ok2 = unescape(password, b)
		if not ok1 or not ok2 {
			return u, BadURL
		}
		rest = rest[i+1:]
	}
	hostport, db, _ := strings.cut(rest, "/")
	ok3 := false
	u.database, b, ok3 = unescape(db, b)
	if not ok3 {
		return u, BadURL
	}
	u.host = hostport
	port := ""
	if strings.has_prefix(hostport, "[") {
		j := strings.index_byte(hostport, ']')
		if j < 0 {
			return u, BadURL
		}
		u.host = hostport[1:j]
		port, _ = strings.cut_prefix(hostport[j+1:], ":")
	} else if h, p, found := strings.cut(hostport, ":"); found {
		u.host = h
		port = p
	}
	if port != "" {
		n, err := strconv.atoi(port)
		if err != nil {
			return u, BadURL
		}
		u.port = n
	}
	if u.host == "" {
		u.host = "localhost"
	}
	if u.database == "" {
		u.database = u.user
	}
	if u.user == "" or u.port <= 0 or u.port >= 65536 {
		return u, BadURL
	}
	return u, nil
}

// unescape percent-decodes s, appending to b only when s has an escape; ok is false for a bad
// escape or when b is too small.
fn unescape(s str, b u8[]) -> (str, u8[], bool) in s, b {
	if strings.index_byte(s, '%') < 0 {
		return s, b, true
	}
	start := len(b)
	for i := 0; i < len(s); i++ {
		c := s[i]
		if c == '%' {
			if i+2 >= len(s) {
				return s, b, false
			}
			hi, lo := unhex(s[i+1]), unhex(s[i+2])
			if hi < 0 or lo < 0 {
				return s, b, false
			}
			c = u8(hi<<4 | lo)
			i += 2
		}
		if len(b) == cap(b) {
			return s, b, false
		}
		b = append(b, c)
	}
	return str(b[start:]), b, true
}

fn unhex(c u8) -> int {
	if c >= '0' and c <= '9' {
		return int(c - '0')
	}
	if c >= 'a' and c <= 'f' {
		return int(c-'a') + 10
	}
	if c >= 'A' and c <= 'F' {
		return int(c-'A') + 10
	}
	return -1
}

// connect dials the server in url (postgres://user:password@host:port/database; a name is looked
// up as net.dial does) and authenticates. buf, of at least 8 KiB, becomes the connection's: half
// for replies (a row must fit in it), half for what it sends (a query with its parameters).
pub fn connect(url str, buf u8[]) -> Conn ! in buf {
	var c Conn
	var ub u8[512] // the URL's decoded user, password and database
	u, perr := parse_url(url, ub[:])
	if perr != nil {
		return c, perr
	}
	buf = buf[:cap(buf)]
	if len(buf) < 8192 {
		return c, TooLarge
	}
	c.rbuf = buf[:len(buf)/2]
	c.wbuf = buf[len(buf)/2:]
	var ab u8[300]
	nc, err := net.dial(str(net.append_host_port(ab[:0], u.host, u.port)))
	if err != nil {
		return c, err
	}
	c.nc = nc
	c.open = true
	if err := c.startup(u); err != nil {
		c.close()
		return c, err
	}
	return c, nil
}

impl Conn {
	fn startup(&self, u URL) -> ! {
		w := self.writer()
		at := w.begin(0)
		w.i32(196608) // protocol 3.0
		w.cstr("user")
		w.cstr(u.user)
		w.cstr("database")
		w.cstr(u.database)
		w.cstr("application_name")
		w.cstr("squark")
		w.cstr("client_encoding")
		w.cstr("UTF8")
		w.byte(0)
		w.end(at)
		self.send(&w)!
		loop {
			t, p, err := self.read_msg()
			if err != nil {
				return err
			}
			switch t {
			case 'R':
				if len(p) < 4 {
					self.close()
					return Protocol
				}
				switch get_i32(p, 0) {
				case 0: // AuthenticationOk
				case 3: // a cleartext password
					pw := self.writer()
					pat := pw.begin('p')
					pw.cstr(u.password)
					pw.end(pat)
					self.send(&pw)!
				case 10: // SASL: the server lists its mechanisms
					if not has_mechanism(p[4:], "SCRAM-SHA-256") {
						return Auth
					}
					self.scram(u.password)!
				default:
					return Auth
				}
			case 'E':
				self.server_error(p)
				return ServerError
			case 'Z':
				return nil
			}
			// 'S' (a parameter's value), 'K' (the cancel key) and 'N' (a notice) need nothing
		}
	}
}

fn has_mechanism(p u8[], name str) -> bool {
	i := 0
	while i < len(p) and p[i] != 0 {
		s, next := cstr_at(p, i)
		if s == name {
			return true
		}
		i = next
	}
	return false
}

// ---- queries ----

// Rows is a query's result, read a row at a time with next. Its views (text) are valid until the
// next call to next.
pub struct Rows {
	c        *Conn
	starts   int[..max_columns]
	lens     int[..max_columns] // -1: NULL
	row      u8[]
	failure  error
	done     bool
	changed  int
}

impl Conn {
	// query sends sql with p's parameters ($1, $2, ...; p may be nil) and returns its rows. They
	// must be read to the end (or closed) before the connection's next query.
	pub fn query(&self, sql str, p *Params) -> Rows ! in self {
		var r Rows
		r.c = self
		r.done = true
		if not self.open {
			return r, Closed
		}
		if self.busy {
			return r, Busy
		}
		if p != nil and p.over {
			return r, TooManyParams
		}
		w := self.writer()
		at := w.begin('P') // Parse: the unnamed statement
		w.cstr("")
		w.cstr(sql)
		w.i16(0)
		w.end(at)
		at = w.begin('B') // Bind: every parameter, and every result column, as text
		w.cstr("")
		w.cstr("")
		w.i16(0)
		if p == nil {
			w.i16(0)
		} else {
			w.i16(len(p.ends))
			start := 0
			for i, end in p.ends {
				if p.nulls>>u64(i)&1 != 0 {
					w.i32(-1)
				} else {
					w.i32(end - start)
					w.bytes(str(p.text[start:end]))
				}
				start = end
			}
		}
		w.i16(0)
		w.end(at)
		at = w.begin('E') // Execute, every row
		w.cstr("")
		w.i32(0)
		w.end(at)
		at = w.begin('S') // Sync
		w.end(at)
		self.send(&w)!
		self.busy = true
		r.done = false
		return r, nil
	}

	// exec runs sql (with p's parameters; p may be nil) and returns how many rows it changed.
	pub fn exec(&self, sql str, p *Params) -> int ! {
		r := self.query(sql, p)!
		while r.next() {
		}
		if r.failure != nil {
			return 0, r.failure
		}
		return r.changed, nil
	}
}

impl Rows {
	// next reads the next row and reports whether there was one. At the end, or at an error,
	// it returns false; err says which.
	pub fn next(&self) -> bool {
		while not self.done {
			t, p, err := self.c.read_msg()
			if err != nil {
				self.failure = err
				self.done = true
				return false
			}
			switch t {
			case 'D':
				if self.row_fields(p) {
					return true
				}
				return false
			case 'C': // CommandComplete: "SELECT 3", "INSERT 0 1", "UPDATE 2"
				tag, _ := cstr_at(p, 0)
				if i := strings.last_index_byte(tag, ' '); i >= 0 {
					self.changed, _ = strconv.atoi(tag[i+1:])
				}
			case 'E':
				self.c.server_error(p)
				if self.failure == nil {
					self.failure = ServerError
				}
			case 'Z':
				self.c.busy = false
				self.done = true
			}
			// '1' ParseComplete, '2' BindComplete, 'I' EmptyQueryResponse, 'N' a notice
		}
		return false
	}

	fn row_fields(&self, p u8[]) -> bool {
		self.starts.clear()
		self.lens.clear()
		self.row = p
		if len(p) < 2 {
			return self.fail(Protocol)
		}
		n := get_i16(p, 0)
		if n > cap(self.starts) {
			self.failure = TooManyColumns
			self.drain()
			return false
		}
		i := 2
		for _ in 0..n {
			if i+4 > len(p) or len(self.starts) == cap(self.starts) {
				return self.fail(Protocol)
			}
			l := get_i32(p, i)
			i += 4
			if l > len(p)-i {
				return self.fail(Protocol)
			}
			self.starts.push(i)
			self.lens.push(l)
			if l > 0 {
				i += l
			}
		}
		return true
	}

	// drain reads the rest of the reply, up to ReadyForQuery, leaving the connection usable.
	fn drain(&self) {
		while not self.done {
			t, _, err := self.c.read_msg()
			if err != nil {
				self.done = true
				return
			}
			if t == 'Z' {
				self.c.busy = false
				self.done = true
			}
		}
	}

	fn fail(&self, err error) -> bool {
		self.failure = err
		self.done = true
		self.c.close() // the protocol is lost
		return false
	}

	// err returns the error that ended the rows, if any: ServerError, Closed, a timeout...
	pub fn err(&self) -> error { return self.failure }

	// affected is how many rows an INSERT, UPDATE or DELETE changed (once next has returned false).
	pub fn affected(&self) -> int { return self.changed }

	pub fn columns(&self) -> int { return len(self.starts) }

	// text returns column i of the row as text (Postgres' text form: 't' and 'f' for booleans), ""
	// for NULL or a column that doesn't exist.
	pub fn text(&self, i int) -> str in self {
		if i < 0 or i >= len(self.starts) or self.lens[i] < 0 {
			return ""
		}
		return str(self.row[self.starts[i] : self.starts[i]+self.lens[i]])
	}

	pub fn is_null(&self, i int) -> bool { return i < 0 or i >= len(self.lens) or self.lens[i] < 0 }

	// int returns column i as an integer (0 for NULL or text that isn't one).
	pub fn int(&self, i int) -> int {
		v, _ := strconv.atoi(self.text(i))
		return v
	}

	pub fn bool(&self, i int) -> bool { return self.text(i) == "t" }

	pub fn f64(&self, i int) -> f64 {
		v, _ := strconv.parse_float(self.text(i))
		return v
	}

	// close reads the rest of the rows, so the connection can take the next query.
	pub fn close(&self) {
		while self.next() {
		}
	}
}

// ---- SCRAM-SHA-256 (RFC 5802, RFC 7677) ----

impl Conn {
	fn scram(&self, password str) -> ! {
		// client-first: "n,,n=,r=<nonce>" (Postgres takes the user from the startup message)
		var raw u8[18]
		for i in 0..18 {
			raw[i] = u8(sys_random())
		}
		var nonce u8[24]
		cn := b64_encode(nonce[:0], raw[:])
		var first_bare u8[40]
		fb := append(append(first_bare[:0], "n=,r="...), cn...)
		w := self.writer()
		at := w.begin('p')
		w.cstr("SCRAM-SHA-256")
		w.i32(3 + len(fb))
		w.bytes("n,,")
		w.bytes(str(fb))
		w.end(at)
		self.send(&w)!

		// server-first: "r=<nonce + server's>,s=<salt>,i=<iterations>"
		var server_first u8[256]
		sf := server_first[:0]
		{
			t, p, err := self.read_msg()
			if err != nil {
				return err
			}
			if t == 'E' {
				self.server_error(p)
				return ServerError
			}
			if t != 'R' or len(p) < 4 or get_i32(p, 0) != 11 or len(p)-4 > cap(server_first) {
				return Protocol
			}
			sf = append(sf, p[4:]...)
		}
		var full_nonce, salt64 str
		iters := 0
		var parts str[8]
		for f in strings.split(str(sf), ",", parts[:]) {
			if v, ok := strings.cut_prefix(f, "r="); ok {
				full_nonce = v
			} else if v, ok := strings.cut_prefix(f, "s="); ok {
				salt64 = v
			} else if v, ok := strings.cut_prefix(f, "i="); ok {
				iters, _ = strconv.atoi(v)
			}
		}
		if not strings.has_prefix(full_nonce, str(cn)) or iters < 1 or iters > 1000000 {
			return Auth
		}
		var salt_buf u8[128]
		salt, ok := b64_decode(salt_buf[:0], salt64)
		if not ok {
			return Auth
		}
		var pwb u8[256]
		if len(password) > len(pwb) {
			return Auth
		}
		pw := pwb[:copy(pwb[:], password)]
		salted := hi(pw, salt, iters)
		client_key := hmac_str(salted[:], "Client Key")
		stored_key := sha256.sum(client_key[:])
		var final_bare u8[160]
		if len(full_nonce) > cap(final_bare) - len("c=biws,r=") {
			return Protocol // the server's nonce is longer than any server sends (and than fits)
		}
		fwp := append(append(final_bare[:0], "c=biws,r="...), full_nonce...)
		var auth_buf u8[512]
		am := append(append(auth_buf[:0], fb...), ',')
		am = append(append(append(am, sf...), ','), fwp...)
		sig := sha256.hmac(stored_key[:], am)
		var proof u8[32]
		for i in 0..32 {
			proof[i] = client_key[i] ^ sig[i]
		}
		var final u8[256]
		fm := append(append(final[:0], fwp...), ",p="...)
		fm = b64_encode(fm, proof[:])
		w2 := self.writer()
		at2 := w2.begin('p')
		w2.bytes(str(fm))
		w2.end(at2)
		self.send(&w2)!

		// server-final: "v=<server signature>", proving the server knows the password too
		t, p, err := self.read_msg()
		if err != nil {
			return err
		}
		if t == 'E' {
			self.server_error(p)
			return ServerError
		}
		if t != 'R' or len(p) < 4 or get_i32(p, 0) != 12 {
			return Protocol
		}
		server_key := hmac_str(salted[:], "Server Key")
		want := sha256.hmac(server_key[:], am)
		var wb u8[48]
		want64 := b64_encode(append(wb[:0], "v="...), want[:])
		if str(p[4:]) != str(want64) {
			return Auth
		}
		return nil
	}
}

fn hmac_str(key u8[], s str) -> u8[32] {
	var b u8[32]
	return sha256.hmac(key, b[:copy(b[:], s)])
}

// hi is PBKDF2-HMAC-SHA-256 with a 32-byte result (RFC 5802's Hi).
fn hi(password, salt u8[], iters int) -> u8[32] {
	var s1 u8[132]
	if len(salt) > 128 {
		salt = salt[:128]
	}
	n := copy(s1[:], salt)
	s1[n+3] = 1 // INT(1)
	u := sha256.hmac(password, s1[:n+4])
	acc := u
	for _ in 1..iters {
		u = sha256.hmac(password, u[:])
		for j in 0..32 {
			acc[j] ^= u[j]
		}
	}
	return acc
}

const b64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fn b64_encode(dst, src u8[]) -> u8[] in dst {
	i := 0
	while i+3 <= len(src) {
		v := int(src[i])<<16 | int(src[i+1])<<8 | int(src[i+2])
		dst = append(dst, b64[v>>18&63], b64[v>>12&63], b64[v>>6&63], b64[v&63])
		i += 3
	}
	switch len(src) - i {
	case 1:
		v := int(src[i]) << 16
		dst = append(dst, b64[v>>18&63], b64[v>>12&63], '=', '=')
	case 2:
		v := int(src[i])<<16 | int(src[i+1])<<8
		dst = append(dst, b64[v>>18&63], b64[v>>12&63], b64[v>>6&63], '=')
	}
	return dst
}

fn b64_value(c u8) -> int {
	switch {
	case c >= 'A' and c <= 'Z':
		return int(c - 'A')
	case c >= 'a' and c <= 'z':
		return int(c-'a') + 26
	case c >= '0' and c <= '9':
		return int(c-'0') + 52
	case c == '+':
		return 62
	case c == '/':
		return 63
	}
	return -1
}

fn b64_decode(dst u8[], s str) -> (u8[], bool) in dst {
	v, bits := 0, 0
	for i in 0..len(s) {
		if s[i] == '=' {
			break
		}
		d := b64_value(s[i])
		if d < 0 or len(dst) == cap(dst) {
			return dst, false
		}
		v = v<<6 | d
		bits += 6
		if bits >= 8 {
			bits -= 8
			dst = append(dst, u8(v>>bits))
		}
	}
	return dst, true
}

// ---- a pool ----

// Pool shares up to 16 connections to one server between a thread's tasks: get takes one
// (connecting it if needed, waiting while all are in use), put gives it back. Declare it per
// thread (`thread db postgres.Pool`) and init it in main.
pub struct Pool {
	url   str
	conns Conn[16]
	bufs  (u8[])[16]
	free  int chan[16]
	n     int
}

impl Pool {
	// init makes p a pool of n connections (1 to 16) to url, each with an equal share of mem for
	// its buffer (at least 8 KiB each). They connect when first taken.
	pub fn init(&self, url str, n int, mem u8[]) {
		n = max(1, min(n, 16))
		self.url = url
		self.n = n
		size := len(mem) / n
		for i in 0..n {
			// capped: connect uses a buffer up to its capacity, which would reach the next one's
			self.bufs[i] = mem[i*size : (i+1)*size : (i+1)*size]
			self.free <- i
		}
	}

	// get takes a connection, waiting while all n are in use (within the task's deadline:
	// net.Timeout once it has passed), and connects it if it isn't.
	pub fn get(&self) -> *Conn ! in self {
		i := 0
		if left, ok := runtime.deadline_left(); ok {
			if left <= 0 {
				return nil, net.Timeout
			}
			select {
			case i = <-self.free:
			case <-time.after(left):
				return nil, net.Timeout
			}
		} else {
			i = <-self.free
		}
		c := &self.conns[i]
		if not c.open {
			nc, err := connect(self.url, self.bufs[i])
			if err != nil {
				self.free <- i
				return nil, err
			}
			*c = nc
		}
		return c, nil
	}

	// put gives c back. A connection whose rows weren't read to the end is closed (it reconnects
	// when next taken).
	pub fn put(&self, c *Conn) {
		if c.busy {
			c.close()
		}
		for i in 0..self.n {
			if &self.conns[i] == c {
				self.free <- i
				return
			}
		}
	}
}
