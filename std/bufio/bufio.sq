// Package bufio reads lines through a buffer the caller provides, from any source with a
// read(u8[]) -> int ! method (a net.conn, an os.File, ...).
module bufio

use io, strings

// TooLong is returned for a line that doesn't fit in the buffer; the line is skipped.
pub fault TooLong -10 "bufio: line longer than the buffer"

// Reader holds input read ahead of the lines returned so far.
pub struct Reader {
	buf        u8[]
	start, end int
	err        error // the source's error (io.EOF at its end), returned once the buffer is empty
	skipping   bool  // inside a line too long for the buffer
}

// new_reader returns a Reader that buffers into storage (its capacity is the longest line, not
// counting the line end).
pub fn new_reader(storage u8[]) -> Reader in storage {
	return Reader{buf: storage[:cap(storage)]}
}

impl Reader {
	// buffered returns how many bytes have been read from the source but not returned yet.
	pub fn buffered(&self) -> int { return self.end - self.start }

	// read_line returns the next line from src, without its "\n" or "\r\n", as a view of the buffer
	// that stays valid until the next call. Lines complete before the source's error come first.
	// At the end of the input (io.EOF) a last line without a newline is returned, without a final
	// "\r", as Go's bufio.Scanner does. On any other error (a timeout, a reset) a partial last line is
	// dropped, unlike Go's Scanner, so a line protocol never acts on a line cut short. The error is
	// then returned, and again on every later call. A line longer than the buffer (not counting its
	// "\n" or "\r\n") is skipped and reported as TooLong; the next call reads the line after it.
	// A line that fills the buffer exactly is followed by one or two 1-byte reads to find its end.
	pub fn read_line(&self, src anytype) -> str ! in self {
		loop {
			if i := strings.index_byte(str(self.buf[self.start:self.end]), '\n'); i >= 0 {
				line := self.buf[self.start : self.start+i]
				self.start += i + 1
				if self.skipping {
					self.skipping = false
					return "", TooLong
				}
				if len(line) > 0 and line[len(line)-1] == '\r' {
					line = line[:len(line)-1]
				}
				return str(line), nil
			}
			if self.err != nil { // the source is done: what's left is the last line
				if self.skipping {
					self.skipping = false
					self.start = self.end
					return "", TooLong
				}
				if self.start < self.end and self.err == io.EOF {
					line := self.buf[self.start:self.end]
					self.start = self.end
					if line[len(line)-1] == '\r' { // as Go's Scanner: a last line drops a final "\r"
						line = line[:len(line)-1]
					}
					return str(line), nil
				}
				self.start = self.end // a line cut short by a failure is dropped
				return "", self.err
			}
			if self.start > 0 { // make room
				copy(self.buf, self.buf[self.start:self.end])
				self.end -= self.start
				self.start = 0
			}
			if self.end == len(self.buf) and len(self.buf) > 0 { // full, and no newline
				if not self.skipping {
					// the buffer holds a whole line if its end comes next: read up to "\r\n" more
					var next u8[1]
					n, err := src.read(next[:])
					cr := n == 1 and next[0] == '\r'
					if cr {
						n = 0
						if err == nil {
							n, err = src.read(next[:])
						}
					}
					if err == nil and n == 0 {
						err = io.EOF
					}
					self.err = err
					if n == 0 and err != io.EOF { // the source failed before the line's end: drop it
						self.start = self.end
						return "", err
					}
					if n == 0 or next[0] == '\n' { // the line's end, or the source's
						line := self.buf[:self.end]
						self.start = self.end
						if not cr and line[len(line)-1] == '\r' {
							line = line[:len(line)-1]
						}
						return str(line), nil
					}
					if self.err != nil { // the line is too long, and it was the last
						self.start = self.end
						return "", TooLong
					}
				}
				self.skipping = true // the line is too long: drop it
				self.end = 0
			}
			n, err := src.read(self.buf[self.end:])
			self.end += n
			if err == nil and n == 0 {
				err = io.EOF // a connection's reader reports the end with a zero-length read
			}
			self.err = err
		}
	}
}

