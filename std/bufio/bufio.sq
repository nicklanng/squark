// Package bufio reads lines through a buffer the caller provides, from any source with a
// Read([]byte) (int, error) method (a net.Conn, an os.File, ...).
package bufio

import (
	"io"
	"strings"
)

// ErrTooLong is returned for a line that doesn't fit in the buffer; the line is skipped.
const ErrTooLong = error(-10, "bufio: line longer than the buffer")

// Reader holds input read ahead of the lines returned so far.
type Reader struct {
	buf        []byte
	start, end int
	err        error // the source's error (io.EOF at its end), returned once the buffer is empty
	skipping   bool  // inside a line too long for the buffer
}

// NewReader returns a Reader that buffers into storage (its capacity is the longest line, not
// counting the line end).
func NewReader(storage []byte) Reader from storage {
	return Reader{buf: storage[:cap(storage)]}
}

// Buffered returns how many bytes have been read from the source but not returned yet.
func (r *Reader) Buffered() int { return r.end - r.start }

// ReadLine returns the next line from src, without its "\n" or "\r\n", as a view of the buffer
// that stays valid until the next call. Lines complete before the source's error come first.
// At the end of the input (io.EOF) a last line without a newline is returned, without a final
// "\r", as Go's bufio.Scanner does. On any other error (a timeout, a reset) a partial last line is
// dropped, unlike Go's Scanner, so a line protocol never acts on a line cut short. The error is
// then returned, and again on every later call. A line longer than the buffer (not counting its
// "\n" or "\r\n") is skipped and reported as ErrTooLong; the next call reads the line after it.
// A line that fills the buffer exactly is followed by one or two 1-byte reads to find its end.
func (r *Reader) ReadLine(src anytype) (string, error) from r {
	for {
		if i := strings.IndexByte(string(r.buf[r.start:r.end]), '\n'); i >= 0 {
			line := r.buf[r.start : r.start+i]
			r.start += i + 1
			if r.skipping {
				r.skipping = false
				return "", ErrTooLong
			}
			if len(line) > 0 && line[len(line)-1] == '\r' {
				line = line[:len(line)-1]
			}
			return string(line), nil
		}
		if r.err != nil { // the source is done: what's left is the last line
			if r.skipping {
				r.skipping = false
				r.start = r.end
				return "", ErrTooLong
			}
			if r.start < r.end && r.err == io.EOF {
				line := r.buf[r.start:r.end]
				r.start = r.end
				if line[len(line)-1] == '\r' { // as Go's Scanner: a last line drops a final "\r"
					line = line[:len(line)-1]
				}
				return string(line), nil
			}
			r.start = r.end // a line cut short by a failure is dropped
			return "", r.err
		}
		if r.start > 0 { // make room
			copy(r.buf, r.buf[r.start:r.end])
			r.end -= r.start
			r.start = 0
		}
		if r.end == len(r.buf) && len(r.buf) > 0 { // full, and no newline
			if !r.skipping {
				// the buffer holds a whole line if its end comes next: read up to "\r\n" more
				var next [1]byte
				n, err := src.Read(next[:])
				cr := n == 1 && next[0] == '\r'
				if cr {
					n = 0
					if err == nil {
						n, err = src.Read(next[:])
					}
				}
				if err == nil && n == 0 {
					err = io.EOF
				}
				r.err = err
				if n == 0 && err != io.EOF { // the source failed before the line's end: drop it
					r.start = r.end
					return "", err
				}
				if n == 0 || next[0] == '\n' { // the line's end, or the source's
					line := r.buf[:r.end]
					r.start = r.end
					if !cr && line[len(line)-1] == '\r' {
						line = line[:len(line)-1]
					}
					return string(line), nil
				}
				if r.err != nil { // the line is too long, and it was the last
					r.start = r.end
					return "", ErrTooLong
				}
			}
			r.skipping = true // the line is too long: drop it
			r.end = 0
		}
		n, err := src.Read(r.buf[r.end:])
		r.end += n
		if err == nil && n == 0 {
			err = io.EOF // a connection's reader reports the end with a zero-length read
		}
		r.err = err
	}
}
