// Package strings provides string helpers. Results are views of their inputs; nothing is copied.
package strings

import "utf8"

func HasPrefix(s, prefix string) bool {
	return len(s) >= len(prefix) && s[:len(prefix)] == prefix
}

func HasSuffix(s, suffix string) bool {
	return len(s) >= len(suffix) && s[len(s)-len(suffix):] == suffix
}

// IndexByte returns the index of the first c in s, or -1. It compares 16 bytes at a time.
func IndexByte(s string, c byte) int {
	i := 0
	if len(s) >= 16 {
		cs := uint8x16(c)
		for ; i+16 <= len(s); i += 16 {
			if j := (uint8x16(s[i:]) == cs).First(); j >= 0 {
				return i + j
			}
		}
	}
	for ; i < len(s); i++ {
		if s[i] == c {
			return i
		}
	}
	return -1
}

// LastIndexByte returns the index of the last c in s, or -1.
func LastIndexByte(s string, c byte) int {
	i := len(s)
	if i >= 16 {
		cs := uint8x16(c)
		for ; i >= 16; i -= 16 {
			if j := (uint8x16(s[i-16:]) == cs).Last(); j >= 0 {
				return i - 16 + j
			}
		}
	}
	for i--; i >= 0; i-- {
		if s[i] == c {
			return i
		}
	}
	return -1
}

// Index returns the index of the first sep in s, or -1. For 16 positions at a time it compares
// sep's first and last bytes, and compares the whole of sep only where both match.
func Index(s, sep string) int {
	n := len(sep)
	if n == 0 {
		return 0
	}
	c := sep[0]
	i := 0
	if n >= 2 {
		first, last := uint8x16(c), uint8x16(sep[n-1])
		for ; i+n-1+16 <= len(s); i += 16 {
			m := (uint8x16(s[i:]) == first) & (uint8x16(s[i+n-1:]) == last)
			for m.Any() {
				j := m.First()
				if s[i+j:i+j+n] == sep {
					return i + j
				}
				m[j] = 0
			}
		}
	}
	for ; i+n <= len(s); i++ {
		j := IndexByte(s[i:len(s)-n+1], c)
		if j < 0 {
			return -1
		}
		i += j
		if s[i:i+n] == sep {
			return i
		}
	}
	return -1
}

func Contains(s, substr string) bool { return Index(s, substr) >= 0 }

func isSpace(c byte) bool {
	return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f'
}

func TrimSpace(s string) string from s {
	i, j := 0, len(s)
	for i < j && isSpace(s[i]) {
		i++
	}
	for j > i && isSpace(s[j-1]) {
		j--
	}
	return s[i:j]
}

func TrimPrefix(s, prefix string) string {
	if HasPrefix(s, prefix) {
		return s[len(prefix):]
	}
	return s
}

func TrimSuffix(s, suffix string) string {
	if HasSuffix(s, suffix) {
		return s[:len(s)-len(suffix)]
	}
	return s
}

// Cut slices s around the first instance of sep.
func Cut(s, sep string) (string, string, bool) from s {
	if i := Index(s, sep); i >= 0 {
		return s[:i], s[i+len(sep):], true
	}
	return s, "", false
}

// CutPrefix returns s without prefix and true, or s and false if s doesn't start with prefix.
func CutPrefix(s, prefix string) (string, bool) from s {
	if HasPrefix(s, prefix) {
		return s[len(prefix):], true
	}
	return s, false
}

// CutSuffix returns s without suffix and true, or s and false if s doesn't end with suffix.
func CutSuffix(s, suffix string) (string, bool) from s {
	if HasSuffix(s, suffix) {
		return s[:len(s)-len(suffix)], true
	}
	return s, false
}

// AppendRepeat appends n copies of s (Go's Repeat, into the caller's memory).
func AppendRepeat(dst []byte, s string, n int) []byte from dst {
	for i := 0; i < n; i++ {
		dst = append(dst, s...)
	}
	return dst
}

// AppendPadRight appends s and then pad until s fills width characters, counted in runes as
// Go's fmt counts a width (%-*s), so "crème" takes 5; a longer s is appended whole. For padding
// on the left, strconv.AppendIntPad and AppendUintPad pad numbers, and AppendRepeat anything.
func AppendPadRight(dst []byte, s string, width int, pad byte) []byte from dst {
	dst = append(dst, s...)
	for n := utf8.RuneCountInString(s); n < width; n++ {
		dst = append(dst, pad)
	}
	return dst
}

func lower(c byte) byte {
	if c >= 'A' && c <= 'Z' {
		return c + 'a' - 'A'
	}
	return c
}

// EqualFold reports ASCII case-insensitive equality.
func EqualFold(a, b string) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if lower(a[i]) != lower(b[i]) {
			return false
		}
	}
	return true
}

// AppendLower appends the ASCII-lowercased s to dst.
func AppendLower(dst []byte, s string) []byte {
	for i := 0; i < len(s); i++ {
		dst = append(dst, lower(s[i]))
	}
	return dst
}

// Split splits s around sep into out, returning the used part of out. An empty sep splits after
// each UTF-8 sequence, as in Go. It stops when out is full; the last element then holds the
// unsplit remainder.
func Split(s string into out, sep string, out []string) []string from out {
	n := 0
	if len(out) == 0 {
		return out[:0]
	}
	if len(sep) == 0 {
		start := 0
		for i := range s {
			if i == 0 {
				continue
			}
			if n == len(out)-1 {
				break
			}
			out[n] = s[start:i]
			n++
			start = i
		}
		if n < len(out) && start < len(s) {
			out[n] = s[start:]
			n++
		}
		return out[:n]
	}
	for n < len(out)-1 {
		i := Index(s, sep)
		if i < 0 {
			break
		}
		out[n] = s[:i]
		s = s[i+len(sep):]
		n++
	}
	if n < len(out) {
		out[n] = s
		n++
	}
	return out[:n]
}

// Fields splits s around runs of ASCII whitespace into out, returning the used part of out. It
// stops when out is full and drops the fields after that (unlike Split, which keeps the
// remainder); size out for the most fields you accept.
func Fields(s string, out []string) []string {
	n := 0
	i := 0
	for i < len(s) && n < len(out) {
		for i < len(s) && isSpace(s[i]) {
			i++
		}
		if i >= len(s) {
			break
		}
		j := i
		for j < len(s) && !isSpace(s[j]) {
			j++
		}
		out[n] = s[i:j]
		n++
		i = j
	}
	return out[:n]
}

// Count counts the non-overlapping instances of sub in s; an empty sub counts the runes plus one,
// as in Go.
func Count(s, sub string) int {
	if len(sub) == 0 {
		n := 1
		for range s {
			n++
		}
		return n
	}
	n := 0
	for {
		i := Index(s, sub)
		if i < 0 {
			return n
		}
		n++
		s = s[i+len(sub):]
	}
}
