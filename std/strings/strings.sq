// Package strings provides string helpers. Results are views of their inputs; nothing is copied.
module strings

use utf8

pub fn has_prefix(s, prefix str) -> bool {
	return len(s) >= len(prefix) and s[:len(prefix)] == prefix
}

pub fn has_suffix(s, suffix str) -> bool {
	return len(s) >= len(suffix) and s[len(s)-len(suffix):] == suffix
}

// index_byte returns the index of the first c in s, or -1. It compares 16 bytes at a time.
pub fn index_byte(s str, c u8) -> int {
	i := 0
	if len(s) >= 16 {
		cs := u8x16(c)
		for ; i+16 <= len(s); i += 16 {
			if j := (u8x16(s[i:]) == cs).first(); j >= 0 {
				return i + j
			}
		}
	}
	for ; i < len(s); i++ {
		if s[i] == c {
			return i
		}
	}
	return -1
}

// last_index_byte returns the index of the last c in s, or -1.
pub fn last_index_byte(s str, c u8) -> int {
	i := len(s)
	if i >= 16 {
		cs := u8x16(c)
		for ; i >= 16; i -= 16 {
			if j := (u8x16(s[i-16:]) == cs).last(); j >= 0 {
				return i - 16 + j
			}
		}
	}
	for i--; i >= 0; i-- {
		if s[i] == c {
			return i
		}
	}
	return -1
}

// index returns the index of the first sep in s, or -1. For 16 positions at a time it compares
// sep's first and last bytes, and compares the whole of sep only where both match.
pub fn index(s, sep str) -> int {
	n := len(sep)
	if n == 0 {
		return 0
	}
	c := sep[0]
	i := 0
	if n >= 2 {
		first, last := u8x16(c), u8x16(sep[n-1])
		for ; i+n-1+16 <= len(s); i += 16 {
			m := (u8x16(s[i:]) == first) & (u8x16(s[i+n-1:]) == last)
			while m.any() {
				j := m.first()
				if s[i+j:i+j+n] == sep {
					return i + j
				}
				m[j] = 0
			}
		}
	}
	for ; i+n <= len(s); i++ {
		j := index_byte(s[i:len(s)-n+1], c)
		if j < 0 {
			return -1
		}
		i += j
		if s[i:i+n] == sep {
			return i
		}
	}
	return -1
}

pub fn contains(s, substr str) -> bool { return index(s, substr) >= 0 }

fn is_space(c u8) -> bool {
	return c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '\v' or c == '\f'
}

pub fn trim_space(s str) -> str in s {
	i, j := 0, len(s)
	while i < j and is_space(s[i]) {
		i++
	}
	while j > i and is_space(s[j-1]) {
		j--
	}
	return s[i:j]
}

pub fn trim_prefix(s, prefix str) -> str {
	if has_prefix(s, prefix) {
		return s[len(prefix):]
	}
	return s
}

pub fn trim_suffix(s, suffix str) -> str {
	if has_suffix(s, suffix) {
		return s[:len(s)-len(suffix)]
	}
	return s
}

// cut slices s around the first instance of sep.
pub fn cut(s, sep str) -> (str, str, bool) in s {
	if i := index(s, sep); i >= 0 {
		return s[:i], s[i+len(sep):], true
	}
	return s, "", false
}

// cut_prefix returns s without prefix and true, or s and false if s doesn't start with prefix.
pub fn cut_prefix(s, prefix str) -> (str, bool) in s {
	if has_prefix(s, prefix) {
		return s[len(prefix):], true
	}
	return s, false
}

// cut_suffix returns s without suffix and true, or s and false if s doesn't end with suffix.
pub fn cut_suffix(s, suffix str) -> (str, bool) in s {
	if has_suffix(s, suffix) {
		return s[:len(s)-len(suffix)], true
	}
	return s, false
}

// append_repeat appends n copies of s.
pub fn append_repeat(dst u8[], s str, n int) -> u8[] in dst {
	for i := 0; i < n; i++ {
		dst = append(dst, s...)
	}
	return dst
}

// append_pad_right appends s and then pad until s fills width characters, counted in runes, so
// "crème" takes 5; a longer s is appended whole. For padding
// on the left, strconv.AppendIntPad and AppendUintPad pad numbers, and append_repeat anything.
pub fn append_pad_right(dst u8[], s str, width int, pad u8) -> u8[] in dst {
	dst = append(dst, s...)
	for n := utf8.rune_count_in_string(s); n < width; n++ {
		dst = append(dst, pad)
	}
	return dst
}

fn lower(c u8) -> u8 {
	if c >= 'A' and c <= 'Z' {
		return c + 'a' - 'A'
	}
	return c
}

// equal_fold reports ASCII case-insensitive equality.
pub fn equal_fold(a, b str) -> bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if lower(a[i]) != lower(b[i]) {
			return false
		}
	}
	return true
}

// append_lower appends the ASCII-lowercased s to dst.
pub fn append_lower(dst u8[], s str) -> u8[] {
	for i := 0; i < len(s); i++ {
		dst = append(dst, lower(s[i]))
	}
	return dst
}

// split splits s around sep into out, returning the used part of out. An empty sep splits after
// each UTF-8 sequence (an invalid byte is a sequence of its own). It stops when out is full; the last element then holds the
// unsplit remainder.
pub fn split(s str in out, sep str, out str[]) -> str[] in out {
	n := 0
	if len(out) == 0 {
		return out[:0]
	}
	if len(sep) == 0 {
		start := 0
		for i, _ in s {
			if i == 0 {
				continue
			}
			if n == len(out)-1 {
				break
			}
			out[n] = s[start:i]
			n++
			start = i
		}
		if n < len(out) and start < len(s) {
			out[n] = s[start:]
			n++
		}
		return out[:n]
	}
	while n < len(out)-1 {
		i := index(s, sep)
		if i < 0 {
			break
		}
		out[n] = s[:i]
		s = s[i+len(sep):]
		n++
	}
	if n < len(out) {
		out[n] = s
		n++
	}
	return out[:n]
}

// fields splits s around runs of ASCII whitespace into out, returning the used part of out. It
// stops when out is full and drops the fields after that (unlike split, which keeps the
// remainder); size out for the most fields you accept.
pub fn fields(s str, out str[]) -> str[] {
	n := 0
	i := 0
	while i < len(s) and n < len(out) {
		while i < len(s) and is_space(s[i]) {
			i++
		}
		if i >= len(s) {
			break
		}
		j := i
		while j < len(s) and not is_space(s[j]) {
			j++
		}
		out[n] = s[i:j]
		n++
		i = j
	}
	return out[:n]
}

// count counts the non-overlapping instances of sub in s; an empty sub counts the runes plus one.
pub fn count(s, sub str) -> int {
	if len(sub) == 0 {
		n := 1
		for _ in s {
			n++
		}
		return n
	}
	n := 0
	loop {
		i := index(s, sub)
		if i < 0 {
			return n
		}
		n++
		s = s[i+len(sub):]
	}
}
