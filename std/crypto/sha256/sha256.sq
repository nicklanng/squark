// Package sha256 computes SHA-256 (FIPS 180-4) and HMAC-SHA-256 (RFC 2104), for protocols such as
// Postgres' SCRAM authentication. Digests are values: nothing is allocated.
module sha256

pub const size = 32
pub const block_size = 64

const k = u32[64]{
	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
	0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
	0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
	0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
}

// Digest is a SHA-256 computation in progress: write data, then sum.
pub struct Digest {
	h   u32[8]
	buf u8[64]
	n   int // bytes in buf
	len int // bytes written in all
}

// new returns a Digest ready for data.
pub fn new() -> Digest {
	var d Digest
	d.h = u32[8]{0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19}
	return d
}

fn rotr(x u32, n u32) -> u32 { return x>>n | x<<(32-n) }

impl Digest {
	// block mixes one 64-byte block into the state.
	fn block(&self, p u8[]) {
		var w u32[64]
		for i in 0..16 {
			w[i] = u32(p[4*i])<<24 | u32(p[4*i+1])<<16 | u32(p[4*i+2])<<8 | u32(p[4*i+3])
		}
		for i in 16..64 {
			v1 := w[i-2]
			s1 := rotr(v1, 17) ^ rotr(v1, 19) ^ v1>>10
			v0 := w[i-15]
			s0 := rotr(v0, 7) ^ rotr(v0, 18) ^ v0>>3
			w[i] = w[i-16] + s0 + w[i-7] + s1
		}
		a, b, c, d := self.h[0], self.h[1], self.h[2], self.h[3]
		e, f, g, h := self.h[4], self.h[5], self.h[6], self.h[7]
		for i in 0..64 {
			t1 := h + (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) + (e&f ^ ^e&g) + k[i] + w[i]
			t2 := (rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) + (a&b ^ a&c ^ b&c)
			h = g
			g = f
			f = e
			e = d + t1
			d = c
			c = b
			b = a
			a = t1 + t2
		}
		self.h[0] += a
		self.h[1] += b
		self.h[2] += c
		self.h[3] += d
		self.h[4] += e
		self.h[5] += f
		self.h[6] += g
		self.h[7] += h
	}

	// write adds p to the data.
	pub fn write(&self, p u8[]) {
		self.len += len(p)
		if self.n > 0 {
			m := copy(self.buf[self.n:], p)
			self.n += m
			p = p[m:]
			if self.n < 64 {
				return
			}
			self.block(self.buf[:])
			self.n = 0
		}
		while len(p) >= 64 {
			self.block(p[:64])
			p = p[64:]
		}
		self.n = copy(self.buf[:], p)
	}

	// write_string adds s to the data.
	pub fn write_string(&self, s str) {
		var chunk u8[64]
		while len(s) > 0 {
			m := copy(chunk[:], s)
			self.write(chunk[:m])
			s = s[m:]
		}
	}

	// sum returns the digest of the data written so far (d can take more data afterwards).
	pub fn sum(self) -> u8[32] {
		bits := u64(self.len) * 8
		var pad u8[72]
		pad[0] = 0x80
		n := 64 - (self.len+9)%64
		if n == 64 {
			n = 0
		}
		for i in 0..8 {
			pad[1+n+i] = u8(bits >> (56 - 8*u64(i)))
		}
		self.write(pad[:1+n+8])
		var out u8[32]
		for i in 0..8 {
			out[4*i] = u8(self.h[i] >> 24)
			out[4*i+1] = u8(self.h[i] >> 16)
			out[4*i+2] = u8(self.h[i] >> 8)
			out[4*i+3] = u8(self.h[i])
		}
		return out
	}
}

// sum returns the SHA-256 digest of data.
pub fn sum(data u8[]) -> u8[32] {
	d := new()
	d.write(data)
	return d.sum()
}

// hmac returns HMAC-SHA-256(key, data) (RFC 2104).
pub fn hmac(key u8[], data u8[]) -> u8[32] {
	var k0 u8[64]
	if len(key) > 64 {
		kd := sum(key)
		copy(k0[:], kd[:])
	} else {
		copy(k0[:], key)
	}
	var ipad, opad u8[64]
	for i in 0..64 {
		ipad[i] = k0[i] ^ 0x36
		opad[i] = k0[i] ^ 0x5c
	}
	inner := new()
	inner.write(ipad[:])
	inner.write(data)
	ih := inner.sum()
	outer := new()
	outer.write(opad[:])
	outer.write(ih[:])
	return outer.sum()
}
