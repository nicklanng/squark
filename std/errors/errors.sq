// Package errors creates error values. A squark error is a value (code + static message),
// so creating one never allocates.
module errors

// new returns an error with the given message. The message must be constant data: a string
// constant, or a string copied into a package arena (not a view of a package variable, which can
// change); the compiler checks this at every call site.
pub fn new(msg str in static) -> ! {
	return error(1, msg)
}

// with_code returns an error carrying an integer code.
pub fn with_code(code int, msg str in static) -> ! {
	return error(code, msg)
}

// is reports whether err is target.
pub fn is(err, target error) -> bool {
	return err == target
}
