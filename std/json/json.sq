// Package json writes and reads JSON without allocating: encoding appends to caller buffers,
// decoding is a pull parser whose strings are views of the input or of caller buffers.
package json

import (
	"strconv"
	"utf8"
)

const ErrSyntax = error(1, "json: syntax error")
const ErrType = error(2, "json: unexpected value type")
const ErrBuffer = error(3, "json: string does not fit in buffer")

const hex = "0123456789abcdef"

// AppendString appends s as a quoted, escaped JSON string. Invalid UTF-8 becomes U+FFFD, and
// U+2028 and U+2029 are escaped, as Go does.
func AppendString(dst []byte, s string) []byte {
	dst = append(dst, '"')
	start := 0
	for i := 0; i < len(s); i++ {
		c := s[i]
		if c >= 0x80 {
			r, size := utf8.DecodeRuneInString(s[i:])
			if r == utf8.RuneError && size == 1 {
				dst = append(dst, s[start:i]...)
				dst = append(dst, "\uFFFD"...)
				start = i + 1
			} else if r == 0x2028 || r == 0x2029 {
				dst = append(dst, s[start:i]...)
				dst = append(dst, '\\', 'u', '2', '0', '2', hex[r&0xF])
				start = i + size
			}
			i += size - 1
			continue
		}
		if c >= 0x20 && c != '"' && c != '\\' {
			continue
		}
		dst = append(dst, s[start:i]...)
		switch c {
		case '"':
			dst = append(dst, '\\', '"')
		case '\\':
			dst = append(dst, '\\', '\\')
		case '\n':
			dst = append(dst, '\\', 'n')
		case '\r':
			dst = append(dst, '\\', 'r')
		case '\t':
			dst = append(dst, '\\', 't')
		default:
			dst = append(dst, '\\', 'u', '0', '0', hex[c>>4], hex[c&0xF])
		}
		start = i + 1
	}
	dst = append(dst, s[start:]...)
	return append(dst, '"')
}

// WriteString writes s to w as a JSON string literal, escaped as AppendString does, without
// building it in memory first: runs that need no escaping go straight to w. w is any writer with
// Write([]byte) and WriteString(string) methods (a *bytes.Buffer, *http.ResponseWriter, net.Conn
// or os.File); their results are ignored. On an unbuffered writer (a Conn or File) each run is a
// write: wrap it in a bytes.Buffer for strings with many escapes.
func WriteString(w anytype, s string) {
	var esc [16]byte
	w.WriteString("\"")
	start := 0
	for i := 0; i < len(s); i++ {
		c := s[i]
		size := 1
		if c >= 0x80 {
			r, n := utf8.DecodeRuneInString(s[i:])
			if !(r == utf8.RuneError && n == 1) && r != 0x2028 && r != 0x2029 {
				i += n - 1
				continue
			}
			size = n
		} else if c >= 0x20 && c != '"' && c != '\\' {
			continue
		}
		w.WriteString(s[start:i])
		e := AppendString(esc[:0], s[i:i+size]) // one character, quoted and escaped
		w.Write(e[1 : len(e)-1])
		i += size - 1
		start = i + 1
	}
	w.WriteString(s[start:])
	w.WriteString("\"")
}

// AppendInt appends a JSON number.
func AppendInt(dst []byte, v int) []byte {
	return strconv.AppendInt(dst, v)
}

// AppendBool appends true or false.
func AppendBool(dst []byte, v bool) []byte {
	if v {
		return append(dst, "true"...)
	}
	return append(dst, "false"...)
}

// Decoder pulls values out of a JSON document.
type Decoder struct {
	data  []byte
	pos   int
	depth int
	first bool
	Err   error
}

func NewDecoder(data []byte) Decoder from data {
	return Decoder{data: data}
}

func (d *Decoder) fail(err error) {
	if d.Err == nil {
		d.Err = err
	}
}

func (d *Decoder) ws() {
	for d.pos < len(d.data) {
		c := d.data[d.pos]
		if c != ' ' && c != '\t' && c != '\n' && c != '\r' {
			return
		}
		d.pos++
	}
}

func (d *Decoder) peek() byte {
	d.ws()
	if d.pos >= len(d.data) {
		return 0
	}
	return d.data[d.pos]
}

// BeginObject consumes '{'.
func (d *Decoder) BeginObject() bool {
	if d.Err != nil || d.peek() != '{' {
		d.fail(ErrSyntax)
		return false
	}
	d.pos++
	d.first = true
	return true
}

// BeginArray consumes '['.
func (d *Decoder) BeginArray() bool {
	if d.Err != nil || d.peek() != '[' {
		d.fail(ErrSyntax)
		return false
	}
	d.pos++
	d.first = true
	return true
}

// More reports whether the current array has another element (and consumes the separator).
func (d *Decoder) More() bool {
	if d.Err != nil {
		return false
	}
	c := d.peek()
	if c == ']' {
		d.pos++
		d.first = false
		return false
	}
	if !d.first {
		if c != ',' {
			d.fail(ErrSyntax)
			return false
		}
		d.pos++
	}
	d.first = false
	return true
}

// Field reads the next object key into keybuf, returning false at the end of the object.
func (d *Decoder) Field(keybuf []byte) (string, bool) {
	if d.Err != nil {
		return "", false
	}
	c := d.peek()
	if c == '}' {
		d.pos++
		d.first = false
		return "", false
	}
	if !d.first {
		if c != ',' {
			d.fail(ErrSyntax)
			return "", false
		}
		d.pos++
	}
	d.first = false
	key, ok := d.String(keybuf)
	if !ok {
		return "", false
	}
	if d.peek() != ':' {
		d.fail(ErrSyntax)
		return "", false
	}
	d.pos++
	return key, true
}

// String decodes a JSON string into buf and returns a view of buf.
func (d *Decoder) String(buf []byte) (string, bool) from buf {
	if d.Err != nil {
		return "", false
	}
	if d.peek() != '"' {
		d.fail(ErrType)
		return "", false
	}
	d.pos++
	out := buf[:0]
	for d.pos < len(d.data) {
		c := d.data[d.pos]
		d.pos++
		if c == '"' {
			return string(out), true
		}
		if c < 0x20 {
			d.fail(ErrSyntax)
			return "", false
		}
		if c != '\\' {
			if len(out) == cap(out) {
				d.fail(ErrBuffer)
				return "", false
			}
			out = append(out, c)
			continue
		}
		if d.pos >= len(d.data) {
			break
		}
		e := d.data[d.pos]
		d.pos++
		var r rune
		switch e {
		case '"', '\\', '/':
			r = rune(e)
		case 'n':
			r = '\n'
		case 't':
			r = '\t'
		case 'r':
			r = '\r'
		case 'b':
			r = 8
		case 'f':
			r = 12
		case 'u':
			r = d.hex4()
			if d.Err != nil {
				return "", false
			}
			if r >= 0xD800 && r < 0xE000 {
				// a high surrogate must be followed by a low one; anything else is U+FFFD
				hi := r
				r = utf8.RuneError
				if hi < 0xDC00 && d.pos+1 < len(d.data) && d.data[d.pos] == '\\' && d.data[d.pos+1] == 'u' {
					save := d.pos
					d.pos += 2
					lo := d.hex4()
					if d.Err != nil {
						return "", false
					}
					if lo >= 0xDC00 && lo < 0xE000 {
						r = 0x10000 + (hi-0xD800)<<10 + (lo - 0xDC00)
					} else {
						d.pos = save // not a pair: that escape is decoded on its own
					}
				}
			}
		default:
			d.fail(ErrSyntax)
			return "", false
		}
		if cap(out)-len(out) < utf8.RuneLen(r) {
			d.fail(ErrBuffer)
			return "", false
		}
		out = utf8.AppendRune(out, r)
	}
	d.fail(ErrSyntax)
	return "", false
}

func (d *Decoder) hex4() rune {
	var r rune
	for i := 0; i < 4; i++ {
		if d.pos >= len(d.data) {
			d.fail(ErrSyntax)
			return utf8.RuneError
		}
		c := d.data[d.pos]
		d.pos++
		switch {
		case c >= '0' && c <= '9':
			r = r*16 + rune(c-'0')
		case c >= 'a' && c <= 'f':
			r = r*16 + rune(c-'a'+10)
		case c >= 'A' && c <= 'F':
			r = r*16 + rune(c-'A'+10)
		default:
			d.fail(ErrSyntax)
			return utf8.RuneError
		}
	}
	return r
}

// number scans a JSON number at d.pos (RFC 8259: -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?)
// and returns where it ends and whether it is an integer (no fraction or exponent).
func (d *Decoder) number() (int, bool) {
	p := d.pos
	if p < len(d.data) && d.data[p] == '-' {
		p++
	}
	switch {
	case p < len(d.data) && d.data[p] == '0':
		p++
	case p < len(d.data) && d.data[p] >= '1' && d.data[p] <= '9':
		p = d.digits(p)
	default:
		d.fail(ErrSyntax)
		return p, false
	}
	isInt := true
	if p < len(d.data) && d.data[p] == '.' {
		q := d.digits(p + 1)
		if q == p+1 {
			d.fail(ErrSyntax)
			return q, false
		}
		p, isInt = q, false
	}
	if p < len(d.data) && (d.data[p] == 'e' || d.data[p] == 'E') {
		p++
		if p < len(d.data) && (d.data[p] == '+' || d.data[p] == '-') {
			p++
		}
		q := d.digits(p)
		if q == p {
			d.fail(ErrSyntax)
			return q, false
		}
		p, isInt = q, false
	}
	return p, isInt
}

// digits returns the end of the run of digits starting at p.
func (d *Decoder) digits(p int) int {
	for p < len(d.data) && d.data[p] >= '0' && d.data[p] <= '9' {
		p++
	}
	return p
}

// delim checks that a number or literal ends here: at the end of the data, whitespace, or the
// next separator (so 1x, truex and nullable are errors, not 1, true and null).
func (d *Decoder) delim() bool {
	if d.pos >= len(d.data) {
		return true
	}
	switch d.data[d.pos] {
	case ' ', '\t', '\n', '\r', ',', ']', '}':
		return true
	}
	d.fail(ErrSyntax)
	return false
}

// literal consumes word (true, false or null) if it is next, followed by a delimiter.
func (d *Decoder) literal(word string) bool {
	if len(d.data)-d.pos < len(word) || string(d.data[d.pos:d.pos+len(word)]) != word {
		return false
	}
	d.pos += len(word)
	return d.delim()
}

// Int decodes an integer. A number with a fraction or exponent is ErrType (it is consumed).
func (d *Decoder) Int() (int, bool) {
	if d.Err != nil {
		return 0, false
	}
	c := d.peek()
	if c != '-' && (c < '0' || c > '9') {
		d.fail(ErrType)
		return 0, false
	}
	start := d.pos
	end, isInt := d.number()
	if d.Err != nil {
		return 0, false
	}
	d.pos = end
	if !isInt || !d.delim() {
		d.fail(ErrType)
		return 0, false
	}
	v, err := strconv.Atoi(string(d.data[start:end]))
	if err != nil {
		d.fail(ErrType) // out of range
		return 0, false
	}
	return v, true
}

// Float decodes a number as the nearest float64 (an integer too). Too large for a float64 is
// ErrType.
func (d *Decoder) Float() (float64, bool) {
	if d.Err != nil {
		return 0, false
	}
	c := d.peek()
	if c != '-' && (c < '0' || c > '9') {
		d.fail(ErrType)
		return 0, false
	}
	start := d.pos
	end, _ := d.number()
	if d.Err != nil {
		return 0, false
	}
	d.pos = end
	if !d.delim() {
		return 0, false
	}
	f, err := strconv.ParseFloat(string(d.data[start:end]))
	if err != nil {
		d.fail(ErrType)
		return 0, false
	}
	return f, true
}

// Bool decodes true or false.
func (d *Decoder) Bool() (bool, bool) {
	if d.Err != nil {
		return false, false
	}
	d.ws()
	if d.literal("true") {
		return true, true
	}
	if d.Err == nil && d.literal("false") {
		return false, true
	}
	d.fail(ErrType)
	return false, false
}

// Null consumes a null if it is the next value and reports whether it was (a missing or optional
// value; anything else is left for the other methods).
func (d *Decoder) Null() bool {
	if d.Err != nil || d.peek() != 'n' {
		return false
	}
	return d.literal("null")
}

// Skip skips one value of any type (iteratively; nesting is tracked with a counter).
func (d *Decoder) Skip() bool {
	if d.Err != nil {
		return false
	}
	depth := 0
	for {
		c := d.peek()
		switch {
		case c == '"':
			d.pos++
			for d.pos < len(d.data) && d.data[d.pos] != '"' {
				if d.data[d.pos] == '\\' {
					d.pos++
				}
				d.pos++
			}
			d.pos++
		case c == '{' || c == '[':
			depth++
			d.pos++
			continue
		case c == '}' || c == ']':
			depth--
			d.pos++
		case c == ',' || c == ':':
			d.pos++
			continue
		case c == 0:
			d.fail(ErrSyntax)
			return false
		case c == 't' || c == 'f' || c == 'n':
			if !d.literal("true") && !d.literal("false") && !d.literal("null") {
				d.fail(ErrSyntax)
				return false
			}
		default:
			end, _ := d.number()
			if d.Err != nil {
				return false
			}
			d.pos = end
			if !d.delim() {
				return false
			}
		}
		if depth <= 0 {
			if d.pos > len(d.data) {
				d.fail(ErrSyntax)
				return false
			}
			return true
		}
	}
}

// Offset returns how many bytes of the input have been consumed.
func (d *Decoder) Offset() int { return d.pos }

// Line returns the 1-based line the decoder has reached (where an error was found, after one).
func (d *Decoder) Line() int {
	n := 1
	for i := 0; i < d.pos && i < len(d.data); i++ {
		if d.data[i] == '\n' {
			n++
		}
	}
	return n
}

// End reports whether only whitespace remains.
func (d *Decoder) End() bool {
	d.ws()
	return d.Err == nil && d.pos == len(d.data)
}
