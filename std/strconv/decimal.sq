// Exact decimal arithmetic for float formatting and parsing: shortest digits that read back to the
// same float64, and correctly rounded parsing. Adapted from Go's strconv (decimal.go, ftoa.go,
// atof.go): Copyright 2009 The Go Authors, BSD-style license (https://go.dev/LICENSE). The
// numbers live in fixed 800-digit buffers on the stack: no heap, no recursion.
package strconv

import "math"

// decimal is a multi-precision decimal number: digits d[:nd] with the decimal point after dp of
// them (dp may be negative or past nd).
type decimal struct {
	d     [800]byte
	nd    int
	dp    int
	neg   bool
	trunc bool // nonzero digits were dropped beyond d[:nd]
}

func (a *decimal) trim() {
	for a.nd > 0 && a.d[a.nd-1] == '0' {
		a.nd--
	}
	if a.nd == 0 {
		a.dp = 0
	}
}

// assign sets a to v.
func (a *decimal) assign(v uint64) {
	var buf [24]byte
	n := 0
	for v > 0 {
		v1 := v / 10
		buf[n] = byte(v - 10*v1 + '0')
		n++
		v = v1
	}
	a.nd = 0
	for n--; n >= 0; n-- {
		a.d[a.nd] = buf[n]
		a.nd++
	}
	a.dp = a.nd
	a.trim()
}

const maxShift = 60 // 9<<k must fit in 64 bits

// rightShift divides a by 2^k (k <= maxShift).
func (a *decimal) rightShift(k uint) {
	r, w := 0, 0
	var n uint64
	for ; n>>k == 0; r++ {
		if r >= a.nd {
			if n == 0 {
				a.nd = 0
				return
			}
			for n>>k == 0 {
				n = n * 10
				r++
			}
			break
		}
		n = n*10 + uint64(a.d[r]-'0')
	}
	a.dp -= r - 1
	mask := uint64(1)<<k - 1
	for ; r < a.nd; r++ {
		c := uint64(a.d[r] - '0')
		dig := n >> k
		n &= mask
		a.d[w] = byte(dig + '0')
		w++
		n = n*10 + c
	}
	for n > 0 {
		dig := n >> k
		n &= mask
		if w < len(a.d) {
			a.d[w] = byte(dig + '0')
			w++
		} else if dig > 0 {
			a.trunc = true
		}
		n = n * 10
	}
	a.nd = w
	a.trim()
}

type leftCheat struct {
	delta  int    // new digits a left shift by k adds
	cutoff string // one fewer if the number's leading digits are below this (5^k)
}

