// Exact decimal arithmetic for float formatting and parsing: shortest digits that read back to the
// same float64, and correctly rounded parsing. Adapted from Go's strconv (decimal.go, ftoa.go,
// atof.go): Copyright 2009 The Go Authors, under a BSD-style license whose full text is in
// THIRD_PARTY_NOTICES at the root of the squark repository (and at https://go.dev/LICENSE). The
// numbers live in fixed 800-digit buffers on the stack: no heap, no recursion.

module strconv

use math

// Decimal is a multi-precision decimal number: digits d[:nd] with the decimal point after dp of
// them (dp may be negative or past nd).
struct Decimal {
	d     u8[800]
	nd    int
	dp    int
	neg   bool
	trunc bool // nonzero digits were dropped beyond d[:nd]
}

impl Decimal {
	fn trim(&self) {
		while self.nd > 0 and self.d[self.nd-1] == '0' {
			self.nd--
		}
		if self.nd == 0 {
			self.dp = 0
		}
	}

	// assign sets a to v.
	fn assign(&self, v u64) {
		var buf u8[24]
		n := 0
		while v > 0 {
			v1 := v / 10
			buf[n] = u8(v - 10*v1 + '0')
			n++
			v = v1
		}
		self.nd = 0
		for n--; n >= 0; n-- {
			self.d[self.nd] = buf[n]
			self.nd++
		}
		self.dp = self.nd
		self.trim()
	}
}

const max_shift = 60 // 9<<k must fit in 64 bits

impl Decimal {
	// right_shift divides a by 2^k (k <= max_shift).
	fn right_shift(&self, k uint) {
		r, w := 0, 0
		var n u64
		for ; n>>k == 0; r++ {
			if r >= self.nd {
				if n == 0 {
					self.nd = 0
					return
				}
				while n>>k == 0 {
					n = n * 10
					r++
				}
				break
			}
			n = n*10 + u64(self.d[r]-'0')
		}
		self.dp -= r - 1
		mask := u64(1)<<k - 1
		for ; r < self.nd; r++ {
			c := u64(self.d[r] - '0')
			dig := n >> k
			n &= mask
			self.d[w] = u8(dig + '0')
			w++
			n = n*10 + c
		}
		while n > 0 {
			dig := n >> k
			n &= mask
			if w < len(self.d) {
				self.d[w] = u8(dig + '0')
				w++
			} else if dig > 0 {
				self.trunc = true
			}
			n = n * 10
		}
		self.nd = w
		self.trim()
	}

	// left_shift multiplies a by 2^k (k <= max_shift).
	fn left_shift(&self, k uint) {
		delta := leftcheats[k].delta
		if prefix_less(self.d[0:self.nd], leftcheats[k].cutoff) {
			delta--
		}
		r, w := self.nd, self.nd+delta
		var n u64
		for r--; r >= 0; r-- {
			n += u64(self.d[r]-'0') << k
			quo := n / 10
			rem := n - 10*quo
			w--
			if w < len(self.d) {
				self.d[w] = u8(rem + '0')
			} else if rem != 0 {
				self.trunc = true
			}
			n = quo
		}
		while n > 0 {
			quo := n / 10
			rem := n - 10*quo
			w--
			if w < len(self.d) {
				self.d[w] = u8(rem + '0')
			} else if rem != 0 {
				self.trunc = true
			}
			n = quo
		}
		self.nd += delta
		if self.nd >= len(self.d) {
			self.nd = len(self.d)
		}
		self.dp += delta
		self.trim()
	}

	// shift multiplies a by 2^k (k > 0) or divides it by 2^-k (k < 0).
	fn shift(&self, k int) {
		if self.nd == 0 {
			return
		}
		while k > max_shift {
			self.left_shift(max_shift)
			k -= max_shift
		}
		while k < -max_shift {
			self.right_shift(max_shift)
			k += max_shift
		}
		if k > 0 {
			self.left_shift(uint(k))
		} else if k < 0 {
			self.right_shift(uint(-k))
		}
	}

	// should_round_up reports whether chopping a at nd digits should round up (half to even).
	fn should_round_up(&self, nd int) -> bool {
		if nd < 0 or nd >= self.nd {
			return false
		}
		if self.d[nd] == '5' and nd+1 == self.nd { // exactly halfway
			if self.trunc {
				return true
			}
			return nd > 0 and (self.d[nd-1]-'0')%2 == 1
		}
		return self.d[nd] >= '5'
	}

	fn round(&self, nd int) {
		if nd < 0 or nd >= self.nd {
			return
		}
		if self.should_round_up(nd) {
			self.round_up(nd)
		} else {
			self.round_down(nd)
		}
	}

	fn round_down(&self, nd int) {
		if nd < 0 or nd >= self.nd {
			return
		}
		self.nd = nd
		self.trim()
	}

	fn round_up(&self, nd int) {
		if nd < 0 or nd >= self.nd {
			return
		}
		for i := nd - 1; i >= 0; i-- {
			if self.d[i] < '9' {
				self.d[i]++
				self.nd = i + 1
				return
			}
		}
		self.d[0] = '1' // all nines
		self.nd = 1
		self.dp++
	}

	// rounded_integer returns the integer part of a, rounded.
	fn rounded_integer(&self) -> u64 {
		if self.dp > 20 {
			return 0xFFFFFFFFFFFFFFFF
		}
		i := 0
		n := u64(0)
		for ; i < self.dp and i < self.nd; i++ {
			n = n*10 + u64(self.d[i]-'0')
		}
		for ; i < self.dp; i++ {
			n *= 10
		}
		if self.should_round_up(self.dp) {
			n++
		}
		return n
	}

	// set reads s ([+-]digits[.digits][e[+-]digits]) into b; false if it isn't such a number.
	fn set(&self, s str) -> bool {
		i := 0
		self.neg, self.trunc = false, false
		if i < len(s) and (s[i] == '+' or s[i] == '-') {
			self.neg = s[i] == '-'
			i++
		}
		sawdot, sawdigits := false, false
		ndig := 0 // significant digits seen, including those dropped once d is full
		for ; i < len(s); i++ {
			c := s[i]
			if c == '.' {
				if sawdot {
					return false
				}
				sawdot = true
				self.dp = ndig
				continue
			}
			if c < '0' or c > '9' {
				break
			}
			sawdigits = true
			if c == '0' and ndig == 0 { // leading zeros
				self.dp--
				continue
			}
			ndig++
			if self.nd < len(self.d) {
				self.d[self.nd] = c
				self.nd++
			} else if c != '0' {
				self.trunc = true
			}
		}
		if not sawdigits {
			return false
		}
		if not sawdot {
			self.dp = ndig
		}
		if i < len(s) and (s[i] == 'e' or s[i] == 'E') {
			i++
			esign := 1
			if i < len(s) and (s[i] == '+' or s[i] == '-') {
				if s[i] == '-' {
					esign = -1
				}
				i++
			}
			if i >= len(s) or s[i] < '0' or s[i] > '9' {
				return false
			}
			e := 0
			for ; i < len(s) and s[i] >= '0' and s[i] <= '9'; i++ {
				if e < 10000 {
					e = e*10 + int(s[i]-'0')
				}
			}
			self.dp += e * esign
		}
		return i == len(s)
	}

	// float_bits returns the float64 closest to d (half to even), and whether it overflowed to ±Inf.
	fn float_bits(&self) -> (u64, bool) {
		exp, mant, overflow := bias, u64(0), false
		switch {
		case self.nd == 0 or self.dp < -330: // zero (or underflow to zero)
		case self.dp > 310:
			overflow = true
		default:
			exp = 0
			while self.dp > 0 { // scale into [0.5, 1)
				n := 27
				if self.dp < len(powtab) {
					n = powtab[self.dp]
				}
				self.shift(-n)
				exp += n
			}
			while self.dp < 0 or self.dp == 0 and self.d[0] < '5' {
				n := 27
				if -self.dp < len(powtab) {
					n = powtab[-self.dp]
				}
				self.shift(n)
				exp -= n
			}
			exp-- // [0.5, 1) to [1, 2)
			if exp < bias+1 {
				n := bias + 1 - exp
				self.shift(-n)
				exp += n
			}
			if exp-bias >= 1<<exp_bits-1 {
				overflow = true
				break
			}
			self.shift(1 + mant_bits)
			mant = self.rounded_integer()
			if mant == 2<<mant_bits { // rounding carried into a new bit
				mant >>= 1
				exp++
				if exp-bias >= 1<<exp_bits-1 {
					overflow = true
					break
				}
			}
			if mant&(1<<mant_bits) == 0 {
				exp = bias // subnormal
			}
		}
		if overflow {
			mant, exp = 0, 1<<exp_bits-1+bias
		}
		bits := mant & (u64(1)<<mant_bits - 1)
		bits |= u64((exp-bias)&(1<<exp_bits-1)) << mant_bits
		if self.neg {
			bits |= u64(1) << 63
		}
		return bits, overflow
	}
}

struct LeftCheat {
	delta  int // new digits a left shift by k adds
	cutoff str // one fewer if the number's leading digits are below this (5^k)
}

