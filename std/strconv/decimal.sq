// prefix_less reports whether the digits b are lexicographically below s.
fn prefix_less(b u8[], s str) -> bool {
	for i := 0; i < len(s); i++ {
		if i >= len(b) {
			return true
		}
		if b[i] != s[i] {
			return b[i] < s[i]
		}
	}
	return false
}

const (
	mant_bits = 52
	exp_bits  = 11
	bias      = -1023
)

// round_shortest rounds d (= mant * 2^(exp-mant_bits)) to the fewest digits that still read back to
// the same float64: the digits must stay between the halfway points to the neighbouring floats.
fn round_shortest(d *Decimal, mant u64, exp int) {
	if mant == 0 {
		d.nd = 0
		return
	}
	minexp := bias + 1
	if exp > minexp and 332*(d.dp-d.nd) >= 100*(exp-mant_bits) {
		return // already shortest
	}
	var upper Decimal
	upper.assign(mant*2 + 1)
	upper.shift(exp - mant_bits - 1)
	var mantlo u64
	var explo int
	if mant > 1<<mant_bits or exp == minexp {
		mantlo, explo = mant-1, exp
	} else {
		mantlo, explo = mant*2-1, exp-1
	}
	var lower Decimal
	lower.assign(mantlo*2 + 1)
	lower.shift(explo - mant_bits - 1)
	inclusive := mant%2 == 0 // round-to-even would keep the bounds themselves
	upperdelta := 0
	for ui := 0; ; ui++ {
		mi := ui - upper.dp + d.dp
		if mi >= d.nd {
			break
		}
		li := ui - upper.dp + lower.dp
		l := u8('0')
		if li >= 0 and li < lower.nd {
			l = lower.d[li]
		}
		m := u8('0')
		if mi >= 0 {
			m = d.d[mi]
		}
		u := u8('0')
		if ui < upper.nd {
			u = upper.d[ui]
		}
		okdown := l != m or inclusive and li+1 == lower.nd
		switch {
		case upperdelta == 0 and m+1 < u:
			upperdelta = 2
		case upperdelta == 0 and m != u:
			upperdelta = 1
		case upperdelta == 1 and (m != '9' or u != '0'):
			upperdelta = 2
		}
		okup := upperdelta > 0 and (inclusive or upperdelta > 1 or ui+1 < upper.nd)
		switch {
		case okdown and okup:
			d.round(mi + 1)
			return
		case okdown:
			d.round_down(mi + 1)
			return
		case okup:
			d.round_up(mi + 1)
			return
		}
	}
}

// append_shortest appends v's shortest round-trip form: plain notation for 1e-6 <= |v| < 1e21,
// exponent notation (1.5e+300) outside, as JSON and JavaScript do.
fn append_shortest(dst u8[], v f64) -> u8[] {
	bits := math.float64bits(v)
	exp := int(bits>>mant_bits) & (1<<exp_bits - 1)
	mant := bits & (u64(1)<<mant_bits - 1)
	if exp == 1<<exp_bits-1 {
		if mant != 0 {
			return append(dst, "NaN"...)
		}
		if bits>>63 != 0 {
			return append(dst, "-Inf"...)
		}
		return append(dst, "+Inf"...)
	}
	if bits>>63 != 0 {
		dst = append(dst, '-')
	}
	if exp == 0 {
		exp++ // subnormal
	} else {
		mant |= u64(1) << mant_bits
	}
	exp += bias
	var d Decimal
	d.assign(mant)
	d.shift(exp - mant_bits)
	round_shortest(&d, mant, exp)
	if d.nd == 0 {
		return append(dst, '0')
	}
	if d.dp > -6 and d.dp <= 21 {
		if d.dp <= 0 {
			dst = append(dst, '0', '.')
			for i := d.dp; i < 0; i++ {
				dst = append(dst, '0')
			}
			return append(dst, d.d[:d.nd]...)
		}
		if d.dp >= d.nd {
			dst = append(dst, d.d[:d.nd]...)
			for i := d.nd; i < d.dp; i++ {
				dst = append(dst, '0')
			}
			return dst
		}
		dst = append(dst, d.d[:d.dp]...)
		dst = append(dst, '.')
		return append(dst, d.d[d.dp:d.nd]...)
	}
	dst = append(dst, d.d[0])
	if d.nd > 1 {
		dst = append(dst, '.')
		dst = append(dst, d.d[1:d.nd]...)
	}
	dst = append(dst, 'e')
	e := d.dp - 1
	if e < 0 {
		dst = append(dst, '-')
		e = -e
	} else {
		dst = append(dst, '+')
	}
	return append_int(dst, e)
}

const powtab = int[9]{1, 3, 6, 9, 13, 16, 19, 23, 26}

const pow10 = f64[23]{1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11, 1e12, 1e13,
	1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22}

// special parses inf, infinity and nan (any case, inf with a sign).
fn special(s str) -> (f64, bool) {
	sign := 1
	t := s
	if len(t) > 0 and (t[0] == '+' or t[0] == '-') {
		if t[0] == '-' {
			sign = -1
		}
		t = t[1:]
	}
	var low u8[8]
	if len(t) > len(low) {
		return 0, false
	}
	for i := 0; i < len(t); i++ {
		c := t[i]
		if c >= 'A' and c <= 'Z' {
			c += 'a' - 'A'
		}
		low[i] = c
	}
	w := str(low[:len(t)])
	switch {
	case w == "inf" or w == "infinity":
		return math.inf(sign), true
	case w == "nan" and len(t) == len(s):
		return math.na_n(), true
	}
	return 0, false
}

// parse_float converts s ("1.5", "-2e-10", "Inf", "NaN") to the nearest float64 (half to even),
// correctly rounded. Syntax if s isn't a number; Range (with ±Inf) if it is too large.
// Hexadecimal floats ("0x1p4") and underscores ("1_000") are not accepted (Syntax).
pub fn parse_float(s str) -> f64 ! {
	if f, ok := special(s); ok {
		return f, nil
	}
	var d Decimal
	if not d.set(s) {
		return 0, Syntax
	}
	// fast path: up to 15 digits and a power of ten up to 22, both exact, one rounding
	if not d.trunc and d.nd <= 15 and d.dp-d.nd >= -22 and d.dp-d.nd <= 22 {
		m := 0
		for i := 0; i < d.nd; i++ {
			m = m*10 + int(d.d[i]-'0')
		}
		f := f64(m)
		if e := d.dp - d.nd; e >= 0 {
			f *= pow10[e]
		} else {
			f /= pow10[-e]
		}
		if d.neg {
			f = -f
		}
		return f, nil
	}
	bits, overflow := d.float_bits()
	f := math.float64frombits(bits)
	if overflow {
		return f, Range
	}
	return f, nil
}
