// Package strconv converts between numbers and text using caller-provided buffers.
package strconv

var ErrSyntax = __error(22, "invalid syntax")
var ErrRange = __error(34, "value out of range")

// AppendInt appends the decimal form of v to dst.
func AppendInt(dst []byte, v int) []byte {
	if v < 0 {
		dst = append(dst, '-')
		return AppendUint(dst, uint64(0)-uint64(v))
	}
	return AppendUint(dst, uint64(v))
}

// AppendUint appends the decimal form of v to dst.
func AppendUint(dst []byte, v uint64) []byte {
	var tmp [20]byte
	i := len(tmp)
	for {
		i--
		tmp[i] = byte('0' + v%10)
		v /= 10
		if v == 0 {
			break
		}
	}
	return append(dst, tmp[i:]...)
}

// FormatInt writes v into buf and returns it as a string view of buf.
func FormatInt(buf []byte, v int) string {
	return string(AppendInt(buf[:0], v))
}

// AppendFloat appends v with prec digits after the decimal point.
func AppendFloat(dst []byte, v float64, prec int) []byte {
	if v != v {
		return append(dst, "NaN"...)
	}
	if v < 0 {
		dst = append(dst, '-')
		v = -v
	}
	if v > 9.2e18 {
		return append(dst, "+Inf"...)
	}
	scale := 1.0
	for i := 0; i < prec; i++ {
		scale *= 10
	}
	whole := uint64(v)
	frac := uint64((v-float64(whole))*scale + 0.5)
	if frac >= uint64(scale) {
		whole++
		frac -= uint64(scale)
	}
	dst = AppendUint(dst, whole)
	if prec > 0 {
		dst = append(dst, '.')
		var tmp [20]byte
		for i := prec - 1; i >= 0; i-- {
			tmp[i] = byte('0' + frac%10)
			frac /= 10
		}
		dst = append(dst, tmp[:prec]...)
	}
	return dst
}

// Atoi parses a base-10 integer.
func Atoi(s string) (int, error) {
	return ParseInt(s, 10)
}

// ParseInt parses an integer in the given base (2 to 36).
func ParseInt(s string, base int) (int, error) {
	if len(s) == 0 {
		return 0, ErrSyntax
	}
	neg := false
	i := 0
	if s[0] == '-' || s[0] == '+' {
		neg = s[0] == '-'
		i = 1
		if len(s) == 1 {
			return 0, ErrSyntax
		}
	}
	var n uint64
	limit := uint64(1) << 63
	for ; i < len(s); i++ {
		c := s[i]
		var d uint64
		switch {
		case c >= '0' && c <= '9':
			d = uint64(c - '0')
		case c >= 'a' && c <= 'z':
			d = uint64(c-'a') + 10
		case c >= 'A' && c <= 'Z':
			d = uint64(c-'A') + 10
		case c == '_':
			continue
		default:
			return 0, ErrSyntax
		}
		if d >= uint64(base) {
			return 0, ErrSyntax
		}
		if n > (limit+uint64(base)-1)/uint64(base) {
			return 0, ErrRange
		}
		n = n*uint64(base) + d
		if n > limit {
			return 0, ErrRange
		}
	}
	if !neg && n == limit {
		return 0, ErrRange
	}
	if neg {
		return int(uint64(0) - n), nil
	}
	return int(n), nil
}

// ParseBool accepts 1, t, T, TRUE, true, True, 0, f, F, FALSE, false, False.
func ParseBool(s string) (bool, error) {
	switch s {
	case "1", "t", "T", "TRUE", "true", "True":
		return true, nil
	case "0", "f", "F", "FALSE", "false", "False":
		return false, nil
	}
	return false, ErrSyntax
}
