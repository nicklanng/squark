// Package strconv converts between numbers and text using caller-provided buffers.
package strconv

import "math"

const ErrSyntax = error(22, "invalid syntax")
const ErrRange = error(34, "value out of range")
const ErrBase = error(22, "invalid base")

// AppendInt appends the decimal form of v to dst.
func AppendInt(dst []byte, v int) []byte from dst {
	if v < 0 {
		dst = append(dst, '-')
		return AppendUint(dst, uint64(0)-uint64(v))
	}
	return AppendUint(dst, uint64(v))
}

// AppendUint appends the decimal form of v to dst.
func AppendUint(dst []byte, v uint64) []byte {
	var tmp [20]byte
	i := len(tmp)
	for {
		i--
		tmp[i] = byte('0' + v%10)
		v /= 10
		if v == 0 {
			break
		}
	}
	return append(dst, tmp[i:]...)
}

// FormatInt writes v into buf and returns it as a string view of buf.
func FormatInt(buf []byte, v int) string {
	return string(AppendInt(buf[:0], v))
}

// AppendFloat appends v with prec digits after the decimal point, like Go's
// strconv.AppendFloat(dst, v, 'f', prec, 64): the exact binary value rounded half to even. A negative
// prec counts as 0. The result can be long (1e300 has 301 digits), so size dst for it.
func AppendFloat(dst []byte, v float64, prec int) []byte {
	bits := math.Float64bits(v)
	exp := int(bits>>52) & 0x7ff
	mant := bits & (1<<52 - 1)
	if exp == 0x7ff {
		if mant != 0 {
			return append(dst, "NaN"...)
		}
		if bits>>63 != 0 {
			return append(dst, "-Inf"...)
		}
		return append(dst, "+Inf"...)
	}
	if bits>>63 != 0 {
		dst = append(dst, '-')
	}
	if exp == 0 {
		exp = 1 // subnormal
	} else {
		mant |= 1 << 52
	}
	e := exp - 1075 // v = mant * 2^e
	if prec < 0 {
		prec = 0
	}

	// digits: buf[1:ni+1] the integer part, then nf fraction digits; buf[0] takes a rounding carry
	var buf [1 + 309 + 1074]byte
	ni := 0
	nf := 0
	if e >= 0 {
		ni = bigIntDigits(mant, e, buf[1:310])
	} else {
		k := -e
		var whole, frac uint64
		if k < 64 {
			whole, frac = mant>>uint(k), mant&(uint64(1)<<uint(k)-1)
		} else {
			frac = mant
		}
		var tmp [20]byte
		t := AppendUint(tmp[:0], whole)
		ni = copy(buf[1:], t)
		// the fraction is frac / 2^k, held in 32-bit limbs; each step multiplies by 10 and takes
		// the bits above k as the next digit
		var f [36]uint64
		f[0], f[1] = frac&0xffffffff, frac>>32
		nl := k/32 + 2
		hi, sh := k/32, uint(k%32)
		for nf < prec && nf < 1074 {
			var carry uint64
			for i := 0; i < nl; i++ {
				x := f[i]*10 + carry
				f[i], carry = x&0xffffffff, x>>32
			}
			d := f[hi] >> sh
			f[hi] &= uint64(1)<<sh - 1
			if sh > 0 {
				d |= f[hi+1] << (32 - sh)
			}
			f[hi+1] = 0
			buf[1+ni+nf] = byte('0' + d)
			nf++
			zero := true
			for i := 0; i < nl && zero; i++ {
				zero = f[i] == 0
			}
			if zero {
				break // exact: the remaining digits are zeros
			}
		}
		// round half to even on what is left: compare the remainder with 2^(k-1)
		hb := (f[(k-1)/32] >> uint((k-1)%32)) & 1
		rest := f[(k-1)/32] & (uint64(1)<<uint((k-1)%32) - 1)
		for i := 0; i < (k-1)/32; i++ {
			rest |= f[i]
		}
		if hb == 1 && (rest != 0 || (buf[ni+nf]-'0')%2 == 1) {
			i := ni + nf
			for buf[i] == '9' {
				buf[i] = '0'
				i--
			}
			if i == 0 {
				buf[0] = '1'
			} else {
				buf[i]++
			}
		}
	}
	if buf[0] == '1' {
		dst = append(dst, '1') // carry out of the integer part: 9.99 -> 10.0
	}
	dst = append(dst, buf[1:1+ni]...)
	if prec > 0 {
		dst = append(dst, '.')
		dst = append(dst, buf[1+ni:1+ni+nf]...)
		for i := nf; i < prec; i++ {
			dst = append(dst, '0')
		}
	}
	return dst
}

// bigIntDigits writes the decimal digits of mant * 2^e (e >= 0) to out and returns how many.
func bigIntDigits(mant uint64, e int, out []byte) int {
	// 32-bit limbs, least significant first: at most 1024 bits
	var n [34]uint64
	lo := e / 32
	sh := uint(e % 32)
	m0, m1 := mant&0xffffffff, mant>>32 // mant < 2^53, so m1 < 2^21
	n[lo] = (m0 << sh) & 0xffffffff
	n[lo+1] = (m0>>(32-sh) | m1<<sh) & 0xffffffff
	n[lo+2] = m1 >> (32 - sh)
	top := lo + 3
	// divide by 1e9 repeatedly: chunks come out least significant first
	var chunks [36]uint64
	nc := 0
	for top > 0 {
		var rem uint64
		for i := top - 1; i >= 0; i-- {
			x := rem<<32 | n[i]
			n[i], rem = x/1000000000, x%1000000000
		}
		chunks[nc] = rem
		nc++
		for top > 0 && n[top-1] == 0 {
			top--
		}
	}
	var tmp [20]byte
	t := AppendUint(tmp[:0], chunks[nc-1])
	w := copy(out, t)
	for i := nc - 2; i >= 0; i-- {
		c := chunks[i]
		for j := 8; j >= 0; j-- {
			out[w+j] = byte('0' + c%10)
			c /= 10
		}
		w += 9
	}
	return w
}

// Atoi parses a base-10 integer.
func Atoi(s string) (int, error) {
	return ParseInt(s, 10)
}

// ParseInt parses an integer in the given base (2 to 36). Unlike Go there is no base 0, so no
// prefixes and no '_' separators.
func ParseInt(s string, base int) (int, error) {
	if base < 2 || base > 36 {
		return 0, ErrBase
	}
	if len(s) == 0 {
		return 0, ErrSyntax
	}
	neg := false
	i := 0
	if s[0] == '-' || s[0] == '+' {
		neg = s[0] == '-'
		i = 1
		if len(s) == 1 {
			return 0, ErrSyntax
		}
	}
	var n uint64
	limit := uint64(1) << 63
	for ; i < len(s); i++ {
		c := s[i]
		var d uint64
		switch {
		case c >= '0' && c <= '9':
			d = uint64(c - '0')
		case c >= 'a' && c <= 'z':
			d = uint64(c-'a') + 10
		case c >= 'A' && c <= 'Z':
			d = uint64(c-'A') + 10
		default:
			return 0, ErrSyntax
		}
		if d >= uint64(base) {
			return 0, ErrSyntax
		}
		if n > (limit+uint64(base)-1)/uint64(base) {
			return 0, ErrRange
		}
		n = n*uint64(base) + d
		if n > limit {
			return 0, ErrRange
		}
	}
	if !neg && n == limit {
		return 0, ErrRange
	}
	if neg {
		return int(uint64(0) - n), nil
	}
	return int(n), nil
}

// ParseBool accepts 1, t, T, TRUE, true, True, 0, f, F, FALSE, false, False.
func ParseBool(s string) (bool, error) {
	switch s {
	case "1", "t", "T", "TRUE", "true", "True":
		return true, nil
	case "0", "f", "F", "FALSE", "false", "False":
		return false, nil
	}
	return false, ErrSyntax
}
